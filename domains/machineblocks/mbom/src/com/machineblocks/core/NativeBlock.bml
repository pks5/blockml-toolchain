<!--
  MachineBlocks MBOM — NativeBlock (mb_block primitive)

  FQN: com.machineblocks.core.NativeBlock
  Final — cannot be used as baseType on Block definitions
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Final leaf Block mapped directly to SCAD mb_block() — the native geometry primitive at render time. Extends Block directly (not CompositeBlock). Uses children aggregation for mb_block() sub-geometry instead of _parts.</documentation>

  <name>NativeBlock</name>
  <fullQualifiedName>com.machineblocks.core.NativeBlock</fullQualifiedName>
  <baseType>com.machineblocks.core.Block</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <allowedSubBlockTypes />

  <!-- Native MB properties only — no custom properties on NativeBlock instances -->

  <aggregations>
    <aggregation name="children"
                 type="com.machineblocks.core.Block[]"
                 default="true" />
  </aggregations>

</block>
