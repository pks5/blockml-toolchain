<!--
  MachineBlocks MBOM — composable Block with _parts aggregation

  FQN: com.machineblocks.core.CompositeBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Composable MachineBlocks Block with default _parts aggregation. On Sets, _parts holds placed block instances (direction, offset, appliedPresets). On other composites, _parts holds child blocks for SCAD composition.</documentation>

  <name>CompositeBlock</name>
  <type>com.machineblocks.core.CompositeBlock</type>
  <baseType>com.machineblocks.core.Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <subTypes>
    <subType type="com.machineblocks.core.Block" />
    <subType type="org.blockml.core.FunctionBlock" />
  </subTypes>

  <implTypes>
    <implType type="org.blockml.language.OpenSCAD" />
  </implTypes>

  <aggregations>
    <aggregation name="_parts"
                 type="com.machineblocks.core.Block[]"
                 default="true" />
  </aggregations>

</block>
