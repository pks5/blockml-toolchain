<!--
  MachineBlocks MBOM — Set assembly step

  FQN: com.machineblocks.core.Step
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Framework Block defining one assembly instruction step in a Set — references a placed block instance via the part association. Used as children of composition aggregation="_steps". Document order defines build order when _steps is present.</documentation>

  <name>Step</name>
  <type>com.machineblocks.core.Step</type>
  <baseType>org.blockml.core.Block</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <associations>
    <association name="part" type="com.machineblocks.core.Block"></association>
  </associations>

  <properties>
    <property name="description" type="String">
      <documentation>Additional description of the step.</documentation>
    </property>
  </properties>

</block>
