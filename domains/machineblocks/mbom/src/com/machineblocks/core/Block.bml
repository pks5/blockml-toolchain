<!--
  MachineBlocks MBOM — domain base Block

  FQN: com.machineblocks.core.Block
  Native properties: full set migrates from 09_mbom_properties.yml into <properties>
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>MachineBlocks domain base Block. Abstract composable type for all physical MBOM blocks — carries native properties (size, offset, direction, …) and the default _parts aggregation.</documentation>

  <name>Block</name>
  <fullQualifiedName>com.machineblocks.core.Block</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <allowedSubBlockTypes>
    <allowedSubBlockType type="com.machineblocks.core.Block" />
    <allowedSubBlockType type="org.blockml.service.FunctionBlock" />
  </allowedSubBlockTypes>

  <supportedImplementationTypes>
    <supportedImplementationType type="org.blockml.language.OpenSCAD" />
  </supportedImplementationTypes>

  <aggregations>
    <aggregation name="_parts"
                 type="com.machineblocks.core.Block[]"
                 default="true" />
  </aggregations>

  <!-- Representative native properties — remainder to migrate from 09_mbom_properties.yml -->
  <properties>
    <property name="size" type="type:Size3D" defaultValue="[1, 1, 1]" />
    <property name="offset" type="type:Vector3D" defaultValue="[0, 0, 0]" />
    <property name="direction" type="type:Direction" defaultValue="north" />
    <property name="baseColor" type="type:Color" />
    <property name="studs" type="Boolean" defaultValue="true" />
  </properties>

</block>
