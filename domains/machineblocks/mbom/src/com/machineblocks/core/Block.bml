<!--
  MachineBlocks MBOM — domain base Block

  FQN: com.machineblocks.core.Block
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>MachineBlocks domain base Block. Carries _presets aggregation and appliedPresets association for domain-specific preset resolution. Preset merge is compiler logic; Customizer output is render-target logic.</documentation>

  <name>Block</name>
  <fullQualifiedName>com.machineblocks.core.Block</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <properties>
    <property name="name" type="String">
      <documentation>The human readable name of the Block.</documentation>
    </property>
  </properties>
  
  <associations>
    <association name="appliedPresets" type="_self[]"></association>
  </associations>

  <aggregations>
    <aggregation name="_presets" type="com.machineblocks.core.Block[]" />
  </aggregations>
  
</block>
