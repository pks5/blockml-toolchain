<!--
  MachineBlocks MBOM — Set base type (STEPS + views)

  FQN: com.machineblocks.core.Set
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <name>Set</name>
  <fullQualifiedName>com.machineblocks.core.Set</fullQualifiedName>
  <baseType>com.machineblocks.core.Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <allowedSubBlockTypes>
    <allowedSubBlockType type="com.machineblocks.core.Block" />
    <allowedSubBlockType type="org.blockml.service.FunctionBlock" />
  </allowedSubBlockTypes>

  <aggregations>
    <aggregation name="_blocks"    cardinality="0..n" type="com.machineblocks.core.Block" visibility="hidden" />
    <aggregation name="_placement" cardinality="0..n" type="com.machineblocks.core.Place" visibility="hidden" />
    <aggregation name="_steps"     cardinality="0..n" type="com.machineblocks.core.Step"  visibility="hidden" />
  </aggregations>

</block>
