<!--
  MachineBlocks MBOM — Set base type (STEPS + views)

  FQN: com.machineblocks.core.Set
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Abstract composable Block for LEGO-style Sets — block palette in inherited _parts, plus _placement and _steps for assembly. Top-level catalog unit in MachineBlocks.</documentation>

  <name>Set</name>
  <fullQualifiedName>com.machineblocks.core.Set</fullQualifiedName>
  <baseType>com.machineblocks.core.Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <allowedSubBlockTypes>
    <allowedSubBlockType type="com.machineblocks.core.Block" />
    <allowedSubBlockType type="org.blockml.service.FunctionBlock" />
  </allowedSubBlockTypes>

  <aggregations>
    <aggregation name="_placement" type="com.machineblocks.core.Placement[]" />
    <aggregation name="_steps"     type="com.machineblocks.core.Step[]" />
  </aggregations>

</block>
