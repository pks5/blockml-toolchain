<!--
  MachineBlocks MBOM — Set base type (STEPS + views)

  FQN: com.machineblocks.core.Set
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Abstract composable Block for LEGO-style Sets — block palette in inherited _presets, placed instances in inherited _parts, assembly order in _steps. Top-level catalog unit in MachineBlocks.</documentation>

  <name>Set</name>
  <fullQualifiedName>com.machineblocks.core.Set</fullQualifiedName>
  <baseType>com.machineblocks.core.CompositeBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <aggregations>
    <aggregation name="_steps"     type="com.machineblocks.core.Step[]" />
  </aggregations>

</block>
