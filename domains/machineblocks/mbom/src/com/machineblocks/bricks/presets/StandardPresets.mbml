<!--
  MachineBlocks.com Presets File

  Name: StandardPresets
  Filename: StandardPresets.mbml
  FQN: com.machineblocks.bricks.StandardPresets

  Preset Collection for com.machineblocks.bricks.Standard (Standard.mbml).
  Compiles to scad/com/machineblocks/bricks/Standard.json (OpenSCAD Customizer).
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:type="com.machineblocks.type"
  xmlns:bricks="com.machineblocks.bricks"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
    http://machineblocks.com/schema/bricks
        https://machineblocks.com/schemas/machineblocks/bricks.xsd
  ">

  <documentation>Named property presets for the MachineBlocks Standard brick — sizes, colors, and composite combinations for Customizer and composition presetRef.</documentation>

  <name>StandardPresets</name>
  <fullQualifiedName>com.machineblocks.bricks.StandardPresets</fullQualifiedName>
  <baseType>org.blockml.core.PresetCollection</baseType>
  <version>3.0.0</version>

  <composition>

    <Preset id="brick-1x1" name="Brick 1x1">
      <bricks:Standard version="3.0.0" size="[1, 1, 3]" />
    </Preset>

    <Preset id="brick-2x4" name="Brick 2x4">
      <bricks:Standard version="3.0.0" size="[2, 4, 3]" />
    </Preset>

    <Preset id="brick-4x4" name="Brick 4x4">
      <bricks:Standard version="3.0.0" size="[4, 4, 3]" />
    </Preset>

    <Preset id="color-red" name="Red">
      <bricks:Standard version="3.0.0" baseColor="#D65745" />
    </Preset>

    <Preset id="color-blue" name="Blue">
      <bricks:Standard version="3.0.0" baseColor="#5296D5" />
    </Preset>

    <Preset id="color-midnight" name="Midnight Blue">
      <bricks:Standard version="3.0.0" baseColor="#303D4E" />
    </Preset>

    <Preset id="brick-1x1-red"
            name="Brick 1x1 Red"
            basePresets="brick-1x1 color-red" />

    <Preset id="brick-2x4-blue"
            name="Brick 2x4 Blue"
            basePresets="brick-2x4 color-blue" />

    <Preset id="brick-1x1-red-text"
            name="Brick 1x1 Red MB"
            basePresets="brick-1x1-red">
      <bricks:Standard version="3.0.0" text="MB" textColor="#EDF0F1" />
    </Preset>

    <Preset id="brick-2x4-special"
            name="Brick 2x4 Special"
            basePresets="com.myproject.presets.MyPresets::my-base brick-2x4">
      <bricks:Standard version="3.0.0" textColor="#EDF0F1" />
    </Preset>

  </composition>

</block>
