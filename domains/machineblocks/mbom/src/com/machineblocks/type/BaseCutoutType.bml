<!--
  BlockML Core — enum type branch (closed value sets)

  FQN: org.blockml.core.EnumType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation></documentation>

  <name>BaseCutoutType</name>
  <fullQualifiedName>com.machineblocks.type.BaseCutoutType</fullQualifiedName>
  <baseType>org.blockml.core.EnumType</baseType>
  <version>1.0.0</version>

  <properties>
    <property name="value" type="String">
      <documentation>The value of the enum.</documentation>
    </property>
  </properties>

  <composition export="true">
      <BaseCutoutType id="NONE" value="none" />
      <BaseCutoutType id="STANDARD" value="standard" />
      <BaseCutoutType id="GROOVE" value="groove" />
      <BaseCutoutType id="STUDS" value="studs" />
  </composition>
</block>
