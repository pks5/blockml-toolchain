<!--
  MachineBlocks — BaseCutoutType enum

  FQN: com.machineblocks.type.BaseCutoutType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Enum TypeBlock for base cutout variants on MachineBlocks bricks.</documentation>

  <name>BaseCutoutType</name>
  <type>com.machineblocks.type.BaseCutoutType</type>
  <baseType>org.blockml.core.EnumType</baseType>
  <version>1.0.0</version>

  <properties>
    <property name="value" type="String">
      <documentation>Enum literal used in property defaultValue and expressions.</documentation>
    </property>
  </properties>

  <composition aggregation="_values">
    <BaseCutoutType id="NONE"     value="none"     />
    <BaseCutoutType id="STANDARD" value="standard" />
    <BaseCutoutType id="GROOVE"   value="groove"   />
    <BaseCutoutType id="STUDS"    value="studs"    />
  </composition>

</block>
