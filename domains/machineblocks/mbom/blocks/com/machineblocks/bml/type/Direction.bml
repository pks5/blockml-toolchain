<!--
  MachineBlocks — Direction enum

  FQN: com.machineblocks.bml.type.Direction
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation">
  <name>Direction</name>
  <type>mbtype:Direction</type>
  <baseType>mbtype:MBEnum(Text)</baseType>
  <is>A cardinal direction</is>

  <documentation>Enum ValueType for west / north / east / south on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <Direction bml:id="West" scad:value="west" />
        <Direction bml:id="North" scad:value="north" />
        <Direction bml:id="East" scad:value="east" />
        <Direction bml:id="South" scad:value="south" />
      </composition>
    </values>
  </aggregations>

</block>
