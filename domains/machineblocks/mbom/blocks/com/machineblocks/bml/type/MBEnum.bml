<!--
  MachineBlocks — abstract enum base with SCAD catalog property

  FQN: com.machineblocks.bml.type.MBEnum
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:scad="com.machineblocks.bml.scad">
  <name>MBEnum</name>
  <type>mbtype:MBEnum</type>
  <baseType>btype:EnumType</baseType>
  <is>A MachineBlocks enum with a SCAD serialization literal</is>

  <documentation>Abstract base for MachineBlocks EnumTypes. Extends org.blockml.bml.type.EnumType
    and declares catalog property scad:value : T — the SCAD serialization literal for each enum
    member (member namespace com.machineblocks.bml.scad). Concrete enums bind T (typically Text)
    and set scad:value on values composition members. BOM property values still store only member
    id + EnumType; scad:value is catalog metadata looked up at render time.</documentation>

  <abstract>true</abstract>

  <genericTypes>
    <T baseType="core:ValueType"/>
  </genericTypes>

  <properties>
    <scad:value abstract="true" type="T">
      <documentation>SCAD serialization literal for this enum member. Abstract on MBEnum —
        concrete enums bind T and set scad:value on each values composition entry. Not part of
        the BOM property value (id + typeFqn only).</documentation>
    </scad:value>
  </properties>

  <references>
    <see type="btype:EnumType" relation="Extends">
      Framework EnumType branch — closed member set via values aggregation.
    </see>
    <see type="mbtype:Align" relation="SeeAlso">
      Concrete MBEnum(Text) — alignment literals.
    </see>
    <see type="mbtype:BaseCutout" relation="SeeAlso">
      Concrete MBEnum(Text) — base cutout literals.
    </see>
  </references>

</block>
