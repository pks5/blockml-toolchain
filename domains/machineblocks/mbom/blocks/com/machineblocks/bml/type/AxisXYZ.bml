<!--
  MachineBlocks — AxisXYZ struct type

  FQN: com.machineblocks.bml.type.AxisXYZ
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="com.machineblocks.bml.type">
  <name>AxisXYZ</name>
  <type>type:AxisXYZ</type>
  <baseType>type:AxisXY(N)</baseType>
  <is>A value triple along X, Y, and Z</is>

  <documentation>Struct ValueType for axis-keyed { x, y, z }. Extends AxisXY(N) and adds z.
    Inherits x and y typed as N. Z is a separate generic (defaultType N) so the Z component may
    differ from X/Y — e.g. AxisXYZ(Decimal(mbunit:GridUnitXY), Decimal(mbunit:GridUnitZ)).
    Bare AxisXYZ / AxisXYZ(T) binds Z to the same effective type as N. N and Z are any ValueType
    (default Decimal).</documentation>

  <genericTypes>
    <N baseType="core:ValueType" defaultType="btype:Decimal"/>
    <Z baseType="core:ValueType" defaultType="N"/>
  </genericTypes>

  <properties>
    <z type="Z">
      <documentation>Value along the Z axis — type Z (defaults to N).</documentation>
    </z>
  </properties>

  <references>
    <see type="type:AxisXY" relation="Extends">
      Two-axis parent — x, y inherited; z declared here.
    </see>
    <see type="type:MultiAxis" relation="SeeAlso">
      Abstract axis-map base — N.
    </see>
    <see type="type:SizeXYZ" relation="SeeAlso">
      Size semantics on AxisXYZ — N = GridUnitXY, Z = GridUnitZ by default.
    </see>
    <see type="type:OffsetXYZ" relation="SeeAlso">
      Offset semantics on AxisXYZ — same grid-unit defaults as SizeXYZ.
    </see>
    <see type="type:RotationXYZ" relation="SeeAlso">
      Rotation semantics — AxisXYZ with N (and Z via default) closed to Decimal(unit:Degree).
    </see>
  </references>

</block>
