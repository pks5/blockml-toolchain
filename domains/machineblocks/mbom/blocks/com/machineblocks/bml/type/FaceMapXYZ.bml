<!--
  MachineBlocks — FaceMapXYZ struct type

  FQN: com.machineblocks.bml.type.FaceMapXYZ
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="com.machineblocks.bml.type">
  <name>FaceMapXYZ</name>
  <type>type:FaceMapXYZ</type>
  <baseType>type:FaceMapXY(T)</baseType>
  <is>A face-keyed value map on X, Y, and Z</is>

  <documentation>Struct ValueType for a sparse face map on all six faces
    { xNeg, xPos, yNeg, yPos, zNeg, zPos }. Extends FaceMapXY(T) and adds zNeg / zPos
    typed as Z. Z defaults to T (declaration-order sibling default) so FaceMapXYZ(T) keeps one
    binding; supply both when Z faces differ — e.g.
    FaceMapXYZ(Decimal(mbunit:GridUnitXY), Decimal(mbunit:GridUnitZ)).
    Preferred type for NativeBlock face maps with Z (baseAdjustment, sizeMod, …). Lateral-only
    maps use FaceMapXY. Named FaceMapXYZ (not FaceMap3D).</documentation>

  <genericTypes>
    <T baseType="core:ValueType"/>
    <Z baseType="core:ValueType" defaultType="T"/>
  </genericTypes>

  <properties>
    <zNeg type="Z">
      <documentation>Value on the Z- face (negative Z) — type Z (defaults to T).</documentation>
    </zNeg>
    <zPos type="Z">
      <documentation>Value on the Z+ face (positive Z) — type Z (defaults to T).</documentation>
    </zPos>
  </properties>

  <references>
    <see type="type:FaceMapXY" relation="Extends">
      Four-face parent — xNeg, xPos, yNeg, yPos inherited; zNeg / zPos declared here.
    </see>
    <see type="type:Face" relation="SeeAlso">
      Face enum — six axis-directed faces (XNeg … ZPos).
    </see>
    <see type="type:AxisXYZ" relation="SeeAlso">
      Parallel pattern — AxisXYZ(N, Z) with Z defaulting to N.
    </see>
  </references>

</block>
