<!--
  MachineBlocks — AxisXY struct type

  FQN: com.machineblocks.bml.type.AxisXY
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:btype="org.blockml.bml.type"
  xmlns:type="com.machineblocks.bml.type">
  <name>AxisXY</name>
  <type>type:AxisXY</type>
  <baseType>type:MultiAxis(N)</baseType>
  <is>A value pair along X and Y</is>

  <documentation>Struct ValueType for axis-keyed { x, y }. Extends MultiAxis(N).
    N is any ValueType (default Decimal) — numbers, structs, enums, etc. Bare AxisXY is Decimal
    (dimensionless). Supply a unit via N — e.g. AxisXY(Decimal(unit:Millimeter)) or
    AxisXY(Integer(unit:MBU)).</documentation>

  <genericTypes>
    <N baseType="core:ValueType" defaultType="btype:Decimal"/>
  </genericTypes>

  <properties>
    <x type="N">
      <documentation>Value along the X axis.</documentation>
    </x>
    <y type="N">
      <documentation>Value along the Y axis.</documentation>
    </y>
  </properties>

  <references>
    <see type="type:MultiAxis" relation="Extends">
      Abstract axis-map base — N.
    </see>
    <see type="type:AxisXYZ" relation="SeeAlso">
      Adds Z — extends this type.
    </see>
    <see type="type:SizeXY" relation="SeeAlso">
      Size semantics on AxisXY.
    </see>
    <see type="type:OffsetXY" relation="SeeAlso">
      Offset semantics on AxisXY.
    </see>
    <see type="type:RotationXY" relation="SeeAlso">
      Rotation semantics — AxisXY with N closed to Decimal(unit:Degree).
    </see>
  </references>

</block>
