<!--
  MachineBlocks — SizeXYZ struct type

  FQN: com.machineblocks.bml.type.SizeXYZ
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:type="com.machineblocks.bml.type">
  <name>SizeXYZ</name>
  <type>type:SizeXYZ</type>
  <baseType>btype:StructType</baseType>
  <is>A size along X, Y, and Z</is>

  <documentation>Struct ValueType for size [x, y, z] in grid units. Named SizeXYZ (not Size3D) —
    MachineBlocks axis-keyed types use XYZ / XY, not 3D / 2D.</documentation>
  <properties>
    <x type="Float">
      <documentation>Size in X direction.</documentation>
    </x>
    <y type="Float">
      <documentation>Size in Y direction.</documentation>
    </y>
    <z type="Float">
      <documentation>Size in Z direction.</documentation>
    </z>
  </properties>

</block>
