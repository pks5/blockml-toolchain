<!--
  MachineBlocks — SizeXYZ struct type

  FQN: com.machineblocks.bml.type.SizeXYZ
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">
  <name>SizeXYZ</name>
  <type>mbtype:SizeXYZ</type>
  <baseType>mbtype:AxisXYZ(N, Z)</baseType>
  <is>A size along X, Y, and Z</is>

  <documentation>Semantic Struct ValueType for a size triple { x, y, z }. Extends AxisXYZ(N, Z) —
    inherits x, y (N) and z (Z); adds size semantics (extent / brick footprint). N and Z are
    constrained to Number. Bare SizeXYZ defaults N to Decimal(mbunit:GridUnitXY) and Z to
    Decimal(mbunit:GridUnitZ) — distinct plate-grid scales. Uniform override requires both
    arguments — e.g. SizeXYZ(Decimal(unit:Millimeter), Decimal(unit:Millimeter)). Named SizeXYZ
    (not Size3D) — MachineBlocks axis-keyed types use XY / XYZ, not 2D / 3D.</documentation>

  <genericTypes>
    <N baseType="type:Number" defaultType="type:Decimal(mbunit:GridUnitXY)"/>
    <Z baseType="type:Number" defaultType="type:Decimal(mbunit:GridUnitZ)"/>
  </genericTypes>

  <references>
    <see type="mbtype:AxisXYZ" relation="Extends">
      Structural { x, y, z } map — SizeXYZ adds size semantics; forwards N and Z.
    </see>
    <see type="mbtype:SizeXY" relation="SeeAlso">
      Two-axis size map on AxisXY.
    </see>
    <see type="mbtype:OffsetXYZ" relation="SeeAlso">
      Parallel offset semantics on AxisXYZ.
    </see>
  </references>

</block>
