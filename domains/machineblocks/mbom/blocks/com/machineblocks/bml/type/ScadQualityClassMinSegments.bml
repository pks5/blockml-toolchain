<!--
  MachineBlocks — ScadQualityClassMinSegments struct type

  FQN: com.machineblocks.bml.type.ScadQualityClassMinSegments
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:mbtype="com.machineblocks.bml.type">

  <name>ScadQualityClassMinSegments</name>
  <type>mbtype:ScadQualityClassMinSegments</type>
  <baseType>type:StructType</baseType>
  <is>Per quality-class minimum segment counts</is>

  <documentation>Struct ValueType for OpenSCAD quality-class minimum full-circle segment counts
    { functional, visual, hidden }. Prevents small radii from becoming overly coarse. Used by
    NativeBlock.scadQualityClassMinSegments.</documentation>

  <properties>
    <functional type="type:Integer">
      <documentation>Minimum full-circle segment count for the functional quality class.</documentation>
    </functional>
    <visual type="type:Integer">
      <documentation>Minimum full-circle segment count for the visual quality class.</documentation>
    </visual>
    <hidden type="type:Integer">
      <documentation>Minimum full-circle segment count for the hidden quality class.</documentation>
    </hidden>
  </properties>

  <references>
    <see type="type:StructType" relation="Extends">
      Struct ValueType branch — functional, visual, hidden.
    </see>
    <see type="mbtype:ScadQualityClassFactors" relation="SeeAlso">
      Parallel per-class segment length multipliers.
    </see>
    <see type="mbtype:ScadQualityProfile" relation="SeeAlso">
      Per-preset segment length and max segment count.
    </see>
  </references>

</block>
