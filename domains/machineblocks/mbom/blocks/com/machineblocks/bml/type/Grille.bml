<!--
  MachineBlocks — Grille enum

  FQN: com.machineblocks.bml.type.Grille
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:mbtype="com.machineblocks.bml.type">
  <name>Grille</name>
  <type>mbtype:Grille</type>
  <baseType>mbtype:MBEnum(Text)</baseType>
  <is>A top-plate grille bar direction</is>

  <documentation>Enum ValueType for grille bar orientation on MachineBlocks bricks.
    Extends MBEnum(Text). Members X / Y set bar direction; None disables the grille.
    BOM property values store only the member id plus this EnumType; scadValue holds the
    SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <Grille bml:id="X" scadValue="x" />
        <Grille bml:id="Y" scadValue="y" />
        <Grille bml:id="None" scadValue="none" />
      </composition>
    </values>
  </aggregations>

</block>
