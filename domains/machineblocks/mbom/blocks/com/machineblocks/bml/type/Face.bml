<!--
  MachineBlocks — Face enum

  FQN: com.machineblocks.bml.type.Face
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation">
  <name>Face</name>
  <type>mbtype:Face</type>
  <baseType>mbtype:MBEnum(Text)</baseType>
  <is>A directed face on a brick</is>

  <documentation>Enum ValueType for the six axis-directed faces on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal (x- / x+ / …).</documentation>

  <aggregations>
    <values>
      <composition>
        <Face bml:id="XMinus" scad:value="x-" />
        <Face bml:id="XPlus" scad:value="x+" />
        <Face bml:id="YMinus" scad:value="y-" />
        <Face bml:id="YPlus" scad:value="y+" />
        <Face bml:id="ZMinus" scad:value="z-" />
        <Face bml:id="ZPlus" scad:value="z+" />
      </composition>
    </values>
  </aggregations>

</block>
