<!--
  MachineBlocks — Face enum

  FQN: com.machineblocks.bml.type.Face
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:type="com.machineblocks.bml.type">
  <name>Face</name>
  <type>type:Face</type>
  <baseType>type:MBEnum(Text)</baseType>
  <is>A directed face on a brick</is>

  <documentation>Enum ValueType for the six axis-directed faces on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scadValue holds the SCAD serialization literal (x- / x+ / …).</documentation>

  <aggregations>
    <values>
      <composition>
        <Face bml:id="XMinus" scadValue="x-" />
        <Face bml:id="XPlus" scadValue="x+" />
        <Face bml:id="YMinus" scadValue="y-" />
        <Face bml:id="YPlus" scadValue="y+" />
        <Face bml:id="ZMinus" scadValue="z-" />
        <Face bml:id="ZPlus" scadValue="z+" />
      </composition>
    </values>
  </aggregations>

</block>
