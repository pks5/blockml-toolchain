<!--
  MachineBlocks — BaseCutout enum

  FQN: com.machineblocks.bml.type.BaseCutout
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:type="com.machineblocks.bml.type">
  <name>BaseCutout</name>
  <type>type:BaseCutout</type>
  <baseType>btype:EnumType</baseType>
  <is>An underside brick cutout shape</is>

  <documentation>Enum ValueType for base cutout variants on MachineBlocks bricks.</documentation>
  <properties>
    <value type="Text">
      <documentation>Enum literal used in property values and expressions.</documentation>
    </value>
  </properties>

  <aggregations>
    <values>
      <composition>
        <BaseCutout bml:id="None" value="none" />
        <BaseCutout bml:id="Standard" value="standard" />
        <BaseCutout bml:id="Groove" value="groove" />
        <BaseCutout bml:id="Studs" value="studs" />
      </composition>
    </values>
  </aggregations>

</block>
