<!--
  MachineBlocks — BaseCutout enum

  FQN: com.machineblocks.bml.type.BaseCutout
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:type="com.machineblocks.bml.type">
  <name>BaseCutout</name>
  <type>type:BaseCutout</type>
  <baseType>type:MBEnum(Text)</baseType>
  <is>An underside brick cutout shape</is>

  <documentation>Enum ValueType for base cutout variants on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scadValue holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <BaseCutout bml:id="None" scadValue="none" />
        <BaseCutout bml:id="Standard" scadValue="standard" />
        <BaseCutout bml:id="Groove" scadValue="groove" />
        <BaseCutout bml:id="Studs" scadValue="studs" />
      </composition>
    </values>
  </aggregations>

</block>
