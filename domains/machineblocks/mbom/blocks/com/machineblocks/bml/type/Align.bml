<!--
  MachineBlocks — Align enum

  FQN: com.machineblocks.bml.type.Align
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbtype="com.machineblocks.bml.type">
  <name>Align</name>
  <type>mbtype:Align</type>
  <baseType>mbtype:MBEnum(Text)</baseType>
  <is>An alignment along an axis</is>

  <documentation>Enum ValueType for start / center / end alignment on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id (Start / Center / End)
    plus this EnumType; scad:value holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <Align bml:id="Start" scad:value="start" />
        <Align bml:id="Center" scad:value="center" />
        <Align bml:id="End" scad:value="end" />
      </composition>
    </values>
  </aggregations>

</block>
