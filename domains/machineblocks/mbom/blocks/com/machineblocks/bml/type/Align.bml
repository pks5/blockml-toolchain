<!--
  MachineBlocks — Align enum

  FQN: com.machineblocks.bml.type.Align
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:type="com.machineblocks.bml.type">
  <name>Align</name>
  <type>type:Align</type>
  <baseType>btype:EnumType</baseType>
  <is>An alignment along an axis</is>

  <documentation>Enum ValueType for start / center / end alignment on MachineBlocks bricks.
    Declares an optional value catalog property for SCAD serialization literals — BOM property
    values store only the member id (Start / Center / End) plus this EnumType.</documentation>
  <properties>
    <value type="Text">
      <documentation>Optional SCAD serialization literal for this member (MachineBlocks convention).</documentation>
    </value>
  </properties>

  <aggregations>
    <values>
      <composition>
        <Align bml:id="Start" value="start" />
        <Align bml:id="Center" value="center" />
        <Align bml:id="End" value="end" />
      </composition>
    </values>
  </aggregations>

</block>
