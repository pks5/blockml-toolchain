<!--
  MachineBlocks — Align enum

  FQN: com.machineblocks.bml.type.Align
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:type="com.machineblocks.bml.type">
  <name>Align</name>
  <type>type:Align</type>
  <baseType>type:MBEnum(Text)</baseType>
  <is>An alignment along an axis</is>

  <documentation>Enum ValueType for start / center / end alignment on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id (Start / Center / End)
    plus this EnumType; scadValue holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <Align bml:id="Start" scadValue="start" />
        <Align bml:id="Center" scadValue="center" />
        <Align bml:id="End" scadValue="end" />
      </composition>
    </values>
  </aggregations>

</block>
