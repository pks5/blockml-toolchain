<!--
  MachineBlocks — Axis enum

  FQN: com.machineblocks.bml.type.Axis
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:type="com.machineblocks.bml.type">
  <name>Axis</name>
  <type>type:Axis</type>
  <baseType>type:MBEnum(Text)</baseType>
  <is>A coordinate axis</is>

  <documentation>Enum ValueType for the X / Y / Z axes on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scadValue holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <Axis bml:id="X" scadValue="x" />
        <Axis bml:id="Y" scadValue="y" />
        <Axis bml:id="Z" scadValue="z" />
      </composition>
    </values>
  </aggregations>

</block>
