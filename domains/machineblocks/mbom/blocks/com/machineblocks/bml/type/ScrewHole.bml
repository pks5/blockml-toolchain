<!--
  MachineBlocks — ScrewHole struct type

  FQN: com.machineblocks.bml.type.ScrewHole
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:mbtype="com.machineblocks.bml.type">

  <name>ScrewHole</name>
  <type>mbtype:ScrewHole</type>
  <baseType>type:StructType</baseType>
  <is>A screw hole on a directed face</is>

  <documentation>Struct ValueType for a screw hole placement { face, offset }. face selects the
    directed brick face; offset is the in-plane position on that face (FaceOffset), measured from
    the respective negative (-) sides.</documentation>

  <properties>
    <face type="mbtype:Face">
      <documentation>Directed face where the screw hole is placed (x- / x+ / y- / y+ / z- / z+).</documentation>
    </face>
    <offset type="mbtype:FaceOffset">
      <documentation>In-plane offset of the hole center on the selected face, measured from the
        respective negative (-) sides.</documentation>
    </offset>
  </properties>

  <references>
    <see type="type:StructType" relation="Extends">
      Struct ValueType branch — face, offset.
    </see>
    <see type="mbtype:Face" relation="SeeAlso">
      face selector — six directed brick faces.
    </see>
    <see type="mbtype:FaceOffset" relation="SeeAlso">
      In-plane offset pair { a, b } on the selected face.
    </see>
  </references>

</block>
