<!--
  MachineBlocks — QualityPreset enum

  FQN: com.machineblocks.bml.type.QualityPreset
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation">
  <name>QualityPreset</name>
  <type>mbtype:QualityPreset</type>
  <baseType>mbtype:MBEnum(Text)</baseType>
  <is>A render or mesh quality preset</is>

  <documentation>Enum ValueType for quality presets — preview / normal / print / render.
    Extends MBEnum(Text). BOM property values store only the member id (Preview / Normal /
    Print / Render) plus this EnumType; scad:value holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <QualityPreset bml:id="Preview" scad:value="preview" />
        <QualityPreset bml:id="Normal" scad:value="normal" />
        <QualityPreset bml:id="Print" scad:value="print" />
        <QualityPreset bml:id="Render" scad:value="render" />
      </composition>
    </values>
  </aggregations>

</block>
