<!--
  MachineBlocks — RotationXYZ struct type

  FQN: com.machineblocks.bml.type.RotationXYZ
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit"
  xmlns:mbtype="com.machineblocks.bml.type">

  <name>RotationXYZ</name>
  <type>mbtype:RotationXYZ</type>
  <baseType>mbtype:AxisXYZ(type:Decimal(unit:Degree))</baseType>
  <is>A rotation about X, Y, and Z in degrees</is>

  <documentation>Semantic Struct ValueType for a rotation triple { x, y, z } in degrees. Extends
    AxisXYZ with N closed to Decimal(unit:Degree); Z is omitted at the baseType application and
    defaults to N (same degree type). Not re-opened as a generic. Named RotationXYZ (not
    Rotation3D) — MachineBlocks axis-keyed types use XY / XYZ, not 2D / 3D.</documentation>

  <references>
    <see type="mbtype:AxisXYZ" relation="Extends">
      Structural { x, y, z } map — N closed to Decimal(unit:Degree); Z defaults to N.
    </see>
    <see type="mbtype:RotationXY" relation="SeeAlso">
      Two-axis rotation map on AxisXY.
    </see>
    <see type="unit:Degree" relation="SeeAlso">
      Angular unit bound into N.
    </see>
  </references>

</block>
