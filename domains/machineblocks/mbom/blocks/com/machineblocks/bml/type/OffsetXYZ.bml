<!--
  MachineBlocks — OffsetXYZ struct type

  FQN: com.machineblocks.bml.type.OffsetXYZ
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:type="com.machineblocks.bml.type">
  <name>OffsetXYZ</name>
  <type>type:OffsetXYZ</type>
  <baseType>type:AxisXYZ(N)</baseType>
  <is>An offset along X, Y, and Z</is>

  <documentation>Semantic Struct ValueType for an offset triple { x, y, z }. Extends AxisXYZ(N) —
    inherits x, y, and z; adds offset / translation semantics (may be negative). Bare OffsetXYZ is
    Decimal (dimensionless). Supply a unit via N — e.g. OffsetXYZ(Decimal(mbunit:GridUnit)). Named
    OffsetXYZ (not Offset3D) — MachineBlocks axis-keyed types use XY / XYZ, not 2D / 3D.</documentation>

  <genericTypes>
    <N baseType="btype:Number" defaultType="btype:Decimal"/>
  </genericTypes>

  <references>
    <see type="type:AxisXYZ" relation="Extends">
      Structural { x, y, z } map — OffsetXYZ adds offset semantics.
    </see>
    <see type="type:OffsetXY" relation="SeeAlso">
      Two-axis offset map on AxisXY.
    </see>
    <see type="type:SizeXYZ" relation="SeeAlso">
      Parallel size semantics on AxisXYZ.
    </see>
  </references>

</block>
