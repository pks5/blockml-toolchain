<!--
  MachineBlocks — OffsetXYZ struct type

  FQN: com.machineblocks.bml.type.OffsetXYZ
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <name>OffsetXYZ</name>
  <type>mbtype:OffsetXYZ</type>
  <baseType>mbtype:AxisXYZ(N, Z)</baseType>
  <is>An offset along X, Y, and Z</is>

  <documentation>Semantic Struct ValueType for an offset triple { x, y, z }. Extends AxisXYZ(N, Z) —
    inherits x, y (N) and z (Z); adds offset / translation semantics (may be negative). N and Z are
    constrained to Number. Bare OffsetXYZ defaults N to Decimal(mbunit:GridUnitXY) and Z to
    Decimal(mbunit:GridUnitZ) — distinct plate-grid scales. Uniform override requires both
    arguments — e.g. OffsetXYZ(Decimal(unit:Millimeter), Decimal(unit:Millimeter)). Named
    OffsetXYZ (not Offset3D) — MachineBlocks axis-keyed types use XY / XYZ, not 2D / 3D.</documentation>

  <genericTypes>
    <N baseType="type:Number" defaultType="type:Decimal(mbunit:GridUnitXY)"/>
    <Z baseType="type:Number" defaultType="type:Decimal(mbunit:GridUnitZ)"/>
  </genericTypes>

  <references>
    <see type="mbtype:AxisXYZ" relation="Extends">
      Structural { x, y, z } map — OffsetXYZ adds offset semantics; forwards N and Z.
    </see>
    <see type="mbtype:OffsetXY" relation="SeeAlso">
      Two-axis offset map on AxisXY.
    </see>
    <see type="mbtype:SizeXYZ" relation="SeeAlso">
      Parallel size semantics on AxisXYZ.
    </see>
  </references>

</block>
