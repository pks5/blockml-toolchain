<!--
  MachineBlocks Bricks Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: com.machineblocks.bml.bricks.Library

  MachineBlocks brick library — exports block definitions and optional XSD.
  Block .bml sources live under blocks/ (scad-lib submodule in full deployment).
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bcore="org.blockml.bml.core"
  xmlns:core="com.machineblocks.bml.core"
  xmlns:type="com.machineblocks.bml.type"
  xmlns:bricks="com.machineblocks.bml.bricks">
  <name>Library</name>
  <type>bricks:Library</type>
  <baseType>bcore:BlockLibrary</baseType>
  <is>A MachineBlocks brick catalog</is>

  <documentation>MachineBlocks standard brick library — Standard, Plate, Tile blocks and their
    preset blocks.</documentation>
  <version>3.0.0</version>

  <properties>
    <description>
      <value>Standard brick types for MachineBlocks</value>
    </description>
  </properties>

  <aggregations>
    <_dependencies>
      <blockml:Library />
    </_dependencies>
    <!-- Optional legacy XSD — omit when all types are exported via _blocks -->
    <_schemas>
      <composition>
        <bcore:BlockLibrary.Schema ref="bricks.xsd" />
      </composition>
    </_schemas>

    <_blocks>
      <type:Size3d />
      <type:Direction />
      <type:Color />
      <bricks:Standard />
      <bricks:Plate />
      <bricks:Tile />
      <bricks:StandardPresets />
    </_blocks>
  </aggregations>

</block>
