<!--
  MachineBlocks Root Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: com.machineblocks.bml.Library

  MachineBlocks root library — exports domain types and units; nests brick sub-libraries.
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:mb="com.machineblocks.bml"
  xmlns:mbann="com.machineblocks.bml.annotation"
  xmlns:bricks="com.machineblocks.bml.bricks"
  xmlns:mbtype="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <name>Library</name>
  <type>mb:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>A MachineBlocks root library catalog</is>

  <documentation>
    Publishable MachineBlocks root library (com.machineblocks.bml.Library). Exports shared domain
    ValueTypes, Units, and ScadAnnotation. Brick catalogs are nested via subLibraries — consumers
    that need bricks depend on com.machineblocks.bml.bricks.Library directly. Membership is defined
    exclusively by this file's blocks list — not by directory layout.
  </documentation>

  <references>
    <see type="mb:README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>

  <version>3.0.0</version>

  <language>
    <English />
  </language>
  <properties>
    <description>
      <value>MachineBlocks root library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <mb:README />
    </readMe>

    <dependencies>
      <blockml:Library />
    </dependencies>

    <subLibraries>
      <bricks:Library />
    </subLibraries>

    <blocks>
      <mbann:ScadAnnotation />
      <mbtype:Align />
      <mbtype:Auto />
      <mbtype:Axis />
      <mbtype:AxisAB />
      <mbtype:AxisXY />
      <mbtype:AxisXYZ />
      <mbtype:BaseCutout />
      <mbtype:BaseRoundingMap />
      <mbtype:Connector />
      <mbtype:CornerMap />
      <mbtype:Direction />
      <mbtype:Face />
      <mbtype:FaceAxisXY />
      <mbtype:FaceMapXY />
      <mbtype:FaceMapXYZ />
      <mbtype:Gender />
      <mbtype:Grille />
      <mbtype:HoleEdgeMap />
      <mbtype:HoleEdgeMode />
      <mbtype:HoleEdgePair />
      <mbtype:HoleType />
      <mbtype:Inherit />
      <mbtype:MBEnum />
      <mbtype:MultiAxis />
      <mbtype:None />
      <mbtype:OffsetAB />
      <mbtype:OffsetXY />
      <mbtype:OffsetXYZ />
      <mbtype:PcbMountingType />
      <mbtype:PcbSocket />
      <mbtype:PillarGapAutoConfig />
      <mbtype:PlaneRoundingMap />
      <mbtype:Port />
      <mbtype:PortShapeType />
      <mbtype:QualityPreset />
      <mbtype:RadiusAB />
      <mbtype:RecessWallGap />
      <mbtype:RotationXY />
      <mbtype:RotationXYZ />
      <mbtype:ScadQualityClassFactors />
      <mbtype:ScadQualityClassMinSegments />
      <mbtype:ScadQualityProfile />
      <mbtype:ScrewHole />
      <mbtype:SelectiveGrid />
      <mbtype:SizeAB />
      <mbtype:SizeXY />
      <mbtype:SizeXYZ />
      <mbtype:StudType />
      <mbtype:WallGap />
      <mbunit:GridUnitXY />
      <mbunit:GridUnitZ />
      <mbunit:MBU />
    </blocks>
  </aggregations>

</block>
