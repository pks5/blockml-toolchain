<!--
  MachineBlocks MBOM — domain base Block

  FQN: com.machineblocks.bml.core.Block
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:bcore="org.blockml.bml.core"
  xmlns:core="com.machineblocks.bml.core"
  xmlns:type="com.machineblocks.bml.type">
  <name>Block</name>
  <type>core:Block</type>
  <baseType>bcore:Entity</baseType>
  <is>A MachineBlocks domain Block</is>

  <documentation>MachineBlocks domain base Block. Carries presets aggregation and basePresets
    association for domain-specific preset resolution. Preset merge is compiler logic; Customizer
    output is render-target logic.</documentation>

  <references>
    <see type="bcore:Entity">
      Domain branch base — Entity instances with composition identity.
    </see>
    <see type="core:CompositeBlock">
      Composable sub-type with default _parts aggregation for child block instances.
    </see>
    <see type="core:NativeBlock">
      Final leaf sub-type rendered directly as mb_block() SCAD primitive.
    </see>
    <see type="core:Set">
      LEGO-style build sub-type with palette, placed parts, and assembly steps.
    </see>
  </references>

  <abstract>true</abstract>

  <properties>
    <name type="Text">
      <documentation>The human readable name of the Block.</documentation>
    </name>
  </properties>

  <associations>
    <basePresets type="InstanceReference(bml:Self)[]"></basePresets>
  </associations>

  <aggregations>
    <presets type="core:Block[]" />
  </aggregations>

</block>