<!--
  MachineBlocks MBOM — composable Block with _parts aggregation

  FQN: com.machineblocks.bml.core.CompositeBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.bml.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.bml.core"
  xmlns:core="com.machineblocks.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <idea>MachineBlocks object composed of child block instances.</idea>

  <documentation>Composable MachineBlocks Block with default _parts aggregation. _parts holds
    placed block instances (direction, offset, appliedPresets) or child blocks for SCAD
    composition.</documentation>

  <references>
    <see block="core:Block">
      Domain base type — inherits presets and basePresets for preset resolution.
    </see>
    <see block="core:Set">
      Set specialization uses _parts for placed instances in a LEGO-style build.
    </see>
  </references>

  <name>CompositeBlock</name>
  <type>core:CompositeBlock</type>
  <baseType>core:Block</baseType>
  <abstract />

  <subTypes>
    <core:Block />
  </subTypes>

  <languages>
    <lang:OpenSCAD />
  </languages>

  <aggregations>
    <_parts
      type="core:Block[]"
      default="true" />
  </aggregations>

</block>