<!--
  MachineBlocks MBOM — Set assembly step

  FQN: com.machineblocks.bml.core.Step
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.bml.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.bml.core"
  xmlns:core="com.machineblocks.bml.core"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation">
  <name>Step</name>
  <type>core:Step</type>
  <baseType>bcore:Block</baseType>
  <is>A single assembly instruction</is>

  <documentation>Framework Block defining one assembly instruction step. Document order in _steps
    defines build order.</documentation>

  <references>
    <see type="core:Set">
      Used as children of Set's _steps aggregation.
    </see>
    <see type="core:Block">
      part association references a placed instance by bml:id in _parts.
    </see>
  </references>

  <final>true</final>

  <associations>
    <part type="InstanceReference(core:Block)"></part>
  </associations>

  <properties>
    <description type="Text">
      <documentation>Additional description of the step.</documentation>
    </description>
  </properties>

</block>