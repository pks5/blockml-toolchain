<!--
  MachineBlocks MBOM — composable Block with _parts aggregation

  FQN: com.machineblocks.core.CompositeBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.core"
  xmlns:core="com.machineblocks.core"
  xmlns:lang="org.blockml.language">

  <idea>MachineBlocks object composed of child block instances.</idea>

  <documentation>Composable MachineBlocks Block with default _parts aggregation. On Sets, _parts
    holds placed block instances (direction, offset, appliedPresets). On other composites, _parts
    holds child blocks for SCAD composition.</documentation>

  <name>CompositeBlock</name>
  <type>core:CompositeBlock</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <subTypes>
    <subType type="core:Block" />
    <subType type="bcore:FunctionBlock" />
  </subTypes>

  <implTypes>
    <implType type="lang:OpenSCAD" />
  </implTypes>

  <aggregations>
    <_parts
      type="core:Block[]"
      default="true" />
  </aggregations>

</block>