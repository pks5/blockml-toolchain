<!--
  MachineBlocks MBOM — Set assembly step

  FQN: com.machineblocks.core.Step
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.core"
  xmlns:core="com.machineblocks.core">

  <idea>One assembly instruction in a Set build sequence.</idea>

  <documentation>Framework Block defining one assembly instruction step. Document order in _steps
    defines build order.</documentation>

  <references>
    <see block="core:Set">
      Used as children of Set's _steps aggregation.
    </see>
    <see block="core:Block">
      part association references a placed instance by bml:id in _parts.
    </see>
  </references>

  <name>Step</name>
  <type>core:Step</type>
  <baseType>bcore:Block</baseType>
  <final />

  <associations>
    <part type="core:Block"></part>
  </associations>

  <properties>
    <description type="Text">
      <documentation>Additional description of the step.</documentation>
    </description>
  </properties>

</block>