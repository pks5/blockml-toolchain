<!--
  MachineBlocks MBOM — Set assembly step

  FQN: com.machineblocks.core.Step
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.core"
  xmlns:core="com.machineblocks.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">One assembly instruction in a Set build sequence.</idea>

  <documentation bml:status="status:Stable">Framework Block defining one assembly instruction step in a Set — references a
    placed block instance via the part association. Used as children of aggregation _steps. Document
    order defines build order when _steps is present.</documentation>

  <status>status:Stable</status>
  <name>Step</name>
  <type>core:Step</type>
  <baseType>bcore:Block</baseType>
  <version>1.0.0</version>

  <final />

  <associations>
    <part type="core:Block"></part>
  </associations>

  <properties>
    <description type="String">
      <documentation bml:status="status:Stable">Additional description of the step.</documentation>
    </description>
  </properties>

</block>