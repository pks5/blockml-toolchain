<!--
  MachineBlocks MBOM — NativeBlock (mb_block primitive)

  FQN: com.machineblocks.core.NativeBlock
  Final — cannot be used as baseType on Block definitions
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      ">

  <idea>Leaf geometry primitive rendered directly as mb_block() in SCAD.</idea>

  <documentation>Final leaf Block mapped directly to SCAD mb_block() — the native geometry primitive
    at render time. Extends Block directly (not CompositeBlock). Uses children aggregation for
    mb_block() sub-geometry instead of _parts.</documentation>

  <name>NativeBlock</name>
  <type>com.machineblocks.core.NativeBlock</type>
  <baseType>com.machineblocks.core.Block</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <!-- Native MB properties only — no custom properties on NativeBlock instances -->
  <properties>
    <base type="org.blockml.type.Boolean">
      <value>true</value>
    </base>
    
    <baseCutoutType type="com.machineblocks.type.BaseCutoutType">
      <value>STANDARD</value>
    </baseCutoutType>
    
    <scale type="org.blockml.type.Float">
      <value>1.0</value>
    </scale>
    
    <stabilizerExpansion type="org.blockml.type.Integer">
      <value>2</value>
    </stabilizerExpansion>
    
    <text type="org.blockml.type.String">
      <value></value>
    </text>
    
    <!-- Value specified as ordered array [x, y, z] (order of properties definition), alternative: {
    x: 1, y: 1, z: 1 } -->
    <size type="com.machineblocks.type.Size3D">
      <value>[1, 1, 1]</value>
    </size>
  </properties>

  <aggregations>
    <children
      type="com.machineblocks.core.Block[]"
      default="true" />
  </aggregations>

</block>