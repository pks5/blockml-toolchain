<!--
  MachineBlocks MBOM — NativeBlock (mb_block primitive)

  FQN: com.machineblocks.core.NativeBlock
  Final — cannot be used as baseType on Block definitions
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.type"
  xmlns:core="com.machineblocks.core">

  <idea>Leaf geometry primitive rendered directly as mb_block() in SCAD.</idea>

  <documentation>Final leaf Block mapped directly to SCAD mb_block() — the native geometry primitive
    at render time. Uses children aggregation for mb_block() sub-geometry instead of _parts.
  </documentation>

  <references>
    <reference block="com.machineblocks.core.Block">
      Extends Block directly — not CompositeBlock.
    </reference>
    <reference block="com.machineblocks.core.CompositeBlock">
      Contrasts with CompositeBlock which uses _parts for composition children.
    </reference>
  </references>

  <name>NativeBlock</name>
  <type>core:NativeBlock</type>
  <baseType>core:Block</baseType>
  <final />

  <!-- Native MB properties only — no custom properties on NativeBlock instances -->
  <properties>
    <base type="Boolean">
      <value>true</value>
    </base>

    <baseCutoutType type="type:BaseCutoutType">
      <value>STANDARD</value>
    </baseCutoutType>

    <scale type="Float">
      <value>1.0</value>
    </scale>

    <stabilizerExpansion type="Integer">
      <value>2</value>
    </stabilizerExpansion>

    <text type="Text">
      <value></value>
    </text>

    <!-- Value specified as ordered array [x, y, z] (order of properties definition), alternative: {
    x: 1, y: 1, z: 1 } -->
    <size type="type:Size3D">
      <value>[1, 1, 1]</value>
    </size>
  </properties>

  <aggregations>
    <children
      type="core:Block[]"
      default="true" />
  </aggregations>

</block>