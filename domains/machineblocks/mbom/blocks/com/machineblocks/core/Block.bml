<!--
  MachineBlocks MBOM — domain base Block

  FQN: com.machineblocks.core.Block
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.core"
  xmlns:core="com.machineblocks.core">

  <idea>Any MachineBlocks domain object — bricks, sets, presets, and compositions.</idea>

  <documentation>MachineBlocks domain base Block. Carries _presets aggregation and basePresets
    association for domain-specific preset resolution. Preset merge is compiler logic; Customizer
    output is render-target logic.</documentation>

  <name>Block</name>
  <type>core:Block</type>
  <baseType>bcore:Entity</baseType>
  <version>1.0.0</version>

  <abstract />

  <properties>
    <name type="String">
      <documentation>The human readable name of the Block.</documentation>
    </name>
  </properties>

  <associations>
    <basePresets type="_self[]"></basePresets>
  </associations>

  <aggregations>
    <_presets type="core:Block[]" />
  </aggregations>

</block>