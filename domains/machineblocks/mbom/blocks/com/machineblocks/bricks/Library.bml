<!--
  BlockML Library Descriptor

  Name: BricksLibrary
  Filename: BricksLibrary.bml
  FQN: com.machineblocks.bricks.BricksLibrary

  MachineBlocks brick library — exports block definitions and optional XSD.
  Block .bml sources live under blocks/ (scad-lib submodule in full deployment).
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:bcore="org.blockml.core"
  xmlns:core="com.machineblocks.core"
  xmlns:type="com.machineblocks.type"
  xmlns:bricks="com.machineblocks.bricks">

  <idea>Published catalog of MachineBlocks standard brick definitions.</idea>

  <documentation>MachineBlocks standard brick library — Standard, Plate, Tile blocks and their
    preset blocks.</documentation>
  <name>Library</name>
  <type>bricks:Library</type>
  <baseType>bcore:BlockLibrary</baseType>
  <version>3.0.0</version>

  <properties>
    <description>
      <value>Standard brick types for MachineBlocks</value>
    </description>
    <package type="String">
      <value>com.machineblocks.bricks</value>
    </package>
  </properties>

  <aggregations>
    <_dependencies>
      <composition>
        <core:CoreLibrary bml:version="3.0.0" />
      </composition>
    </_dependencies>

    <!-- Optional legacy XSD — omit when all types are exported via _blocks -->
    <_schemas>
      <composition>
        <Schema ref="bricks.xsd" />
      </composition>
    </_schemas>

    <_blocks>
      <composition>
        <type:Size3d bml:version="1.0.0" />
        <type:Direction bml:version="1.0.0" />
        <type:Color bml:version="1.0.0" />
        <bricks:Standard bml:version="1.0.0" />
        <bricks:Plate bml:version="1.0.0" />
        <bricks:Tile bml:version="1.0.0" />
        <bricks:StandardPresets bml:version="3.0.0" />
      </composition>
    </_blocks>
  </aggregations>

</block>
