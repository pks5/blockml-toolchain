<!--
  MachineBlocks — BaseCutoutType enum

  FQN: com.machineblocks.type.BaseCutoutType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bml="http://blockml.org/schema/bml"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      ">

  <idea>Shape variant of the underside cutout on a brick base.</idea>

  <documentation>Enum TypeBlock for base cutout variants on MachineBlocks bricks.</documentation>

  <name>BaseCutoutType</name>
  <type>com.machineblocks.type.BaseCutoutType</type>
  <baseType>org.blockml.core.EnumType</baseType>
  <version>1.0.0</version>

  <properties>
    <value type="String">
      <documentation>Enum literal used in property values and expressions.</documentation>
    </value>
  </properties>

  <aggregations>
    <_values>
      <composition bml:exportIds="true">
        <BaseCutoutType bml:id="NONE" value="none" />
        <BaseCutoutType bml:id="STANDARD" value="standard" />
        <BaseCutoutType bml:id="GROOVE" value="groove" />
        <BaseCutoutType bml:id="STUDS" value="studs" />
      </composition>
    </_values>
  </aggregations>

</block>