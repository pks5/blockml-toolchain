<!--
  MachineBlocks — Size3d struct type

  FQN: com.machineblocks.type.Size3d
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      ">

  <idea>Three-dimensional size in MachineBlocks grid units.</idea>

  <documentation>Struct TypeBlock for three-dimensional size [x, y, z] in grid units.</documentation>

  <name>Size3d</name>
  <type>com.machineblocks.type.Size3d</type>
  <baseType>org.blockml.core.StructType</baseType>
  <version>1.0.0</version>

  <properties>
    <x type="org.blockml.type.Float">
      <documentation>Size in X direction.</documentation>
    </x>
    <y type="org.blockml.type.Float">
      <documentation>Size in Y direction.</documentation>
    </y>
    <z type="org.blockml.type.Float">
      <documentation>Size in Z direction.</documentation>
    </z>
  </properties>

</block>