            <workflow:InstructionTask>
              <instructions>Translate the poem in 
org.blockml.bml.workspace.playground.NextPoem222.bml 
to spanish.</instructions>
            </workflow:InstructionTask>
          </task>
        </workflow:ModelOperation>
      </composition>
