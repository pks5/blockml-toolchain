  <aggregations>
    <operations override="true">
      <composition>
        <workflow:AgenticOperation name="Create Poem" status="Pending" captureOutput="true">
          <task>
            <workflow:InstructionTask>
              <instructions>Create or update the block 
${ #this.parameters.targetBlock } 
that contains a random story in ${ #this.parameters.storyLanguage } 
about ${ #this.parameters.topic }. 
For each execution create a new poem.
The story should be structured with the following properties:
- title (type:Text)
- author (type:Text)
- story (type:Text)
- language (type:Text)
- date (type:DateTime)
- time (type:DateTime)
- location (type:Text)
- weather (type:Text)</instructions>
            </workflow:InstructionTask>
          </task>
        </workflow:AgenticOperation>
        <workflow:ToolOperation name="Validate" status="Pending" captureOutput="true" command="blockml">
          <args>[&quot;validate&quot;]</args>
        </workflow:ToolOperation>
        <workflow:AgenticOperation name="Translate Poem" status="Pending">
          <task>
            <workflow:InstructionTask>
              <instructions>Translate the story in 
${ #this.parameters.targetBlock } 
to ${ #this.parameters.translationLanguage }.</instructions>
            </workflow:InstructionTask>
          </task>
        </workflow:AgenticOperation>
      </composition>
    </operations>
