{&quot;type&quot;:&quot;stream_event&quot;,&quot;event&quot;:{&quot;type&quot;:&quot;content_block_start&quot;,&quot;index&quot;:2,&quot;content_block&quot;:{&quot;type&quot;:&quot;tool_use&quot;,&quot;id&quot;:&quot;toolu_01XyAo48codrYb8byUnPJzhN&quot;,&quot;name&quot;:&quot;Bash&quot;,&quot;input&quot;:{},&quot;caller&quot;:{&quot;type&quot;:&quot;direct&quot;}}},&quot;session_id&quot;:&quot;5d8689b9-d089-4adb-9dfa-a82710b1ec49&quot;,&quot;parent_tool_use_id&quot;:null,&quot;uuid&quot;:&quot;cb3dc172-e955-4f77-8943-6998877d5cdf&quot;}
