<!--Workspace pending transform — JokeTest
  FQN: org.blockml.bml.workspace._meta.transform.succeeded.T00001_JokeTest_20260830T014020-->
<block xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type"
  xmlns:pending="org.blockml.bml.workspace._meta.transform.pending"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd                       ">

  <name>
    PoemTestTemplate
  </name>
  <type>
    pending:PoemTestTemplate
  </type>
  <baseType>
    workflow:ModelTransformation(Parameters)
  </baseType>
  <is>
    A pending ModelTransformation that creates a playground Poem block
  </is>
  <subBlocks>
    <block>
      <name>Parameters</name>
      <baseType>type:StructType</baseType>
      <is>Run parameters for this poem transformation</is>
      <properties>
        <topic type="type:Text" />
        <storyLanguage type="type:Text" />
        <translationLanguage type="type:Text" />
        <targetBlock type="type:Text" />
      </properties>
    </block>
  </subBlocks>
  <properties>
    <description override="true">
      <value>A transformation that creates a playground Poem block</value>
    </description>
    <status override="true" type="workflow:ExecutionStatus">
      <value>Pending</value>
    </status>
    <createdAt override="true" type="type:DateTime">
      <value>2026-08-30T01:40:20</value>
    </createdAt>
    <template override="true" type="type:Boolean">
      <value>true</value>
    </template>
  </properties>
  <aggregations>
    <operations override="true">
      <composition>
        <workflow:AgenticOperation name="Create Poem" status="Pending" captureOutput="true">
          <task>
            <workflow:InstructionTask>
              <instructions>
                Create or update the block 
                ${ #this.parameters.targetBlock } 
                that contains a random song in ${ #this.parameters.storyLanguage } 
                about ${ #this.parameters.topic }. 
                For each execution create a new song.
                The song should be structured with the following properties:
                - title (type:Text)
                - artist (type:Text)
                - song (type:Text)
                - language (type:Text)
                - date (type:DateTime)
              </instructions>
            </workflow:InstructionTask>
          </task>
        </workflow:AgenticOperation>
        <workflow:ToolOperation name="Validate" status="Pending" captureOutput="true" command="blockml">
          <args>["validate"]</args>
        </workflow:ToolOperation>
        <workflow:AgenticOperation name="Translate Poem" status="Pending">
          <task>
            <workflow:InstructionTask>
              <instructions>
                Translate the song in 
                ${ #this.parameters.targetBlock } 
                to ${ #this.parameters.translationLanguage }.
              </instructions>
            </workflow:InstructionTask>
          </task>
        </workflow:AgenticOperation>
      </composition>
    </operations>
  </aggregations>
</block>