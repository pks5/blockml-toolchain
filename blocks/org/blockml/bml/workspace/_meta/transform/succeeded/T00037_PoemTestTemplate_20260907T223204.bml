{&quot;type&quot;:&quot;stream_event&quot;,&quot;event&quot;:{&quot;type&quot;:&quot;content_block_stop&quot;,&quot;index&quot;:0},&quot;session_id&quot;:&quot;0b7f7c2b-8a4f-4fd3-9857-9d9fc16ceeaf&quot;,&quot;parent_tool_use_id&quot;:null,&quot;uuid&quot;:&quot;b30e8f5f-bf13-4986-97b8-6f95ab5bbad0&quot;}
