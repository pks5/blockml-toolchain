;/type>\n  &lt;baseType>core:BlockLibrary&lt;/baseType>\n  &lt;is>The BlockML monorepo workspace library catalog&lt;/is>\n\n  &lt;documentation>\n    Documentation and SSOT hub for the BlockML toolchain monorepo. Links package\n    BML libraries (workspace → packages only). Membership is defined exclusively\n    by this blocks list. Package libraries must not depend back on this library.\n  &lt;/documentation>\n\n  &lt;version>0.9.0&lt;/version>\n\n  &lt;language>\n    &lt;English />\n  &lt;/language>\n\n  &lt;properties>\n    &lt;description override=\&quot;true\&quot;>\n      &lt;value>BlockML workspace monorepo library&lt;/value>\n    &lt;/description>\n  &lt;/properties>\n\n  &lt;aggregations>\n    &lt;readMe>\n      &lt;composition>\n        &lt;workspace:README />\n      &lt;/composition>\n    &lt;/readMe>\n    &lt;dependencies>\n      &lt;composition>\n        &lt;blockml:Library />\n        &lt;bom:Library />\n        &lt;builder:Library />\n        &lt;blockdoc:Library />\n        &lt;cli:Library />\n        &lt;fatblock:Library />\n        &lt;framework:Library />\n        &lt;graph:Library />\n        &lt;inspect:Library />\n        &lt;parser:Library />\n        &lt;runtime:Library />\n        &lt;search:Library />\n        &lt;serializer:Library />\n        &lt;transformer:Library />\n        &lt;validator:Library />\n        &lt;xsd:Library />\n      &lt;/composition>\n    &lt;/dependencies>\n    &lt;blocks>\n      &lt;composition>&lt;workspace:WorkspaceType />\n        &lt;wsdocumentation:Introduction />\n        &lt;wsdocumentation:PackageMap />\n        &lt;wsdocumentation:ArchitectureOverview />\n        &lt;wsdocumentation:ReadingOrder />\n        &lt;wsdocumentation:LinkingRules />\n      &lt;/composition>\n    &lt;/blocks>\n  &lt;/aggregations>\n\n&lt;/block>&quot;,&quot;is_error&quot;:false}]},&quot;parent_tool_use_id&quot;:null,&quot;session_id&quot;:&quot;4260a56f-1f9b-40c7-912b-e04fcc520ce5&quot;,&quot;uuid&quot;:&quot;66a76287-cd8d-4bea-8d0