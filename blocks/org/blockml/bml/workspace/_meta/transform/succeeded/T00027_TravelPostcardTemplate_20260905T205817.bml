- title (type:Text) — a short postcard title
- destination (type:Text) — ${ #this.parameters.destination }
- opening (type:Text) — one vivid opening sentence
- body (type:Text) — three short postcard paragraphs
- language (type:Text) — ${ #this.parameters.language }
