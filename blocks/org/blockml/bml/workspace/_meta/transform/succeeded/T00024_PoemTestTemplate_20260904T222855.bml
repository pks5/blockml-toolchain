umentationTruncated\&quot;: true,\n      \&quot;baseType\&quot;: {\n        \&quot;kind\&quot;: \&quot;named\&quot;,\n        \&quot;ref\&quot;: \&quot;org.blockml.bml.type.PrimitiveType\&quot;\n      },\n      \&quot;ancestors\&quot;: [\n        \&quot;org.blockml.bml.core.Block\&quot;,\n        \&quot;org.blockml.bml.core.ValueType\&quot;,\n        \&quot;org.blockml.bml.type.PrimitiveType\&quot;\n---\n{\n  \&quot;root\&quot;: \&quot;org.blockml.bml.type.DateTime\&quot;,\n  \&quot;depth\&quot;: 1,\n  \&quot;blocks\&quot;: {\n    \&quot;org.blockml.bml.type.DateTime\&quot;: {\n      \&quot;fqn\&quot;: \&quot;org.blockml.bml.type.DateTime\&quot;,\n      \&quot;name\&quot;: \&quot;DateTime\&quot;,\n      \&quot;members\&quot;: [\n        {\n          \&quot;kind\&quot;: \&quot;property\&quot;,\n          \&quot;name\&quot;: \&quot;min\&quot;,\n          \&quot;visibility\&quot;: \&quot;public\&quot;,\n          \&quot;type\&quot;: {\n            \&quot;kind\&quot;: \&quot;named\&quot;,\n            \&quot;ref\&quot;: \&quot;org.blockml.bml.type.DateTime\&quot;\n          }\n        },\n        {\n          \&quot;kind\&quot;: \&quot;property\&quot;,\n          \&quot;name\&quot;: \&quot;max\&quot;,\n          \&quot;visibility\&quot;: \&quot;public\&quot;,\n          \&quot;type\&quot;: {\n            \&quot;kind\&quot;: \&quot;named\&quot;,\n            \&quot;ref\&quot;: \&quot;org.blockml.bml.type.DateTime\&quot;\n          }\n        }\n      ],\n      \&quot;file\&quot;: \&quot;node_modules/@blockml/core/blocks/org/blockml/bml/type/DateTime.bml\&quot;,\n      \&quot;origin\&quot;: \&quot;dependency\&quot;,\n      \&quot;is\&quot;: \&quot;A date and time\&quot;,\n      \&quot;documentation\&quot;: \&quot;BOM Core primitive ValueType for a combined date and time of day. Unqualified name\\n    DateTime resolves to org.blockml.bml.type.DateTime. Extends org.blockml.bml.type.Temporal. Payload\\n    values are stored on Properties — not on the DateTime type itself.\\n