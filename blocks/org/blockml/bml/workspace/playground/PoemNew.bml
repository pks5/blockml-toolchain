<!--
  Workspace Playground — PoemNew
  FQN: org.blockml.bml.workspace.playground.PoemNew
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>PoemNew</name>
  <type>playground:PoemNew</type>
  <baseType>core:Documentation</baseType>
  <is>A random poem produced by a workspace transform execution, translated into Russian from German, about a tree and a mushroom</is>

  <documentation>
    На опушке стоит старый дуб,
    уходят корни в землю вглубь.
    Он годы носит, как наряд,
    из терпеливых лет подряд.

    У ног его, и тих, и мал,
    за ночь грибок нежданно встал.
    На тонкой ножке шляпка спит,
    он мало хочет, всё молчит.

    Дуб шепчет тихо: «Будь со мной,
    придёт мороз — я за стеной
    тебя укрою от дождя».
    Гриб еле кивнёт, но не спя.

    Так и стоят — велик и мал,
    в рассвете, что чуть серым стал.
    Один вознёсся, тот приник,
    и знают оба: лес велик.
  </documentation>

  <properties>
    <title>
      <value>Дерево и гриб</value>
    </title>
    <author>
      <value>John Doe</value>
    </author>
    <year>
      <value>2026</value>
    </year>
  </properties>

</block>
