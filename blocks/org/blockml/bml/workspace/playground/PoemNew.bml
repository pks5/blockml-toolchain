<!--
  Workspace Playground — PoemNew
  FQN: org.blockml.bml.workspace.playground.PoemNew
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>PoemNew</name>
  <type>playground:PoemNew</type>
  <baseType>core:Documentation</baseType>
  <is>A random poem produced by a workspace transform execution, translated into Russian from German, about a tree and a mushroom</is>

  <documentation>
    На кромке леса бук стоит,
    в зелёный час одет на вид.
    Кора груба, вершина — ширь,
    он тихо дремлет, зная мир.

    У ног его, и мал, и смел,
    за ночь грибок в траве поспел.
    Он в красной шляпке, тонконог,
    цветёт лишь раз — короткий срок.

    Бук говорит: «Останься здесь,
    холодный ветер бродит весь.
    Я задержу и дождь, и снег,
    и рост не будет горек, нет.»

    Так в сером утре мокнут двое,
    гигант и карлик под росою.
    Один высок, другой — у ног,
    но лес обоим — общий кров.
  </documentation>

  <properties>
    <title>
      <value>В тени бука</value>
    </title>
    <author>
      <value>John Doe</value>
    </author>
    <year>
      <value>2026</value>
    </year>
  </properties>

</block>
