<!--
  Workspace Playground — PoemNew
  FQN: org.blockml.bml.workspace.playground.PoemNew
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>PoemNew</name>
  <type>playground:PoemNew</type>
  <baseType>core:Documentation</baseType>
  <is>A random poem produced by a workspace transform execution, translated into Russian from German, about a tree and a mushroom</is>

  <documentation>
    Берёза качается в ветре ночном,
    бела её платья убор день за днём.
    Листва шелестит, и легка, и светла —
    как песня из воздуха и серебра.

    Во мху, где не сыщешь луча с вышины,
    впервые грибок вырастает из тьмы.
    Коричнева шляпка, и бледен росток,
    один он стоит, где царит холодок.

    «Молчи, — прошептала берёза ему, —
    тебя сквозь и ветер, и ночь сберегу.
    Листва моя ловит росу и дожди,
    и ты без забот и тревоги расти».

    Когда же рассвет забрезжит седой,
    нашёл каждый место и жребий свой:
    берёза — высоко, грибочек — в тени,
    два друга, в лесу расцветают они.
  </documentation>

  <properties>
    <title>
      <value>Берёза и гриб</value>
    </title>
    <author>
      <value>John Doe</value>
    </author>
    <year>
      <value>2026</value>
    </year>
  </properties>

</block>
