<!--
  Workspace Playground — Library domain — Book
  FQN: org.blockml.bml.workspace.playground.library.Book
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:library="org.blockml.bml.workspace.playground.library">

  <name>Book</name>
  <type>library:Book</type>
  <baseType>core:Block</baseType>
  <is>A titled work the library holds and can lend to members</is>

  <documentation>
    A book carries its bibliographic data (`title`, `isbn`) and its current
    lending `status`. Authorship is modelled as the `authors` association —
    a non-owning link to `library:Author` instances that live under
    `library:Library.authors`; a book has one or more authors.

    A book is lent through a `library:Borrowing`. Because at most one active
    `library:Borrowing` may reference a given book, a book can only be borrowed
    by one member at a time; while that borrowing is active `status` is
    `Borrowed`.
  </documentation>

  <properties>
    <title type="type:Text">
      <documentation>Title of the book.</documentation>
    </title>
    <isbn type="type:Text">
      <documentation>International Standard Book Number identifying this work.</documentation>
    </isbn>
    <status type="library:AvailabilityStatus">
      <documentation>Whether the book is currently available or borrowed.</documentation>
    </status>
  </properties>

  <associations>
    <authors type="InstanceReference(library:Author)[]">
      <documentation>
        The one or more authors who wrote this book. Non-owning: the referenced
        `library:Author` instances are owned by `library:Library.authors`.
      </documentation>
    </authors>
  </associations>

</block>
