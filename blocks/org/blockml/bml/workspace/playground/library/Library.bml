<!--
  Workspace Playground — Library domain — Library
  FQN: org.blockml.bml.workspace.playground.library.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:library="org.blockml.bml.workspace.playground.library">

  <name>Library</name>
  <type>library:Library</type>
  <baseType>core:Block</baseType>
  <is>The aggregate that owns the books, members, authors and borrowings it manages</is>

  <documentation>
    Root of the library domain model. It owns four collections through
    aggregations, so their instances belong to the library's managed state:

    * `books` — the `library:Book` copies the library holds.
    * `members` — the registered `library:Member` people.
    * `authors` — `library:Author` people, kept independently of books so an
      author survives the removal of any book and can be shared by several.
    * `borrowings` — the active `library:Borrowing` lending records. Modelling
      borrowings here (rather than as a property of a book or member) is what
      makes them part of the library state and lets a member hold several at
      once while each book has at most one.
  </documentation>

  <aggregations>
    <books type="library:Book[]">
      <documentation>Every book copy the library holds.</documentation>
    </books>
    <members type="library:Member[]">
      <documentation>Every registered member.</documentation>
    </members>
    <authors type="library:Author[]">
      <documentation>Authors known to the library, owned independently of books.</documentation>
    </authors>
    <borrowings type="library:Borrowing[]">
      <documentation>Active lending records; managed library state.</documentation>
    </borrowings>
  </aggregations>

</block>
