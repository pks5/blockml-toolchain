<!--
  Workspace Playground — Library domain — Author
  FQN: org.blockml.bml.workspace.playground.library.Author
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:library="org.blockml.bml.workspace.playground.library">

  <name>Author</name>
  <type>library:Author</type>
  <baseType>core:Block</baseType>
  <is>A person who wrote one or more books held by the library</is>

  <documentation>
    An author exists in the model independently of any book.

    * Books point at authors through the non-owning `library:Book.authors`
      association, so one `library:Author` instance can be referenced by many
      `library:Book` instances — an author may have written multiple books.
    * Authors are owned by `library:Library.authors`, not by any book, so an
      author outlives the books that reference it.
  </documentation>

  <properties>
    <name type="type:Text">
      <documentation>Full name of the author.</documentation>
    </name>
  </properties>

</block>
