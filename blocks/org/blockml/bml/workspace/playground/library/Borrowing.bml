<!--
  Workspace Playground — Library domain — Borrowing
  FQN: org.blockml.bml.workspace.playground.library.Borrowing
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:library="org.blockml.bml.workspace.playground.library">

  <name>Borrowing</name>
  <type>library:Borrowing</type>
  <baseType>core:Block</baseType>
  <is>A lending record connecting one member with one borrowed book</is>

  <documentation>
    A borrowing is a first-class part of the library's managed state: it is owned
    by `library:Library.borrowings`, not stored as a property of a book or a
    member. It links exactly one `library:Member` to exactly one `library:Book`
    via the `member` and `book` associations and records `borrowedAt` and
    `dueAt`.

    Since `book` is a single-valued association and the library keeps at most one
    active borrowing per book, a book can only be borrowed by one member at a
    time. A member may appear as the `member` of many concurrent borrowings.
  </documentation>

  <properties>
    <borrowedAt type="type:DateTime">
      <documentation>When the book was handed to the member.</documentation>
    </borrowedAt>
    <dueAt type="type:DateTime">
      <documentation>When the book is due back at the library.</documentation>
    </dueAt>
  </properties>

  <associations>
    <member type="InstanceReference(library:Member)">
      <documentation>The member who borrowed the book.</documentation>
    </member>
    <book type="InstanceReference(library:Book)">
      <documentation>The single book covered by this borrowing.</documentation>
    </book>
  </associations>

</block>
