<!--
  Workspace Playground — Library domain — AvailabilityStatus
  FQN: org.blockml.bml.workspace.playground.library.AvailabilityStatus
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:library="org.blockml.bml.workspace.playground.library">

  <name>AvailabilityStatus</name>
  <type>library:AvailabilityStatus</type>
  <baseType>type:EnumType</baseType>
  <is>The lending availability of a book copy</is>

  <documentation>
    Closed set of states a `library:Book` can be in with respect to lending.

    * `Available` — the book is on the shelf and may be borrowed.
    * `Borrowed` — the book is currently out on an active `library:Borrowing`.
  </documentation>

  <aggregations>
    <values>
      <composition>
        <AvailabilityStatus bml:id="Available" />
        <AvailabilityStatus bml:id="Borrowed" />
      </composition>
    </values>
  </aggregations>

</block>
