<!--
  Workspace Playground — Poem
  FQN: org.blockml.bml.workspace.playground.Poem
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>Poem</name>
  <type>playground:Poem</type>
  <baseType>core:Documentation</baseType>
  <is>A random poem produced by a workspace transform execution</is>

  <documentation>
    Mane cinereum super tecta muta descendit,
    merulae clamor ventum gelidum findit.
    Viae adhuc in semisomno spirant,
    ubi umbrae scamna deserta cingunt.

    Fenestra rubet, quasi solem teneat,
    lucerna vigilat, ubi dies iam pridem coepit.
    Caffea fumat, brevis mora in strepitu,
    antequam hora cursum suum capiat.

    Et super omnia transit nubes corvorum
    velut atramentum quod caelum lente scribit.
    Arcus designant quos nemo hominum tenere potest,
    et tamen salutatio quae usque ad vesperum manet.
  </documentation>

  <properties>
    <title>
      <value>Mane cinereum descendit</value>
    </title>
    <author>
      <value>John Doe</value>
    </author>
    <year>
      <value>2026</value>
    </year>
  </properties>

</block>
