<!--
  Workspace Playground — RandomBlock
  FQN: org.blockml.bml.workspace.playground.RandomBlock
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>RandomBlock</name>
  <type>playground:RandomBlock</type>
  <baseType>core:Documentation</baseType>
  <is>A field census of imaginary bells cast for bell towers that were never built, compiled at random by a workspace transform execution</is>

  <documentation>
    Produced by a BlockML workspace transform execution — the "Create Random
    Block" step of playground:MyTestTransformation. Every run replaces this
    block with freshly invented, arbitrary material, so nothing catalogued
    here is stable or authoritative.
  </documentation>

  <properties>
    <title type="type:Text">
      <value>The Census of Bells That Were Never Hung</value>
    </title>
    <compiler type="type:Text">
      <value>The itinerant founder Wenna Trevithick, working from a handcart forge</value>
    </compiler>
    <region type="type:Text">
      <value>The chalk downland between Ogbourne St George and the deserted hamlet of Snap, Wiltshire</value>
    </region>
    <summary type="type:Text">
      <value>Seven bells were poured for towers that stayed on paper. The largest, "Broad Aldous", carries a rim inscription meant for a church whose foundation trench still shows as a green scar in the pasture. The smallest is no wider than a teacup and rings only in frost. Each bell was weighed, struck once, its note written on a slate tag, and then buried a spade's depth down at the point where the tower's door would have stood, so a future builder might dig it up already tuned.</value>
    </summary>
    <bellsCast type="type:Integer">
      <value>7</value>
    </bellsCast>
    <heaviestBellKilograms type="type:Integer">
      <value>612</value>
    </heaviestBellKilograms>
    <deepestBurialCentimetres type="type:Integer">
      <value>28</value>
    </deepestBurialCentimetres>
    <strikeNoteHertz type="type:Integer">
      <value>247</value>
    </strikeNoteHertz>
    <compiledAt type="type:DateTime">
      <value>2026-09-06T03:37:20</value>
    </compiledAt>
    <lastBellBuriedOn type="type:DateTime">
      <value>2026-08-19T06:45:00</value>
    </lastBellBuriedOn>
  </properties>

</block>
