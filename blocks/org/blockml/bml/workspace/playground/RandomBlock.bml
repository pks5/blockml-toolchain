<!--
  Workspace Playground — RandomBlock
  FQN: org.blockml.bml.workspace.playground.RandomBlock
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>RandomBlock</name>
  <type>playground:RandomBlock</type>
  <baseType>core:Documentation</baseType>
  <is>A fog timetable for a narrow-gauge tram line whose stops are named only on the mornings the mist is thick enough to hide the next pole</is>

  <documentation>
    Produced by a BlockML workspace transform execution — the "Create Random
    Block" step of playground:MyTestTransformation. Every run replaces this
    block with freshly invented, arbitrary material, so nothing recorded
    here is stable or authoritative.
  </documentation>

  <properties>
    <title type="type:Text">
      <value>The Fog Timetable of the Marrom Halt Tramway</value>
    </title>
    <keeper type="type:Text">
      <value>Present-day duty is held by the signalwoman Oona Bricriu, who walks the line counting poles by touch</value>
    </keeper>
    <region type="type:Text">
      <value>The reed flats where the River Ceirw loses itself before the sea, below the abandoned lime kilns at Trawsallt</value>
    </region>
    <summary type="type:Text">
      <value>The tramway runs a single motor car along four kilometres of thirty-inch track, but only when a bank of sea fog rolls in thick enough that the driver cannot see the next pole. On those mornings each halt is given a name chalked onto a slate at the platform edge — "Heron's Excuse", "Second Kettle", "Where The Dog Turned Back" — and the name is wiped off again the moment the fog lifts, so the line has no fixed stops at all. A brass bell on the front buffer is rung once per pole passed, and passengers count the rings to know where to step down into the white.</value>
    </summary>
    <namedHalts type="type:Integer">
      <value>11</value>
    </namedHalts>
    <trackLengthMetres type="type:Integer">
      <value>4120</value>
    </trackLengthMetres>
    <foggyRunningDaysLastYear type="type:Integer">
      <value>63</value>
    </foggyRunningDaysLastYear>
    <bellRingsPerFullTrip type="type:Integer">
      <value>187</value>
    </bellRingsPerFullTrip>
    <compiledAt type="type:DateTime">
      <value>2026-09-06T05:24:10</value>
    </compiledAt>
    <firstFogRunRecordedOn type="type:DateTime">
      <value>2026-07-02T06:15:00</value>
    </firstFogRunRecordedOn>
  </properties>

</block>
