<!--Workspace Playground — RandomBlock
  FQN: org.blockml.bml.workspace.playground.RandomBlock-->
<playground:RandomBlock xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:playground="org.blockml.bml.workspace.playground">

  <name>
    RandomBlock
  </name>
  <baseType>
    core:Documentation
  </baseType>
  <is>
    A lending register for a roadside glass cabinet where travellers leave one glove and take another that fits better
  </is>
  <documentation>
    Produced by a BlockML workspace transform execution — the "Create Random
    Block" step of playground:MyTestTransformation. Every run replaces this
    block with freshly invented, arbitrary material, so nothing recorded
    here is stable or authoritative.
  </documentation>
  <properties>
    <title type="type:Text">
      <value>The Single-Glove Cabinet at the Kettleburn Turning</value>
    </title>
    <keeper type="type:Text">
      <value>Looked after by Marek Ostrowski, a school-bus driver who dusts the shelves on Sundays and never removes a glove himself</value>
    </keeper>
    <region type="type:Text">
      <value>A gravel lay-by on the old drovers' road above Kettleburn, halfway between the wind turbines and the flooded quarry</value>
    </region>
    <summary type="type:Text">
      <value>The cabinet is a repurposed telephone kiosk with the phone gone and four pine shelves screwed inside. The single rule, painted on the door in green, is: leave a glove, take a glove, and only if the one you take fits better than the one you left. Walkers who lose a mitten on the ridge come down here to be matched; a surprising number of pairs have been reunited across years by strangers who never met. A cloth-bound ledger hangs on a string, and each visitor writes one line about the glove they took and where they think its twin might be.</value>
    </summary>
    <glovesOnShelvesToday type="type:Integer">
      <value>47</value>
    </glovesOnShelvesToday>
    <ledgerEntriesThisYear type="type:Integer">
      <value>312</value>
    </ledgerEntriesThisYear>
    <reunitedPairsAllTime type="type:Integer">
      <value>29</value>
    </reunitedPairsAllTime>
    <shelfHeightCentimetres type="type:Integer">
      <value>26</value>
    </shelfHeightCentimetres>
    <compiledAt type="type:DateTime">
      <value>2026-09-06T14:38:52</value>
    </compiledAt>
    <cabinetInstalledOn type="type:DateTime">
      <value>2019-11-03T09:30:00</value>
    </cabinetInstalledOn>
  </properties>
</playground:RandomBlock>
