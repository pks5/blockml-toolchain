<!--Workspace Documentation — LinkingRules
  FQN: org.blockml.bml.workspace.documentation.LinkingRules-->
<wsdocumentation:LinkingRules xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:wsdocumentation="org.blockml.bml.workspace.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Normative monorepo BML linking and SSOT rules
  </is>
  <documentation>
    Normative rules for this monorepo:
    
    1. Workspace → packages only. org.blockml.bml.workspace.Library may list package
       libraries in dependencies. Package Library.bml files must never depend on
       org.blockml.bml.workspace.Library.
    2. No re-export. This hub does not put package blocks in its own blocks list.
       Package membership stays exclusive to each package Library.
    3. Package SSOT. Each @blockml/* package owns its BML under packages/*/blocks/
       and points at it via package.json blockml.library.
    4. Hub SSOT. The root package.json blockml.library points at this workspace
       Library — the entry for monorepo documentation and orientation.
    5. Markdown transitional. docs/*.md is holding text until migrated into BML;
       prefer package and workspace BML libraries as authoritative.
  </documentation>
  <references>
    <see type="wsdocumentation:Introduction" relation="SeeAlso" />
    <see type="wsdocumentation:PackageMap" relation="SeeAlso" />
  </references>
</wsdocumentation:LinkingRules>
