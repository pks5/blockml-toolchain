<!--Workspace Documentation — ArchitectureOverview
  FQN: org.blockml.bml.workspace.documentation.ArchitectureOverview-->
<wsdocumentation:ArchitectureOverview xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:core="org.blockml.bml.core"
  xmlns:wsdocumentation="org.blockml.bml.workspace.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    High-level BlockML toolchain pipeline
  </is>
  <documentation>
    Toolchain data flow:
    
    BML (.bml, XML) → @blockml/parser → Urmodell (canonical BOM, @blockml/bom)
    → @blockml/validator / @blockml/framework utilities
    → @blockml/compiler (runtime facade + Target Registry)
    → render targets (blockdoc, xsd, fatblock, …)
    → emitters / on-disk output
    
    @blockml/serializer round-trips Urmodell → BML.
    @blockml/cli (blockml) owns host bootstrap, config, validate/compile/search/graph orchestration,
    and writing RenderOutput.
    
    The core is domain-agnostic. Domain knowledge lives in domain packages and
    domain CLIs outside this repo.
  </documentation>
  <references>
    <see type="wsdocumentation:ReadingOrder" relation="ReadNext" />
    <see type="cli:Library" relation="SeeAlso" />
    <see type="runtime:Library" relation="SeeAlso" />
  </references>
</wsdocumentation:ArchitectureOverview>
