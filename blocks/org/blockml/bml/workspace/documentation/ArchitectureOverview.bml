<!--
  Workspace Documentation — ArchitectureOverview
  FQN: org.blockml.bml.workspace.documentation.ArchitectureOverview
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:search="org.blockml.bml.search"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:fatblock="org.blockml.bml.target.fatblock"
  xmlns:xsd="org.blockml.bml.target.xsd"
  xmlns:type="org.blockml.bml.type"
  xmlns:workspace="org.blockml.bml.workspace"
  xmlns:wsdocumentation="org.blockml.bml.workspace.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ArchitectureOverview</name>
  <type>wsdocumentation:ArchitectureOverview</type>
  <baseType>core:Documentation</baseType>
  <is>High-level BlockML toolchain pipeline</is>

  <documentation>Toolchain data flow:

    BML (.bml, XML) → @blockml/parser → Urmodell (canonical BOM, @blockml/bom)
    → @blockml/validator / @blockml/framework utilities
    → @blockml/compiler (runtime facade + Target Registry)
    → render targets (blockdoc, xsd, fatblock, …)
    → emitters / on-disk output

    @blockml/serializer round-trips Urmodell → BML.
    @blockml/cli (blockml) owns host bootstrap, config, validate/compile/search/graph orchestration,
    and writing RenderOutput.

    The core is domain-agnostic. Domain knowledge lives in domain packages and
    domain CLIs outside this repo.</documentation>

  <references>
    <see type="wsdocumentation:ReadingOrder" relation="ReadNext" />
    <see type="cli:Library" relation="SeeAlso" />
    <see type="runtime:Library" relation="SeeAlso" />
  </references>

</block>
