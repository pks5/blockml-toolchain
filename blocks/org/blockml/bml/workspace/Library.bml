<!--BlockML Workspace Library
  FQN: org.blockml.bml.workspace.Library-->
<workspace:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:core="org.blockml.bml.core"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:search="org.blockml.bml.search"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:fatblock="org.blockml.bml.target.fatblock"
  xmlns:xsd="org.blockml.bml.target.xsd"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:workspace="org.blockml.bml.workspace">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML monorepo workspace library catalog
  </is>
  <version>
    0.9.12
  </version>
  <documentation>
    Documentation and SSOT hub for the BlockML toolchain monorepo. Links package
    BML libraries (workspace → packages only). Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder. Package libraries must not depend back on this library.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML workspace monorepo library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <workspace:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <builder:Library />
        <blockdoc:Library />
        <cli:Library />
        <fatblock:Library />
        <framework:Library />
        <graph:Library />
        <inspect:Library />
        <parser:Library />
        <runtime:Library />
        <search:Library />
        <serializer:Library />
        <transformer:Library />
        <validator:Library />
        <xsd:Library />
      </composition>
    </dependencies>
  </aggregations>
</workspace:Library>
