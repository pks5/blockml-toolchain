<!--
  BlockML Workspace Library
  FQN: org.blockml.bml.workspace.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:search="org.blockml.bml.search"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:fatblock="org.blockml.bml.target.fatblock"
  xmlns:xsd="org.blockml.bml.target.xsd"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:type="org.blockml.bml.type"
  xmlns:workspace="org.blockml.bml.workspace"
  xmlns:wsdocumentation="org.blockml.bml.workspace.documentation">

  <name>Library</name>
  <type>workspace:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML monorepo workspace library catalog</is>

  <documentation>
    Documentation and SSOT hub for the BlockML toolchain monorepo. Links package
    BML libraries (workspace → packages only). Membership is defined exclusively
    by this blocks list. Package libraries must not depend back on this library.
  </documentation>

  <version>0.8.1</version>

  <language>
    <English />
  </language>

  <properties>
    <description override="true">
      <value>BlockML workspace monorepo library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <workspace:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
        <bom:Library />
        <blockdoc:Library />
        <cli:Library />
        <fatblock:Library />
        <framework:Library />
        <parser:Library />
        <runtime:Library />
        <search:Library />
        <serializer:Library />
        <transformer:Library />
        <validator:Library />
        <xsd:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition><workspace:WorkspaceType />
        <wsdocumentation:Introduction />
        <wsdocumentation:PackageMap />
        <wsdocumentation:ArchitectureOverview />
        <wsdocumentation:ReadingOrder />
        <wsdocumentation:LinkingRules />
      </composition>
    </blocks>
  </aggregations>

</block>
