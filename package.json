{
  "name": "blockml",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "blockml": {
    "library": "./blocks/org/blockml/bml/workspace/Library.bml"
  },
  "dependencies": {
    "@blockml/core": "^1.0.10",
    "@machineblocks/core": "^3.0.0-A1"
  },
  "devDependencies": {
    "@blockml/blockdoc-target": "workspace:*",
    "@blockml/bom": "workspace:*",
    "@blockml/cli": "workspace:*",
    "@blockml/compiler": "workspace:*",
    "@blockml/fatblock-target": "workspace:*",
    "@blockml/framework": "workspace:*",
    "@blockml/graph": "workspace:*",
    "@blockml/lsp": "workspace:*",
    "@blockml/parser": "workspace:*",
    "@blockml/search": "workspace:*",
    "@blockml/serializer": "workspace:*",
    "@blockml/transformer": "workspace:*",
    "@blockml/validator": "workspace:*",
    "@blockml/xsd-target": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:bom": "vitest run packages/bom/test",
    "test:parser": "vitest run packages/parser/test",
    "test:serializer": "vitest run packages/serializer/test",
    "test:watch": "vitest",
    "test:roundtrip": "vitest run tests/roundtrip",
    "test:framework": "vitest run packages/framework/test",
    "test:framework-bml": "vitest run packages/framework/test/bml-ts-parity.test.ts",
    "test:validator": "vitest run packages/validator/test tests/validation",
    "test:validator-bml": "vitest run packages/validator/test/bml-ts-parity.test.ts",
    "test:constraints": "vitest run packages/framework/test/constraints.test.ts",
    "test:compiler": "vitest run packages/compiler/test",
    "test:blockdoc": "vitest run packages/blockdoc-target/test tests/blockdoc",
    "test:xsd": "vitest run packages/xsd-target/test tests/xsd",
    "test:fatblock": "vitest run packages/fatblock-target/test tests/fatblock",
    "test:cli": "vitest run packages/cli-tools/test",
    "test:lsp": "vitest run packages/lsp/test",
    "test:search": "vitest run packages/search/test",
    "test:graph": "vitest run packages/graph/test",
    "test:transformer": "vitest run packages/transformer/test",
    "compile:blockdoc": "node packages/cli-tools/dist/cli.js compile blockdoc",
    "compile:xsd": "node packages/cli-tools/dist/cli.js compile xsd",
    "compile:fatblock": "node packages/cli-tools/dist/cli.js compile fatblock --per-package",
    "validate": "node packages/cli-tools/dist/cli.js validate",
    "search:index": "node packages/cli-tools/dist/cli.js search index",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "publish:packages": "bash scripts/publish-packages.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
