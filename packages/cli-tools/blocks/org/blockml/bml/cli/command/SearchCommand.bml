<!--CLI Command — SearchCommand
  FQN: org.blockml.bml.cli.command.SearchCommand-->
<clicommand:SearchCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml search command model
  </is>
  <documentation>
    blockml search QUERY [--json] [--limit n]; blockml search index [--force]. Corpus is validate --all via @blockml/search.
  </documentation>
  <references>
    <see type="clidocumentation:SearchCommand" relation="SeeAlso" />
    <see type="clicap:RunSearch" relation="SeeAlso" />
  </references>
  <properties>
    <query type="type:Text">
      <documentation>
        Search query. Mutually exclusive with index=true. (optional)
      </documentation>
    </query>
    <index type="type:Boolean">
      <documentation>
        Rebuild the local search index. (optional)
      </documentation>
    </index>
    <json type="type:Boolean">
      <documentation>
        Print SearchResult[] as JSON. (optional)
      </documentation>
    </json>
    <force type="type:Boolean">
      <documentation>
        V1 alias of full rebuild. (optional)
      </documentation>
    </force>
  </properties>
</clicommand:SearchCommand>
