<!--
  CLI Command — TransformApplyCommand
  FQN: org.blockml.bml.cli.command.TransformApplyCommand
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:type="org.blockml.bml.type">

  <name>TransformApplyCommand</name>
  <type>clicommand:TransformApplyCommand</type>
  <baseType>cli:CliType</baseType>
  <is>blockml transform apply subcommand</is>

  <documentation>blockml transform apply EXECUTION-FQN [--verbose] [--parameters JSON] [--parameters-source PATH]. The CLI token is apply. The argument is the FQN of a pending ModelTransformation. Delegates to @blockml/transformer.</documentation>
  <references>
    <see type="clicommand:TransformCommand" relation="SeeAlso" />
    <see type="clidocumentation:TransformCommand" relation="SeeAlso" />
    <see type="clicap:RunTransform" relation="SeeAlso" />
  </references>
  <properties>
    <executionFqn type="type:Text"><documentation>FQN of a ModelTransformation in the library _meta.transform.pending package. (required)</documentation></executionFqn>
    <parameters type="type:Text"><documentation>JSON value of run parameters. StructType: merged over pending. Other types: replaces pending. Ignored when parametersSource is set. (optional)</documentation></parameters>
    <parametersSource type="type:Text"><documentation>PropertyReference path copied onto parameters. Ignores --parameters. (optional)</documentation></parametersSource>
    <verbose type="type:Boolean"><documentation>Stream the transformation agent output live. (optional)</documentation></verbose>
  </properties>

</block>
