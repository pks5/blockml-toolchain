<!--CLI Command — TransformApplyCommand
  FQN: org.blockml.bml.cli.command.TransformApplyCommand-->
<clicommand:TransformApplyCommand xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml transform apply subcommand
  </is>
  <documentation>
    blockml transform apply EXECUTION-FQN [--library path] [--verbose] [--parameters JSON] [--parameter-mappings JSON]. The CLI token is apply. The argument is a pending one-shot, an available template, or a template outside _meta.transform. The source FQN need not live under the target library. --library is a path to the target Library.bml; omitted uses cwd package.json blockml.library. Missing both is exit 2. Distinct from --libraries. Delegates to @blockml/transformer.
  </documentation>
  <references>
    <see type="clicommand:TransformCommand" relation="SeeAlso" />
    <see type="clidocumentation:TransformCommand" relation="SeeAlso" />
    <see type="clicap:RunTransform" relation="SeeAlso" />
  </references>
  <properties>
    <executionFqn type="type:Text">
      <documentation>
        FQN of an Apply-source ModelTransformation (pending one-shot, available template, or template outside _meta.transform). (required)
      </documentation>
    </executionFqn>
    <library type="type:Text">
      <documentation>
        Path to the target Library.bml for _meta. Distinct from --libraries. (optional)
      </documentation>
    </library>
    <parameters type="type:Text">
      <documentation>
        JSON value of run parameters. StructType: merged over pending. Other types: replaces pending. Ignored when parameterMappings is non-empty. (optional)
      </documentation>
    </parameters>
    <parameterMappings type="type:Text">
      <documentation>
        JSON array of ParameterMapping objects applied onto parameters. Ignores --parameters. (optional)
      </documentation>
    </parameterMappings>
    <verbose type="type:Boolean">
      <documentation>
        Stream the transformation agent output live. (optional)
      </documentation>
    </verbose>
  </properties>
</clicommand:TransformApplyCommand>
