<!--CLI Command — CompileCommand
  FQN: org.blockml.bml.cli.command.CompileCommand-->
<clicommand:CompileCommand xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml compile command model
  </is>
  <documentation>
    CLI12–CLI16: compile to registered target. Default target blockdoc when omitted. Fatblock without file uses package.json blockml.library.
  </documentation>
  <references>
    <see type="clidocumentation:CompileCommand" relation="SeeAlso" />
    <see type="clicap:RunCompile" relation="SeeAlso" />
  </references>
  <properties>
    <target type="type:Text">
      <documentation>
        Registry name. Default blockdoc. (optional)
      </documentation>
    </target>
    <file type="type:Text">
      <documentation>
        Host document for fatblock; defaults to package.json blockml.library. (optional)
      </documentation>
    </file>
    <all type="type:Boolean">
      <documentation>
        Document targets only — loop srcDir. (optional)
      </documentation>
    </all>
  </properties>
</clicommand:CompileCommand>
