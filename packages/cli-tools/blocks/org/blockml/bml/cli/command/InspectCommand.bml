<!--CLI Command — InspectCommand
  FQN: org.blockml.bml.cli.command.InspectCommand-->
<clicommand:InspectCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml inspect command model
  </is>
  <documentation>
    blockml inspect FQN [--depth n] [--json] [--src] [--libraries]. Corpus is validate --all via @blockml/inspect. JSON-only InspectResult.
  </documentation>
  <references>
    <see type="clidocumentation:InspectCommand" relation="SeeAlso" />
    <see type="clicap:RunInspect" relation="SeeAlso" />
  </references>
  <properties>
    <inspectFqn type="type:Text">
      <documentation>
        Block FQN to inspect. A .bml path is not an FQN; unknown tokens may suggest the file's root FQN. (required)
      </documentation>
    </inspectFqn>
    <depth type="type:Integer">
      <documentation>
        Expansion depth 0..3. Default 1. (optional)
      </documentation>
    </depth>
    <json type="type:Boolean">
      <documentation>
        Accepted and implied; output is always JSON. (optional)
      </documentation>
    </json>
  </properties>
</clicommand:InspectCommand>
