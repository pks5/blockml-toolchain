<!--CLI Command — AgentsMdCommand
  FQN: org.blockml.bml.cli.command.AgentsMdCommand-->
<clicommand:AgentsMdCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml agents-md command model
  </is>
  <documentation>
    blockml agents-md generate [--src dir]. Parent command. V1 defines generate only. Calls GenerateAgentsMd and prints its lines. A missing or unknown subcommand prints the short USAGE and exits 2.
  </documentation>
  <references>
    <see type="clidocumentation:AgentsMdCommand" relation="SeeAlso" />
    <see type="clicap:GenerateAgentsMd" relation="SeeAlso" />
  </references>
  <properties>
    <subcommand type="type:Text">
      <documentation>
        generate. (required)
      </documentation>
    </subcommand>
    <srcDir type="type:Text">
      <documentation>
        --src: project source folder. Default is blockml.config.json srcDir, else blocks. (optional)
      </documentation>
    </srcDir>
  </properties>
</clicommand:AgentsMdCommand>
