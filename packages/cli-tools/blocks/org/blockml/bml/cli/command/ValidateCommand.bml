<!--CLI Command — ValidateCommand
  FQN: org.blockml.bml.cli.command.ValidateCommand-->
<clicommand:ValidateCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml validate command model
  </is>
  <documentation>
    CLI10/CLI11: validate file XOR --all; default = project sources; --all = entire registry; no target bootstrap; no output files.
  </documentation>
  <references>
    <see type="clidocumentation:ValidateCommand" relation="SeeAlso" />
    <see type="clicap:RunValidate" relation="SeeAlso" />
  </references>
  <properties>
    <file type="type:Text">
      <documentation>
        Single file path. Mutually exclusive with all=true. (optional)
      </documentation>
    </file>
    <all type="type:Boolean">
      <documentation>
        Validate every document in the registry, including npm libraries. (optional)
      </documentation>
    </all>
  </properties>
</clicommand:ValidateCommand>
