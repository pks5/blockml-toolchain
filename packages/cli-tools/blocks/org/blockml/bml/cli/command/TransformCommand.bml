<!--
  CLI Command — TransformCommand
  FQN: org.blockml.bml.cli.command.TransformCommand
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:type="org.blockml.bml.type">

  <name>TransformCommand</name>
  <type>clicommand:TransformCommand</type>
  <baseType>cli:CliType</baseType>
  <is>blockml transform command model</is>

  <documentation>blockml transform SUBCOMMAND. Parent command for transformation subcommands. V1 defines apply only. Further subcommands are added to subcommands.</documentation>
  <references>
    <see type="clidocumentation:TransformCommand" relation="SeeAlso" />
    <see type="clicommand:TransformApplyCommand" relation="SeeAlso" />
    <see type="clicap:RunTransform" relation="SeeAlso" />
  </references>
  <aggregations>
    <subcommands type="cli:CliType[]">
      <documentation>Named subcommands of blockml transform. V1: apply.</documentation>
      <composition>
        <clicommand:TransformApplyCommand />
      </composition>
    </subcommands>
  </aggregations>

</block>
