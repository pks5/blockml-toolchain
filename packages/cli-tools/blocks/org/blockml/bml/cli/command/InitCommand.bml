<!--CLI Command — InitCommand
  FQN: org.blockml.bml.cli.command.InitCommand-->
<clicommand:InitCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml init command model
  </is>
  <documentation>
    blockml init PACKAGE-FQN [--src dir] [--install]. Scaffolds a BlockML project: package.json merge, Library + README, AGENTS.md + CLAUDE.md. Does not load the TypeRegistry.
  </documentation>
  <references>
    <see type="clidocumentation:InitCommand" relation="SeeAlso" />
    <see type="clicap:RunInit" relation="SeeAlso" />
  </references>
  <properties>
    <initPackageFqn type="type:Text">
      <documentation>
        Package FQN to initialize (dotted identifier, not …Library). A bml
        segment after the domain is recommended. (required)
      </documentation>
    </initPackageFqn>
    <install type="type:Boolean">
      <documentation>
        --install: run npm install after writing files. Default false. (optional)
      </documentation>
    </install>
  </properties>
</clicommand:InitCommand>
