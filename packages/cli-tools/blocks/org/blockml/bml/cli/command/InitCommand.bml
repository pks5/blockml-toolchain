<!--CLI Command — InitCommand
  FQN: org.blockml.bml.cli.command.InitCommand-->
<clicommand:InitCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml init command model
  </is>
  <documentation>
    blockml init PACKAGE-FQN [--src dir] [--install]. Parses flags, calls InitProject, and prints its lines. When the package FQN is missing, also prints the short USAGE. Scaffold writes and AGENTS.md generation stay in InitProject.
  </documentation>
  <references>
    <see type="clidocumentation:InitCommand" relation="SeeAlso" />
    <see type="clicap:InitProject" relation="SeeAlso" />
  </references>
  <properties>
    <initPackageFqn type="type:Text">
      <documentation>
        Package FQN to initialize (dotted identifier, not …Library). A bml
        segment after the domain is recommended. (required)
      </documentation>
    </initPackageFqn>
    <srcDir type="type:Text">
      <documentation>
        --src: source folder under the project root. Default blocks. (optional)
      </documentation>
    </srcDir>
    <install type="type:Boolean">
      <documentation>
        --install: run npm install after package.json, Library, and README, and before AGENTS.md generation. Default false. (optional)
      </documentation>
    </install>
  </properties>
</clicommand:InitCommand>
