<!--CLI Command — NewCommand
  FQN: org.blockml.bml.cli.command.NewCommand-->
<clicommand:NewCommand xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml new command model
  </is>
  <documentation>
    blockml new FQN [--baseType FQN] [--is text]. Creates a type-as-root .bml file via @blockml/builder (no xsi/schemaLocation) and adds the Block to the owning Library catalog.
  </documentation>
  <references>
    <see type="clidocumentation:NewCommand" relation="SeeAlso" />
    <see type="clicap:RunNew" relation="SeeAlso" />
  </references>
  <properties>
    <newFqn type="type:Text">
      <documentation>
        FQN of the Block to create. (required)
      </documentation>
    </newFqn>
    <newBaseType type="type:Text">
      <documentation>
        --baseType override. (optional)
      </documentation>
    </newBaseType>
    <newIs type="type:Text">
      <documentation>
        --is override. (optional)
      </documentation>
    </newIs>
  </properties>
</clicommand:NewCommand>
