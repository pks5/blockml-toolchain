<!--CLI Config — ExitCodes
  FQN: org.blockml.bml.cli.config.ExitCodes-->
<cliconfig:ExitCodes xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Process exit code meanings
  </is>
  <documentation>
    CLI18 exit code matrix.
  </documentation>
  <properties>
    <success type="type:Integer">
      <documentation>
        0 — command completed without errors.
      </documentation>
    </success>
    <compilerError type="type:Integer">
      <documentation>
        1 — parser/validator/compiler diagnostics with severity error.
      </documentation>
    </compilerError>
    <configError type="type:Integer">
      <documentation>
        2 — unknown command, missing file, unsupported target, bootstrap failure.
      </documentation>
    </configError>
  </properties>
</cliconfig:ExitCodes>
