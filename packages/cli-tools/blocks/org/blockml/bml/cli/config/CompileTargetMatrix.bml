<!--CLI Config — CompileTargetMatrix
  FQN: org.blockml.bml.cli.config.CompileTargetMatrix-->
<cliconfig:CompileTargetMatrix xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Target-specific CLI argument requirements (V1)
  </is>
  <documentation>
    CLI19 target matrix. Document fatblock defaults file from package.json blockml.library; library/corpus omit file; --all ignored for corpus targets.
  </documentation>
  <properties>
    <blockdoc type="type:Text">
      <documentation>
        file omit; --all no; default outDir blockdoc; no --src/--libraries → project blockml.library packages as corpus; else auto libraries[] then srcDir.
      </documentation>
    </blockdoc>
    <xsd type="type:Text">
      <documentation>
        file omit; --all no; scope auto libraries[]; default outDir schemas.
      </documentation>
    </xsd>
    <fatblock type="type:Text">
      <documentation>
        file optional (default package.json blockml.library); --src optional (default host directory); --per-package one {hostFqn}.fat.bml per local library package at the invocation directory.
      </documentation>
    </fatblock>
  </properties>
</cliconfig:CompileTargetMatrix>
