<!--CLI Config — CliColorScheme
  FQN: org.blockml.bml.cli.config.CliColorScheme-->
<cliconfig:CliColorScheme xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Terminal color roles for CLI output
  </is>
  <documentation>
    CLI24 palette. ANSI SGR when color is enabled (TTY, or FORCE_COLOR);
    disabled when NO_COLOR is set. Info uses the terminal default foreground (white on dark terminals).
    Recommendation is reserved for future diagnostics.
  </documentation>
  <properties>
    <error type="type:Text">
      <documentation>
        Red (ANSI 31). Diagnostic severity error and failure/config status.
      </documentation>
    </error>
    <warning type="type:Text">
      <documentation>
        Yellow (ANSI 33). Diagnostic severity warning.
      </documentation>
    </warning>
    <recommendation type="type:Text">
      <documentation>
        Blue (ANSI 34). Future recommendation diagnostics.
      </documentation>
    </recommendation>
    <info type="type:Text">
      <documentation>
        Default/white. Normal status, verbose lists, usage.
      </documentation>
    </info>
    <success type="type:Text">
      <documentation>
        Green (ANSI 32). Validation/compilation succeeded status.
      </documentation>
    </success>
  </properties>
</cliconfig:CliColorScheme>
