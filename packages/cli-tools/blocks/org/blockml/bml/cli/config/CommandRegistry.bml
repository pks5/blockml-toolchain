<!--CLI Config — CommandRegistry
  FQN: org.blockml.bml.cli.config.CommandRegistry-->
<cliconfig:CommandRegistry xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Command names and V1 implementation status
  </is>
  <documentation>
    V1 implements validate, compile, search, scan, graph, inspect, transform, new, and init. Later: watch, activate-config.
  </documentation>
  <properties>
    <validate type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </validate>
    <compile type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </compile>
    <search type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </search>
    <graph type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </graph>
    <transform type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </transform>
    <new type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </new>
    <init type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </init>
    <inspect type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </inspect>
    <scan type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </scan>
    <watch type="type:Boolean">
      <documentation>
        false — planned.
      </documentation>
    </watch>
    <activateConfig type="type:Boolean">
      <documentation>
        false — planned.
      </documentation>
    </activateConfig>
  </properties>
</cliconfig:CommandRegistry>
