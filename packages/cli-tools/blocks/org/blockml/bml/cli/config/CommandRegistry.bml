<!--CLI Config — CommandRegistry
  FQN: org.blockml.bml.cli.config.CommandRegistry-->
<cliconfig:CommandRegistry xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Command names and V1 implementation status
  </is>
  <documentation>
    V1 implements validate, compile, search, scan, graph, inspect, transform, and new. Later: init, watch, activate-config.
  </documentation>
  <properties>
    <validate type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </validate>
    <compile type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </compile>
    <search type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </search>
    <graph type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </graph>
    <transform type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </transform>
    <new type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </new>
    <init type="type:Boolean">
      <documentation>
        false — planned.
      </documentation>
    </init>
    <inspect type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </inspect>
    <scan type="type:Boolean">
      <documentation>
        true — implemented in V1.
      </documentation>
    </scan>
    <watch type="type:Boolean">
      <documentation>
        false — planned.
      </documentation>
    </watch>
    <activateConfig type="type:Boolean">
      <documentation>
        false — planned.
      </documentation>
    </activateConfig>
  </properties>
</cliconfig:CommandRegistry>
