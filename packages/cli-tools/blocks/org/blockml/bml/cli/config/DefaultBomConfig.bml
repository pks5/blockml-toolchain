<!--CLI Config — DefaultBomConfig
  FQN: org.blockml.bml.cli.config.DefaultBomConfig-->
<cliconfig:DefaultBomConfig xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Defaults when blockml.config.json is missing or fields omitted
  </is>
  <documentation>
    CLI1/CLI2: missing file returns these defaults; empty targets[] becomes ["blockdoc"].
  </documentation>
  <properties>
    <outDir type="type:Text">
      <documentation>
        "blockdoc"
      </documentation>
    </outDir>
    <srcDir type="type:Text">
      <documentation>
        "blocks"
      </documentation>
    </srcDir>
    <targets type="type:Text">
      <documentation>
        ["blockdoc"]
      </documentation>
    </targets>
  </properties>
</cliconfig:DefaultBomConfig>
