<!--CLI Config — DefaultBomConfig
  FQN: org.blockml.bml.cli.config.DefaultBomConfig-->
<cliconfig:DefaultBomConfig xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Defaults when blockml.config.json is missing or fields omitted
  </is>
  <documentation>
    CLI1/CLI2: missing file returns these defaults; empty targets[] becomes ["blockdoc"].
  </documentation>
  <properties>
    <outDir type="type:Text">
      <documentation>
        "blockdoc"
      </documentation>
    </outDir>
    <srcDir type="type:Text">
      <documentation>
        "blocks"
      </documentation>
    </srcDir>
    <targets type="type:Text">
      <documentation>
        ["blockdoc"]
      </documentation>
    </targets>
  </properties>
</cliconfig:DefaultBomConfig>
