<!--CLI API — ParsedArgs
  FQN: org.blockml.bml.cli.api.ParsedArgs-->
<cliapi:ParsedArgs xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Result of parseArgs(argv)
  </is>
  <documentation>
    CLI9: parsed command-line arguments from process.argv slice.
  </documentation>
  <properties>
    <command type="type:Text">
      <documentation>
        validate | compile | search | scan | graph | inspect | transform | new | init. (optional)
      </documentation>
    </command>
    <subcommand type="type:Text">
      <documentation>
        Subcommand of command. For scan: package or type. For transform: apply. For graph: index, neighbors, uses, used-by, ancestors, descendants, members, path, query, schema. (optional)
      </documentation>
    </subcommand>
    <target type="type:Text">
      <documentation>
        Registry name e.g. blockdoc, xsd, fatblock. (optional)
      </documentation>
    </target>
    <file type="type:Text">
      <documentation>
        Path to .bml file for document targets or validate. (optional)
      </documentation>
    </file>
    <all type="type:Boolean">
      <documentation>
        --all: validate entire registry including npm (validate) or document compile. (optional)
      </documentation>
    </all>
    <outDir type="type:Text">
      <documentation>
        --out override. (optional)
      </documentation>
    </outDir>
    <srcDir type="type:Text">
      <documentation>
        --src override. (optional)
      </documentation>
    </srcDir>
    <libraries type="type:Text">
      <documentation>
        --libraries comma-separated override of config.libraries extras (identity seed remains). (optional)
      </documentation>
    </libraries>
    <library type="type:Text">
      <documentation>
        --library path to the target Library.bml for transform apply. Distinct from --libraries. (optional)
      </documentation>
    </library>
    <include type="type:Text">
      <documentation>
        --include comma-separated for fatblock. (optional)
      </documentation>
    </include>
    <perPackage type="type:Boolean">
      <documentation>
        --per-package: one fatblock per local package.json blockml.library. (optional)
      </documentation>
    </perPackage>
    <verbose type="type:Boolean">
      <documentation>
        --verbose: validate bootstrap lists; transform streams additional agent-session detail. Lifecycle lines always print. (optional)
      </documentation>
    </verbose>
    <json type="type:Boolean">
      <documentation>
        --json: machine-readable output (search, scan, graph; inspect is always JSON). (optional)
      </documentation>
    </json>
    <force type="type:Boolean">
      <documentation>
        --force: alias of full rebuild for search or graph index. (optional)
      </documentation>
    </force>
    <limit type="type:Integer">
      <documentation>
        --limit: max search hits, or max graph uses/used-by/neighbors after --origin/--relation filters. (optional)
      </documentation>
    </limit>
    <query type="type:Text">
      <documentation>
        Joined positional query for search, or Cypher for graph query. (optional)
      </documentation>
    </query>
    <index type="type:Boolean">
      <documentation>
        search index subcommand: full rebuild. (optional)
      </documentation>
    </index>
    <graphFqn type="type:Text">
      <documentation>
        Block FQN for graph ops, or path start. (optional)
      </documentation>
    </graphFqn>
    <graphTo type="type:Text">
      <documentation>
        Path end FQN for graph path. (optional)
      </documentation>
    </graphTo>
    <depth type="type:Integer">
      <documentation>
        --depth: uses/used-by/neighbors hops (default 1); ancestors/descendants/path max hops (default 16); inspect expansion (0 allowed). members ignores --depth. (optional)
      </documentation>
    </depth>
    <inspectFqn type="type:Text">
      <documentation>
        Block FQN for inspect. (optional)
      </documentation>
    </inspectFqn>
    <executionFqn type="type:Text">
      <documentation>
        FQN of an Apply-source ModelTransformation for transform apply (pending, available, or template outside _meta.transform). (optional)
      </documentation>
    </executionFqn>
    <parametersJson type="type:Text">
      <documentation>
        Raw --parameters JSON value for transform apply. (optional)
      </documentation>
    </parametersJson>
    <parameterMappingsJson type="type:Text">
      <documentation>
        Raw --parameter-mappings JSON array for transform apply. (optional)
      </documentation>
    </parameterMappingsJson>
    <newFqn type="type:Text">
      <documentation>
        FQN for blockml new. (optional)
      </documentation>
    </newFqn>
    <newBaseType type="type:Text">
      <documentation>
        --baseType for blockml new. (optional)
      </documentation>
    </newBaseType>
    <newIs type="type:Text">
      <documentation>
        --is for blockml new. (optional)
      </documentation>
    </newIs>
    <initFqn type="type:Text">
      <documentation>
        Package FQN for blockml init. (optional)
      </documentation>
    </initFqn>
    <install type="type:Boolean">
      <documentation>
        --install: run npm install after package.json, Library, and README, and before AGENTS.md generation. (optional)
      </documentation>
    </install>
    <selectors type="type:Text[]">
      <documentation>
        Selector tokens for scan package|type. (optional)
      </documentation>
    </selectors>
    <help type="type:Boolean">
      <documentation>
        --help / -h: print help page and exit 0. (optional)
      </documentation>
    </help>
    <origin type="type:Text">
      <documentation>
        --origin: comma-separated workspace|dependency|unresolved filter for graph uses/used-by/neighbors. (optional)
      </documentation>
    </origin>
    <relation type="type:Text">
      <documentation>
        --relation: comma-separated GraphRelation filter for graph uses/used-by/neighbors. (optional)
      </documentation>
    </relation>
  </properties>
</cliapi:ParsedArgs>
