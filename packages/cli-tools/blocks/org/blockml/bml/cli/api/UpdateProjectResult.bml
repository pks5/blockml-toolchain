<!--CLI API — UpdateProjectResult
  FQN: org.blockml.bml.cli.api.UpdateProjectResult-->
<cliapi:UpdateProjectResult xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Exit code and messages from updateProject
  </is>
  <documentation>
    code 0 success, 1 npm install failure or package.json write failure,
    2 configuration error (missing package.json, no blockml key, unreadable
    package.json, dependency field that cannot hold the pin).
  </documentation>
  <properties>
    <code type="type:Integer">
      <documentation>
        Exit code 0|1|2. (required)
      </documentation>
    </code>
    <lines type="type:Text">
      <documentation>
        Structured lines with kind and uncolored text. Does not include USAGE. (required)
      </documentation>
    </lines>
  </properties>
</cliapi:UpdateProjectResult>
