<!--CLI API — WriteOutputOptions
  FQN: org.blockml.bml.cli.api.WriteOutputOptions-->
<cliapi:WriteOutputOptions xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Options for writeOutputFiles
  </is>
  <properties>
    <cleanOutDir type="type:Boolean">
      <documentation>
        When true, rmSync outDir before writing. Default true for compile. (optional)
      </documentation>
    </cleanOutDir>
    <rootFiles type="type:Text">
      <documentation>
        Additional files written beside outDir (e.g. XSD catalog.xml). (optional)
      </documentation>
    </rootFiles>
  </properties>
</cliapi:WriteOutputOptions>
