<!--CLI API — BomConfig
  FQN: org.blockml.bml.cli.api.BomConfig-->
<cliapi:BomConfig xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    blockml.config.json project configuration shape (CLI-owned subset)
  </is>
  <documentation>
    Fields the V1 CLI reads from blockml.config.json. Full schema in clidocumentation:Configuration.
  </documentation>
  <references>
    <see type="clidocumentation:Configuration" relation="SeeAlso" />
  </references>
  <properties>
    <outDir type="type:Text">
      <documentation>
        Output root. Default "blockdoc". (optional)
      </documentation>
    </outDir>
    <srcDir type="type:Text">
      <documentation>
        Source root. Default "blocks" (recommended BlockML source folder). (optional)
      </documentation>
    </srcDir>
    <libraries type="type:Text">
      <documentation>
        Extra Library.bml seeds; appended to package.json blockml.library. (optional)
      </documentation>
    </libraries>
    <targets type="type:Text">
      <documentation>
        Registry names to bootstrap. Default ["blockdoc"]. (optional)
      </documentation>
    </targets>
    <targetPackages type="type:Text">
      <documentation>
        Registry name → npm package for plugin load. (optional)
      </documentation>
    </targetPackages>
    <targetOptions type="type:Text">
      <documentation>
        Per-target opaque options keyed by registry name. (optional)
      </documentation>
    </targetOptions>
    <defaultTarget type="type:Text">
      <documentation>
        Default compile target when omitted. Default blockdoc. (optional)
      </documentation>
    </defaultTarget>
  </properties>
</cliapi:BomConfig>
