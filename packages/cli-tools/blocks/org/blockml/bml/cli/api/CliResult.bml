<!--CLI API — CliResult
  FQN: org.blockml.bml.cli.api.CliResult-->
<cliapi:CliResult xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Exit code and stderr output from runCli
  </is>
  <documentation>
    CLI18: code 0 success, 1 compiler errors, 2 configuration error.
  </documentation>
  <properties>
    <code type="type:Integer">
      <documentation>
        Process exit code. (required)
      </documentation>
    </code>
    <stderr type="type:Text">
      <documentation>
        Diagnostic lines joined with newlines. (required)
      </documentation>
    </stderr>
  </properties>
</cliapi:CliResult>
