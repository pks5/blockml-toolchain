<!--
  CLI API — CliBootstrapOptions
  FQN: org.blockml.bml.cli.api.CliBootstrapOptions
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>CliBootstrapOptions</name>
  <type>cliapi:CliBootstrapOptions</type>
  <baseType>cli:CliType</baseType>
  <is>Options for bootstrapProjectTypeRegistry</is>

  <properties>
    <config type="cliapi:BomConfig"><documentation>Loaded blockml.config.json. (required)</documentation></config>
    <rootDir type="type:Text"><documentation>Project root directory. (optional)</documentation></rootDir>
    <librariesOverride type="type:Text"><documentation>--libraries CLI override. (optional)</documentation></librariesOverride>
    <srcDirOverride type="type:Text"><documentation>--src CLI override. (optional)</documentation></srcDirOverride>
    <corpusPaths type="type:Text"><documentation>When set, used as corpus paths instead of [srcDir]. Validate passes project source roots. (optional)</documentation></corpusPaths>
  </properties>

</block>
