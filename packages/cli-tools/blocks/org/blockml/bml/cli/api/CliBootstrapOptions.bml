<!--CLI API — CliBootstrapOptions
  FQN: org.blockml.bml.cli.api.CliBootstrapOptions-->
<cliapi:CliBootstrapOptions xmlns="http://blockml.org/bml"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    cli:CliType
  </baseType>
  <is>
    Options for bootstrapProjectTypeRegistry
  </is>
  <properties>
    <config type="cliapi:BomConfig">
      <documentation>
        Loaded blockml.config.json. (required)
      </documentation>
    </config>
    <rootDir type="type:Text">
      <documentation>
        Project root directory. (optional)
      </documentation>
    </rootDir>
    <librariesOverride type="type:Text">
      <documentation>
        --libraries CLI override. (optional)
      </documentation>
    </librariesOverride>
    <srcDirOverride type="type:Text">
      <documentation>
        --src CLI override. (optional)
      </documentation>
    </srcDirOverride>
    <corpusPaths type="type:Text">
      <documentation>
        When set, used as corpus paths instead of [srcDir]. Validate passes project source roots. (optional)
      </documentation>
    </corpusPaths>
  </properties>
</cliapi:CliBootstrapOptions>
