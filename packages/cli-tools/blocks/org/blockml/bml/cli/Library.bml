<!--BlockML CLI Library
  FQN: org.blockml.bml.cli.Library-->
<cli:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:search="org.blockml.bml.search"
  xmlns:transformer="org.blockml.bml.transformer">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML universal CLI package library catalog
  </is>
  <version>
    0.9.11
  </version>
  <documentation>
    # The BlockML universal CLI package library catalog
    
    Canonical CLI specification for BlockML — commands, config, bootstrap order,
    target matrix, exit codes, terminal colors (CLI1–CLI24). TypeScript in packages/cli-tools/src/
    implements this library. Compiler facade and scope live in org.blockml.bml.compiler.runtime.*
    Framework bootstrap lives in org.blockml.bml.framework.*.
    Local search lives in org.blockml.bml.search.* (@blockml/search).
    Local graph lives in org.blockml.bml.graph.* (@blockml/graph).
    Inspect lives in org.blockml.bml.inspect.* (@blockml/inspect).
    Builder lives in org.blockml.bml.builder.* (@blockml/builder).
    Transformation lives in org.blockml.bml.transformer.* (@blockml/transformer).
    
    Membership is defined exclusively by this blocks list.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML CLI library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <cli:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <runtime:Library />
        <framework:Library />
        <builder:Library />
        <graph:Library />
        <inspect:Library />
        <search:Library />
        <transformer:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <cli:CliType />
        <cliapi:BomConfig />
        <cliapi:ParsedArgs />
        <cliapi:CliResult />
        <cliapi:WriteOutputOptions />
        <cliapi:CliBootstrapOptions />
        <cliconfig:CliConstants />
        <cliconfig:ExitCodes />
        <cliconfig:DefaultBomConfig />
        <cliconfig:CompileTargetMatrix />
        <cliconfig:CommandRegistry />
        <cliconfig:CliColorScheme />
        <clicommand:ValidateCommand />
        <clicommand:CompileCommand />
        <clicommand:SearchCommand />
        <clicommand:GraphCommand />
        <clicommand:InspectCommand />
        <clicommand:ScanCommand />
        <clicommand:TransformCommand />
        <clicommand:TransformApplyCommand />
        <clicommand:NewCommand />
        <clicommand:InitCommand />
        <clicap:LoadConfig />
        <clicap:ParseArgs />
        <clicap:FormatDiagnostic />
        <clicap:WriteCliOutput />
        <clicap:RunCli />
        <clicap:RunValidate />
        <clicap:RunSearch />
        <clicap:RunGraph />
        <clicap:RunInspect />
        <clicap:RunScan />
        <clicap:RunNew />
        <clicap:RunInit />
        <clicap:RunTransform />
        <clicap:ValidateAgainstXsd />
        <clicap:RunCompile />
        <clicap:RunCompileFatBlock />
        <clicap:BootstrapTargets />
        <clicap:RegisterTargetFactory />
        <clicap:BootstrapProjectTypeRegistry />
        <clicap:WriteOutputFiles />
        <clicap:DefaultOutDir />
        <clicap:WorkspaceRoot />
        <clidocumentation:Introduction />
        <clidocumentation:LayerSeparation />
        <clidocumentation:ArchitectureOverview />
        <clidocumentation:V1Scope />
        <clidocumentation:PublicApi />
        <clidocumentation:RuntimeBootstrap />
        <clidocumentation:Commands />
        <clidocumentation:Help />
        <clidocumentation:CompileCommand />
        <clidocumentation:ValidateCommand />
        <clidocumentation:SearchCommand />
        <clidocumentation:GraphCommand />
        <clidocumentation:InspectCommand />
        <clidocumentation:ScanCommand />
        <clidocumentation:NewCommand />
        <clidocumentation:InitCommand />
        <clidocumentation:TransformCommand />
        <clidocumentation:Configuration />
        <clidocumentation:TargetBootstrap />
        <clidocumentation:TargetCliMatrix />
        <clidocumentation:ExitCodesAndDiagnostics />
        <clidocumentation:DualCliModel />
        <clidocumentation:Installation />
        <clidocumentation:DesignDecisions />
        <clidocumentation:PackageOwnership />
        <clidocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>
</cli:Library>
