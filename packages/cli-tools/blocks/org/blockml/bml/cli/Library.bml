<!--
  BlockML CLI Library
  FQN: org.blockml.bml.cli.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>Library</name>
  <type>cli:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML universal CLI package library catalog</is>

  <documentation>
    Canonical CLI specification for BlockML — commands, config, bootstrap order,
    target matrix, exit codes (CLI1–CLI21). TypeScript in packages/cli-tools/src/
    implements this library. Compiler facade and scope live in org.blockml.bml.compiler.runtime.*
    Framework bootstrap lives in org.blockml.bml.framework.*.
    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.6.0</version>

  <language>
    <English />
  </language>

  <properties>
    <description>
      <value>BlockML CLI library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <cli:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
        <runtime:Library />
        <framework:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition><cli:CliType />
        <cliapi:BomConfig />
        <cliapi:ParsedArgs />
        <cliapi:CliResult />
        <cliapi:WriteOutputOptions />
        <cliapi:CliBootstrapOptions />
        <cliconfig:CliConstants />
        <cliconfig:ExitCodes />
        <cliconfig:DefaultBomConfig />
        <cliconfig:CompileTargetMatrix />
        <cliconfig:CommandRegistry />
        <clicommand:ValidateCommand />
        <clicommand:CompileCommand />
        <clicap:LoadConfig />
        <clicap:ParseArgs />
        <clicap:FormatDiagnostic />
        <clicap:RunCli />
        <clicap:RunValidate />
        <clicap:ValidateAgainstXsd />
        <clicap:RunCompile />
        <clicap:RunCompileFatBlock />
        <clicap:BootstrapTargets />
        <clicap:RegisterTargetFactory />
        <clicap:BootstrapProjectTypeRegistry />
        <clicap:WriteOutputFiles />
        <clicap:DefaultOutDir />
        <clicap:WorkspaceRoot />
        <clidocumentation:Introduction />
        <clidocumentation:LayerSeparation />
        <clidocumentation:ArchitectureOverview />
        <clidocumentation:V1Scope />
        <clidocumentation:PublicApi />
        <clidocumentation:RuntimeBootstrap />
        <clidocumentation:Commands />
        <clidocumentation:CompileCommand />
        <clidocumentation:ValidateCommand />
        <clidocumentation:Configuration />
        <clidocumentation:TargetBootstrap />
        <clidocumentation:TargetCliMatrix />
        <clidocumentation:ExitCodesAndDiagnostics />
        <clidocumentation:DualCliModel />
        <clidocumentation:Installation />
        <clidocumentation:DesignDecisions />
        <clidocumentation:PackageOwnership />
        <clidocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>

</block>
