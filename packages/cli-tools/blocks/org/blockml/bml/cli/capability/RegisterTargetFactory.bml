<!--CLI Capability — RegisterTargetFactory
  FQN: org.blockml.bml.cli.capability.RegisterTargetFactory-->
<clicap:RegisterTargetFactory xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Programmatic target registration for domain CLI hosts
  </is>
  <documentation>
    Hosts call registerTargetFactory(name, factory, hints?) before bootstrapTargets/runCli.
    Programmatic registration wins over config targetPackages plugin loading.
    Domain CLIs (e.g. @machineblocks/cli) register domain targets here — not in @blockml/cli builtins.
  </documentation>
  <references>
    <see type="clicap:BootstrapTargets" relation="SeeAlso" />
    <see type="clidocumentation:DualCliModel" relation="SeeAlso" />
  </references>
</clicap:RegisterTargetFactory>
