<!--CLI Capability — BootstrapTargets
  FQN: org.blockml.bml.cli.capability.BootstrapTargets-->
<clicap:BootstrapTargets xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Register render targets from config.targets[]
  </is>
  <documentation>
    # Register render targets from config.targets[]
    
    CLI3: async idempotent — second call no-op. CLI4: built-in factories blockdoc, xsd, fatblock; custom via registerTargetFactory or targetPackages plugin load. CLI5: unknown name in targets[] throws. Also registers requested target name for this run. resetBootstrapTargets clears registry.
  </documentation>
  <references>
    <see type="clidocumentation:TargetBootstrap" relation="SeeAlso" />
    <see type="cliconfig:CliConstants" relation="SeeAlso" />
  </references>
  <properties>
    <config type="cliapi:BomConfig">
      <documentation>
        Project config with targets[]. (required)
      </documentation>
    </config>
    <requested type="type:Text">
      <documentation>
        Target names needed for this invocation. (optional)
      </documentation>
    </requested>
  </properties>
</clicap:BootstrapTargets>
