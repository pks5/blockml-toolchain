<!--
  CLI Capability — WriteOutputFiles
  FQN: org.blockml.bml.cli.capability.WriteOutputFiles
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>WriteOutputFiles</name>
  <type>clicap:WriteOutputFiles</type>
  <baseType>core:Capability</baseType>
  <is>Write RenderOutput files to disk</is>

  <documentation>CLI7: when cleanOutDir true, rmSync outDir recursively before write. CLI8: rootFiles from RenderOutput.rootFiles (or options override) written relative to rootDir outside outDir (e.g. catalog.xml for xsd). Returns filesWritten and rootFilesWritten.</documentation>

  <references>
    <see type="clidocumentation:RuntimeBootstrap" relation="SeeAlso" />
  </references>

  <properties>
    <output type="type:Text">
      <documentation>RenderOutput with files[]. (required)</documentation>
    </output>
    <outDir type="type:Text">
      <documentation>Output directory relative to rootDir. (required)</documentation>
    </outDir>
    <rootDir type="type:Text">
      <documentation>Project root. (optional)</documentation>
    </rootDir>
    <options type="cliapi:WriteOutputOptions">
      <documentation>cleanOutDir and rootFiles. (optional)</documentation>
    </options>
  </properties>

</block>
