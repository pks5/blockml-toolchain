<!--CLI Capability — FormatDiagnostic
  FQN: org.blockml.bml.cli.capability.FormatDiagnostic-->
<clicap:FormatDiagnostic xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Format one diagnostic for CLI transcript
  </is>
  <documentation>
    CLI17: format severity code file:line — message. Empty source omits location.
    Output is uncolored text. WriteCliOutput applies CLI24 colors from severity.
  </documentation>
  <references>
    <see type="clidocumentation:ExitCodesAndDiagnostics" relation="SeeAlso" />
    <see type="clicap:WriteCliOutput" relation="SeeAlso" />
  </references>
  <properties>
    <diagnostic type="type:Text">
      <documentation>
        Diagnostic object with severity, code, message, optional source. (required)
      </documentation>
    </diagnostic>
    <result type="type:Text">
      <documentation>
        Single formatted line. (required)
      </documentation>
    </result>
  </properties>
</clicap:FormatDiagnostic>
