<!--
  CLI Capability — RunValidate
  FQN: org.blockml.bml.cli.capability.RunValidate
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>RunValidate</name>
  <type>clicap:RunValidate</type>
  <baseType>core:Capability</baseType>
  <is>Execute blockml validate command</is>

  <documentation>CLI10: file and --all together exit 2. CLI11: never writes render output.
    Registry is always full (resolve). Validate set: default = project sources (srcDir + local packages/*);
    --all = entire registry including npm; file = compileBmlToBom for that file.
    --verbose prints bootstrap sources then validate vs registry file lists before diagnostics.
    After CLI17 diagnostics, always print a status line:
    Validation succeeded|failed. Tested N block(s), M with errors, W warning(s), R recommendation(s).
    Block = unique filePath. XSD is not part of this command.</documentation>

  <references>
    <see type="clidocumentation:ValidateCommand" relation="SeeAlso" />
    <see type="clicommand:ValidateCommand" relation="SeeAlso" />
  </references>

  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>Parsed validate args. (required)</documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>Project root. (required)</documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>Exit code 0|1|2. (required)</documentation>
    </code>
  </properties>

</block>
