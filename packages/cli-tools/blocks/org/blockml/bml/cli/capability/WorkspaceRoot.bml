<!--CLI Capability — WorkspaceRoot
  FQN: org.blockml.bml.cli.capability.WorkspaceRoot-->
<clicap:WorkspaceRoot xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Find workspace root containing @blockml/core
  </is>
  <documentation>
    CLI15: walk up from rootDir until node_modules/@blockml/core exists; used for fatblock core Library seed path. Extra seed is omitted when package identity is already that library (same realpath or same Library type FQN).
  </documentation>
  <references>
    <see type="clicap:RunCompileFatBlock" relation="SeeAlso" />
  </references>
  <properties>
    <from type="type:Text">
      <documentation>
        Starting directory. (required)
      </documentation>
    </from>
    <result type="type:Text">
      <documentation>
        Workspace root path. (required)
      </documentation>
    </result>
  </properties>
</clicap:WorkspaceRoot>
