<!--CLI Capability — RunInit
  FQN: org.blockml.bml.cli.capability.RunInit-->
<clicap:RunInit xmlns="http://blockml.org/bml"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Execute blockml init command
  </is>
  <documentation>
    # Execute blockml init command
    
    Validates PACKAGE-FQN (dotted identifiers, contains a bml segment, last
    segment is not Library). Creates or merges package.json: blockml.library,
    devDependencies.@blockml/cli, dependencies.@blockml/core. Writes Library.bml
    and README.bml with BomBuilder.create (type-as-root, no xsi/schemaLocation)
    when missing. Copies AGENTS.md from the CLI templates directory and writes
    CLAUDE.md (@AGENTS.md) when missing. Does not load the TypeRegistry or
    blockml.config.json. Does not overwrite existing BML or agent files.
    
    Same library path already present → exit 0. Conflicting blockml.library →
    exit 2. Missing or invalid FQN → exit 2. --install runs npm install in
    rootDir after writes.
  </documentation>
  <references>
    <see type="clidocumentation:InitCommand" relation="SeeAlso" />
    <see type="clicommand:InitCommand" relation="SeeAlso" />
    <see type="buildercap:Create" relation="SeeAlso" />
  </references>
  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>
        Parsed init args. (required)
      </documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>
        Project root. (required)
      </documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>
        Exit code 0|1|2. (required)
      </documentation>
    </code>
  </properties>
</clicap:RunInit>
