<!--CLI Capability — WriteCliOutput
  FQN: org.blockml.bml.cli.capability.WriteCliOutput-->
<clicap:WriteCliOutput xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Print CLI lines with CLI24 colors and stdout/stderr routing
  </is>
  <documentation>
    # Print CLI lines with CLI24 colors and stdout/stderr routing
    
    CLI24: apply CliColorScheme and write lines. error and warning go to stderr;
    info, success, and recommendation go to stdout (so terminals that paint stderr red
    do not color normal status). Direct bin entry uses this; runCli returns an uncolored
    combined transcript in CliResult.stderr for programmatic callers.
  </documentation>
  <references>
    <see type="cliconfig:CliColorScheme" relation="SeeAlso" />
    <see type="clicap:RunCli" relation="SeeAlso" />
    <see type="clidocumentation:ExitCodesAndDiagnostics" relation="SeeAlso" />
  </references>
  <properties>
    <lines type="type:Text">
      <documentation>
        Structured lines with kind and uncolored text. (required)
      </documentation>
    </lines>
  </properties>
</clicap:WriteCliOutput>
