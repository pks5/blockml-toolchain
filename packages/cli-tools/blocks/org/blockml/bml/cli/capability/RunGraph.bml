<!--
  CLI Capability — RunGraph
  FQN: org.blockml.bml.cli.capability.RunGraph
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:type="org.blockml.bml.type">

  <name>RunGraph</name>
  <type>clicap:RunGraph</type>
  <baseType>core:Capability</baseType>
  <is>Execute blockml graph command</is>

  <documentation>
    # Execute blockml graph command

    graph index — rebuildIndex via @blockml/graph (full rebuild; --force is an alias).
    Other subcommands — openGraph (auto-build if missing/stale) then the named operation.

    Human output: FQN, relation, file:line. --json: GraphNeighbor[] / GraphNode[] / GraphPath / GraphQueryResult.
    Unknown FQN → exit 2 (same as inspect). path is outgoing-only; hops include direction.
    The index is exclusive; OpenIndex waits on a lock and retries Ladybug lock contention.
    Missing subcommand → exit 2.
  </documentation>

  <references>
    <see type="clidocumentation:GraphCommand" relation="SeeAlso" />
    <see type="clicommand:GraphCommand" relation="SeeAlso" />
    <see type="graphcap:OpenIndex" relation="SeeAlso" />
  </references>

  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>Parsed graph args. (required)</documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>Project root. (required)</documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>Exit code 0|1|2. (required)</documentation>
    </code>
  </properties>

</block>
