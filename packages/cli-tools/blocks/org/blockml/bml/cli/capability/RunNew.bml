<!--
  CLI Capability — RunNew
  FQN: org.blockml.bml.cli.capability.RunNew
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>RunNew</name>
  <type>clicap:RunNew</type>
  <baseType>core:Capability</baseType>
  <is>Execute blockml new command</is>

  <documentation>
    # Execute blockml new command

    Resolves the destination path from the owning Library (longest pkg.Library
    prefix in the TypeRegistry) or {srcDir}/{fqn-as-path}.bml. Creates the Block
    with BomBuilder.create, serializes, and writes the file. When a Library is
    found, edits Library.blocks to export the new FQN.

    Existing destination file → exit 1. Missing FQN → exit 2.
  </documentation>

  <references>
    <see type="clidocumentation:NewCommand" relation="SeeAlso" />
    <see type="clicommand:NewCommand" relation="SeeAlso" />
    <see type="buildercap:Create" relation="SeeAlso" />
  </references>

  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>Parsed new args. (required)</documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>Project root. (required)</documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>Exit code 0|1|2. (required)</documentation>
    </code>
  </properties>

</block>
