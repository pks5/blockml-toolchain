<!--CLI Capability — RunNew
  FQN: org.blockml.bml.cli.capability.RunNew-->
<clicap:RunNew xmlns="http://blockml.org/bml"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Execute blockml new command
  </is>
  <documentation>
    # Execute blockml new command
    
    Resolves the destination path from the owning Library (longest pkg.Library
    prefix in the TypeRegistry) or {srcDir}/{fqn-as-path}.bml. Creates the Block
    with BomBuilder.create (type-as-root, no xsi/schemaLocation), serializes, and
    writes the file. Membership is by location; the Library catalog is not edited.
    
    Existing destination file → exit 1. Missing FQN → exit 2.
  </documentation>
  <references>
    <see type="clidocumentation:NewCommand" relation="SeeAlso" />
    <see type="clicommand:NewCommand" relation="SeeAlso" />
    <see type="buildercap:Create" relation="SeeAlso" />
  </references>
  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>
        Parsed new args. (required)
      </documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>
        Project root. (required)
      </documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>
        Exit code 0|1|2. (required)
      </documentation>
    </code>
  </properties>
</clicap:RunNew>
