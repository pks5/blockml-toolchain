<!--CLI Capability — DefaultOutDir
  FQN: org.blockml.bml.cli.capability.DefaultOutDir-->
<clicap:DefaultOutDir xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Resolve default output directory for a target
  </is>
  <documentation>
    CLI13: xsd returns schemas; blockdoc returns config.outDir or blockdoc; fatblock returns . (invocation directory).
  </documentation>
  <properties>
    <target type="type:Text">
      <documentation>
        Registry name. (required)
      </documentation>
    </target>
    <config type="cliapi:BomConfig">
      <documentation>
        Project config. (required)
      </documentation>
    </config>
    <result type="type:Text">
      <documentation>
        Default outDir path. (required)
      </documentation>
    </result>
  </properties>
</clicap:DefaultOutDir>
