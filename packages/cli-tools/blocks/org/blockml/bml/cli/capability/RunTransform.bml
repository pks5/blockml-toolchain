<!--
  CLI Capability — RunTransform
  FQN: org.blockml.bml.cli.capability.RunTransform
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:type="org.blockml.bml.type">

  <name>RunTransform</name>
  <type>clicap:RunTransform</type>
  <baseType>core:Capability</baseType>
  <is>Execute blockml transform apply</is>

  <documentation>
    # Execute blockml transform apply

    Runs each ModelOperation of an Apply-source ModelTransformation (Prepare,
    then per operation: Running commit, registered executor, Reflect,
    Persist; then Finalize). The CLI supplies Claude Code workers for
    AgenticExecutor.
    Target library for `_meta` is --library (path to Library.bml) or,
    when omitted, cwd package.json blockml.library. Missing both → exit 2.
    The source FQN need not live under that library.
    Acquire an exclusive worktree lock first. If a transform is already
    running in this worktree, exit 2 immediately (no wait). Resolve/config/busy
    → exit 2. After a started execution, Finalize relocates to succeeded
    (exit 0) only when every ModelOperation succeeded and result resolution did
    not throw; otherwise failed (exit 1).
    Pending-contract violations do not start (exit 2). Missing FQN → exit 2.

    Lifecycle status and execute/reflect boundary lines always print.
    The complete line is followed by Elapsed … (total wall-clock time).
    --verbose streams each Claude Code session live to the terminal
    (thinking, tool calls, assistant text). Claude-specific; the Transformer
    API stays generic.
  </documentation>

  <references>
    <see type="clidocumentation:TransformCommand" relation="SeeAlso" />
    <see type="clicommand:TransformCommand" relation="SeeAlso" />
    <see type="clicommand:TransformApplyCommand" relation="SeeAlso" />
  </references>

  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>Parsed transform args, including optional --library. (required)</documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>Project root. (required)</documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>Exit code 0|1|2. (required)</documentation>
    </code>
  </properties>

</block>
