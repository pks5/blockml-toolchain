<!--
  CLI Capability — RunInspect
  FQN: org.blockml.bml.cli.capability.RunInspect
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:inspectcap="org.blockml.bml.inspect.capability"
  xmlns:type="org.blockml.bml.type">

  <name>RunInspect</name>
  <type>clicap:RunInspect</type>
  <baseType>core:Capability</baseType>
  <is>Execute blockml inspect command</is>

  <documentation>
    # Execute blockml inspect command

    inspect FQN — inspectProject via @blockml/inspect (validate --all corpus).
    Always prints InspectResult JSON. Missing FQN or unknown FQN → exit 2.
    Unknown FQN may print Did you mean …? when search finds a Block whose last segment matches.
    --help / -h print inspect usage and exit 0.
    --json is accepted and implied. Default depth 1.
  </documentation>

  <references>
    <see type="clidocumentation:InspectCommand" relation="SeeAlso" />
    <see type="clicommand:InspectCommand" relation="SeeAlso" />
    <see type="inspectcap:InspectBlock" relation="SeeAlso" />
  </references>

  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>Parsed inspect args. (required)</documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>Project root. (required)</documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>Exit code 0|2. (required)</documentation>
    </code>
  </properties>

</block>
