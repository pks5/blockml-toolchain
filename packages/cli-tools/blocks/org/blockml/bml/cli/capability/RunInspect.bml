<!--CLI Capability — RunInspect
  FQN: org.blockml.bml.cli.capability.RunInspect-->
<clicap:RunInspect xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:inspectcap="org.blockml.bml.inspect.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Execute blockml inspect command
  </is>
  <documentation>
    # Execute blockml inspect command
    
    inspect FQN — inspectProject via @blockml/inspect (validate --all corpus).
    Always prints InspectResult JSON. Missing FQN or unknown FQN → exit 2.
    Unknown FQN may print Did you mean …? when search finds a Block whose last segment matches, or when the token is a .bml path whose document-root FQN is in the corpus.
    --help / -h print inspect help page and exit 0. Missing FQN prints short USAGE.
    --json is accepted and implied. Default depth 1.
  </documentation>
  <references>
    <see type="clidocumentation:InspectCommand" relation="SeeAlso" />
    <see type="clicommand:InspectCommand" relation="SeeAlso" />
    <see type="inspectcap:InspectBlock" relation="SeeAlso" />
  </references>
  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>
        Parsed inspect args. (required)
      </documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>
        Project root. (required)
      </documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>
        Exit code 0|2. (required)
      </documentation>
    </code>
  </properties>
</clicap:RunInspect>
