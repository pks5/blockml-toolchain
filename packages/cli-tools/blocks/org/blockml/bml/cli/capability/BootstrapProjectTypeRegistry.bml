<!--CLI Capability — BootstrapProjectTypeRegistry
  FQN: org.blockml.bml.cli.capability.BootstrapProjectTypeRegistry-->
<clicap:BootstrapProjectTypeRegistry xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    CLI wrapper around framework bootstrapTypeRegistry
  </is>
  <documentation>
    CLI6: libraryPaths from resolveLibrarySeeds (package.json blockml.library then extras). Default paths=[srcDir]; validate passes corpusPaths=project source roots (srcDir plus local packages/*). Merges CLI overrides for --src and --libraries (extras only).
  </documentation>
  <references>
    <see type="clidocumentation:RuntimeBootstrap" relation="SeeAlso" />
  </references>
  <properties>
    <options type="cliapi:CliBootstrapOptions">
      <documentation>
        Bootstrap options. (required)
      </documentation>
    </options>
    <result type="type:Text">
      <documentation>
        BootstrapResult with registry and diagnostics. (required)
      </documentation>
    </result>
  </properties>
</clicap:BootstrapProjectTypeRegistry>
