<!--CLI Capability — RunCompile
  FQN: org.blockml.bml.cli.capability.RunCompile-->
<clicap:RunCompile xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Execute blockml compile for library/corpus targets
  </is>
  <documentation>
    # Execute blockml compile for library/corpus targets
    
    - CLI12: default target from config.defaultTarget or blockdoc. CLI13: per-target defaultOutDir hints (xsd schemas; blockdoc config.outDir or blockdoc; fatblock .). CLI16: scope auto with libraries[] or roots[srcDir]. CLI22: blockdoc without --src/--libraries uses project packages that declare blockml.library as corpus roots (all .bml under those packages). Bootstrap targets then compileToOutput; writeOutputFiles with cleanOutDir for corpus targets. Document-only targets use generic document compile path.
    - After CLI17 diagnostics, always print a status line:
    - Compilation succeeded. Wrote …  |  Compilation failed with K error(s).
    - No files and no error diagnostics → Compilation failed: no output files produced.
  </documentation>
  <references>
    <see type="clidocumentation:CompileCommand" relation="SeeAlso" />
    <see type="clicap:BootstrapTargets" relation="SeeAlso" />
    <see type="clicap:WriteOutputFiles" relation="SeeAlso" />
  </references>
  <properties>
    <parsed type="cliapi:ParsedArgs">
      <documentation>
        Parsed compile args. (required)
      </documentation>
    </parsed>
    <rootDir type="type:Text">
      <documentation>
        Project root. (required)
      </documentation>
    </rootDir>
    <code type="type:Integer">
      <documentation>
        Exit code 0|1|2. (required)
      </documentation>
    </code>
  </properties>
</clicap:RunCompile>
