<!--CLI — CliType
  FQN: org.blockml.bml.cli.CliType-->
<cli:CliType xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Entity
  </baseType>
  <is>
    Abstract marker for CLI implementation data-structure blocks
  </is>
  <documentation>
    All org.blockml.bml.cli.api|config|command.* types extend this marker. Distinct from core:Capability (operations).
  </documentation>
  <abstract>
    true
  </abstract>
</cli:CliType>
