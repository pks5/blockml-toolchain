<!--CLI Documentation — DualCliModel
  FQN: org.blockml.bml.cli.documentation.DualCliModel-->
<clidocumentation:DualCliModel xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Universal CLI vs domain host CLIs
  </is>
  <documentation>
    @blockml/cli (blockml) — universal toolchain CLI in this repo.
    validate · compile blockdoc|xsd|fatblock
    Domain-agnostic; no MachineBlocks hardcoding.
    
    @machineblocks/cli — thin MachineBlocks host (MachineBlocks mono-repo).
    Registers machineblocks-v3-scad target; MB defaults; recommended MB user entry.
    
    Interop: domain targets may be loadable as plugins later; product UX stays with domain CLI.
  </documentation>
  <references>
    <see type="clidocumentation:Installation" relation="ReadNext" />
  </references>
</clidocumentation:DualCliModel>
