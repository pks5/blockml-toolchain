<!--CLI Documentation — Commands
  FQN: org.blockml.bml.cli.documentation.Commands-->
<clidocumentation:Commands xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Command inventory
  </is>
  <documentation>
    V1 commands:
    • validate — parser + semantic validation; no target; no output files (CLI11)
    • compile — render target output; requires bootstrapped target
    • search — local full-text search over the validate --all corpus; search index rebuilds the cache
    • scan — packages or types matching PackageSelector / TypeSelector over the validate --all corpus
    • graph — local authored structural graph over the validate --all corpus; graph index rebuilds the cache
    • inspect — compact JSON inspect view of a Block FQN from the TypeRegistry (effective members, optional depth)
    • transform — parent command; apply executes a ModelTransformation via @blockml/transformer
    • new — create a Block .bml file via @blockml/builder under the owning Library
    • init — scaffold a BlockML project (package.json, Library + README, AGENTS.md)
    • agents-md — parent command; generate rewrites AGENTS.md from AgentInstructions blocks
    
    Planned commands (not V1): watch, activate-config.
    See cliconfig:CommandRegistry for implementation flags.
    Printed operator help: clidocumentation:Help (root) and each command documentation Printed help section.
  </documentation>
  <references>
    <see type="clidocumentation:Help" relation="ReadNext" />
    <see type="clidocumentation:CompileCommand" relation="SeeAlso" />
  </references>
</clidocumentation:Commands>
