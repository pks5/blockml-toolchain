<!--
  CLI Documentation — NewCommand
  FQN: org.blockml.bml.cli.documentation.NewCommand
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>NewCommand</name>
  <type>clidocumentation:NewCommand</type>
  <baseType>core:Documentation</baseType>
  <is>blockml new specification</is>

  <documentation><![CDATA[Syntax:
    blockml new FQN [--baseType FQN] [--is text] [--src dir] [--libraries a,b]

    Defaults: --baseType org.blockml.bml.core.Block; --is is the short name.
    Creates one .bml file via BomBuilder and adds a catalog child on the owning
    Library.bml when a pkg.Library prefix exists in the registry.
    Does not overwrite an existing file.

Printed help:
Usage: blockml new <fqn> [--baseType fqn] [--is text] [--src dir] [--libraries a,b]
       blockml new --help

When: create a new Block. Writes a .bml file and adds it to the owning Library catalog.

Defaults: --baseType org.blockml.bml.core.Block; --is is the short name.
Does not overwrite an existing file.
Prefer existing Blocks over new duplicates.

Related: inspect, validate.]]></documentation>
  <references>
    <see type="clidocumentation:Commands" relation="SeeAlso" />
    <see type="clicap:RunNew" relation="SeeAlso" />
  </references>

</block>
