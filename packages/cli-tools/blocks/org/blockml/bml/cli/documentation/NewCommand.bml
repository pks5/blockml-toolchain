<!--CLI Documentation — NewCommand
  FQN: org.blockml.bml.cli.documentation.NewCommand-->
<clidocumentation:NewCommand xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    blockml new specification
  </is>
  <documentation>
    <![CDATA[
    Syntax:
        blockml new FQN [--baseType FQN] [--is text] [--src dir] [--libraries a,b]
    
        Defaults: --baseType org.blockml.bml.core.Block; --is is the short name.
        Creates one .bml file via BomBuilder in the preferred type-as-root form
        (doc:DocumentFormat) without xmlns:xsi / xsi:schemaLocation, and adds a catalog
        child on the owning Library.bml when a pkg.Library prefix exists in the registry.
        Does not overwrite an existing file.
    
    Printed help:
    Usage: blockml new <fqn> [--baseType fqn] [--is text] [--src dir] [--libraries a,b]
           blockml new --help
    
    When: create a new Block. Writes a .bml file and adds it to the owning Library catalog.
    
    Defaults: --baseType org.blockml.bml.core.Block; --is is the short name.
    Does not overwrite an existing file.
    Prefer existing Blocks over new duplicates.
    
    Related: inspect, validate.
    ]]>
  </documentation>
  <references>
    <see type="clidocumentation:Commands" relation="SeeAlso" />
    <see type="clicap:RunNew" relation="SeeAlso" />
    <see type="doc:DocumentFormat" relation="SeeAlso" />
  </references>
</clidocumentation:NewCommand>
