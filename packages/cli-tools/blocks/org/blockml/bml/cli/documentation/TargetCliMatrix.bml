<!--CLI Documentation — TargetCliMatrix
  FQN: org.blockml.bml.cli.documentation.TargetCliMatrix-->
<clidocumentation:TargetCliMatrix xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Per-target CLI requirements
  </is>
  <documentation>
    CLI19 matrix (V1):
    
    blockdoc — file omit; --all ignored; default outDir blockdoc; without --src/--libraries: project packages with blockml.library as corpus (all .bml); else scope auto: libraries[] else roots[srcDir]
    xsd — file omit; --all ignored; default outDir schemas; may write root catalog.xml
    fatblock — file optional (default package.json blockml.library); --src optional
    (default host directory); --per-package one {hostFqn}.fat.bml per local library
    package, all written to the invocation directory (or --out)
    
    Planned machineblocks-v3-scad — document target; file required; --all loops srcDir;
    registered by domain CLI not @blockml/cli.
  </documentation>
  <references>
    <see type="clidocumentation:ExitCodesAndDiagnostics" relation="ReadNext" />
  </references>
</clidocumentation:TargetCliMatrix>
