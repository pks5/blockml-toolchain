<!--CLI Documentation — Installation
  FQN: org.blockml.bml.cli.documentation.Installation-->
<clidocumentation:Installation xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Building and linking the blockml command
  </is>
  <documentation>
    From this monorepo:
    npm install
    npm run build
    npm link
    
    blockml bin points to packages/cli-tools/dist/cli.js.
    Requires Node.js 20+.
    
    Consumer project (empty or existing npm repo):
    npx @blockml/cli init com.acme.bml
    npx blockml validate
    
    init runs npm install and generates AGENTS.md unless --no-install is passed.
    
    Existing BlockML project, move @blockml/cli and @blockml/core to this CLI:
    npx @blockml/cli update
    
    Domain users: install @machineblocks/cli from MachineBlocks mono-repo instead.
  </documentation>
  <references>
    <see type="clidocumentation:DesignDecisions" relation="ReadNext" />
  </references>
</clidocumentation:Installation>
