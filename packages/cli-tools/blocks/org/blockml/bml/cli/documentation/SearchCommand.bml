<!--
  CLI Documentation — SearchCommand
  FQN: org.blockml.bml.cli.documentation.SearchCommand
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>SearchCommand</name>
  <type>clidocumentation:SearchCommand</type>
  <baseType>core:Documentation</baseType>
  <is>blockml search specification</is>

  <documentation>Syntax:
    blockml search QUERY [--json] [--limit n] [--src dir] [--libraries a,b]
    blockml search index [--force] [--src dir] [--libraries a,b]

    QUERY may be multiple unquoted tokens. The sole positional token "index" is the rebuild subcommand.

    Search uses the same corpus as validate --all (@blockml/search / bootstrapFullProjectRegistry).
    Missing or stale .blockml/search/ is rebuilt automatically before a query.
    --json prints SearchResult[] (fqn, name, file, score, library?).
    Human lines: score, FQN, relative file path.</documentation>
  <references>
    <see type="clidocumentation:Commands" relation="SeeAlso" />
    <see type="clicap:RunSearch" relation="SeeAlso" />
  </references>

</block>
