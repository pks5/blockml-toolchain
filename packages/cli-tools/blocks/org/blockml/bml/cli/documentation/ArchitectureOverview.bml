<!--CLI Documentation — ArchitectureOverview
  FQN: org.blockml.bml.cli.documentation.ArchitectureOverview-->
<clidocumentation:ArchitectureOverview xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Module map and command flow
  </is>
  <documentation>
    Entry: clicap:RunCli (runCli) → ParseArgs → dispatch.
    
    validate flow: LoadConfig → BootstrapProjectTypeRegistry (full registry) →
    compileBmlToBom (file) or validateRegistryDocuments (project sources, or entire registry with --all).
    
    compile flow (library/corpus): LoadConfig → BootstrapTargets → BootstrapProjectTypeRegistry
    → compileToOutput(scope auto) → WriteOutputFiles.
    
    compile flow (fatblock): LoadConfig → BootstrapTargets → project library graph
    plus core Library and srcDir corpus → compileToOutput(document) → write
    {hostFqn}.fat.bml at the invocation directory.
    
    TypeScript module map:
    • cli.ts → RunCli, ParseArgs, RunValidate, RunCompile, RunCompileFatBlock, RunSearch, RunScan, RunGraph, RunInspect, RunNew, RunTransform, FormatDiagnostic
    • load-config.ts → LoadConfig, api/BomConfig
    • bootstrap-targets.ts → BootstrapTargets
    • bootstrap-type-registry.ts → BootstrapProjectTypeRegistry
    • project-sources.ts → project source roots for default validate; project library package roots for default blockdoc
    • run-search.ts → RunSearch
    • run-scan.ts → RunScan
    • run-graph.ts → RunGraph
    • run-inspect.ts → RunInspect
    • run-new.ts → RunNew
    • run-transform.ts → RunTransform
    • write-output.ts → WriteOutputFiles
  </documentation>
  <references>
    <see type="clidocumentation:V1Scope" relation="ReadNext" />
  </references>
</clidocumentation:ArchitectureOverview>
