<!--
  CLI Documentation — ValidateCommand
  FQN: org.blockml.bml.cli.documentation.ValidateCommand
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ValidateCommand</name>
  <type>clidocumentation:ValidateCommand</type>
  <baseType>core:Documentation</baseType>
  <is>blockml validate specification</is>

  <documentation>Syntax:
    blockml validate [file] [--all] [--src dir] [--libraries a,b] [--no-xsd]

    Single file: parse + compileBmlToBom against project registry.
    --all or corpus: bootstrapProjectTypeRegistry + validateRegistryDocuments.

    After Stage 1–2, optional XSD validation against local bml.xsd (default on).
    Disable with --no-xsd or bom.config.json xsdValidation: false (--no-xsd wins).
    Missing catalog.xml or schemas → warning BML_XSD_SCHEMAS_MISSING; XSD step skipped.

    file and --all together → exit 2 (CLI10).
    No target bootstrap. No output files written (CLI11).
    Exit 0 on success; 1 on diagnostic errors; 2 on config errors.</documentation>
  <references>
    <see type="clidocumentation:Configuration" relation="ReadNext"></see>
    <see type="clicap:ValidateAgainstXsd" relation="SeeAlso" />
  </references>

</block>
