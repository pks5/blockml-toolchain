<!--CLI Documentation — ExitCodesAndDiagnostics
  FQN: org.blockml.bml.cli.documentation.ExitCodesAndDiagnostics-->
<clidocumentation:ExitCodesAndDiagnostics xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Exit codes and diagnostic formatting
  </is>
  <documentation>
    CLI18 exit codes:
    • 0 — success
    • 1 — compiler/parser/validator errors (diagnostics with severity error)
    • 2 — configuration error (unknown command, missing file, unsupported target, bootstrap failure)
      or uncaught Internal CLI error (application failure, not a BML diagnostic)
    
    CLI17 diagnostic format: severity code file:line — message (uncolored text).
    Printed first. Then a status line:
    validate — Validation succeeded|failed. Tested N block(s), M with errors, W warning(s), R recommendation(s).
    compile — Compilation succeeded. Wrote …  |  Compilation failed with K error(s).
    transform — Transformed SUCCEEDED-FQN then Elapsed …  |  resolve/config error (exit 2) or failed execution (exit 1, FAILED-FQN, Elapsed …).
    Uncaught exception — Internal CLI error: message (exit 2; no stack dump).
    runCli joins uncolored lines with newlines in CliResult.stderr.
    Direct bin entry uses WriteCliOutput (CLI24): red error, yellow warning,
    blue recommendation, default/white info, green success. error and warning
    write to stderr; info, success, and recommendation write to stdout.
  </documentation>
  <references>
    <see type="clidocumentation:DualCliModel" relation="ReadNext" />
    <see type="cliconfig:CliColorScheme" relation="SeeAlso" />
    <see type="clicap:WriteCliOutput" relation="SeeAlso" />
  </references>
</clidocumentation:ExitCodesAndDiagnostics>
