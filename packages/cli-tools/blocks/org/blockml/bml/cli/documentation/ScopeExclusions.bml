<clidocumentation:ScopeExclusions xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Explicitly out of V1 CLI library scope
  </is>
  <documentation>
    Not V1 in this package (may exist in MD vision only):
    • watch, activate-config commands
    • bom-cli.config.json command renaming
    • Incremental build cache .bom-cache/ (C5)
    • Thumbnail generation OpenSCAD+Sharp (C6)
    • resolveOpenScad.ts, resolveMbLib.ts
    • --force flag for compile cache skip
    • machineblocks-v3-scad target registration
    • Config profiles (activeConfig)
    • Codegen from BML to TypeScript (structural SSOT only in V1)
  </documentation>
</clidocumentation:ScopeExclusions>
