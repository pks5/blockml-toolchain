<!--
  CLI Documentation — DesignDecisions
  FQN: org.blockml.bml.cli.documentation.DesignDecisions
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>DesignDecisions</name>
  <type>clidocumentation:DesignDecisions</type>
  <baseType>core:Documentation</baseType>
  <is>Normative CLI decisions CLI1–CLI24</is>

  <documentation>
    # Normative CLI decisions CLI1–CLI24

    - CLI1 missing blockml.config.json → DefaultBomConfig.
    - CLI2 empty targets[] → ["blockdoc"].
    - CLI3 bootstrapTargets idempotent.
    - CLI4 TARGET_FACTORIES blockdoc/xsd/fatblock.
    - CLI5 unknown target name throws.
    - CLI6 registry bootstrap: identity seed (blockml.library) plus config/--libraries extras; compile paths=[srcDir] or blockdoc default project library roots (CLI22); validate corpusPaths=project source roots.
    - CLI7 writeOutputFiles cleanOutDir rmSync.
    - CLI8 rootFiles beside rootDir (XSD catalog).
    - CLI9 parseArgs flag and positional rules. Transform apply accepts
      --parameters JSON and --parameters-source PATH.
    - CLI10 validate file XOR --all. Default validate = project sources; --all = entire registry.
    - CLI11 validate never writes render output.
    - CLI12 default compile target blockdoc.
    - CLI13 defaultOutDir xsd→schemas; blockdoc→config.outDir/blockdoc; fatblock→. (invocation directory).
    - CLI14 fatblock without file/--src defaults to package.json blockml.library as host and that library directory as src; missing both file and library → exit 2.
    - CLI15 fatblock TypeRegistry from package.json blockml.library graph plus core Library (omitted when identity is already that library by realpath or FQN) and srcDir corpus.
    - CLI16 compile scope auto libraries or roots.
    - CLI17 formatDiagnostic line format.
    - CLI18 runCli exit code matrix.
    - CLI19 target CLI matrix blockdoc/xsd/fatblock.
    - CLI20 validate skips bootstrapTargets.
    - CLI21 bin entry uses realpath so npm .bin/blockml symlink invokes runCli.
    - CLI22 blockdoc without --src/--libraries scans cwd + packages/* for blockml.library and documents all .bml under those packages (corpus roots; TypeRegistry may still hold identity seeds for type resolution).
    - CLI23 fatblock --per-package writes one {hostFqn}.fat.bml per local package.json blockml.library (this package and packages/*) into the invocation directory; incompatible with host file, --src, and non-fatblock targets; --out overrides that directory.
    - CLI24 terminal colors: red error, yellow warning, blue recommendation, default/white info, green success. error/warning → stderr; info/success/recommendation → stdout. runCli transcript stays uncolored.
  </documentation>
  <references>
    <see type="clidocumentation:PackageOwnership" relation="ReadNext" />
  </references>

</block>
