<!--
  CLI Documentation — PublicApi
  FQN: org.blockml.bml.cli.documentation.PublicApi
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>PublicApi</name>
  <type>clidocumentation:PublicApi</type>
  <baseType>core:Documentation</baseType>
  <is>Exported TypeScript / capability surface</is>

  <documentation>Package @blockml/cli exports:
    • runCli(argv, cwd?) → Promise&lt;{ code, stderr }&gt;
    • parseArgs(argv) → ParsedArgs
    • formatDiagnostic(d) → string
    • loadConfig(cwd?) → BomConfig
    • bootstrapTargets(config, requested?, rootDir?) → Promise&lt;void&gt;
    • registerTargetFactory(name, factory, hints?)
    • getTargetCliHints(name) → TargetCliHints | undefined
    • getTargetFactory(name) → factory | undefined
    • builtinTargetNames() → string[]
    • resetBootstrapTargets()
    • bootstrapProjectTypeRegistry(options) → BootstrapResult
    • writeOutputFiles(output, outDir, rootDir?, options?) → WriteOutputResult
    • loadTargetFromPackage / resolveTargetPackage / isBuiltinTarget (plugin loader)

    Bin: blockml → dist/cli.js (direct run invokes runCli).

    BML counterparts: clicap:RunCli, ParseArgs, LoadConfig, BootstrapTargets,
    RegisterTargetFactory, BootstrapProjectTypeRegistry, WriteOutputFiles.</documentation>
  <references>
    <see type="clidocumentation:RuntimeBootstrap" relation="ReadNext"></see>
    <see type="clicap:RunCli" relation="Defines"></see>
    <see type="cliapi:BomConfig" relation="Defines"></see>
    <see type="cliapi:ParsedArgs" relation="Defines"></see>
  </references>

</block>
