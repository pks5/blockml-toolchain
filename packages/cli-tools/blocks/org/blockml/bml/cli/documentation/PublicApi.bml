<!--CLI Documentation — PublicApi
  FQN: org.blockml.bml.cli.documentation.PublicApi-->
<clidocumentation:PublicApi xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Exported TypeScript / capability surface
  </is>
  <documentation>
    <![CDATA[
    Package @blockml/cli exports:
    • runCli(argv, cwd?) → Promise<{ code, stderr }>
    • parseArgs(argv) → ParsedArgs
    • formatDiagnostic(d) → string
    • writeCliOutput(lines) — CLI24 colored bin printer
    • loadConfig(cwd?) → BomConfig
    • bootstrapTargets(config, requested?, rootDir?) → Promise<void>
    • registerTargetFactory(name, factory, hints?)
    • getTargetCliHints(name) → TargetCliHints | undefined
    • getTargetFactory(name) → factory | undefined
    • builtinTargetNames() → string[]
    • resetBootstrapTargets()
    • bootstrapProjectTypeRegistry(options) → BootstrapResult
    • runSearch via blockml search (delegates to @blockml/search)
    • runGraph via blockml graph (delegates to @blockml/graph)
    • runInspect via blockml inspect (delegates to @blockml/inspect)
    • runNew via blockml new (delegates to @blockml/builder)
    • runTransform via blockml transform apply (delegates to @blockml/transformer)
    • writeOutputFiles(output, outDir, rootDir?, options?) → WriteOutputResult
    • loadTargetFromPackage / resolveTargetPackage / isBuiltinTarget (plugin loader)
    
    Bin: blockml → dist/cli.js (direct run invokes WriteCliOutput after executeCli;
    CLI21 realpath so node_modules/.bin/blockml symlink matches).
    
    BML counterparts: clicap:RunCli, ParseArgs, LoadConfig, BootstrapTargets,
    RegisterTargetFactory, BootstrapProjectTypeRegistry, WriteOutputFiles,
    WriteCliOutput, FormatDiagnostic.
    ]]>
  </documentation>
  <references>
    <see type="clidocumentation:RuntimeBootstrap" relation="ReadNext" />
    <see type="clicap:RunCli" relation="Defines" />
    <see type="cliapi:BomConfig" relation="Defines" />
    <see type="cliapi:ParsedArgs" relation="Defines" />
  </references>
</clidocumentation:PublicApi>
