<!--CLI Documentation — TargetBootstrap
  FQN: org.blockml.bml.cli.documentation.TargetBootstrap-->
<clidocumentation:TargetBootstrap xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:cliapi="org.blockml.bml.cli.api"
  xmlns:clicap="org.blockml.bml.cli.capability"
  xmlns:clicommand="org.blockml.bml.cli.command"
  xmlns:cliconfig="org.blockml.bml.cli.config"
  xmlns:clidocumentation="org.blockml.bml.cli.documentation"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    targets[] and registerTarget wiring (C3)
  </is>
  <documentation>
    CLI3: bootstrapTargets is async idempotent (bootstrapped flag).
    CLI4: V1 built-ins — blockdoc → BlockDocTarget, xsd → XsdTarget, fatblock → FatBlockTarget.
    CLI5: unknown name in targets[] throws configuration error.
    Custom targets: registerTargetFactory (host API) or targetPackages plugin load.
    
    config.targets[] defines available targets; CLI target argument selects which to compile.
    Default targets when omitted: ["blockdoc"].
    
    validate and inspect do NOT call bootstrapTargets.
    Domain targets (machineblocks-v3-scad) registered by @machineblocks/cli — not this package.
  </documentation>
  <references>
    <see type="clidocumentation:TargetCliMatrix" relation="ReadNext" />
  </references>
</clidocumentation:TargetBootstrap>
