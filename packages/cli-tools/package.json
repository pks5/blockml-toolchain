{
  "name": "@blockml/cli",
  "version": "0.7.1",
  "description": "BlockML CLI — validate and compile BML (blockdoc, xsd, fatblock)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/cli-tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "blockml": "./dist/cli.js"
  },
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/cli/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@blockml/blockdoc-target": "^0.7.1",
    "@blockml/fatblock-target": "^0.7.1",
    "@blockml/xsd-target": "^0.7.1",
    "@blockml/compiler": "^0.7.1",
    "@blockml/core": "^1.0.5",
    "@blockml/framework": "^0.7.1",
    "libxmljs2": "^0.35.0"
  },
  "engines": {
    "node": ">=20"
  }
}
