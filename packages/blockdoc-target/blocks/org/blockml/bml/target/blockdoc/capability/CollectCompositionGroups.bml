<!--BlockDoc Capability — CollectCompositionGroups
  FQN: org.blockml.bml.target.blockdoc.capability.CollectCompositionGroups-->
<bdcap:CollectCompositionGroups xmlns="http://blockml.org/bml"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Ordered composition groups with dedupe
  </is>
  <documentation>
    BD18: first block.compositions (dedupe by aggregationName), then aggregation members with composition (dedupe by member name).
  </documentation>
  <references>
    <see type="bddocumentation:MemberAndCompositionRules" relation="SeeAlso" />
  </references>
  <properties>
    <block type="bomblock:BlockDefinition">
      <documentation>
        Block definition (required).
      </documentation>
    </block>
    <result type="type:Text">
      <documentation>
        Ordered {aggregationName, composition} list (required).
      </documentation>
    </result>
  </properties>
</bdcap:CollectCompositionGroups>
