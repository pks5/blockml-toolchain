<!--BlockDoc Capability — CollectRootFqns
  FQN: org.blockml.bml.target.blockdoc.capability.CollectRootFqns-->
<bdcap:CollectRootFqns xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Root FQN per source file (shortest FQN)
  </is>
  <documentation>
    BD11: group TypeRegistry keys by doc.source.filePath; keep shortest FQN per file; sort. Nested Parent.Child are pages but not package-index Block entries.
  </documentation>
  <references>
    <see type="bddocumentation:SiteAssembly" relation="SeeAlso" />
  </references>
  <properties>
    <typeRegistry type="type:Text">
      <documentation>
        TypeRegistry (required).
      </documentation>
    </typeRegistry>
    <result type="type:Text">
      <documentation>
        Sorted root FQN list (required).
      </documentation>
    </result>
  </properties>
</bdcap:CollectRootFqns>
