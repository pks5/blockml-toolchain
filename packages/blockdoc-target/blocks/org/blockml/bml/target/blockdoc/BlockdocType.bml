<!--BlockDoc — BlockdocType
  FQN: org.blockml.bml.target.blockdoc.BlockdocType-->
<blockdoc:BlockdocType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for BlockDoc implementation data-structure blocks
  </is>
  <documentation>
    All org.blockml.bml.target.blockdoc.api|config|path|page|render.* types extend this marker. Distinct from bom:UrmodellType (parse-result data) and core:Capability (operations).
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>
</blockdoc:BlockdocType>
