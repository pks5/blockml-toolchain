<!--BlockDoc Capability — RenderDottedPackagePath
  FQN: org.blockml.bml.target.blockdoc.capability.RenderDottedPackagePath-->
<bdcap:RenderDottedPackagePath xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Package FQN as dotted linked segments
  </is>
  <documentation>
    BD20: each segment linked — if prefix is known block FQN → block page; else package index. Joined with '.' (no spaces).
  </documentation>
  <references>
    <see type="bddocumentation:PageChrome" relation="SeeAlso" />
  </references>
  <properties>
    <packageFqn type="type:Text">
      <documentation>
        Package prefix (required).
      </documentation>
    </packageFqn>
    <pagePath type="type:Text">
      <documentation>
        Current page path (required).
      </documentation>
    </pagePath>
    <options type="bdapi:BlockDocOptions">
      <documentation>
        Resolved options (required).
      </documentation>
    </options>
    <knownFqns type="type:Text">
      <documentation>
        Set of linkable FQNs (required).
      </documentation>
    </knownFqns>
    <result type="bdrender:DocMarkup">
      <documentation>
        HTML fragment (required).
      </documentation>
    </result>
  </properties>
</bdcap:RenderDottedPackagePath>
