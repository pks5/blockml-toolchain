<!--BlockDoc Page — SiteIndexPage
  FQN: org.blockml.bml.target.blockdoc.page.SiteIndexPage-->
<bdpage:SiteIndexPage xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    HTML template model for the All Blocks listing
  </is>
  <documentation>
    # HTML template model for the All Blocks listing
    
    Emitted as all-blocks.html (merged) or {libraryPrefix}/all-blocks.html (perLibrary). Title "BlockDoc" (merged) or "{libraryPrefix} — BlockDoc" (perLibrary). Lists only root FQNs. One library: grouped by package prefix. Multiple libraries: grouped by library then package (BD21). Includes sticky toolbar (BD25) with Index → interesting home and All Blocks → this page.
  </documentation>
  <properties>
    <title type="type:Text">
      <documentation>
        Page h1 / title. (required)
      </documentation>
    </title>
    <html type="type:Text">
      <documentation>
        Full HTML document string. (required)
      </documentation>
    </html>
  </properties>
</bdpage:SiteIndexPage>
