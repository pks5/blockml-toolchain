<!--
  BlockDoc Capability — RenderComposition
  FQN: org.blockml.bml.target.blockdoc.capability.RenderComposition
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <name>RenderComposition</name>
  <type>bdcap:RenderComposition</type>
  <baseType>core:Capability</baseType>
  <is>Composition tree → nested HTML lists</is>

  <documentation>BD14/BD19: blockInstance → linked type; optional id= from literal/expression/address; members: keys (≤5 else +N more). Containers → directive summary (each vars | if | unless | with names | 'container') + nested ul.</documentation>

  <references>
    <see type="bddocumentation:MemberAndCompositionRules" relation="SeeAlso" />
  </references>

  <properties>
    <aggregationName type="type:Text">
      <documentation>Group heading (required).</documentation>
    </aggregationName>
    <composition type="bomcomp:CompositionTemplate">
      <documentation>Composition template (required).</documentation>
    </composition>
    <pagePath type="type:Text">
      <documentation>Current page path (required).</documentation>
    </pagePath>
    <options type="bdapi:BlockDocOptions">
      <documentation>Resolved options (required).</documentation>
    </options>
    <knownFqns type="type:Text">
      <documentation>Set of linkable FQNs (required).</documentation>
    </knownFqns>
    <result type="bdrender:DocMarkup">
      <documentation>HTML section or empty (required).</documentation>
    </result>
  </properties>

</block>
