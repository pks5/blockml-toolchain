<!--BlockDoc Capability — RenderComposition
  FQN: org.blockml.bml.target.blockdoc.capability.RenderComposition-->
<bdcap:RenderComposition xmlns="http://blockml.org/bml"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Composition tree → nested HTML lists
  </is>
  <documentation>
    BD14/BD19: blockInstance → linked type; optional id= from literal/expression/address; members: keys (≤5 else +N more). Containers → directive summary (each vars | if | unless | with names | 'container') + nested ul.
  </documentation>
  <references>
    <see type="bddocumentation:MemberAndCompositionRules" relation="SeeAlso" />
  </references>
  <properties>
    <aggregationName type="type:Text">
      <documentation>
        Group heading (required).
      </documentation>
    </aggregationName>
    <composition type="bomcomp:CompositionTemplate">
      <documentation>
        Composition template (required).
      </documentation>
    </composition>
    <pagePath type="type:Text">
      <documentation>
        Current page path (required).
      </documentation>
    </pagePath>
    <options type="bdapi:BlockDocOptions">
      <documentation>
        Resolved options (required).
      </documentation>
    </options>
    <knownFqns type="type:Text">
      <documentation>
        Set of linkable FQNs (required).
      </documentation>
    </knownFqns>
    <result type="bdrender:DocMarkup">
      <documentation>
        HTML section or empty (required).
      </documentation>
    </result>
  </properties>
</bdcap:RenderComposition>
