<!--
  BlockDoc Capability — AssembleSite
  FQN: org.blockml.bml.target.blockdoc.capability.AssembleSite
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <name>AssembleSite</name>
  <type>bdcap:AssembleSite</type>
  <baseType>core:Capability</baseType>
  <is>Orchestrate full multi-file site emission</is>

  <documentation>BD23/BD24/BD27: emit one HTML per selected FQN (nested via findBlock on subBlocks);
    emit all-blocks.html (BD21 listing); merged + fqn → index.html redirects to
    FirstInterestingPackagePrefix (or virtual root package index when empty); perLibrary →
    {libPrefix}/all-blocks.html (libPrefix = Library type with .Library stripped); if outLayout=fqn
    emit package indexes for all prefixes; emit search-index.json and search.js for every block page.</documentation>

  <references>
    <see type="bddocumentation:SiteAssembly" relation="SeeAlso" />
    <see type="bdcap:Render" relation="SeeAlso" />
    <see type="bdcap:BuildSearchIndex" relation="SeeAlso" />
    <see type="bdcap:FirstInterestingPackagePrefix" relation="SeeAlso" />
  </references>

  <properties>
    <request type="type:Text">
      <documentation>CompileRequest with targetOptions (required).</documentation>
    </request>
    <typeRegistry type="type:Text">
      <documentation>TypeRegistry (required).</documentation>
    </typeRegistry>
    <libraryPaths type="type:Text">
      <documentation>Library paths from session (optional).</documentation>
    </libraryPaths>
    <result type="bdapi:BlockDocRenderOutput">
      <documentation>files[] (required).</documentation>
    </result>
  </properties>

</block>
