<!--BlockDoc Documentation — PackageOwnership
  FQN: org.blockml.bml.target.blockdoc.documentation.PackageOwnership-->
<bddocumentation:PackageOwnership xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Who owns BlockDoc vs host toolchain
  </is>
  <documentation>
    @blockml/blockdoc-target owns: this BML library; TypeScript implementation; behavioral tests;
    BlockDocOptions; HTML layout and link algorithms; registry identity blockdoc.
    
    @blockml/compiler owns: RenderTarget contract; CompileRequest/CompileOptions; Target Registry;
    compileToOutput; scope kind resolution for auto.
    
    @blockml/cli owns: bootstrapTargets / targets[] default ["blockdoc"]; writing files under
    outDir (default blockdoc/); CLI usage strings and exit codes.
    
    @blockml/bom owns: Urmodell types consumed by render helpers.
    
    MachineBlocks / domain targets are out of scope for this repo.
  </documentation>
  <references>
    <see type="bddocumentation:ScopeExclusions" relation="ReadNext" />
  </references>
</bddocumentation:PackageOwnership>
