<!--BlockDoc Capability — Render
  FQN: org.blockml.bml.target.blockdoc.capability.Render-->
<bdcap:Render xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Public RenderTarget entry: compile request → HTML site
  </is>
  <documentation>
    Registry name blockdoc. accepts: library, corpus, auto. Does not fail on Stage-2 semantic gaps (control gate). Orchestrates ResolveOptions + AssembleSite. No validateRequest.
  </documentation>
  <references>
    <see type="bddocumentation:PublicApi" relation="SeeAlso" />
    <see type="bdapi:BlockDocOptions" relation="SeeAlso" />
    <see type="bdcap:AssembleSite" relation="SeeAlso" />
  </references>
  <properties>
    <request type="type:Text">
      <documentation>
        CompileRequest (required).
      </documentation>
    </request>
    <renderContext type="type:Text">
      <documentation>
        RenderContext / session (required).
      </documentation>
    </renderContext>
    <result type="bdapi:BlockDocRenderOutput">
      <documentation>
        Multi-file output (required).
      </documentation>
    </result>
  </properties>
</bdcap:Render>
