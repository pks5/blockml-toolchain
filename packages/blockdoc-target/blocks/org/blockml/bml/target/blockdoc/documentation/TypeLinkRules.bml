<!--BlockDoc Documentation — TypeLinkRules
  FQN: org.blockml.bml.target.blockdoc.documentation.TypeLinkRules-->
<bddocumentation:TypeLinkRules xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    TypeExpression summary and link policy (BD15)
  </is>
  <documentation>
    Summary syntax:
    • named: fqn + optional type-args + optional [min..max] multiplicity
    • union: a | b
    • Self; generic param name; anonymous { f: T, … }
    
    Link policy:
    • Link only if knownFqns.has(fqn) for named expressions; else escaped plain text
    • Named: link the fqn, append escaped suffix (type args / multiplicity)
    • Unions / anonymous / self / generic: no links — escaped summary only
    • Missing expression → em dash (—)
    
    Sub-block pages always link to sub.type paths (not gated on knownFqns) — see PageChrome.
  </documentation>
  <references>
    <see type="bddocumentation:MemberAndCompositionRules" relation="ReadNext" />
    <see type="bdcap:RenderTypeExpression" relation="SeeAlso" />
  </references>
</bddocumentation:TypeLinkRules>
