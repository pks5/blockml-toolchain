<!--BlockDoc API — SearchIndex
  FQN: org.blockml.bml.target.blockdoc.api.SearchIndex-->
<bdapi:SearchIndex xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    Site-root search-index.json document
  </is>
  <documentation>
    BD24: emitted as search-index.json at the site root. Same block list is inlined into search.js so quick search works without fetch (file://).
  </documentation>
  <references>
    <see type="bdapi:SearchIndexEntry" relation="SeeAlso" />
    <see type="bdcap:BuildSearchIndex" relation="SeeAlso" />
  </references>
  <properties>
    <blocks type="bdapi:SearchIndexEntry">
      <documentation>
        Indexed blocks, one per emitted block page (required).
      </documentation>
    </blocks>
  </properties>
</bdapi:SearchIndex>
