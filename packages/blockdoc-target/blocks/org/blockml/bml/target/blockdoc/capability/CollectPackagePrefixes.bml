<!--BlockDoc Capability — CollectPackagePrefixes
  FQN: org.blockml.bml.target.blockdoc.capability.CollectPackagePrefixes-->
<bdcap:CollectPackagePrefixes xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    All ancestor package prefixes of root FQN packages
  </is>
  <documentation>
    BD12: for each root FQN package prefix, add every ancestor prefix (1..n segments). Used to emit package indexes when outLayout=fqn.
  </documentation>
  <references>
    <see type="bddocumentation:PathAndLayout" relation="SeeAlso" />
  </references>
  <properties>
    <rootFqns type="type:Text">
      <documentation>
        Root FQN list (required).
      </documentation>
    </rootFqns>
    <result type="type:Text">
      <documentation>
        Sorted package prefix list (required).
      </documentation>
    </result>
  </properties>
</bdcap:CollectPackagePrefixes>
