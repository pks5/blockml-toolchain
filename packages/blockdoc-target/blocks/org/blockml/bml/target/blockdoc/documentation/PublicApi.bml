<!--BlockDoc Documentation — PublicApi
  FQN: org.blockml.bml.target.blockdoc.documentation.PublicApi-->
<bddocumentation:PublicApi xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Public TypeScript / capability surface
  </is>
  <documentation>
    Package @blockml/blockdoc-target exports:
    
    • BlockDocTarget — RenderTarget; name="blockdoc"; accepts=["library","corpus","auto"];
      render(request, ctx) → BlockDocRenderOutput { files: {path, content}[] }
    • BlockDocOptions — siteMode?, outLayout?, includeNonExported?
    • DEFAULT_BLOCKDOC_OPTIONS / resolveBlockDocOptions(targetOptions?)
    • fqnToHtmlPath(fqn, outLayout), escapeHtml(text)
    
    BML counterparts: bdcap:Render, bdapi:BlockDocOptions, bdapi:BlockDocRenderOutput,
    bdapi:SearchIndex, bdcap:ResolveOptions, bdcap:FqnToHtmlPath, bdcap:EscapeHtml,
    bdcap:BuildSearchIndex, bdcap:RenderToolbar.
    
    Opaque CompileRequest.targetOptions is typed here as BlockDocOptions (BD3).
    Host CLI passes config.targetOptions.blockdoc.
  </documentation>
  <references>
    <see type="bddocumentation:PathAndLayout" relation="ReadNext" />
    <see type="bdcap:Render" relation="Defines" />
    <see type="bdapi:BlockDocOptions" relation="Defines" />
    <see type="bdapi:BlockDocRenderOutput" relation="Defines" />
    <see type="bdcap:ResolveOptions" relation="Defines" />
  </references>
</bddocumentation:PublicApi>
