<!--
  BlockDoc Capability — BuildSearchIndex
  FQN: org.blockml.bml.target.blockdoc.capability.BuildSearchIndex
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <name>BuildSearchIndex</name>
  <type>bdcap:BuildSearchIndex</type>
  <baseType>core:Capability</baseType>
  <is>Index every emitted block page for quick search</is>

  <documentation>
    # Index every emitted block page for quick search

    BD24: for each selected FQN that becomes a block page, emit SearchIndexEntry
    with site-root href from FqnToHtmlPath. Keywords = name, type, FQN segments, is, aliases,
    authored KeywordEntry term / typeFqn tail. AssembleSite writes search-index.json and inlines
    the same entries into search.js.
  </documentation>

  <references>
    <see type="bdapi:SearchIndex" relation="SeeAlso" />
    <see type="bdcap:AssembleSite" relation="SeeAlso" />
  </references>

  <properties>
    <blocks type="bomblock:BlockDefinition">
      <documentation>Blocks that receive HTML pages (required).</documentation>
    </blocks>
    <options type="bdapi:BlockDocOptions">
      <documentation>Resolved options for href layout (required).</documentation>
    </options>
    <result type="bdapi:SearchIndex">
      <documentation>Search index document (required).</documentation>
    </result>
  </properties>

</block>
