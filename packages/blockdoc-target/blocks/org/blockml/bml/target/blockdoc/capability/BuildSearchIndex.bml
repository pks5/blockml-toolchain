<!--BlockDoc Capability — BuildSearchIndex
  FQN: org.blockml.bml.target.blockdoc.capability.BuildSearchIndex-->
<bdcap:BuildSearchIndex xmlns="http://blockml.org/bml"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Index every emitted block page for quick search
  </is>
  <documentation>
    # Index every emitted block page for quick search
    
    BD24: for each selected FQN that becomes a block page, emit SearchIndexEntry
    with site-root href from FqnToHtmlPath. Keywords = name, type, FQN segments, is, aliases,
    authored KeywordEntry value / typeFqn tail. AssembleSite writes search-index.json and inlines
    the same entries into search.js.
  </documentation>
  <references>
    <see type="bdapi:SearchIndex" relation="SeeAlso" />
    <see type="bdcap:AssembleSite" relation="SeeAlso" />
  </references>
  <properties>
    <blocks type="bomblock:BlockDefinition">
      <documentation>
        Blocks that receive HTML pages (required).
      </documentation>
    </blocks>
    <options type="bdapi:BlockDocOptions">
      <documentation>
        Resolved options for href layout (required).
      </documentation>
    </options>
    <result type="bdapi:SearchIndex">
      <documentation>
        Search index document (required).
      </documentation>
    </result>
  </properties>
</bdcap:BuildSearchIndex>
