<!--
  BlockDoc Documentation — ArchitectureOverview
  FQN: org.blockml.bml.target.blockdoc.documentation.ArchitectureOverview
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ArchitectureOverview</name>
  <type>bddocumentation:ArchitectureOverview</type>
  <baseType>core:Documentation</baseType>
  <is>Module map and render pipeline</is>

  <documentation>Entry: bdcap:Render (BlockDocTarget.render) → ResolveOptions → AssembleSite.

    Assembly stages:
    1. Collect registry FQNs; optionally FilterExportedFqns (Library.blocks)
    2. CollectRootFqns (shortest FQN per source file) for indexes
    3. Emit RenderBlockPage per FQN (find nested types via subBlocks DFS)
    4. Emit site index (merged index.html or perLibrary {prefix}/index.html)
    5. If outLayout=fqn: CollectPackagePrefixes → RenderPackageIndex each

    TypeScript module ↔ BML map:
    • options.ts → bdapi:BlockDocOptions, bdcap:ResolveOptions, bdconfig:BlockDocConstants
    • fqn-path.ts → bdcap:FqnToHtmlPath, RelativeHref, EscapeHtml, bdpath:FqnHtmlPath
    • navigation.ts → CollectRootFqns, CollectPackagePrefixes, RenderDottedPackagePath
    • type-links.ts → RenderTypeExpression
    • member-sections.ts → ResolveSubBlockType, RenderMemberSections
    • composition-render.ts → CollectCompositionGroups, RenderComposition
    • render-block-page.ts → RenderBlockPage, RenderSiteIndex, bdpage:*, PageSectionOrder
    • package-index.ts → RenderPackageIndex
    • blockdoc-target.ts → Render, AssembleSite, FilterExportedFqns</documentation>
  <references>
    <see type="bddocumentation:V1Scope" relation="ReadNext"></see>
  </references>

</block>
