<!--
  BlockDoc Capability — FirstInterestingPackagePrefix
  FQN: org.blockml.bml.target.blockdoc.capability.FirstInterestingPackagePrefix
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <name>FirstInterestingPackagePrefix</name>
  <type>bdcap:FirstInterestingPackagePrefix</type>
  <baseType>core:Capability</baseType>
  <is>Deepest package prefix skipped to until a distinction exists</is>

  <documentation>
    # Deepest package prefix skipped to until a distinction exists

    BD27: walk from the empty prefix; while the current prefix has exactly one
    direct sub-package and no direct root blocks, descend into that sub-package. Stop at the
    first prefix with two or more children (sub-packages and/or blocks). Empty result means
    the site root is already interesting (distinct top-level packages). Used as the merged
    site home when outLayout=fqn: index.html redirects there, or is a virtual root package
    index when the result is empty.
  </documentation>

  <references>
    <see type="bddocumentation:SiteAssembly" relation="SeeAlso" />
    <see type="bdcap:CollectPackagePrefixes" relation="SeeAlso" />
  </references>

  <properties>
    <rootFqns type="type:Text">
      <documentation>Root FQN list (required).</documentation>
    </rootFqns>
    <result type="type:Text">
      <documentation>Interesting package prefix, or empty string for site root (required).</documentation>
    </result>
  </properties>

</block>
