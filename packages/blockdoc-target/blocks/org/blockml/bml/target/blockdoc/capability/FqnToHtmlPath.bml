<!--BlockDoc Capability — FqnToHtmlPath
  FQN: org.blockml.bml.target.blockdoc.capability.FqnToHtmlPath-->
<bdcap:FqnToHtmlPath xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map FQN + OutLayout to relative HTML path
  </is>
  <documentation>
    BD7: outLayout fqn → join('.') segments with '/' + '.html'. outLayout package → all but last segment + '/index.html' (single-segment FQN → that segment + '/index.html').
  </documentation>
  <references>
    <see type="bddocumentation:PathAndLayout" relation="SeeAlso" />
  </references>
  <properties>
    <fqn type="type:Text">
      <documentation>
        Fully-qualified name (required).
      </documentation>
    </fqn>
    <outLayout type="bdapi:OutLayout">
      <documentation>
        Layout mode (required).
      </documentation>
    </outLayout>
    <result type="bdpath:FqnHtmlPath">
      <documentation>
        Relative path result (required).
      </documentation>
    </result>
  </properties>
</bdcap:FqnToHtmlPath>
