<!--BlockDoc Render — DocMarkup
  FQN: org.blockml.bml.target.blockdoc.render.DocMarkup-->
<bdrender:DocMarkup xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    HTML fragment string produced by render helpers
  </is>
  <documentation>
    Opaque HTML markup fragment (escaped text and/or anchor tags). Used as capability output type for type links, member cells, navigation fragments.
  </documentation>
  <properties>
    <html type="type:Text">
      <documentation>
        HTML fragment. (required)
      </documentation>
    </html>
  </properties>
</bdrender:DocMarkup>
