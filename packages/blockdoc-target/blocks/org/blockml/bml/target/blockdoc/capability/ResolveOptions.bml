<!--BlockDoc Capability — ResolveOptions
  FQN: org.blockml.bml.target.blockdoc.capability.ResolveOptions-->
<bdcap:ResolveOptions xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Merge opaque targetOptions into required BlockDocOptions
  </is>
  <documentation>
    BD3: missing fields take defaults from BlockDocConstants (siteMode=merged, outLayout=fqn, includeNonExported=true).
  </documentation>
  <references>
    <see type="bddocumentation:PublicApi" relation="SeeAlso" />
    <see type="bdconfig:BlockDocConstants" relation="SeeAlso" />
  </references>
  <properties>
    <targetOptions type="type:Text">
      <documentation>
        Opaque CompileRequest.targetOptions (optional).
      </documentation>
    </targetOptions>
    <result type="bdapi:BlockDocOptions">
      <documentation>
        Fully resolved options (required).
      </documentation>
    </result>
  </properties>
</bdcap:ResolveOptions>
