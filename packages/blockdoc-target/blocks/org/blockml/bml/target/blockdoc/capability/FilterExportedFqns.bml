<!--BlockDoc Capability — FilterExportedFqns
  FQN: org.blockml.bml.target.blockdoc.capability.FilterExportedFqns-->
<bdcap:FilterExportedFqns xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Optionally restrict FQNs to location-based library members
  </is>
  <documentation>
    BD13: when includeNonExported=false and libraryPaths present, keep FQNs that
    belong to those libraries by location (nearest Library.bml walking up; GetExportedFqns).
  </documentation>
  <references>
    <see type="bddocumentation:SiteAssembly" relation="SeeAlso" />
  </references>
  <properties>
    <fqns type="type:Text">
      <documentation>
        Candidate FQN list (required).
      </documentation>
    </fqns>
    <libraryPaths type="type:Text">
      <documentation>
        Library.bml paths (required).
      </documentation>
    </libraryPaths>
    <includeNonExported type="type:Boolean">
      <documentation>
        If true, return fqns unchanged (required).
      </documentation>
    </includeNonExported>
    <result type="type:Text">
      <documentation>
        Filtered FQN list (required).
      </documentation>
    </result>
  </properties>
</bdcap:FilterExportedFqns>
