<!--BlockDoc Capability — RelativeHref
  FQN: org.blockml.bml.target.blockdoc.capability.RelativeHref-->
<bdcap:RelativeHref xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Compute relative href from one HTML path to another
  </is>
  <documentation>
    BD9: pop file segment from from-path; count common directory prefix; ups=0 → './' else '../'*ups + remainder.
  </documentation>
  <references>
    <see type="bddocumentation:PathAndLayout" relation="SeeAlso" />
  </references>
  <properties>
    <fromPath type="type:Text">
      <documentation>
        Current page relative path (required).
      </documentation>
    </fromPath>
    <toPath type="type:Text">
      <documentation>
        Target relative path (required).
      </documentation>
    </toPath>
    <result type="type:Text">
      <documentation>
        Relative href (required).
      </documentation>
    </result>
  </properties>
</bdcap:RelativeHref>
