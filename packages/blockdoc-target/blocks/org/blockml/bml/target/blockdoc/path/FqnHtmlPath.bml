<!--BlockDoc Path — FqnHtmlPath
  FQN: org.blockml.bml.target.blockdoc.path.FqnHtmlPath-->
<bdpath:FqnHtmlPath xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    Relative HTML path derived from an FQN and OutLayout
  </is>
  <documentation>
    Result of FqnToHtmlPath. BD7: fqn layout → segments joined with / + .html; package layout → all but last segment + /index.html.
  </documentation>
  <properties>
    <fqn type="type:Text">
      <documentation>
        Source fully-qualified name. (required)
      </documentation>
    </fqn>
    <outLayout type="bdapi:OutLayout">
      <documentation>
        Layout mode. (required)
      </documentation>
    </outLayout>
    <path type="type:Text">
      <documentation>
        Relative path under outDir. (required)
      </documentation>
    </path>
  </properties>
</bdpath:FqnHtmlPath>
