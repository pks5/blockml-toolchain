<!--BlockDoc API — BlockDocRenderOutput
  FQN: org.blockml.bml.target.blockdoc.api.BlockDocRenderOutput-->
<bdapi:BlockDocRenderOutput xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    Multi-file HTML site RenderOutput
  </is>
  <documentation>
    Extends compiler RenderOutput. files[] are relative paths under outDir with HTML, search-index.json, and search.js content.
  </documentation>
  <properties>
    <files type="type:Text">
      <documentation>
        Array of { path: Text; content: Text }. Relative to outputBasePath. (required)
      </documentation>
    </files>
  </properties>
</bdapi:BlockDocRenderOutput>
