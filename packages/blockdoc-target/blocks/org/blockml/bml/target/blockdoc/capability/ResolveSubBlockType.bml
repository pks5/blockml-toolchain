<!--BlockDoc Capability — ResolveSubBlockType
  FQN: org.blockml.bml.target.blockdoc.capability.ResolveSubBlockType-->
<bdcap:ResolveSubBlockType xmlns="http://blockml.org/bml"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Resolve unqualified/simple type name to nested sub-block FQN
  </is>
  <documentation>
    BD16: strip type-args and multiplicity suffixes from type name; take last '.' segment; match block.subBlocks[].name → return sub.type FQN.
  </documentation>
  <references>
    <see type="bddocumentation:MemberAndCompositionRules" relation="SeeAlso" />
  </references>
  <properties>
    <block type="bomblock:BlockDefinition">
      <documentation>
        Owning block (required).
      </documentation>
    </block>
    <typeName type="type:Text">
      <documentation>
        Declared type name or FQN (optional).
      </documentation>
    </typeName>
    <result type="type:Text">
      <documentation>
        Resolved sub-block FQN or empty (optional).
      </documentation>
    </result>
  </properties>
</bdcap:ResolveSubBlockType>
