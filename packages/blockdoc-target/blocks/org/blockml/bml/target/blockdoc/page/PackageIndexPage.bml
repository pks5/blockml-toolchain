<!--BlockDoc Page — PackageIndexPage
  FQN: org.blockml.bml.target.blockdoc.page.PackageIndexPage-->
<bdpage:PackageIndexPage xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    HTML template model for a package prefix index (fqn layout only)
  </is>
  <documentation>
    # HTML template model for a package prefix index (fqn layout only)
    
    Emitted only when outLayout=fqn. Lists direct sub-packages and direct root blocks (not nested Parent.Child as Blocks entries). Includes toolbar and Index→ancestors breadcrumb. Index href is the interesting home (BD27). Empty prefix (site root) is used when FirstInterestingPackagePrefix is empty.
  </documentation>
  <properties>
    <packagePrefix type="type:Text">
      <documentation>
        Dotted package prefix. (required)
      </documentation>
    </packagePrefix>
    <html type="type:Text">
      <documentation>
        Full HTML document string. (required)
      </documentation>
    </html>
  </properties>
</bdpage:PackageIndexPage>
