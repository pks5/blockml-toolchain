<!--BlockDoc Documentation — ScopeExclusions
  FQN: org.blockml.bml.target.blockdoc.documentation.ScopeExclusions-->
<bddocumentation:ScopeExclusions xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Explicitly out of BlockDoc V1 library scope
  </is>
  <documentation>
    Out of scope for this library:
    • CLI bootstrap map, dual-CLI model, exit codes, blockml.config.json schema
    • compile scope auto resolution algorithm (compiler SSOT)
    • Dependency graphs / richer future navigation beyond toolbar + dotted path + package indexes
    • Authored XML example surfaces on API pages (future Definition / docs work)
    • Unused legacy block-page breadcrumb helper (not part of normative page chrome)
    • XSD, FatBlock, SCAD, and other render targets
    • Codegen tooling that emits TypeScript from this library (structural SSOT only in V1)
  </documentation>
</bddocumentation:ScopeExclusions>
