<!--BlockDoc Capability — RenderTypeExpression
  FQN: org.blockml.bml.target.blockdoc.capability.RenderTypeExpression-->
<bdcap:RenderTypeExpression xmlns="http://blockml.org/bml"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    TypeExpression → summary text with optional named FQN links
  </is>
  <documentation>
    BD15: named → link fqn if knownFqns else escape; append escaped args/multiplicity suffix. union | grouped | Self | anonymousStruct | genericParam → escaped summary only (no links). Missing expr → em dash.
  </documentation>
  <references>
    <see type="bddocumentation:TypeLinkRules" relation="SeeAlso" />
  </references>
  <properties>
    <expr type="bomtype:TypeExpression">
      <documentation>
        Type expression (optional).
      </documentation>
    </expr>
    <pagePath type="type:Text">
      <documentation>
        Current page path (required).
      </documentation>
    </pagePath>
    <options type="bdapi:BlockDocOptions">
      <documentation>
        Resolved options (required).
      </documentation>
    </options>
    <knownFqns type="type:Text">
      <documentation>
        Set of linkable FQNs (required).
      </documentation>
    </knownFqns>
    <result type="bdrender:DocMarkup">
      <documentation>
        HTML fragment (required).
      </documentation>
    </result>
  </properties>
</bdcap:RenderTypeExpression>
