<!--BlockDoc API — SearchIndexEntry
  FQN: org.blockml.bml.target.blockdoc.api.SearchIndexEntry-->
<bdapi:SearchIndexEntry xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    One indexed block for BlockDoc quick search
  </is>
  <documentation>
    BD24: one entry per emitted block HTML page. href is site-root relative (FqnToHtmlPath).
    keywords are deduplicated search terms: name, type FQN, FQN segments, is, alias names,
    authored keyword terms and keyword type tails.
  </documentation>
  <references>
    <see type="bdapi:SearchIndex" relation="SeeAlso" />
    <see type="bdcap:BuildSearchIndex" relation="SeeAlso" />
  </references>
  <properties>
    <name type="type:Text">
      <documentation>
        Block short name (required).
      </documentation>
    </name>
    <blockType type="type:Text">
      <documentation>
        JSON field type — block FQN (required).
      </documentation>
    </blockType>
    <is type="type:Text" />
    <href type="type:Text">
      <documentation>
        Site-root-relative HTML path (required).
      </documentation>
    </href>
    <keywords type="type:Text">
      <documentation>
        JSON array of search terms (required).
      </documentation>
    </keywords>
  </properties>
</bdapi:SearchIndexEntry>
