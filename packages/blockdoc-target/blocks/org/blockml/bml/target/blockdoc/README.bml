<!--BlockDoc Render Target — README
  FQN: org.blockml.bml.target.blockdoc.README-->
<blockdoc:README xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:ReadMe
  </baseType>
  <is>
    Reading entry for the BlockDoc render target library
  </is>
  <documentation>
    The @blockml/blockdoc-target package implements RenderTarget name blockdoc.
    This library (org.blockml.bml.target.blockdoc.*) is the SSOT; TypeScript in
    packages/blockdoc-target/src/ implements it. Tests in packages/blockdoc-target/test/
    verify behavioral contracts.
    
    Start reading at org.blockml.bml.target.blockdoc.documentation.Introduction (ReadNext chain).
    
    Layer separation:
    • org.blockml.bml.bom.* (@blockml/bom) — Urmodell types BlockDoc reads
    • org.blockml.bml.target.blockdoc.* (this library) — HTML site rules and architecture
    • @blockml/compiler — RenderTarget contract and compile facade
    • @blockml/cli — target bootstrap and file writing
    
    Modules: documentation (narrative specs), api/config/path/page/render (data types),
    capability (render + path/nav/page operations).
    
    Not in this library: CLI targets[] bootstrap; compile scope auto resolution; other render targets.
  </documentation>
  <references>
    <see type="bddocumentation:Introduction" relation="ReadFirst" />
    <see type="bddocumentation:DesignDecisions" relation="SeeAlso" />
    <see type="bddocumentation:PublicApi" relation="SeeAlso" />
    <see type="bdcap:Render" relation="SeeAlso" />
  </references>
</blockdoc:README>
