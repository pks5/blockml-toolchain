<!--BlockDoc Capability — EscapeHtml
  FQN: org.blockml.bml.target.blockdoc.capability.EscapeHtml-->
<bdcap:EscapeHtml xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Escape ampersand, angle brackets, and quotes for HTML text/attributes
  </is>
  <documentation>
    BD10: replace ampersand, less-than, greater-than, and double-quote with HTML character references (amp, lt, gt, quot).
  </documentation>
  <properties>
    <text type="type:Text">
      <documentation>
        Raw text (required).
      </documentation>
    </text>
    <result type="type:Text">
      <documentation>
        Escaped text (required).
      </documentation>
    </result>
  </properties>
</bdcap:EscapeHtml>
