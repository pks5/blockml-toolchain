<!--BlockDoc Documentation — SiteAssembly
  FQN: org.blockml.bml.target.blockdoc.documentation.SiteAssembly-->
<bddocumentation:SiteAssembly xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Corpus selection and multi-file emission (BD11, BD13, BD23, BD26, BD27)
  </is>
  <documentation>
    FQN selection: TypeRegistry.keys(), sorted unique. includeNonExported=false → FilterExportedFqns
    from location-based library membership (GetExportedFqns / bootstrap exportsByLibrary). When session.corpusRoots is set (corpus
    compile, including CLI default project-library scan), keep only FQNs whose source.filePath lies
    under those roots.
    
    Root FQNs (BD11): shortest FQN per source.filePath — indexes list these only.
    
    Nested types: if registry doc root FQN ≠ requested FQN, DFS subBlocks (findBlock).
    
    Site indexes (BD23/BD27):
    • merged + outLayout=fqn → index.html redirects to FirstInterestingPackagePrefix package index
      (or is a virtual root package index when that prefix is empty); all-blocks.html is the full listing (BD21)
    • merged + outLayout=package → index.html and all-blocks.html are the BD21 listing
    • perLibrary → {libPrefix}/all-blocks.html listing; {libPrefix}/index.html is the package index when outLayout=fqn
    
    Package indexes when outLayout=fqn for every CollectPackagePrefixes entry; toolbar Index and
    package-index breadcrumb Index point at the interesting home (not all-blocks.html).
    
    Search (BD24): after HTML pages, emit search-index.json and search.js (inlined index + quick-search client)
    covering every emitted block FQN.
    
    Control gate: does not require validator Stage-2 success.
  </documentation>
  <references>
    <see type="bddocumentation:DesignDecisions" relation="ReadNext" />
    <see type="bdcap:AssembleSite" relation="SeeAlso" />
    <see type="bdcap:FilterExportedFqns" relation="SeeAlso" />
    <see type="bdcap:FirstInterestingPackagePrefix" relation="SeeAlso" />
  </references>
</bddocumentation:SiteAssembly>
