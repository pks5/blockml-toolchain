<!--BlockDoc Render Target Library
  FQN: org.blockml.bml.target.blockdoc.Library-->
<blockdoc:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockDoc HTML render target library catalog
  </is>
  <version>
    0.9.12
  </version>
  <documentation>
    # The BlockDoc HTML render target library catalog
    
    Canonical BlockDoc specification for BlockML — registry name blockdoc, options,
    path/link/page/site rules (BD1–BD28). TypeScript in packages/blockdoc-target/src/
    implements this library. Urmodell input types live in org.blockml.bml.bom.* (@blockml/bom).
    
    Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockDoc render target library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <blockdoc:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
      </composition>
    </dependencies>
  </aggregations>
</blockdoc:Library>
