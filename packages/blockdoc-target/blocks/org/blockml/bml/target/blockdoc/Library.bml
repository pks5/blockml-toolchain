<!--
  BlockDoc Render Target Library
  FQN: org.blockml.bml.target.blockdoc.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <name>Library</name>
  <type>blockdoc:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockDoc HTML render target library catalog</is>

  <documentation>
    Canonical BlockDoc specification for BlockML — registry name blockdoc, options,
    path/link/page/site rules (BD1–BD26). TypeScript in packages/blockdoc-target/src/
    implements this library. Urmodell input types live in org.blockml.bml.bom.* (@blockml/bom).
    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.7.1</version>

  <language>
    <English />
  </language>

  <properties>
    <description override="true">
      <value>BlockDoc render target library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <blockdoc:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
        <bom:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition><blockdoc:BlockdocType />
        <bdapi:SiteMode />
        <bdapi:OutLayout />
        <bdapi:BlockDocOptions />
        <bdapi:BlockDocRenderOutput />
        <bdapi:SearchIndexEntry />
        <bdapi:SearchIndex />
        <bdconfig:BlockDocConstants />
        <bdconfig:PageSectionOrder />
        <bdpath:FqnHtmlPath />
        <bdpage:BlockPage />
        <bdpage:SiteIndexPage />
        <bdpage:PackageIndexPage />
        <bdrender:DocMarkup />
        <bdcap:Render />
        <bdcap:ResolveOptions />
        <bdcap:FqnToHtmlPath />
        <bdcap:RelativeHref />
        <bdcap:EscapeHtml />
        <bdcap:CollectRootFqns />
        <bdcap:CollectPackagePrefixes />
        <bdcap:FilterExportedFqns />
        <bdcap:RenderTypeExpression />
        <bdcap:ResolveSubBlockType />
        <bdcap:RenderMemberSections />
        <bdcap:CollectCompositionGroups />
        <bdcap:RenderComposition />
        <bdcap:RenderDottedPackagePath />
        <bdcap:RenderBlockPage />
        <bdcap:RenderSiteIndex />
        <bdcap:RenderPackageIndex />
        <bdcap:BuildSearchIndex />
        <bdcap:RenderToolbar />
        <bdcap:AssembleSite />
        <bddocumentation:Introduction />
        <bddocumentation:LayerSeparation />
        <bddocumentation:ArchitectureOverview />
        <bddocumentation:V1Scope />
        <bddocumentation:PublicApi />
        <bddocumentation:PathAndLayout />
        <bddocumentation:TypeLinkRules />
        <bddocumentation:MemberAndCompositionRules />
        <bddocumentation:PageChrome />
        <bddocumentation:SiteAssembly />
        <bddocumentation:DesignDecisions />
        <bddocumentation:PackageOwnership />
        <bddocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>

</block>
