<!--BlockDoc API — BlockDocOptions
  FQN: org.blockml.bml.target.blockdoc.api.BlockDocOptions-->
<bdapi:BlockDocOptions xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    Opaque targetOptions payload for registry name blockdoc
  </is>
  <documentation>
    Typed targetOptions for BlockDocTarget.render. Defaults: siteMode=merged, outLayout=fqn, includeNonExported=true (BD3).
  </documentation>
  <references>
    <see type="bddocumentation:PublicApi" relation="SeeAlso" />
    <see type="bdcap:ResolveOptions" relation="SeeAlso" />
  </references>
  <properties>
    <siteMode type="bdapi:SiteMode">
      <documentation>
        default "merged" — one site for all libraries in scope. (optional)
      </documentation>
    </siteMode>
    <outLayout type="bdapi:OutLayout">
      <documentation>
        URL path layout under outDir — default "fqn". (optional)
      </documentation>
    </outLayout>
    <includeNonExported type="type:Boolean">
      <documentation>
        when false, only location-based library members; when true, all registry FQNs. Default true. (optional)
      </documentation>
    </includeNonExported>
  </properties>
</bdapi:BlockDocOptions>
