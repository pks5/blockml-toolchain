<!--BlockDoc Page — BlockPage
  FQN: org.blockml.bml.target.blockdoc.page.BlockPage-->
<bdpage:BlockPage xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    HTML template model for one block documentation page
  </is>
  <documentation>
    Emitted by RenderBlockPage. Toolbar chrome (BD25); no FQN/baseType/is definition list; no block-page breadcrumb nav (BD8).
  </documentation>
  <properties>
    <blockType type="type:Text">
      <documentation>
        Block FQN (page title). (required)
      </documentation>
    </blockType>
    <html type="type:Text">
      <documentation>
        Full HTML document string. (required)
      </documentation>
    </html>
  </properties>
</bdpage:BlockPage>
