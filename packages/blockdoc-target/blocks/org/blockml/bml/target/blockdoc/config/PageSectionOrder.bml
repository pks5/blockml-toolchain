<!--BlockDoc Config — PageSectionOrder
  FQN: org.blockml.bml.target.blockdoc.config.PageSectionOrder-->
<bdconfig:PageSectionOrder xmlns="http://blockml.org/bml"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    blockdoc:BlockdocType
  </baseType>
  <is>
    Normative section order for block / site / package pages
  </is>
  <documentation>
    # Normative section order for block / site / package pages
    
    BD6/BD25 block page order: sticky toolbar (BlockDoc, Index, All Blocks, search); dotted package path (fqn layout) or plain package; h1 name; optional extends / version / is; Documentation; Properties; Aggregations; Associations; Capabilities; Composition; Sub-Blocks; References.
    
    All Blocks listing: toolbar; h1 title; count line; package sections, or library sections then packages when multiple libraries (BD21).
    
    Package index: toolbar; breadcrumb; h1 last segment; Sub-packages; Blocks.
  </documentation>
  <properties>
    <blockPageSections type="type:Text">
      <documentation>
        Ordered section ids for block HTML pages.
      </documentation>
    </blockPageSections>
    <siteIndexSections type="type:Text">
      <documentation>
        Ordered section ids for site / perLibrary index.
      </documentation>
    </siteIndexSections>
    <packageIndexSections type="type:Text">
      <documentation>
        Ordered section ids for package index.html.
      </documentation>
    </packageIndexSections>
  </properties>
</bdconfig:PageSectionOrder>
