<!--
  BlockDoc Config — PageSectionOrder
  FQN: org.blockml.bml.target.blockdoc.config.PageSectionOrder
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:blockdoc="org.blockml.bml.target.blockdoc"
  xmlns:bdapi="org.blockml.bml.target.blockdoc.api"
  xmlns:bdcap="org.blockml.bml.target.blockdoc.capability"
  xmlns:bdconfig="org.blockml.bml.target.blockdoc.config"
  xmlns:bddocumentation="org.blockml.bml.target.blockdoc.documentation"
  xmlns:bdpage="org.blockml.bml.target.blockdoc.page"
  xmlns:bdpath="org.blockml.bml.target.blockdoc.path"
  xmlns:bdrender="org.blockml.bml.target.blockdoc.render"
  xmlns:type="org.blockml.bml.type">

  <name>PageSectionOrder</name>
  <type>bdconfig:PageSectionOrder</type>
  <baseType>blockdoc:BlockdocType</baseType>
  <is>Normative section order for block / site / package pages</is>

  <documentation>BD6/BD25 block page order: sticky toolbar (BlockDoc, Index, search); dotted package path (fqn layout) or plain package; h1 name; optional extends / version / is; Documentation; Properties; Aggregations; Associations; Capabilities; Composition; Sub-Blocks; References.
    Site index: toolbar; h1 title; count line; package sections (heading + block list).
    Package index: toolbar; breadcrumb; h1 last segment; Sub-packages; Blocks.</documentation>

  <properties>
    <blockPageSections type="type:Text">
      <documentation>Ordered section ids for block HTML pages.</documentation>
    </blockPageSections>
    <siteIndexSections type="type:Text">
      <documentation>Ordered section ids for site / perLibrary index.</documentation>
    </siteIndexSections>
    <packageIndexSections type="type:Text">
      <documentation>Ordered section ids for package index.html.</documentation>
    </packageIndexSections>
  </properties>

</block>
