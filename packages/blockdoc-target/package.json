{
  "name": "@blockml/blockdoc-target",
  "version": "0.4.0",
  "description": "BlockML BlockDoc render target — browseable HTML documentation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/blockdoc-target"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/target/blockdoc/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/blockdoc-target/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.4.0",
    "@blockml/compiler": "^0.4.0",
    "@blockml/core": "^1.0.5",
    "@blockml/framework": "^0.4.0",
    "@blockml/parser": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
