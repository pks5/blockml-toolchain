{
  "name": "@blockml/fatblock-target",
  "version": "0.9.14",
  "description": "BlockML FatBlock render target — portable .bml folder bundles",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/fatblock-target"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/target/fatblock/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/fatblock-target/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.9.14",
    "@blockml/compiler": "^0.9.14",
    "@blockml/core": "^1.4.5",
    "@blockml/framework": "^0.9.14",
    "@blockml/parser": "^0.9.14",
    "@blockml/serializer": "^0.9.14"
  },
  "engines": {
    "node": ">=20"
  }
}
