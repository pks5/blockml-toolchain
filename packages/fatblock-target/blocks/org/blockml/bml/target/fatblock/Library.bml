<!--FatBlock Render Target Library
  FQN: org.blockml.bml.target.fatblock.Library-->
<fatblock:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:fatblock="org.blockml.bml.target.fatblock"
  xmlns:fbapi="org.blockml.bml.target.fatblock.api"
  xmlns:fbcap="org.blockml.bml.target.fatblock.capability"
  xmlns:fbconfig="org.blockml.bml.target.fatblock.config"
  xmlns:fbdocumentation="org.blockml.bml.target.fatblock.documentation"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The FatBlock portable .bml render target library catalog
  </is>
  <version>
    0.9.5
  </version>
  <documentation>
    # The FatBlock portable .bml render target library catalog
    
    Canonical FatBlock specification for BlockML — registry name fatblock, folder-pool
    candidates, embed assembly, namespace merge, {hostFqn}.fat.bml (FB1–FB20). TypeScript in
    packages/fatblock-target/src/ implements this library. Membership is defined
    exclusively by this blocks list.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>FatBlock render target library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <fatblock:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <serializer:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <fatblock:FatblockType />
        <fbapi:FatBlockOptions />
        <fbapi:FatBlockRenderOutput />
        <fbapi:AssembleFatDocumentResult />
        <fbconfig:FatBlockConstants />
        <fbconfig:DefaultFatBlockOptions />
        <fbcap:ResolveOptions />
        <fbcap:ValidateRequest />
        <fbcap:Render />
        <fbcap:RootFqnsByFilePath />
        <fbcap:CollectCandidateFqns />
        <fbcap:MatchesIncludePattern />
        <fbcap:FilterByIncludes />
        <fbcap:CloneBlockDefinition />
        <fbcap:MergeNamespaceBindings />
        <fbcap:AssembleFatDocument />
        <fbcap:SerializeFatDocument />
        <fbcap:FatOutputBasename />
        <fbdocumentation:Introduction />
        <fbdocumentation:LayerSeparation />
        <fbdocumentation:ArchitectureOverview />
        <fbdocumentation:V1Scope />
        <fbdocumentation:PublicApi />
        <fbdocumentation:CandidateCollection />
        <fbdocumentation:EmbedAssemblyRules />
        <fbdocumentation:NamespaceMergeRules />
        <fbdocumentation:OutputLayout />
        <fbdocumentation:Diagnostics />
        <fbdocumentation:DesignDecisions />
        <fbdocumentation:PackageOwnership />
        <fbdocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>
</fatblock:Library>
