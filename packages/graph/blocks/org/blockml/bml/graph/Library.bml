<!--BlockML Graph Library Descriptor
  FQN: org.blockml.bml.graph.Library-->
<graph:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:graph="org.blockml.bml.graph">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Graph package library catalog
  </is>
  <version>
    0.9.12
  </version>
  <documentation>
    Canonical graph specification for BlockML — local authored structural graph
    over the validate --all BML corpus. TypeScript in packages/graph/src/ implements this library.
    Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Graph library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <graph:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <framework:Library />
      </composition>
    </dependencies>
  </aggregations>
</graph:Library>
