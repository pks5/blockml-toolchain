<!--Graph — GraphPath
  FQN: org.blockml.bml.graph.GraphPath-->
<graph:GraphPath xmlns="http://blockml.org/bml"
  xmlns:graph="org.blockml.bml.graph">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    Shortest authored path between two blocks
  </is>
  <documentation>
    hops are GraphNeighbor values with direction outgoing. Member nodes explain MEMBER_TYPE connections. path does not walk incoming edges.
  </documentation>
  <properties>
    <from type="graph:GraphNode">
      <documentation>
        Start block. (required)
      </documentation>
    </from>
    <to type="graph:GraphNode">
      <documentation>
        End block. (required)
      </documentation>
    </to>
    <hops type="graph:GraphNeighbor[]">
      <documentation>
        Ordered hops including members. (required)
      </documentation>
    </hops>
  </properties>
</graph:GraphPath>
