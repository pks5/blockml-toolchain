<!--Graph Documentation — PackageOwnership
  FQN: org.blockml.bml.graph.documentation.PackageOwnership-->
<graphdocumentation:PackageOwnership xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graphdocumentation="org.blockml.bml.graph.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Toolchain responsibilities for Graph
  </is>
  <documentation>
    @blockml/graph — index, persistence, semantic API, query API. Owns this BML library.
    
    @blockml/framework — project discovery and TypeRegistry bootstrap (same corpus as validate --all).
    @blockml/cli — blockml graph command host.
    @blockml/bom — BlockDefinition members and SourceLocation.
  </documentation>
  <references>
    <see type="graphdocumentation:ScopeExclusions" relation="ReadNext" />
  </references>
</graphdocumentation:PackageOwnership>
