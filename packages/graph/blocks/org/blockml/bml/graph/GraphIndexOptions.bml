<!--Graph — GraphIndexOptions
  FQN: org.blockml.bml.graph.GraphIndexOptions-->
<graph:GraphIndexOptions xmlns="http://blockml.org/bml"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    Project and cache location for graph index operations
  </is>
  <documentation>
    rootDir defaults to process.cwd(); srcDir defaults to blocks; indexDir defaults to {rootDir}/.blockml/graph.
  </documentation>
  <properties>
    <rootDir type="type:Text">
      <documentation>
        rootDir (optional). TS type: type:Text.
      </documentation>
    </rootDir>
    <srcDir type="type:Text">
      <documentation>
        srcDir (optional). TS type: type:Text.
      </documentation>
    </srcDir>
    <libraries type="type:Text[]">
      <documentation>
        libraries (optional). TS type: type:Text[].
      </documentation>
    </libraries>
    <indexDir type="type:Text">
      <documentation>
        indexDir (optional). TS type: type:Text.
      </documentation>
    </indexDir>
  </properties>
</graph:GraphIndexOptions>
