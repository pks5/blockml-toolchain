<!--Graph — GraphMember
  FQN: org.blockml.bml.graph.GraphMember-->
<graph:GraphMember xmlns="http://blockml.org/bml"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    Authored or inherited member view
  </is>
  <documentation>
    inheritedFrom is set when the member is declared on an ancestor or contract, not stored as a derived HAS_MEMBER edge.
  </documentation>
  <properties>
    <node type="graph:GraphNode">
      <documentation>
        Member node. (required)
      </documentation>
    </node>
    <relation type="type:Text">
      <documentation>
        HAS_MEMBER. (required)
      </documentation>
    </relation>
    <inheritedFrom type="type:Text">
      <documentation>
        Owner FQN when inherited. (optional)
      </documentation>
    </inheritedFrom>
    <file type="type:Text">
      <documentation>
        Provenance file. (optional)
      </documentation>
    </file>
    <line type="type:Integer">
      <documentation>
        Provenance line. (optional)
      </documentation>
    </line>
  </properties>
</graph:GraphMember>
