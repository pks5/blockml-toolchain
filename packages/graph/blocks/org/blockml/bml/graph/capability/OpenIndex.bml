<!--Graph Capability — OpenIndex
  FQN: org.blockml.bml.graph.capability.OpenIndex-->
<graphcap:OpenIndex xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Load a ready graph index or rebuild when missing or stale
  </is>
  <documentation>
    Load a ready index or rebuild when missing or stale. The Ladybug database is exclusive; openGraph waits on an index lock if another process holds the graph, then loads or rebuilds. close() releases the lock.
  </documentation>
  <references>
    <see type="graphcap:RebuildIndex" relation="SeeAlso" />
  </references>
  <properties>
    <options type="graph:GraphIndexOptions">
      <documentation>
        options (optional).
      </documentation>
    </options>
    <result type="graph:BuildIndexResult">
      <documentation>
        result (required).
      </documentation>
    </result>
  </properties>
</graphcap:OpenIndex>
