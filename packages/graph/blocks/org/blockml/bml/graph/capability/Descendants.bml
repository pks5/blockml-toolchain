<!--Graph Capability — Descendants
  FQN: org.blockml.bml.graph.capability.Descendants-->
<graphcap:Descendants xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Inverse BASE_TYPE walk
  </is>
  <documentation>
    Only BASE_TYPE. Default depth 16.
  </documentation>
  <references>
    <see type="graphcap:Ancestors" relation="SeeAlso" />
  </references>
  <properties>
    <fqn type="type:Text">
      <documentation>
        Block FQN. (required)
      </documentation>
    </fqn>
    <depth type="type:Integer">
      <documentation>
        Max hops (optional).
      </documentation>
    </depth>
    <nodes type="graph:GraphNode[]">
      <documentation>
        Descendant blocks. (required)
      </documentation>
    </nodes>
  </properties>
</graphcap:Descendants>
