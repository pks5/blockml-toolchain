<!--Graph Capability — Neighbors
  FQN: org.blockml.bml.graph.capability.Neighbors-->
<graphcap:Neighbors xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:graphdocumentation="org.blockml.bml.graph.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Union of uses and usedBy
  </is>
  <documentation>
    Authored environment of a block, both directions. Default depth 1. depth n is an undirected walk of n hops. CLI --origin, --relation, and --limit filter the result list.
  </documentation>
  <references>
    <see type="graphcap:Uses" relation="SeeAlso" />
    <see type="graphcap:UsedBy" relation="SeeAlso" />
  </references>
  <properties>
    <fqn type="type:Text">
      <documentation>
        Block FQN. (required)
      </documentation>
    </fqn>
    <depth type="type:Integer">
      <documentation>
        Undirected hops. Default 1. (optional)
      </documentation>
    </depth>
    <origin type="type:Text">
      <documentation>
        Keep neighbors whose node.origin is listed. Comma-separated. (optional)
      </documentation>
    </origin>
    <relation type="type:Text">
      <documentation>
        Keep neighbors whose relation is listed. Comma-separated. (optional)
      </documentation>
    </relation>
    <limit type="type:Integer">
      <documentation>
        Max neighbors after filters. (optional)
      </documentation>
    </limit>
    <neighbors type="graph:GraphNeighbor[]">
      <documentation>
        Neighbors. (required)
      </documentation>
    </neighbors>
  </properties>
</graphcap:Neighbors>
