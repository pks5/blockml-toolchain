<!--Graph Capability — BuildIndex
  FQN: org.blockml.bml.graph.capability.BuildIndex-->
<graphcap:BuildIndex xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Build an in-memory graph index from the validate --all corpus
  </is>
  <documentation>
    Calls bootstrapFullProjectRegistry, maps authored Block and Member nodes, and creates a Ladybug in-memory store. Does not write to disk.
  </documentation>
  <references>
    <see type="fwcap:BootstrapFullProjectRegistry" relation="SeeAlso" />
    <see type="graphcap:RebuildIndex" relation="SeeAlso" />
  </references>
  <properties>
    <options type="graph:GraphIndexOptions">
      <documentation>
        options (optional).
      </documentation>
    </options>
    <result type="graph:BuildIndexResult">
      <documentation>
        result (required).
      </documentation>
    </result>
  </properties>
</graphcap:BuildIndex>
