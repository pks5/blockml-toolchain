<!--Graph Capability — Path
  FQN: org.blockml.bml.graph.capability.Path-->
<graphcap:Path xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Shortest authored path between two blocks
  </is>
  <documentation>
    Walks outgoing authored edges only (the same direction as uses), including HAS_MEMBER and MEMBER_TYPE so provenance is preserved. Incoming edges are used-by, not path. Each hop is a GraphNeighbor with direction outgoing.
  </documentation>
  <properties>
    <from type="type:Text">
      <documentation>
        Start FQN. (required)
      </documentation>
    </from>
    <to type="type:Text">
      <documentation>
        End FQN. (required)
      </documentation>
    </to>
    <depth type="type:Integer">
      <documentation>
        Max hops (optional).
      </documentation>
    </depth>
    <path type="graph:GraphPath">
      <documentation>
        Path or absent. (optional)
      </documentation>
    </path>
  </properties>
</graphcap:Path>
