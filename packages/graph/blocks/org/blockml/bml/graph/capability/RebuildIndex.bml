<!--Graph Capability — RebuildIndex
  FQN: org.blockml.bml.graph.capability.RebuildIndex-->
<graphcap:RebuildIndex xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Full rebuild and persist of the graph index
  </is>
  <documentation>
    Deletes .blockml/graph/lbug and rebuilds authored nodes and edges, then writes manifest.json. Waits on the same exclusive index lock as OpenIndex so two processes cannot rebuild or query concurrently.
  </documentation>
  <references>
    <see type="graphcap:BuildIndex" relation="SeeAlso" />
  </references>
  <properties>
    <options type="graph:GraphIndexOptions">
      <documentation>
        options (optional).
      </documentation>
    </options>
    <result type="graph:BuildIndexResult">
      <documentation>
        result (required).
      </documentation>
    </result>
  </properties>
</graphcap:RebuildIndex>
