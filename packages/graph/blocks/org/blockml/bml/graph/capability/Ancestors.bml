<!--Graph Capability — Ancestors
  FQN: org.blockml.bml.graph.capability.Ancestors-->
<graphcap:Ancestors xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    BASE_TYPE walk toward roots
  </is>
  <documentation>
    Only BASE_TYPE. Default depth 16.
  </documentation>
  <properties>
    <fqn type="type:Text">
      <documentation>
        Block FQN. (required)
      </documentation>
    </fqn>
    <depth type="type:Integer">
      <documentation>
        Max hops (optional).
      </documentation>
    </depth>
    <nodes type="graph:GraphNode[]">
      <documentation>
        Ancestor blocks. (required)
      </documentation>
    </nodes>
  </properties>
</graphcap:Ancestors>
