<!--Graph Capability — Query
  FQN: org.blockml.bml.graph.capability.Query-->
<graphcap:Query xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Cypher escape hatch over the authored graph
  </is>
  <documentation>
    Executes parameterized Cypher against the Ladybug store. Engine types are not part of the public API. Call schema() first: Ladybug is a Cypher subset — no type(), no shortestPath(). Example is on GraphSchema.example.
  </documentation>
  <references>
    <see type="graphcap:Schema" relation="SeeAlso" />
  </references>
  <properties>
    <cypher type="type:Text">
      <documentation>
        Cypher statement. (required)
      </documentation>
    </cypher>
    <params type="type:Text">
      <documentation>
        JSON parameters (optional).
      </documentation>
    </params>
    <result type="graph:GraphQueryResult">
      <documentation>
        Tabular result. (required)
      </documentation>
    </result>
  </properties>
</graphcap:Query>
