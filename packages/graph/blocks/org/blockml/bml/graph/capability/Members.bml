<!--Graph Capability — Members
  FQN: org.blockml.bml.graph.capability.Members-->
<graphcap:Members xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Authored members plus inherited view
  </is>
  <documentation>
    HAS_MEMBER on the block plus BASE_TYPE ancestors and CONTRACT owners. inheritedFrom is set for inherited members; those edges are not stored on the child. BASE_TYPE is the resolved parent only — generic arguments on baseType are not ancestors. SubBlock members are not listed on the parent.
  </documentation>
  <properties>
    <fqn type="type:Text">
      <documentation>
        Block FQN. (required)
      </documentation>
    </fqn>
    <members type="graph:GraphMember[]">
      <documentation>
        Members. (required)
      </documentation>
    </members>
  </properties>
</graphcap:Members>
