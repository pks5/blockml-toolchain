<!--Graph Capability — Schema
  FQN: org.blockml.bml.graph.capability.Schema-->
<graphcap:Schema xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:graphdocumentation="org.blockml.bml.graph.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Stable node and relation documentation
  </is>
  <documentation>
    Returns node table names, authored relation names, a prose description, and a Ladybug Cypher example. Description names the supported subset (MATCH/WHERE/RETURN/ORDER BY/LIMIT, named relations, $params) and what is missing (type(), shortestPath()).
  </documentation>
  <properties>
    <schema type="type:Text">
      <documentation>
        Schema description. (required)
      </documentation>
    </schema>
    <example type="type:Text">
      <documentation>
        Minimal working Cypher. (required)
      </documentation>
    </example>
  </properties>
</graphcap:Schema>
