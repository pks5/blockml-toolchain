<!--Graph — GraphQueryResult
  FQN: org.blockml.bml.graph.GraphQueryResult-->
<graph:GraphQueryResult xmlns="http://blockml.org/bml"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    Tabular Cypher query result
  </is>
  <documentation>
    columns are engine column names; each row.values aligns with columns. Ladybug types are not exposed.
  </documentation>
  <properties>
    <columns type="type:Text[]">
      <documentation>
        Column names. (required)
      </documentation>
    </columns>
    <rows type="type:Text[]">
      <documentation>
        JSON-shaped row values. (required)
      </documentation>
    </rows>
  </properties>
</graph:GraphQueryResult>
