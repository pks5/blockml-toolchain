<!--Graph — GraphType
  FQN: org.blockml.bml.graph.GraphType-->
<graph:GraphType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for Graph implementation data-structure blocks
  </is>
  <documentation>
    GraphNode, GraphPath, and related ValueTypes used as capability payloads.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>
</graph:GraphType>
