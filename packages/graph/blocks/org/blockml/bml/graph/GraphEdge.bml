<!--Graph — GraphEdge
  FQN: org.blockml.bml.graph.GraphEdge-->
<graph:GraphEdge xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphcap="org.blockml.bml.graph.capability"
  xmlns:graphdocumentation="org.blockml.bml.graph.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    Authored relation between graph nodes
  </is>
  <documentation>
    relation is one of BASE_TYPE, CONTRACT, HAS_SUBBLOCK, HAS_MEMBER, MEMBER_TYPE, INPUT_TYPE, OUTPUT_TYPE, THROWS.
  </documentation>
  <properties>
    <relation type="type:Text">
      <documentation>
        Authored relation name. (required)
      </documentation>
    </relation>
    <from type="type:Text">
      <documentation>
        Source node id. (required)
      </documentation>
    </from>
    <to type="type:Text">
      <documentation>
        Target node id. (required)
      </documentation>
    </to>
    <file type="type:Text">
      <documentation>
        Provenance file. (optional)
      </documentation>
    </file>
    <line type="type:Integer">
      <documentation>
        Provenance line. (optional)
      </documentation>
    </line>
    <cardinality type="type:Text">
      <documentation>
        Optional multiplicity on MEMBER_TYPE. (optional)
      </documentation>
    </cardinality>
  </properties>
</graph:GraphEdge>
