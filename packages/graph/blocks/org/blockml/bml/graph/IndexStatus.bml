<!--Graph — IndexStatus
  FQN: org.blockml.bml.graph.IndexStatus-->
<graph:IndexStatus xmlns="http://blockml.org/bml"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    Presence and freshness of the persisted graph index
  </is>
  <documentation>
    state is missing, ready, or stale.
  </documentation>
  <properties>
    <state type="type:Text">
      <documentation>
        state (required). TS type: type:Text.
      </documentation>
    </state>
    <blocks type="type:Integer">
      <documentation>
        blocks (optional). TS type: type:Integer.
      </documentation>
    </blocks>
    <members type="type:Integer">
      <documentation>
        members (optional). TS type: type:Integer.
      </documentation>
    </members>
    <indexDir type="type:Text">
      <documentation>
        indexDir (required). TS type: type:Text.
      </documentation>
    </indexDir>
  </properties>
</graph:IndexStatus>
