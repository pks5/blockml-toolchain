<graph:README xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:graphdocumentation="org.blockml.bml.graph.documentation">

  <baseType>
    core:ReadMe
  </baseType>
  <is>
    Reading entry for the Graph library
  </is>
  <documentation>
    The @blockml/graph package indexes the effective BML corpus of a project
    (same as blockml validate --all) as an authored structural graph.
    
    Start at org.blockml.bml.graph.documentation.Introduction.
  </documentation>
  <references>
    <see type="graphdocumentation:Introduction" relation="ReadFirst" />
    <see type="graphdocumentation:PublicApi" relation="SeeAlso" />
  </references>
</graph:README>
