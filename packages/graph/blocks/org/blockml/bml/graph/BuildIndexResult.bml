<!--Graph — BuildIndexResult
  FQN: org.blockml.bml.graph.BuildIndexResult-->
<graph:BuildIndexResult xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:graph="org.blockml.bml.graph"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    graph:GraphType
  </baseType>
  <is>
    In-memory graph index plus bootstrap diagnostics
  </is>
  <documentation>
    Returned by buildIndex, rebuildIndex, and openGraph.
  </documentation>
  <properties>
    <index type="graph:GraphType">
      <documentation>
        Opaque GraphIndex handle. (required)
      </documentation>
    </index>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics (required). TS type: bomcommon:Diagnostic[].
      </documentation>
    </diagnostics>
    <blocks type="type:Integer">
      <documentation>
        Resolved Block nodes. (required)
      </documentation>
    </blocks>
    <members type="type:Integer">
      <documentation>
        Member nodes. (required)
      </documentation>
    </members>
  </properties>
</graph:BuildIndexResult>
