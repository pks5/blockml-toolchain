<!--XSD Render Target Library
  FQN: org.blockml.bml.target.xsd.Library-->
<xsd:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:xsd="org.blockml.bml.target.xsd"
  xmlns:xsdapi="org.blockml.bml.target.xsd.api"
  xmlns:xsdcap="org.blockml.bml.target.xsd.capability"
  xmlns:xsdconfig="org.blockml.bml.target.xsd.config"
  xmlns:xsddocumentation="org.blockml.bml.target.xsd.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The XSD schema render target library catalog
  </is>
  <version>
    0.9.8
  </version>
  <documentation>
    Canonical XSD specification for BlockML — registry name xsd, bml.xsd particles,
    domain vocabularies, catalog.xml (XSD1–XSD18). TypeScript in
    packages/xsd-target/src/ implements this library. Membership is defined
    exclusively by this blocks list.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>XSD render target library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <xsd:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <xsd:XsdType />
        <xsdapi:XsdOptions />
        <xsdapi:XsdRenderOutput />
        <xsdapi:CatalogEntry />
        <xsdconfig:XsdConstants />
        <xsdconfig:DefaultXsdOptions />
        <xsdcap:ResolveOptions />
        <xsdcap:Render />
        <xsdcap:EmitBlockXsd />
        <xsdcap:MemberPrefersElement />
        <xsdcap:ExtraElementNames />
        <xsdcap:EmitTypesXsd />
        <xsdcap:EmitServiceXsd />
        <xsdcap:VocabularyElements />
        <xsdcap:EmitCatalogXml />
        <xsdcap:CatalogRelativePath />
        <xsddocumentation:Introduction />
        <xsddocumentation:LayerSeparation />
        <xsddocumentation:ArchitectureOverview />
        <xsddocumentation:V1Scope />
        <xsddocumentation:PublicApi />
        <xsddocumentation:ParticleMappingRules />
        <xsddocumentation:DomainVocabularyRules />
        <xsddocumentation:CatalogAndOutputLayout />
        <xsddocumentation:Diagnostics />
        <xsddocumentation:DesignDecisions />
        <xsddocumentation:PackageOwnership />
        <xsddocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>
</xsd:Library>
