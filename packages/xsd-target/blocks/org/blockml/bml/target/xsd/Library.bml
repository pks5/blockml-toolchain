<!--XSD Render Target Library
  FQN: org.blockml.bml.target.xsd.Library-->
<xsd:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:xsd="org.blockml.bml.target.xsd">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The XSD schema render target library catalog
  </is>
  <version>
    0.9.15
  </version>
  <documentation>
    Canonical XSD specification for BlockML — registry name xsd, bml.xsd particles,
    domain vocabularies, catalog.xml (XSD1–XSD18). TypeScript in
    packages/xsd-target/src/ implements this library. Membership is the nearest
    Library.bml at the same package level or above; search stops one level below
    the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>XSD render target library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <xsd:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
      </composition>
    </dependencies>
  </aggregations>
</xsd:Library>
