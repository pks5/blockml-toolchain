<!--
  XSD Capability — CatalogRelativePath
  FQN: org.blockml.bml.target.xsd.capability.CatalogRelativePath
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:xsd="org.blockml.bml.target.xsd"
  xmlns:xsdapi="org.blockml.bml.target.xsd.api"
  xmlns:xsdcap="org.blockml.bml.target.xsd.capability"
  xmlns:xsdconfig="org.blockml.bml.target.xsd.config"
  xmlns:xsddocumentation="org.blockml.bml.target.xsd.documentation"
  xmlns:type="org.blockml.bml.type">

  <name>CatalogRelativePath</name>
  <type>xsdcap:CatalogRelativePath</type>
  <baseType>core:Capability</baseType>
  <is>Build catalog uri path for a schema file under outDir</is>

  <documentation>XSD14: normalize backslashes to slash; strip trailing slashes; return ./outDir/schemaFileName.</documentation>

  <properties>
    <outDir type="type:Text">
      <documentation>Output base path. (required)</documentation>
    </outDir>
    <schemaFileName type="type:Text">
      <documentation>e.g. bml.xsd. (required)</documentation>
    </schemaFileName>
    <result type="type:Text">
      <documentation>Relative path. (required)</documentation>
    </result>
  </properties>

</block>
