{
  "name": "@blockml/transformer",
  "version": "0.9.2",
  "description": "BlockML transformer — sequential ModelOperations with registered executors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/transformer"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/transformer/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/transformer/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.9.2",
    "@blockml/core": "^1.1.1",
    "@blockml/framework": "^0.9.2",
    "@blockml/serializer": "^0.9.2",
    "proper-lockfile": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
