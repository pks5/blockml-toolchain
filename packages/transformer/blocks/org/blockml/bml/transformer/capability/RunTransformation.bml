<!--Transformer Capability — RunTransformation
  FQN: org.blockml.bml.transformer.capability.RunTransformation-->
<transformercap:RunTransformation xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Orchestrate a ModelTransformation over sequential ModelOperations
  </is>
  <documentation>
    # Run Transformation
    
    Public engine entry. Acquires the worktree lock, then runs Prepare,
    each ModelOperation (Running commit, registered executor, Reflect,
    Persist), and Finalize. A failed ModelOperation aborts the rest.
    Target library for `_meta` is `library` (path to Library.bml) or
    cwd `package.json` `blockml.library`. Apply sources are
    `_meta.transform.pending` (`template=false`),
    `_meta.transform.available` (`template=true`), or a
    ModelTransformation outside `_meta.transform` (`template=true`).
    Does not implement any process step. Emits
    lifecycle events at status and execute/reflect boundaries regardless
    of --verbose. Measures wall-clock duration from Prepare through
    Finalize, writes `duration` on the terminal ModelTransformation,
    and prints `Elapsed …` on the complete lifecycle line.
    TS: Transformer.run / runTransformation.
  </documentation>
  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:PrepareExecution" relation="SeeAlso" />
    <see type="transformercap:ExecuteTask" relation="SeeAlso" />
    <see type="transformercap:ReflectOnExecution" relation="SeeAlso" />
    <see type="transformercap:PersistExecution" relation="SeeAlso" />
    <see type="transformercap:FinalizeExecution" relation="SeeAlso" />
  </references>
  <properties>
    <executionFqn type="type:Text">
      <documentation>
        Apply-source ModelTransformation FQN (pending one-shot, available template, or template outside _meta.transform). (required)
      </documentation>
    </executionFqn>
    <library type="type:Text">
      <documentation>
        Path to the target Library.bml. Omitted: cwd package.json blockml.library. (optional)
      </documentation>
    </library>
    <terminalFqn type="type:Text">
      <documentation>
        Succeeded or failed ModelTransformation FQN after Finalize. (required)
      </documentation>
    </terminalFqn>
    <duration type="type:Duration">
      <documentation>
        Wall-clock elapsed time from Prepare through Finalize. (required)
      </documentation>
    </duration>
  </properties>
</transformercap:RunTransformation>
