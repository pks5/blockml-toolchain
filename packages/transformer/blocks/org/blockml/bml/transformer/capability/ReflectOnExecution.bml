<!--
  Transformer Capability — ReflectOnExecution
  FQN: org.blockml.bml.transformer.capability.ReflectOnExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation">

  <name>ReflectOnExecution</name>
  <type>transformercap:ReflectOnExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process step [3] — observe Execute output without changing the model</is>

  <documentation>
    # Reflect on Execution

    Read the Execute trace for the current ModelOperation and produce
    `changedFiles` plus optional `output`. Deterministic. No agent
    process. Must not change the model — Persist writes those fields
    onto the ModelOperation.

    * `changedFiles` — workspace-relative paths from the Execute git
      worktree trace (excluding `_meta/transform/`).
    * `output` — Execute agent stdout, only when this operation's
      `captureOutput` is true.

    Skipped when Execute throws. `output` never decides Succeeded vs
    Failed. TS: pipeline/reflect.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:ExecuteTask" relation="SeeAlso" />
    <see type="transformercap:PersistExecution" relation="SeeAlso" />
  </references>

  <properties>
    <changedFiles type="type:Text[]">
      <documentation>Paths modified during Execute, from the git worktree trace. (required)</documentation>
    </changedFiles>
    <output type="type:Text">
      <documentation>
        Execute agent stdout. Present when ModelOperation.captureOutput is true.
        (optional)
      </documentation>
    </output>
  </properties>

</block>
