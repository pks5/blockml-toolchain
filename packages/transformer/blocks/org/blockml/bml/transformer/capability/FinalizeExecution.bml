<!--
  Transformer Capability — FinalizeExecution
  FQN: org.blockml.bml.transformer.capability.FinalizeExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>FinalizeExecution</name>
  <type>transformercap:FinalizeExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process step [5] — complete the ModelTransformation lifecycle</is>

  <documentation>
    # Finalize Execution

    Set completedAt and status, then relocate the running ModelTransformation to
    `_meta.transform.succeeded` or `_meta.transform.failed`. `Succeeded` only when every
    ModelOperation succeeded and result resolution did not throw. After that relocation, commit.

    When every ModelOperation succeeded and `resultSource` is set, close
    any expression against this Block, read that Property from the
    current model and write it onto `result`. Unset or empty
    `resultSource` after close skips this. Unknown Block or Property, a
    close fault, or a type that is not bound `R`, throws
    `workflow:ResultException`, fills `exception`, and fails
    the transformation. A ModelOperation failure skips result and leaves
    `exception` empty. Prepare may already have written
    `workflow:ParametersException` onto `exception`.

    Default implementation is deterministic. Runs after every started execution,
    including a failed ModelOperation. Does not write output, changedFiles,
    or operation exception onto the ModelTransformation. TS: pipeline/finalize.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:PersistExecution" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

  <properties>
    <runningFqn type="type:Text">
      <documentation>Running ModelTransformation FQN to finalize. (required)</documentation>
    </runningFqn>
    <terminalFqn type="type:Text">
      <documentation>Succeeded or failed ModelTransformation FQN after relocation. (required)</documentation>
    </terminalFqn>
    <status type="workflow:ExecutionStatus">
      <documentation>Terminal status Succeeded or Failed. (required)</documentation>
    </status>
    <completedAt type="type:DateTime">
      <documentation>When this execution finished. (required)</documentation>
    </completedAt>
  </properties>

</block>
