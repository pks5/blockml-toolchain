<!--
  Transformer Capability — PrepareExecution
  FQN: org.blockml.bml.transformer.capability.PrepareExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>PrepareExecution</name>
  <type>transformercap:PrepareExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process stage [1] — create a running TaskExecution</is>

  <documentation>
    Resolve a pending TaskExecution, assign sequence and startedAt, relocate
    it to _transform.running. Default implementation is deterministic.
    TS: pipeline/prepare.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:ExecuteTask" relation="SeeAlso" />
    <see type="workflow:TaskExecution" relation="SeeAlso" />
  </references>

  <properties>
    <pendingFqn type="type:Text">
      <documentation>Pending TaskExecution FQN. (required)</documentation>
    </pendingFqn>
    <runningFqn type="type:Text">
      <documentation>Running TaskExecution FQN after relocation. (required)</documentation>
    </runningFqn>
    <sequence type="type:Integer">
      <documentation>Allocated execution sequence. (required)</documentation>
    </sequence>
  </properties>

</block>
