<!--
  Transformer Capability — PrepareExecution
  FQN: org.blockml.bml.transformer.capability.PrepareExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>PrepareExecution</name>
  <type>transformercap:PrepareExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process stage [1] — create a running ModelTransformation</is>

  <documentation>
    # Prepare Execution

    1. Validate the pending contract: `status=Pending`, `stages` with a
       Task on each Stage, and `createdAt` must be set; `executionId` and
       start/finish fields must be absent on the ModelTransformation.
    2. Require a clean Git worktree (including HEAD). Abort without starting
       if the worktree is dirty or not a Git toplevel.
    3. Assign a unique `executionId` (random UUID), `sequence`, `startedAt`,
       and `baseCommit` (current HEAD), set `status=Running`.
    4. Relocate the Block to `_meta.transform.running`. When `template` is
       true, leave the pending Block in place, copy it, set
       `template=false` on the copy, and relocate that copy instead.
    5. Deep-merge CLI `--parameters` JSON over pending `parameters`, check
       the bound generic `T`, and write the result onto the running copy.
       Omitted CLI parameters are `{}`. Bound `T` defaults to
       `workflow:EmptyStruct`.
    6. Commit the running relocation.

    Default implementation is deterministic. TS: pipeline/prepare.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:ExecuteTask" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

  <properties>
    <pendingFqn type="type:Text">
      <documentation>Pending ModelTransformation FQN. (required)</documentation>
    </pendingFqn>
    <runningFqn type="type:Text">
      <documentation>Running ModelTransformation FQN after relocation. (required)</documentation>
    </runningFqn>
    <sequence type="type:Integer">
      <documentation>Allocated execution sequence. (required)</documentation>
    </sequence>
  </properties>

</block>
