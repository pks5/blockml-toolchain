<!--
  Transformer Capability — PrepareExecution
  FQN: org.blockml.bml.transformer.capability.PrepareExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>PrepareExecution</name>
  <type>transformercap:PrepareExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process step [1] — create a running ModelTransformation</is>

  <documentation>
    # Prepare Execution

    1. Validate the pending contract: `status=Pending`, `operations` of
       concrete ModelOperation subtypes (AgenticOperation requires a
       Task; ToolOperation requires `command`), and `createdAt` must be set; `executionId` and start/finish
       fields must be absent on the ModelTransformation.
    2. Require a clean Git worktree (including HEAD). Abort without starting
       if the worktree is dirty or not a Git toplevel.
    3. Assign a unique `executionId` (`type:UUID`), `sequence`, `startedAt`,
       and `baseCommit` (current HEAD), set `status=Running`.
    4. Relocate or copy into the target library's
       `_meta.transform.running`. The target library is `--library` or
       cwd `package.json` `blockml.library` (`dirname(Library.bml)`).
       Placement: `_meta.transform.pending` requires `template=false`
       and the source is relocated. `_meta.transform.available` is the
       template catalog under `_meta.transform` and requires
       `template=true`. A source outside `_meta.transform` requires
       `template=true`. Other `_meta.transform` packages are rejected.
       Templates are never moved: copy them (including SubBlocks /
       bound `T`), set `template=false` on the copy, rewrite local type
       FQNs onto the copy, and relocate that copy instead.
    5. Resolve `parameters`. CLI `--parameter-mappings` or pending
       `parameterMappings` wins and ignores `--parameters`: close each
       mapping `source` against this Block, then apply the mappings in
       order onto `parameters`. A non-empty CLI array replaces pending
       mappings on the running copy. Otherwise `StructType` deep-merges
       CLI JSON over pending; other types replace. Write a value only
       when one exists (not `""`, not `{}`). Bound `T` defaults to
       `type:Text`. Mapping fault: write `workflow:ParametersException`
       onto `exception`, persist Running, skip operations.
    6. Commit the running relocation.

    Default implementation is deterministic. TS: pipeline/prepare.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:ExecuteTask" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

  <properties>
    <pendingFqn type="type:Text">
      <documentation>Pending ModelTransformation FQN. Need not live under the target library. (required)</documentation>
    </pendingFqn>
    <runningFqn type="type:Text">
      <documentation>Running ModelTransformation FQN after relocation. (required)</documentation>
    </runningFqn>
    <sequence type="type:Integer">
      <documentation>Allocated execution sequence. (required)</documentation>
    </sequence>
  </properties>

</block>
