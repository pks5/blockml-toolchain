<!--
  Transformer Capability — PersistExecution
  FQN: org.blockml.bml.transformer.capability.PersistExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>PersistExecution</name>
  <type>transformercap:PersistExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process stage [4] — write reflection into the running TaskExecution</is>

  <documentation>
    # Persist Execution

    Write `changedFiles`, `feedback`, and on failure the BML exception into
    the running TaskExecution. Must not relocate the Block.

    Default implementation is a deterministic BOM writer. Skips I/O when
    `changedFiles` is empty, `feedback` is absent, and no exception is present.
    TS: pipeline/persist.ts and execution/persist.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:ReflectOnExecution" relation="SeeAlso" />
    <see type="transformercap:FinalizeExecution" relation="SeeAlso" />
    <see type="workflow:TaskExecution" relation="SeeAlso" />
  </references>

  <properties>
    <changedFiles type="type:Text[]">
      <documentation>Paths to persist onto TaskExecution.changedFiles. (required)</documentation>
    </changedFiles>
    <feedback type="type:Text">
      <documentation>Text to persist onto TaskExecution.feedback. (optional)</documentation>
    </feedback>
  </properties>

</block>
