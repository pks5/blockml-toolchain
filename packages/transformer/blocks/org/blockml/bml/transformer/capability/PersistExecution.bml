<!--
  Transformer Capability — PersistExecution
  FQN: org.blockml.bml.transformer.capability.PersistExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>PersistExecution</name>
  <type>transformercap:PersistExecution</type>
  <baseType>core:Capability</baseType>
  <is>Process stage [4] — write reflection into the current Stage</is>

  <documentation>
    # Persist Execution

    Write `changedFiles`, `feedback`, `status`, `completedAt`, and on
    failure the BML exception into the current `workflow:Stage`. When the
    Stage succeeded and reflection supplied a `result` (the Stage
    aggregated a `workflow:ResultProducer`), write that value onto
    `result`. Then commit model changes together with that Stage terminal
    state. Must not relocate the ModelTransformation and must not write
    those fields onto the ModelTransformation.

    Default implementation is a deterministic BOM writer. Always writes
    Stage status. Does not interpret produce. TS: pipeline/persist.ts
    and execution/persist.ts.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="SeeAlso" />
    <see type="transformercap:ReflectOnExecution" relation="SeeAlso" />
    <see type="transformercap:FinalizeExecution" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
    <see type="workflow:Stage" relation="SeeAlso" />
    <see type="workflow:ResultProducer" relation="SeeAlso" />
  </references>

  <properties>
    <changedFiles type="type:Text[]">
      <documentation>Workspace-relative paths persisted as FilePathEntity children of Stage.changedFiles. (required)</documentation>
    </changedFiles>
    <feedback type="type:Text">
      <documentation>Text to persist onto Stage.feedback. (optional)</documentation>
    </feedback>
    <result type="type:Text">
      <documentation>
        Typed produce outcome to persist onto Stage.result when the Stage
        succeeded. (optional)
      </documentation>
    </result>
  </properties>

</block>
