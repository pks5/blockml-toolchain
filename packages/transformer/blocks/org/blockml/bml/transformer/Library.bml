<!--BlockML Transformer Library Descriptor
  FQN: org.blockml.bml.transformer.Library-->
<transformer:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Transformer package library catalog
  </is>
  <version>
    0.9.11
  </version>
  <documentation>
    Canonical transformer specification for BlockML — sequential
    ModelOperations over ModelTransformation. TypeScript in
    packages/transformer/src/ implements this library. Membership is defined
    exclusively by this blocks list.
  </documentation>
  <references>
    <see type="transformer:README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Transformer library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <transformer:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <workflow:CompositeRule />
        <workflow:CompositeTask />
        <workflow:Criterion />
        <workflow:ExecutionException />
        <workflow:ExecutionStatus />
        <workflow:AgenticOperation />
        <workflow:AuthorativeSourceSet />
        <workflow:InstructionRule />
        <workflow:InstructionTask />
        <workflow:ModelOperation />
        <workflow:ModelTransformation />
        <workflow:Prerequisite />
        <workflow:ParameterMapping />
        <workflow:ParametersException />
        <workflow:PrerequisiteNotMetException />
        <workflow:ResultException />
        <workflow:ResultMapping />
        <workflow:Rule />
        <workflow:Sector />
        <workflow:SectorModel />
        <workflow:Task />
        <workflow:ToolOperation />
        <transformercap:AgenticExecutor />
        <transformercap:ExecuteTask />
        <transformercap:FinalizeExecution />
        <transformercap:OperationExecutor />
        <transformercap:PersistExecution />
        <transformercap:PrepareExecution />
        <transformercap:ReflectOnExecution />
        <transformercap:RunTransformation />
        <transformercap:ToolExecutor />
        <transformerdocumentation:ArchitectureOverview />
      </composition>
    </blocks>
  </aggregations>
</transformer:Library>