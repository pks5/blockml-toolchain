<!--BlockML Transformer Library Descriptor
  FQN: org.blockml.bml.transformer.Library-->
<block xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd                       ">

  <name>
    Library
  </name>
  <type>
    blockml:transformer.Library
  </type>
  <baseType>
    blockml:core.BlockLibrary
  </baseType>
  <is>
    The BlockML Transformer package library catalog
  </is>
  <version>
    0.9.1
  </version>
  <documentation>
    Canonical transformer specification for BlockML — sequential
    ModelOperations over ModelTransformation. TypeScript in
    packages/transformer/src/ implements this library. Membership is defined
    exclusively by this blocks list.
  </documentation>
  <references>
    <see type="blockml:transformer.README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Transformer library</value>
    </description>
  </properties>
  <aggregations>
    <readMe>
      <composition>
        <blockml:transformer.README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition>
        <blockml:transformer.workflow.CompositeTask />
        <blockml:transformer.workflow.Criterion />
        <blockml:transformer.workflow.ExecutionException />
        <blockml:transformer.workflow.ExecutionStatus />
        <blockml:transformer.workflow.AgenticOperation />
        <blockml:transformer.workflow.InstructionRule />
        <blockml:transformer.workflow.InstructionTask />
        <blockml:transformer.workflow.ModelOperation />
        <blockml:transformer.workflow.ModelTransformation />
        <blockml:transformer.workflow.Prerequisite />
        <blockml:transformer.workflow.ParametersException />
        <blockml:transformer.workflow.PrerequisiteNotMetException />
        <blockml:transformer.workflow.ResultException />
        <blockml:transformer.workflow.ResultMapping />
        <blockml:transformer.workflow.Rule />
        <blockml:transformer.workflow.Task />
        <blockml:transformer.workflow.ToolOperation />
        <blockml:transformer.capability.AgenticExecutor />
        <blockml:transformer.capability.ExecuteTask />
        <blockml:transformer.capability.FinalizeExecution />
        <blockml:transformer.capability.OperationExecutor />
        <blockml:transformer.capability.PersistExecution />
        <blockml:transformer.capability.PrepareExecution />
        <blockml:transformer.capability.ReflectOnExecution />
        <blockml:transformer.capability.RunTransformation />
        <blockml:transformer.capability.ToolExecutor />
        <blockml:transformer.documentation.ArchitectureOverview />
      </composition>
    </blocks>
  </aggregations>
</block>