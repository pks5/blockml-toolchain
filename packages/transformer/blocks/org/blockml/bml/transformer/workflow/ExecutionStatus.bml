<!--
  Transformer Workflow — ExecutionStatus
  FQN: org.blockml.bml.transformer.workflow.ExecutionStatus
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>ExecutionStatus</name>
  <type>workflow:ExecutionStatus</type>
  <baseType>type:EnumType</baseType>
  <is>The lifecycle state of a ModelTransformation or ModelOperation</is>

  <documentation>
    Closed set of states a `workflow:ModelTransformation` or
    `workflow:ModelOperation` can be in.

    On a ModelTransformation the `_meta.transform` package of the Block
    matches this value:

    * `Pending` — created, not yet started (`_meta.transform.pending`).
    * `Running` — currently executing (`_meta.transform.running`).
    * `Failed` — finished unsuccessfully (`_meta.transform.failed`).
    * `Succeeded` — finished successfully (`_meta.transform.succeeded`).

    A ModelOperation uses the same values. Its `Running` state is
    persisted and committed before the registered executor runs
    (recovery boundary). A ModelOperation `Failed` aborts the remaining
    operations and fails the transformation.
  </documentation>

  <references>
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
    <see type="workflow:ModelOperation" relation="SeeAlso" />
    <see type="type:EnumType" relation="Extends" />
  </references>

  <aggregations>
    <values>
      <composition>
        <workflow:ExecutionStatus bml:id="Pending" />
        <workflow:ExecutionStatus bml:id="Running" />
        <workflow:ExecutionStatus bml:id="Failed" />
        <workflow:ExecutionStatus bml:id="Succeeded" />
      </composition>
    </values>
  </aggregations>

</block>
