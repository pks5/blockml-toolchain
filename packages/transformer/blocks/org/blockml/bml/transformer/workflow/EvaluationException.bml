<!--
  Transformer Workflow — EvaluationException
  FQN: org.blockml.bml.transformer.workflow.EvaluationException
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>EvaluationException</name>
  <type>workflow:EvaluationException</type>
  <baseType>core:Exception</baseType>
  <is>A thrown condition for an unforeseen evaluation failure</is>

  <documentation>
    Unforeseen Criterion.isSatisfied or Prerequisite.require failure — not declared
    in advance (missing context, I/O, …). Distinct from CriterionNotSatisfiedException
    (known unsatisfied acceptance criterion). Inherits message from core:Exception.
  </documentation>

  <isNot>Not CriterionNotSatisfiedException (known unsatisfied criterion) and not a
    validator diagnostic (org.blockml.bml.core.Diagnostic).</isNot>

  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:CriterionNotSatisfiedException" relation="ContrastsWith" />
    <see type="workflow:Criterion" relation="SeeAlso" />
    <see type="workflow:Prerequisite" relation="SeeAlso" />
  </references>

</block>
