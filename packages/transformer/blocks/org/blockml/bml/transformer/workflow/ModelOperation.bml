<!--
  Transformer Workflow — ModelOperation
  FQN: org.blockml.bml.transformer.workflow.ModelOperation
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>ModelOperation</name>
  <type>workflow:ModelOperation</type>
  <baseType>core:Block</baseType>
  <is>A self-contained operation of a ModelTransformation</is>
  <abstract>true</abstract>

  <documentation>
    Abstract envelope for one self-contained (Model-)Operation of a
    ModelTransformation. Concrete subtypes (for example
    `workflow:AgenticOperation`, `workflow:ToolOperation`) add
    type-specific members. Instances
    must be a concrete subtype; this type itself is not instantiated.

    The transformer writes envelope fields the same way for every
    subtype. A registered `transformercap:OperationExecutor` does only the
    type-specific work and may return output text.

    * `status` — lifecycle state (`workflow:ExecutionStatus`).
    * `startedAt` / `completedAt` — the interval of this operation.
    * `baseCommit` — Git HEAD commit when this operation started.
    * `captureOutput` — when true, the envelope writes the executor's
      output text onto `output`. Default false: `output` stays unset.
    * `output` — optional text this operation produced (agent stdout,
      tool stdout, or a deterministic summary). Present only when
      `captureOutput` is true. Persist sanitizes the text so the
      archive stays well-formed XML: XML 1.0 illegal characters and
      U+FFFD (replacement character) become `\uXXXX` escapes. Entity
      escaping of ampersand and less-than is not enough — U+FFFD is a
      legal XML Char but the parser treats it as an encoding error.
    * `changedFiles` — workspace-relative paths modified during this
      operation (`type:FilePathEntity[]`).
    * `resultMappings` — optional `workflow:ResultMapping` list. When
      Persist would set `status=Succeeded`, it applies each mapping in
      order onto the enclosing ModelTransformation `result`. A mapping
      fault writes `workflow:ResultException` onto this operation,
      sets `status=Failed`, and aborts remaining operations.
    * `exception` — present if and only if `status` is Failed.
  </documentation>

  <references>
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
    <see type="workflow:AgenticOperation" relation="SeeAlso" />
    <see type="workflow:ToolOperation" relation="SeeAlso" />
    <see type="workflow:ResultMapping" relation="SeeAlso" />
    <see type="workflow:ResultException" relation="SeeAlso" />
    <see type="transformercap:OperationExecutor" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="core:Exception" relation="SeeAlso" />
    <see type="type:FilePathEntity" relation="SeeAlso" />
  </references>

  <properties>
    <name type="type:Text">
      <documentation>Name of this ModelOperation.</documentation>
    </name>
    <status type="workflow:ExecutionStatus">
      <documentation>Lifecycle state of this ModelOperation.</documentation>
    </status>
    <startedAt type="type:DateTime">
      <documentation>When this ModelOperation started.</documentation>
    </startedAt>
    <baseCommit type="type:Text">
      <documentation>Git HEAD commit when this ModelOperation started.</documentation>
    </baseCommit>
    <completedAt type="type:DateTime">
      <documentation>When this ModelOperation finished.</documentation>
    </completedAt>
    <captureOutput type="type:Boolean">
      <documentation>
        When true, the envelope writes the executor output text onto
        output. Default false.
      </documentation>
      <value>false</value>
    </captureOutput>
    <output type="type:Text">
      <documentation>
        Optional text this ModelOperation produced. Written by the
        envelope when captureOutput is true. Absent otherwise.
        Sanitized to XML-safe text (illegal XML 1.0 chars and U+FFFD
        become \uXXXX) so the archive remains parseable.
      </documentation>
    </output>
  </properties>

  <aggregations>
    <changedFiles type="type:FilePathEntity[]">
      <documentation>Workspace-relative paths modified during this ModelOperation.</documentation>
    </changedFiles>
    <resultMappings type="workflow:ResultMapping[]">
      <documentation>
        Mappings Persist applies onto ModelTransformation.result when
        this operation succeeds. Empty: leave result unchanged.
      </documentation>
    </resultMappings>
    <exception type="core:Exception">
      <documentation>The Exception thrown during this ModelOperation, if any.</documentation>
    </exception>
  </aggregations>

</block>
