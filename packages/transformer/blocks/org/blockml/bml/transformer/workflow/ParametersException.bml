<!--
  Transformer Workflow — ParametersException
  FQN: org.blockml.bml.transformer.workflow.ParametersException
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>ParametersException</name>
  <type>workflow:ParametersException</type>
  <baseType>core:Exception</baseType>
  <is>A thrown condition when ModelTransformation parameters cannot be resolved</is>

  <documentation>
    # Parameters Exception

    Prepare could not copy `parametersSource` onto `parameters`:

    * the path points at an unknown Block or Property
    * or the Property type does not match the bound parameter generic `T`

    Distinct from ResultException (Finalize result fault) and
    ExecutionException (a ModelOperation fault). Inherits message from
    core:Exception. Written only onto `workflow:ModelTransformation.exception`.
    A ModelOperation failure leaves that aggregation empty.
  </documentation>

  <isNot>Not ResultException (Finalize result fault), not ExecutionException
    (ModelOperation execution fault), and not a validator diagnostic
    (org.blockml.bml.core.Diagnostic).</isNot>

  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:ResultException" relation="ContrastsWith" />
    <see type="workflow:ExecutionException" relation="ContrastsWith" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

</block>
