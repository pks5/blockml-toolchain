<!--
  Transformer Workflow — ResultMapping
  FQN: org.blockml.bml.transformer.workflow.ResultMapping
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>ResultMapping</name>
  <type>workflow:ResultMapping</type>
  <baseType>core:Block</baseType>
  <is>A mapping from a source Property onto the transformation result</is>

  <documentation>
    DTO that describes how a source Property maps onto a transformation
    `result`. This type does not validate: it does not check that
    `source` exists, that `sourcePath` / `resultPath` are well-formed,
    or that types are compatible. Persist evaluates each mapping on a
    succeeding `workflow:ModelOperation` and throws
    `workflow:ResultException` on that operation when a rule fails.

    * `source` — required `type:PropertyIdentifier` of the Property to
      read. Unchecked at authoring time. At runtime the path is closed
      against the enclosing ModelTransformation, then looked up.
    * `sourcePath` — optional OpenUI5 model path into `source`.
    * `resultPath` — optional OpenUI5 model path into `result`.

    Paths are valid only on a `type:StructType` or an array. A numeric
    segment selects an array index (0-based). A name segment selects a
    Struct field. A non-array Struct's first segment must be a name.
    A path into a scalar (for example `type:Text`) is invalid.

    No paths: the whole source value replaces `result`. The source type
    must equal bound `R`. `resultPath` on an unset `result` initializes
    empty `R` (`{}` or `[]`). Writing creates missing Struct fields.
    Array index equal to length appends; a greater index fails. Reading
    a missing field or index fails. Selected leaf types must be equal.
  </documentation>

  <isNot>Not a validator or Constraint, and not an existence-checked
    type:PropertyReference.</isNot>

  <references>
    <see type="type:PropertyIdentifier" relation="SeeAlso" />
    <see type="type:StructType" relation="SeeAlso" />
    <see type="workflow:ModelOperation" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
    <see type="workflow:ResultException" relation="SeeAlso" />
  </references>

  <properties>
    <source type="type:PropertyIdentifier">
      <documentation>
        Required path of the Property to read. Unchecked
        PropertyIdentifier: syntax only; the property need not exist.
      </documentation>
    </source>
    <sourcePath type="type:Text">
      <documentation>
        Optional OpenUI5 model path into source. Valid on StructType or
        an array. Examples: /0/myProp, /1, /myProp/2, /myProp,
        /myProp/myChild.
      </documentation>
    </sourcePath>
    <resultPath type="type:Text">
      <documentation>
        Optional OpenUI5 model path into the result object. Same format
        as sourcePath.
      </documentation>
    </resultPath>
  </properties>

</block>
