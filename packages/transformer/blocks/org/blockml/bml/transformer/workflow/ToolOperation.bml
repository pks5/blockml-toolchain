<!--Transformer Workflow — ToolOperation
  FQN: org.blockml.bml.transformer.workflow.ToolOperation-->
<workflow:ToolOperation xmlns="http://blockml.org/bml"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    workflow:ModelOperation
  </baseType>
  <is>
    A ModelOperation that runs an npm CLI tool deterministically
  </is>
  <documentation>
    Concrete `workflow:ModelOperation` whose type-specific work is an
    npm CLI invocation executed by `transformercap:ToolExecutor`.
    
    The envelope `name` is the operation label (for example
    "Validate model"). Do not add a second name for the tool.
    
    * `command` — one npm bin token (`blockml`). Required while pending.
    * `args` — argv after the command (`validate`, `--all`). Optional.
    
    The executor builds argv as `npx`, `command`, then `args`. No shell.
    cwd is the worktree. Must not write `_meta/transform/`. Non-zero
    exit fails the operation. Combined stdout/stderr is the output
    candidate; `captureOutput` decides whether the envelope persists
    that text.
  </documentation>
  <references>
    <see type="workflow:ModelOperation" relation="Extends" />
    <see type="transformercap:ToolExecutor" relation="SeeAlso" />
  </references>
  <properties>
    <command type="type:Text">
      <documentation>
        npm bin token passed after npx (for example blockml). Required
        while pending. A single token; not a shell string.
      </documentation>
    </command>
    <args type="type:Text[]">
      <documentation>
        Additional argv after command (for example validate, --all).
      </documentation>
    </args>
  </properties>
</workflow:ToolOperation>
