<!--
  Transformer Workflow — EmptyStruct
  FQN: org.blockml.bml.transformer.workflow.EmptyStruct
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>EmptyStruct</name>
  <type>workflow:EmptyStruct</type>
  <baseType>type:StructType</baseType>
  <is>A StructType with no fields</is>

  <documentation>
    Unit StructType — the only compatible value is an empty object `{}`.
    Default binding for `workflow:ModelTransformation` generic `T`, so an
    unparameterized transformation accepts no parameters. Candidate to move
    to `org.blockml.bml.type.EmptyStruct`.
  </documentation>

  <references>
    <see type="type:StructType" relation="Extends" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

</block>
