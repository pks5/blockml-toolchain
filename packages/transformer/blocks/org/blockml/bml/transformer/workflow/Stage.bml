<!--
  Transformer Workflow — Stage
  FQN: org.blockml.bml.transformer.workflow.Stage
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type"
  xmlns:lang="org.blockml.bml.language"
  xmlns:cap="org.blockml.bml.capability">

  <name>Stage</name>
  <type>workflow:Stage</type>
  <baseType>core:Block</baseType>
  <is>An isolated part of a ModelTransformation</is>

  <documentation>
    An isolated part of a ModelTransformation.

    A Stage runs in its own agent process. It owns `feedback` and
    `changedFiles` independently of other Stages in the same transformation.

    * `status` — lifecycle state (`workflow:ExecutionStatus`).
    * `startedAt` / `completedAt` — the interval of this Stage.
    * `baseCommit` — Git HEAD commit when this Stage started.
    * `task` — the Task that ran in this Stage.
    * `resultProducer` — optional strategy that produces `result` of bound
      `T` (`workflow:ResultProducer(T)`). After a successful Task, the
      transformer invokes `produce` and writes the value onto `result`.
    * `feedback` — Stage-local feedback from its agent process.
    * `changedFiles` — workspace-relative paths modified during this Stage
      (`type:FilePathEntity[]`).
    * `result` — typed outcome of this Stage, produced by `resultProducer`
      when that aggregation is present.
    * `exception` — present if and only if `status` is Failed.
  </documentation>

  <references>
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:ResultProducer" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="core:Exception" relation="SeeAlso" />
    <see type="type:FilePathEntity" relation="SeeAlso" />
  </references>

  <genericTypes>
    <T baseType="core:ValueType" defaultType="type:Text" />
  </genericTypes>

  <properties>
    <name type="type:Text">
      <documentation>Name of this Stage.</documentation>
    </name>
    <status type="workflow:ExecutionStatus">
      <documentation>Lifecycle state of this Stage.</documentation>
    </status>
    <startedAt type="type:DateTime">
      <documentation>When this Stage started.</documentation>
    </startedAt>
    <baseCommit type="type:Text">
      <documentation>Git HEAD commit when this Stage started.</documentation>
    </baseCommit>
    <completedAt type="type:DateTime">
      <documentation>When this Stage finished.</documentation>
    </completedAt>
    <feedback type="type:Text">
      <documentation>Feedback from this Stage's agent process.</documentation>
    </feedback>
    <result type="T">
      <documentation>
        Typed outcome of this Stage. Written from resultProducer.produce
        after a successful Task when that aggregation is present.
      </documentation>
    </result>
  </properties>

  <aggregations>
    <task type="workflow:Task">
      <documentation>The Task that ran in this Stage.</documentation>
    </task>
    <resultProducer type="workflow:ResultProducer(T)">
      <documentation>
        How this Stage's result is produced. When present, produce is
        invoked after a successful Task and the returned value is written
        onto result. Absent when this Stage has no typed result.
      </documentation>
    </resultProducer>
    <changedFiles type="type:FilePathEntity[]">
      <documentation>Workspace-relative paths modified during this Stage.</documentation>
    </changedFiles>
    <exception type="core:Exception">
      <documentation>The Exception thrown during this Stage, if any.</documentation>
    </exception>
  </aggregations>

  
</block>
