<!--
  Transformer Workflow — ModelTransformation
  FQN: org.blockml.bml.transformer.workflow.ModelTransformation
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>ModelTransformation</name>
  <type>workflow:ModelTransformation</type>
  <baseType>core:Block</baseType>
  <is>A recorded transformation of the model by a workflow Task</is>

  <documentation>
    One transformation of the model driven by a Task.

    * `status` — lifecycle state (`workflow:ExecutionStatus`). Matches the
      `_transform` package: Pending, Running, Succeeded, Failed.
    * `startedAt` / `completedAt` — the execution interval.
    * `baseCommit` — Git HEAD commit when this execution started. Set only
      after Prepare confirms a clean worktree and sets `status=Running`.
    * `task` — the Task that ran.
    * `changedFiles` — workspace-relative paths modified during this execution
      (`type:FilePathEntity[]`).
    * `exception` — present if and only if `status` is Failed.
    * Persist writes `changedFiles` and `feedback` onto this Block while it is still running.
  </documentation>

  <references>
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="core:Exception" relation="SeeAlso" />
    <see type="type:FilePathEntity" relation="SeeAlso" />
  </references>

  <properties>
    <executionId type="type:Text">
      <documentation>Globally unique identifier of this execution.</documentation>
    </executionId>
    <sequence type="type:Integer">
      <documentation>Which execution within the model this task was applied to.</documentation>
    </sequence>
    <status type="workflow:ExecutionStatus">
      <documentation>Lifecycle state of this execution.</documentation>
    </status>
    <createdAt type="type:DateTime">
      <documentation>When this execution was created.</documentation>
    </createdAt>
    <startedAt type="type:DateTime">
      <documentation>When this execution started.</documentation>
    </startedAt>
    <baseCommit type="type:Text">
      <documentation>Git HEAD commit at start, recorded after a clean-worktree check.</documentation>
    </baseCommit>
    <completedAt type="type:DateTime">
      <documentation>When this execution finished.</documentation>
    </completedAt>
  </properties>

  <aggregations>
    <stages type="workflow:Stage[]">
      <documentation>The stages that ran in this execution.</documentation>
    </stages>
  </aggregations>

</block>
