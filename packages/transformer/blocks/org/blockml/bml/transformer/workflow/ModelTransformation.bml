<!--
  Transformer Workflow — ModelTransformation
  FQN: org.blockml.bml.transformer.workflow.ModelTransformation
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>ModelTransformation</name>
  <type>workflow:ModelTransformation</type>
  <baseType>core:Block</baseType>
  <is>A recorded transformation of the model by sequential workflow Stages</is>

  <documentation>
    One transformation of the model driven by sequential `workflow:Stage`
    instances. Each Stage runs one Task in an isolated agent process.

    * `template` — when true, this Block is a reusable template. Prepare
      leaves it in `_meta.transform.pending`, copies it, sets
      `template=false` on the copy, and relocates that copy to running.
      The copy is a snapshot: SubBlocks (including bound `T`) are copied
      and rewritten onto the copy, so later template edits cannot change
      recorded executions. Default false: the pending Block is relocated
      and removed.
    * `parameters` — run values of generic `T` (`type:StructType`, default
      `type:EmptyStruct`). Bind `T` with
      `baseType=workflow:ModelTransformation(Parameters)` and a same-Block
      SubBlock `Parameters`. Prepare deep-merges CLI `--parameters` JSON
      over pending defaults, checks the bound `T`, and writes the result
      onto the running copy. Execute does not interpret this property.
    * `status` — lifecycle state (`workflow:ExecutionStatus`). Matches the
      `_meta.transform` package: Pending, Running, Succeeded, Failed.
      `Succeeded` only when every Stage succeeded.
    * `executionId` — globally unique identifier. Absent while pending.
      Assigned when Prepare sets `status=Running` (random UUID, unique
      among other ModelTransformations).
    * `startedAt` / `completedAt` — the execution interval.
    * `baseCommit` — Git HEAD commit when this execution started. Set only
      after Prepare confirms a clean worktree and sets `status=Running`.
    * `stages` — the Stages of this execution, in order. Feedback,
      `changedFiles`, and `exception` live on each Stage, not on this Block.
  </documentation>

  <references>
    <see type="workflow:Stage" relation="SeeAlso" />
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="type:EmptyStruct" relation="SeeAlso" />
  </references>

  <genericTypes>
    <T baseType="type:StructType" defaultType="type:EmptyStruct" />
  </genericTypes>

  <properties>
    <description type="type:Text">
      <documentation>Description of this transformation.</documentation>
    </description>
    <template type="type:Boolean">
      <documentation>
        When true, this ModelTransformation is a reusable template. Prepare
        leaves the pending Block in place, copies it including SubBlocks,
        sets template=false on the copy, rewrites local type FQNs onto the
        copy, and relocates that copy to running. Default false.
      </documentation>
      <value>false</value>
    </template>
    <parameters type="T">
      <documentation>
        Run parameters of bound T. Default type:EmptyStruct (empty object).
        Prepare merges CLI JSON over pending values and writes the result
        when setting Running. Tasks do not read this; map it later with
        expressions.
      </documentation>
    </parameters>
    <executionId type="type:Text">
      <documentation>Globally unique identifier. Absent while pending; assigned at Running.</documentation>
    </executionId>
    <sequence type="type:Integer">
      <documentation>Which execution within the model this transformation was applied to.</documentation>
    </sequence>
    <status type="workflow:ExecutionStatus">
      <documentation>Lifecycle state of this execution.</documentation>
    </status>
    <createdAt type="type:DateTime">
      <documentation>When this execution was created.</documentation>
    </createdAt>
    <startedAt type="type:DateTime">
      <documentation>When this execution started.</documentation>
    </startedAt>
    <baseCommit type="type:Text">
      <documentation>Git HEAD commit at start, recorded after a clean-worktree check.</documentation>
    </baseCommit>
    <completedAt type="type:DateTime">
      <documentation>When this execution finished.</documentation>
    </completedAt>
  </properties>

  <aggregations>
    <stages type="workflow:Stage[]">
      <documentation>The stages that ran in this execution.</documentation>
    </stages>
  </aggregations>

</block>
