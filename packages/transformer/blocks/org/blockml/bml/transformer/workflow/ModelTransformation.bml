<!--
  Transformer Workflow — ModelTransformation
  FQN: org.blockml.bml.transformer.workflow.ModelTransformation
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>ModelTransformation</name>
  <type>workflow:ModelTransformation</type>
  <baseType>core:Block</baseType>
  <is>A recorded transformation of the model by sequential ModelOperations</is>

  <documentation>
    One transformation of the model driven by sequential
    `workflow:ModelOperation` instances. Operations may be mixed concrete
    subtypes. `workflow:AgenticOperation` runs a Task in an isolated
    agent process. `workflow:ToolOperation` runs an npm CLI tool
    via npx. Other subtypes use their registered executor.

    * `template` — when true, this Block is a reusable template. Prepare
      leaves it in `_meta.transform.pending`, copies it, sets
      `template=false` on the copy, and relocates that copy to running.
      The copy is a snapshot: SubBlocks (including bound `T`) are copied
      and rewritten onto the copy, so later template edits cannot change
      recorded executions. Default false: the pending Block is relocated
      and removed.
    * `parameters` — run value of generic `T` (`core:ValueType`, default
      `type:Text`). Bind a Struct with
      `baseType=workflow:ModelTransformation(Parameters)` and a same-Block
      SubBlock `Parameters`. Prepare writes a value only when one exists
      (not `""`, not `{}`). `StructType`: deep-merge CLI `--parameters`
      over pending. Other types: CLI replaces pending. Execute does not
      interpret this property.
    * `parametersSource` — optional `type:PropertyReference` whose current
      value Prepare copies onto `parameters`. Canonical path
      `BlockFqn.properties.name`. CLI `--parameters-source` wins over
      pending. Any effective source ignores `--parameters`. Type of the
      source Property must equal bound `T`.
    * `resultSource` — optional `type:PropertyReference` to the Property
      whose current value Finalize copies onto `result`. Canonical path
      `BlockFqn.properties.name`. Absent or empty: Finalize skips result.
    * `result` — value of generic `R` (`core:ValueType`, default
      `type:Text`). Bind `R` as the second type argument, e.g.
      `workflow:ModelTransformation(Parameters, type:Integer)`. Written
      only at Finalize after every ModelOperation succeeded. Type of the
      source Property must equal bound `R`.
    * `exception` — `core:Exception` when Prepare cannot resolve
      `parametersSource` (`workflow:ParametersException`) or Finalize
      cannot resolve `resultSource` (`workflow:ResultException`). Empty
      when a ModelOperation fails; operation faults stay on that
      ModelOperation.
    * `status` — lifecycle state (`workflow:ExecutionStatus`). Matches the
      `_meta.transform` package: Pending, Running, Succeeded, Failed.
      `Succeeded` only when every ModelOperation succeeded and result
      resolution did not throw.
    * `executionId` — globally unique identifier (`type:UUID`). Absent
      while pending. Assigned when Prepare sets `status=Running`
      (random UUID, unique among other ModelTransformations).
    * `startedAt` / `completedAt` — the execution interval.
    * `baseCommit` — Git HEAD commit when this execution started. Set only
      after Prepare confirms a clean worktree and sets `status=Running`.
    * `operations` — concrete ModelOperation subtypes of this execution,
      in order. `output`, `changedFiles`, and `exception` live on each
      operation. Agent Task work applies only to AgenticOperation.
  </documentation>

  <references>
    <see type="workflow:ModelOperation" relation="SeeAlso" />
    <see type="workflow:AgenticOperation" relation="SeeAlso" />
    <see type="workflow:ToolOperation" relation="SeeAlso" />
    <see type="workflow:OperationExecutor" relation="SeeAlso" />
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="type:PropertyReference" relation="SeeAlso" />
    <see type="type:UUID" relation="SeeAlso" />
    <see type="workflow:ParametersException" relation="SeeAlso" />
    <see type="workflow:ResultException" relation="SeeAlso" />
  </references>

  <genericTypes>
    <T baseType="core:ValueType" defaultType="type:Text" />
    <R baseType="core:ValueType" defaultType="type:Text" />
  </genericTypes>

  <properties>
    <description type="type:Text">
      <documentation>Description of this transformation.</documentation>
    </description>
    <template type="type:Boolean">
      <documentation>
        When true, this ModelTransformation is a reusable template. Prepare
        leaves the pending Block in place, copies it including SubBlocks,
        sets template=false on the copy, rewrites local type FQNs onto the
        copy, and relocates that copy to running. Default false.
      </documentation>
      <value>false</value>
    </template>
    <parameters type="T">
      <documentation>
        Run value of bound T. Default type:Text. Written only when a
        value exists. StructType: merge CLI over pending. Other types:
        CLI replaces pending. Tasks do not read this.
      </documentation>
    </parameters>
    <parametersSource type="type:PropertyReference">
      <documentation>
        Optional path to the Property Prepare copies onto parameters.
        Canonical form BlockFqn.properties.name. Any effective source
        ignores --parameters.
      </documentation>
    </parametersSource>
    <resultSource type="type:PropertyReference">
      <documentation>
        Optional path to the Property Finalize copies onto result.
        Canonical form BlockFqn.properties.name. Unset: skip result.
      </documentation>
    </resultSource>
    <executionId type="type:UUID">
      <documentation>Globally unique identifier. Absent while pending; assigned at Running.</documentation>
    </executionId>
    <sequence type="type:Integer">
      <documentation>Which execution within the model this transformation was applied to.</documentation>
    </sequence>
    <status type="workflow:ExecutionStatus">
      <documentation>Lifecycle state of this execution.</documentation>
    </status>
    <createdAt type="type:DateTime">
      <documentation>When this execution was created.</documentation>
    </createdAt>
    <startedAt type="type:DateTime">
      <documentation>When this execution started.</documentation>
    </startedAt>
    <baseCommit type="type:Text">
      <documentation>Git HEAD commit at start, recorded after a clean-worktree check.</documentation>
    </baseCommit>
    <completedAt type="type:DateTime">
      <documentation>When this execution finished.</documentation>
    </completedAt>
    <result type="R">
      <documentation>
        Value copied from resultSource at Finalize after every
        ModelOperation succeeded. Type is bound R (default type:Text).
        Absent when resultSource is unset or a ModelOperation failed.
      </documentation>
    </result>
  </properties>

  <aggregations>
    <operations type="workflow:ModelOperation[]">
      <documentation>Concrete ModelOperation subtypes of this execution, in order.</documentation>
    </operations>
    <exception type="core:Exception">
      <documentation>
        ParametersException from Prepare or ResultException from Finalize.
        Empty when a ModelOperation fails.
      </documentation>
    </exception>
  </aggregations>

</block>
