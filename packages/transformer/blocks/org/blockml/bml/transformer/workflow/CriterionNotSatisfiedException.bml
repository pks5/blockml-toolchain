<!--
  Transformer Workflow — CriterionNotSatisfiedException
  FQN: org.blockml.bml.transformer.workflow.CriterionNotSatisfiedException
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>CriterionNotSatisfiedException</name>
  <type>workflow:CriterionNotSatisfiedException</type>
  <baseType>core:Exception</baseType>
  <is>A thrown condition when a Criterion is not satisfied</is>

  <documentation>
    Base type for known, declared criterion failures (evaluated, does not hold).
    Distinct from EvaluationException (unforeseen evaluation faults).
    Inherits message from core:Exception.
  </documentation>

  <isNot>Not EvaluationException (unforeseen evaluation fault) and not a
    validator diagnostic (org.blockml.bml.core.Diagnostic).</isNot>

  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:EvaluationException" relation="ContrastsWith" />
    <see type="workflow:Criterion" relation="SeeAlso" />
  </references>

  <abstract>true</abstract>

</block>
