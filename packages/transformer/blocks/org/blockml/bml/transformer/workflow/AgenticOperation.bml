<!--
  Transformer Workflow — AgenticOperation
  FQN: org.blockml.bml.transformer.workflow.AgenticOperation
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>AgenticOperation</name>
  <type>workflow:AgenticOperation</type>
  <baseType>workflow:ModelOperation</baseType>
  <is>A ModelOperation that runs a Task in an isolated agent process</is>

  <documentation>
    Concrete `workflow:ModelOperation` whose type-specific work is a
    `workflow:Task` executed by `workflow:AgenticExecutor`.

    The envelope fields (`status`, timestamps, `baseCommit`,
    `captureOutput`, `output`, `changedFiles`, `exception`) are inherited.
    `task` is required while pending. Default executor: isolated agent
    process; output candidate is agent stdout.
  </documentation>

  <references>
    <see type="workflow:ModelOperation" relation="Extends" />
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:AgenticExecutor" relation="SeeAlso" />
  </references>

  <aggregations>
    <task type="workflow:Task">
      <documentation>The Task the AgenticExecutor performs for this operation.</documentation>
    </task>
  </aggregations>

</block>
