<!--Transformer Workflow — AgenticOperation
  FQN: org.blockml.bml.transformer.workflow.AgenticOperation-->
<workflow:AgenticOperation xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    workflow:ModelOperation
  </baseType>
  <is>
    A ModelOperation that runs a Task in an isolated agent process
  </is>
  <documentation>
    Concrete `workflow:ModelOperation` whose type-specific work is a
    `workflow:Task` executed by `transformercap:AgenticExecutor`.
    
    The envelope fields (`status`, timestamps, `baseCommit`,
    `captureOutput`, `output`, `changedFiles`, `resultMappings`,
    `exception`) are inherited.
    `task` is required while pending. The host closes the Task instance
    against the ModelTransformation context (every expression becomes a
    literal) and hands that prefix-free BML fragment to the agent. The
    agent interprets `Task.run`; it does not see this envelope. Default
    executor: isolated agent process; output candidate is agent stdout.
  </documentation>
  <references>
    <see type="workflow:ModelOperation" relation="Extends" />
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="transformercap:AgenticExecutor" relation="SeeAlso" />
  </references>
  <aggregations>
    <task type="workflow:Task">
      <documentation>
        The Task the AgenticExecutor performs for this operation.
      </documentation>
    </task>
  </aggregations>
</workflow:AgenticOperation>
