<!--Transformer Workflow — Prerequisite
  FQN: org.blockml.bml.transformer.workflow.Prerequisite-->
<workflow:Prerequisite xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    core:Block
  </baseType>
  <is>
    A precondition that must hold before a Task may run
  </is>
  <isnot>
    Not an acceptance Criterion (org.blockml.bml.transformer.workflow.Criterion),
    not a workflow Rule (obligation during Task.run), and not a BlockML validation
    Constraint (org.blockml.bml.core.Constraint / org.blockml.bml.constraint.*).
  </isnot>
  <documentation>
    Abstract precondition for Task.run. Concrete subtypes implement require; this type
    carries no implementation. Unlike Criterion, a Prerequisite is not an acceptance
    check after the task — it must already hold before the task starts.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="workflow:Criterion" relation="ContrastsWith" />
    <see type="workflow:Rule" relation="ContrastsWith" />
    <see type="workflow:Task" relation="SeeAlso" />
  </references>
  <capabilities>
    <require abstract="true" type="cap:Action">
      <throws>
        <workflow:PrerequisiteNotMetException />
        <workflow:ExecutionException />
      </throws>
      <documentation>
        Enforce this precondition. Concrete subtypes supply the Action implementation.
      </documentation>
    </require>
  </capabilities>
</workflow:Prerequisite>
