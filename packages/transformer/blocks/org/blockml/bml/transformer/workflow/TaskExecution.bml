<!--
  Transformer Workflow — TaskExecution
  FQN: org.blockml.bml.transformer.workflow.TaskExecution
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>TaskExecution</name>
  <type>workflow:TaskExecution</type>
  <baseType>core:Block</baseType>
  <is>A recorded execution of a workflow Task</is>

  <documentation>
    One execution of a Task against the model.

    * `status` — lifecycle state (`workflow:ExecutionStatus`). Matches the
      `_transform` package: Pending, Running, Succeeded, Failed.
    * `startedAt` / `completedAt` — the execution interval.
    * `task` — the Task that ran.
    * `exception` — present if and only if `status` is Failed.
    * Persist writes `changedFiles` and `feedback` onto this Block while it is still running.
  </documentation>

  <references>
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="core:Exception" relation="SeeAlso" />
  </references>

  <properties>
    <executionId type="type:Text">
      <documentation>Globally unique identifier of this execution.</documentation>
    </executionId>
    <sequence type="type:Integer">
      <documentation>Which execution within the model this task was applied to.</documentation>
    </sequence>
    <status type="workflow:ExecutionStatus">
      <documentation>Lifecycle state of this execution.</documentation>
    </status>
    <createdAt type="type:DateTime">
      <documentation>When this execution was created.</documentation>
    </createdAt>
    <startedAt type="type:DateTime">
      <documentation>When this execution started.</documentation>
    </startedAt>
    <completedAt type="type:DateTime">
      <documentation>When this execution finished.</documentation>
    </completedAt>
    <feedback type="type:Text">
      <documentation>Feedback from the task execution.</documentation>
    </feedback>
    <changedFiles type="type:Text[]">
      <documentation>Workspace-relative filesystem paths modified during this execution.</documentation>
    </changedFiles>
  </properties>

  <aggregations>
    <task type="workflow:Task">
      <documentation>The Task that was executed.</documentation>
    </task>
    <exception type="core:Exception">
      <documentation>The Exception thrown during this execution, if any.</documentation>
    </exception>
  </aggregations>

</block>
