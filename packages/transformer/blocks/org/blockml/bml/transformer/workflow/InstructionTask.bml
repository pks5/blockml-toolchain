<!--Transformer Workflow — InstructionTask
  FQN: org.blockml.bml.transformer.workflow.InstructionTask-->
<workflow:InstructionTask xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:lang="org.blockml.bml.language"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    workflow:Task
  </baseType>
  <is>
    A task described by instruction prose
  </is>
  <documentation>
    Task whose action is stated as free-form instructions. run still enforces
    prerequisites, rules, and successCriteria; execute reads and follows instructions.
  </documentation>
  <references>
    <see type="workflow:Task" relation="Extends" />
    <see type="workflow:InstructionRule" relation="SeeAlso" />
  </references>
  <properties>
    <instructions type="type:Text">
      <documentation>
        Prose that states what this task must do when execute runs.
      </documentation>
    </instructions>
  </properties>
  <capabilities>
    <_execute override="true" type="cap:Action">
      <documentation>
        Read the instructions property and follow them.
      </documentation>
      <implementation language="lang:English">
        <![CDATA[Read the instructions and follow them.]]>
      </implementation>
    </_execute>
  </capabilities>
</workflow:InstructionTask>
