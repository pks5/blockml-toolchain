<!--
  Transformer Workflow — AgenticExecutor
  FQN: org.blockml.bml.transformer.workflow.AgenticExecutor
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:cap="org.blockml.bml.capability"
  xmlns:lang="org.blockml.bml.language"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:type="org.blockml.bml.type">

  <name>AgenticExecutor</name>
  <type>workflow:AgenticExecutor</type>
  <baseType>workflow:OperationExecutor</baseType>
  <is>Executor for AgenticOperation — run the Task and return output text</is>

  <documentation>
    Default `workflow:OperationExecutor` for `workflow:AgenticOperation`.
    Performs `transformercap:ExecuteTask` in a new isolated agent process
    and returns agent stdout as the output candidate. The envelope
    decides whether to persist that text (`captureOutput`) and always
    collects `changedFiles` from git.

    Must not write ModelOperation envelope fields, commit, or write
    files under `_meta/transform/`. TS: executor/agentic-executor.ts.
  </documentation>

  <references>
    <see type="workflow:OperationExecutor" relation="Extends" />
    <see type="workflow:AgenticOperation" relation="SeeAlso" />
    <see type="transformercap:ExecuteTask" relation="SeeAlso" />
  </references>

  <capabilities>
    <execute override="true" type="cap:Action">
      <documentation>
        Run the AgenticOperation Task in an isolated agent process.
        Return agent stdout as the output candidate.
      </documentation>
      <implementation language="lang:English">
        <![CDATA[Perform the Task in an isolated agent process. Return stdout as the output candidate.]]>
      </implementation>
    </execute>
  </capabilities>

</block>
