<!--Transformer Workflow — Criterion
  FQN: org.blockml.bml.transformer.workflow.Criterion-->
<workflow:Criterion xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    An acceptance criterion for a completed task
  </is>
  <isnot>
    Not a Prerequisite (precondition before Task.run), not a workflow Rule
    (obligation during Task.run), and not a BlockML validation Constraint
    (org.blockml.bml.core.Constraint / org.blockml.bml.constraint.*).
  </isnot>
  <documentation>
    Abstract acceptance (success) condition. After Task.run, each success criterion
    must hold. Concrete subtypes implement isSatisfied; this type carries no
    implementation. Preconditions before the task belong on Prerequisite, not here.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="workflow:Prerequisite" relation="ContrastsWith" />
    <see type="workflow:Rule" relation="ContrastsWith" />
  </references>
  <capabilities>
    <isSatisfied abstract="true" type="cap:Outbound" outputType="type:Boolean">
      <throws>
        <workflow:ExecutionException />
      </throws>
      <documentation>
        Whether this acceptance criterion currently holds. Concrete subtypes supply the Outbound implementation.
      </documentation>
    </isSatisfied>
  </capabilities>
</workflow:Criterion>
