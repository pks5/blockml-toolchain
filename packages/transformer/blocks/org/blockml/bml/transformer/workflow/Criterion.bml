<!--
  Transformer Workflow — Criterion
  FQN: org.blockml.bml.transformer.workflow.Criterion
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow"
  xmlns:type="org.blockml.bml.type">

  <name>Criterion</name>
  <type>workflow:Criterion</type>
  <baseType>core:Block</baseType>
  <is>A criterion of any kind</is>

  <documentation>
    Abstract condition that can be evaluated to true or false. Concrete subtypes
    implement isSatisfied; this type carries no implementation.
  </documentation>

  <isNot>Not a BlockML validation Constraint (org.blockml.bml.core.Constraint / org.blockml.bml.constraint.*) and not a workflow Rule (obligation during Task.run).</isNot>

  <references>
    <see type="workflow:Rule" relation="ContrastsWith" />
  </references>

  <abstract>true</abstract>

  <capabilities>
    <satisfy type="cap:Action">
      <throws>
        <workflow:CriterionNotSatisfiedException />
        <workflow:EvaluationException />
      </throws>
      <abstract>true</abstract>
      <documentation>Whether this criterion currently holds. Concrete subtypes supply the Outbound implementation.</documentation>
    </satisfy>
  </capabilities>

</block>
