<!--
  Transformer Workflow — ResultException
  FQN: org.blockml.bml.transformer.workflow.ResultException
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>ResultException</name>
  <type>workflow:ResultException</type>
  <baseType>core:Exception</baseType>
  <is>A thrown condition when a ResultMapping cannot be applied</is>

  <documentation>
    # Result Exception

    Persist could not apply a `workflow:ResultMapping` onto
    `result` while completing a succeeding ModelOperation:

    * the `source` expression could not be closed
    * `source` points at an unknown Block or Property
    * a path is invalid for the current type (scalar, wrong first
      segment, out-of-range index)
    * or the selected leaf types are not equal

    Distinct from ParametersException (Prepare parameter fault) and
    ExecutionException (executor or other operation fault). Inherits
    message from core:Exception. Written onto the failed
    `workflow:ModelOperation.exception`. Leaves
    `workflow:ModelTransformation.exception` empty and aborts remaining
    operations.
  </documentation>

  <isNot>Not ParametersException (Prepare parameter fault), not
    ExecutionException (ModelOperation execution fault), and not a
    validator diagnostic (org.blockml.bml.core.Diagnostic).</isNot>

  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:ParametersException" relation="ContrastsWith" />
    <see type="workflow:ExecutionException" relation="ContrastsWith" />
    <see type="workflow:ResultMapping" relation="SeeAlso" />
    <see type="workflow:ModelOperation" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

</block>
