<!--
  Transformer Workflow — ResultException
  FQN: org.blockml.bml.transformer.workflow.ResultException
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>ResultException</name>
  <type>workflow:ResultException</type>
  <baseType>core:Exception</baseType>
  <is>A thrown condition when ModelTransformation result cannot be resolved</is>

  <documentation>
    # Result Exception

    Finalize could not copy `resultSource` onto `result`:

    * the path points at an unknown Block or Property
    * or the Property type does not match the bound result generic `R`

    Distinct from ExecutionException (a Stage fault). Inherits message from
    core:Exception. Written only onto
    `workflow:ModelTransformation.resultException`. A Stage failure leaves
    that aggregation empty.
  </documentation>

  <isNot>Not ExecutionException (Stage execution fault) and not a
    validator diagnostic (org.blockml.bml.core.Diagnostic).</isNot>

  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:ExecutionException" relation="ContrastsWith" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
  </references>

</block>
