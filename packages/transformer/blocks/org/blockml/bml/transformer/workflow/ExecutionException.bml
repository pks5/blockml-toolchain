<!--Transformer Workflow — ExecutionException
  FQN: org.blockml.bml.transformer.workflow.ExecutionException-->
<workflow:ExecutionException xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <baseType>
    core:Exception
  </baseType>
  <is>
    A thrown condition for an unforeseen execution failure
  </is>
  <isnot>
    Not PrerequisiteNotMetException (known unmet prerequisite) and not a
    validator diagnostic (org.blockml.bml.core.Diagnostic).
  </isnot>
  <documentation>
    Unforeseen Criterion.isSatisfied or Prerequisite.require failure —
    not declared in advance (missing context, I/O, …). Distinct from
    PrerequisiteNotMetException (known unmet precondition). Inherits
    message from core:Exception.
  </documentation>
  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:PrerequisiteNotMetException" relation="ContrastsWith" />
    <see type="workflow:Criterion" relation="SeeAlso" />
    <see type="workflow:Prerequisite" relation="SeeAlso" />
  </references>
</workflow:ExecutionException>
