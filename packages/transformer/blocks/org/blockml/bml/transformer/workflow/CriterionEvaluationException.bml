<!--
  Transformer Workflow — CriterionEvaluationException
  FQN: org.blockml.bml.transformer.workflow.CriterionEvaluationException
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>CriterionEvaluationException</name>
  <type>workflow:CriterionEvaluationException</type>
  <baseType>core:Exception</baseType>
  <is>A thrown condition for an unforeseen Criterion evaluation failure</is>

  <documentation>
    Unforeseen Criterion.satisfy failure — not declared in advance (missing context, I/O, …).
    Distinct from CriterionNotSatisfiedException (known unsatisfied criterion).
    Inherits message from core:Exception.
  </documentation>

  <isNot>Not CriterionNotSatisfiedException (known unsatisfied criterion) and not a
    validator diagnostic (org.blockml.bml.core.Diagnostic).</isNot>

  <references>
    <see type="core:Exception" relation="Extends" />
    <see type="workflow:CriterionNotSatisfiedException" relation="ContrastsWith" />
    <see type="workflow:Criterion" relation="SeeAlso" />
  </references>

</block>
