<!--
  BlockML Transformer — README
  FQN: org.blockml.bml.transformer.README
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:transformer="org.blockml.bml.transformer"
  xmlns:transformercap="org.blockml.bml.transformer.capability"
  xmlns:transformerdocumentation="org.blockml.bml.transformer.documentation"
  xmlns:workflow="org.blockml.bml.transformer.workflow">

  <name>README</name>
  <type>transformer:README</type>
  <baseType>core:ReadMe</baseType>
  <is>Reading entry for the Transformer library</is>

  <documentation>
    The @blockml/transformer package owns the BlockML transformer library
    (org.blockml.bml.transformer.*). Workflow types live in
    org.blockml.bml.transformer.workflow.*. Process stages live in
    org.blockml.bml.transformer.capability.*.

    The TypeScript engine executes ModelTransformation instances via
    `blockml transform apply EXECUTION-FQN [--parameters JSON]`. Transformer.run prepares the
    execution, then runs each `workflow:Stage` in order: persist Stage
    Running, Execute its Task in an isolated agent process, Reflect,
    Persist results onto that Stage, commit. Default Prepare and Finalize
    are deterministic. Default Execute is a TransformationAgent that
    changes BML model source only (not ModelTransformation /
    `_meta/transform/`). Default Reflect is a second Claude worker
    (read-only; changedFiles + feedback; result when a ResultProducer is
    present). Default Persist writes those fields onto the Stage that just
    ran. After a started execution,
    Finalize relocates the Block to `_meta.transform.succeeded` only when
    every Stage succeeded, otherwise `_meta.transform.failed`. A failed
    Stage aborts the rest. Prepare requires
    a clean Git worktree, records `baseCommit`, and commits the running
    relocation. Each Stage commits Running first (recovery boundary), then
    commits model changes together with the Stage terminal state. Finalize
    commits the terminal relocation. Transformation intelligence lives in
    the model, not in the engine.
  </documentation>

  <references>
    <see type="transformerdocumentation:ArchitectureOverview" relation="ReadFirst" />
    <see type="transformercap:RunTransformation" relation="SeeAlso" />
    <see type="workflow:Task" relation="SeeAlso" />
    <see type="workflow:Stage" relation="SeeAlso" />
    <see type="workflow:ResultProducer" relation="SeeAlso" />
    <see type="workflow:ModelTransformation" relation="SeeAlso" />
    <see type="workflow:CompositeTask" relation="SeeAlso" />
    <see type="workflow:Prerequisite" relation="SeeAlso" />
    <see type="workflow:PrerequisiteNotMetException" relation="SeeAlso" />
    <see type="workflow:Criterion" relation="SeeAlso" />
    <see type="workflow:ExecutionException" relation="SeeAlso" />
    <see type="workflow:ExecutionStatus" relation="SeeAlso" />
    <see type="workflow:Rule" relation="SeeAlso" />
    <see type="workflow:InstructionRule" relation="SeeAlso" />
    <see type="workflow:InstructionTask" relation="SeeAlso" />
    <see type="type:EmptyStruct" relation="SeeAlso" />
  </references>

</block>
