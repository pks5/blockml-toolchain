{
  "name": "@blockml/search",
  "version": "0.9.5",
  "description": "BlockML local full-text search over the project BML corpus",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/search"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/search/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/search/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.9.5",
    "@blockml/core": "^1.3.0",
    "@blockml/framework": "^0.9.5",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18"
  },
  "engines": {
    "node": ">=20"
  }
}
