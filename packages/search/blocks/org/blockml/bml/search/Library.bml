<!--BlockML Search Library Descriptor
  FQN: org.blockml.bml.search.Library-->
<search:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:search="org.blockml.bml.search">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Search package library catalog
  </is>
  <version>
    0.9.13
  </version>
  <documentation>
    Canonical search specification for BlockML — local full-text search over the
    validate --all BML corpus. TypeScript in packages/search/src/ implements this library.
    Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Search library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <search:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <framework:Library />
      </composition>
    </dependencies>
  </aggregations>
</search:Library>
