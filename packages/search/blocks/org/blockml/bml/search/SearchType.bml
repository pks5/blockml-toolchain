<!--Search — SearchType
  FQN: org.blockml.bml.search.SearchType-->
<search:SearchType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:search="org.blockml.bml.search">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for Search implementation data-structure blocks
  </is>
  <documentation>
    SearchDocument, SearchResult, and related ValueTypes used as capability payloads.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>
</search:SearchType>
