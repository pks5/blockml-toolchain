<!--
  Search — SearchType
  FQN: org.blockml.bml.search.SearchType
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type">

  <name>SearchType</name>
  <type>search:SearchType</type>
  <baseType>core:Entity</baseType>
  <is>Abstract marker for Search implementation data-structure blocks</is>

  <documentation>SearchDocument, SearchResult, and related ValueTypes used as capability payloads.</documentation>

  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>

  <abstract>true</abstract>

</block>
