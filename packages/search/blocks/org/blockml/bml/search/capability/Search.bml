<!--Search Capability — Search
  FQN: org.blockml.bml.search.capability.Search-->
<searchcap:Search xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Full-text search over the local BML index
  </is>
  <documentation>
    Opens a ready index or rebuilds when missing/stale, then searches. Exact FQN lookup (document id) always ranks that block first. Remaining hits use Orama BM25. Boost: fqn 10, name 8, aliases 6, keywords 6, documentation 1.
  </documentation>
  <references>
    <see type="searchcap:OpenIndex" relation="SeeAlso" />
  </references>
  <properties>
    <query type="type:Text">
      <documentation>
        query. TS type: type:Text. (required)
      </documentation>
    </query>
    <options type="search:SearchOptions">
      <documentation>
        options. TS type: search:SearchOptions. (optional)
      </documentation>
    </options>
    <results type="search:SearchResult[]">
      <documentation>
        results. TS type: search:SearchResult[]. (required)
      </documentation>
    </results>
  </properties>
</searchcap:Search>
