<!--Search Capability — RebuildIndex
  FQN: org.blockml.bml.search.capability.RebuildIndex-->
<searchcap:RebuildIndex xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Full rebuild and persist of the search index
  </is>
  <documentation>
    Full rebuild and persist of the search index
  </documentation>
  <references>
    <see type="searchcap:BuildIndex" relation="SeeAlso" />
    <see type="searchcap:SaveIndex" relation="SeeAlso" />
  </references>
  <properties>
    <options type="search:SearchIndexOptions">
      <documentation>
        options. TS type: search:SearchIndexOptions. (optional)
      </documentation>
    </options>
    <result type="search:BuildIndexResult">
      <documentation>
        result. TS type: search:BuildIndexResult. (required)
      </documentation>
    </result>
  </properties>
</searchcap:RebuildIndex>
