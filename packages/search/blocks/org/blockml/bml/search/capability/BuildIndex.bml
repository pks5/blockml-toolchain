<!--Search Capability — BuildIndex
  FQN: org.blockml.bml.search.capability.BuildIndex-->
<searchcap:BuildIndex xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Build an in-memory search index from the validate --all corpus
  </is>
  <documentation>
    Calls bootstrapFullProjectRegistry, maps registry FQNs to SearchDocuments, and creates the Orama index. Does not write to disk.
  </documentation>
  <references>
    <see type="fwcap:BootstrapFullProjectRegistry" relation="SeeAlso" />
    <see type="searchcap:SaveIndex" relation="SeeAlso" />
  </references>
  <properties>
    <options type="search:SearchIndexOptions">
      <documentation>
        options. TS type: search:SearchIndexOptions. (optional)
      </documentation>
    </options>
    <result type="search:BuildIndexResult">
      <documentation>
        result. TS type: search:BuildIndexResult. (required)
      </documentation>
    </result>
  </properties>
</searchcap:BuildIndex>
