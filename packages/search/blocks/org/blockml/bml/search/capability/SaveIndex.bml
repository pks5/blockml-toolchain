<!--Search Capability — SaveIndex
  FQN: org.blockml.bml.search.capability.SaveIndex-->
<searchcap:SaveIndex xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Persist Orama snapshot and freshness manifest
  </is>
  <documentation>
    Writes .blockml/search/orama.json and manifest.json. Cache only; BML remains source of truth.
  </documentation>
  <properties>
    <index type="search:SearchType">
      <documentation>
        index. TS type: search:SearchType. (required)
      </documentation>
    </index>
    <options type="search:SearchIndexOptions">
      <documentation>
        options. TS type: search:SearchIndexOptions. (optional)
      </documentation>
    </options>
  </properties>
</searchcap:SaveIndex>
