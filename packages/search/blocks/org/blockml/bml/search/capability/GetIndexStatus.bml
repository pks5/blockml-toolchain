<!--
  Search Capability — GetIndexStatus
  FQN: org.blockml.bml.search.capability.GetIndexStatus
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type">

  <name>GetIndexStatus</name>
  <type>searchcap:GetIndexStatus</type>
  <baseType>core:Capability</baseType>
  <is>Report missing, ready, or stale for the persisted index</is>

  <documentation>Report missing, ready, or stale for the persisted index</documentation>

  <properties>
    <options type="search:SearchIndexOptions">
      <documentation>options. TS type: search:SearchIndexOptions. (optional)</documentation>
    </options>
    <status type="search:IndexStatus">
      <documentation>status. TS type: search:IndexStatus. (required)</documentation>
    </status>
  </properties>

</block>
