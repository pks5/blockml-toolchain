<!--Search Capability — OpenIndex
  FQN: org.blockml.bml.search.capability.OpenIndex-->
<searchcap:OpenIndex xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Load a ready index or rebuild when missing or stale
  </is>
  <documentation>
    Load a ready index or rebuild when missing or stale
  </documentation>
  <references>
    <see type="searchcap:LoadIndex" relation="SeeAlso" />
    <see type="searchcap:RebuildIndex" relation="SeeAlso" />
  </references>
  <properties>
    <options type="search:SearchIndexOptions">
      <documentation>
        options. TS type: search:SearchIndexOptions. (optional)
      </documentation>
    </options>
    <result type="search:BuildIndexResult">
      <documentation>
        result. TS type: search:BuildIndexResult. (required)
      </documentation>
    </result>
  </properties>
</searchcap:OpenIndex>
