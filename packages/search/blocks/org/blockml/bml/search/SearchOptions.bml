<!--Search — SearchOptions
  FQN: org.blockml.bml.search.SearchOptions-->
<search:SearchOptions xmlns="http://blockml.org/bml"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchIndexOptions
  </baseType>
  <is>
    SearchIndexOptions plus result limit
  </is>
  <documentation>
    limit defaults to 10.
  </documentation>
  <properties>
    <limit type="type:Integer">
      <documentation>
        limit (optional). TS type: type:Integer.
      </documentation>
    </limit>
  </properties>
</search:SearchOptions>
