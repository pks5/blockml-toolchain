<!--Search — SearchResult
  FQN: org.blockml.bml.search.SearchResult-->
<search:SearchResult xmlns="http://blockml.org/bml"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    One ranked hit from search()
  </is>
  <documentation>
    Abstracted from Orama hits. Sorted by exact FQN match first, then score descending, then FQN.
  </documentation>
  <properties>
    <fqn type="type:Text">
      <documentation>
        fqn (required). TS type: type:Text.
      </documentation>
    </fqn>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <file type="type:Text">
      <documentation>
        file (required). TS type: type:Text.
      </documentation>
    </file>
    <score type="type:Number">
      <documentation>
        score (required). TS type: type:Number.
      </documentation>
    </score>
    <library type="type:Text">
      <documentation>
        library (optional). TS type: type:Text.
      </documentation>
    </library>
  </properties>
</search:SearchResult>
