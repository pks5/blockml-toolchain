<!--Search — SearchResult
  FQN: org.blockml.bml.search.SearchResult-->
<search:SearchResult xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    One ranked hit from search()
  </is>
  <documentation>
    Abstracted from Orama hits. Sorted by exact FQN match first, then score descending, then FQN.
  </documentation>
  <properties>
    <fqn type="type:Text">
      <documentation>
        fqn (required). TS type: type:Text.
      </documentation>
    </fqn>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <file type="type:Text">
      <documentation>
        file (required). TS type: type:Text.
      </documentation>
    </file>
    <score type="type:Number">
      <documentation>
        score (required). TS type: type:Number.
      </documentation>
    </score>
    <library type="type:Text">
      <documentation>
        library (optional). TS type: type:Text.
      </documentation>
    </library>
  </properties>
</search:SearchResult>
