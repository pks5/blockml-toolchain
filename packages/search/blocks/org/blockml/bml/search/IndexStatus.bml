<!--Search — IndexStatus
  FQN: org.blockml.bml.search.IndexStatus-->
<search:IndexStatus xmlns="http://blockml.org/bml"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    Presence and freshness of the persisted index
  </is>
  <documentation>
    state is missing, ready, or stale.
  </documentation>
  <properties>
    <state type="type:Text">
      <documentation>
        state (required). TS type: type:Text.
      </documentation>
    </state>
    <documents type="type:Integer">
      <documentation>
        documents (optional). TS type: type:Integer.
      </documentation>
    </documents>
    <indexDir type="type:Text">
      <documentation>
        indexDir (required). TS type: type:Text.
      </documentation>
    </indexDir>
  </properties>
</search:IndexStatus>
