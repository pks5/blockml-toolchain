<!--Search — SearchDocument
  FQN: org.blockml.bml.search.SearchDocument-->
<search:SearchDocument xmlns="http://blockml.org/bml"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    Indexed block record derived from BOM
  </is>
  <documentation>
    One SearchDocument per TypeRegistry FQN (root and subBlocks). Aliases, keywords, and documentation stay separate fields.
  </documentation>
  <properties>
    <id type="type:Text">
      <documentation>
        Same as fqn. (required)
      </documentation>
    </id>
    <fqn type="type:Text">
      <documentation>
        fqn (required). TS type: type:Text.
      </documentation>
    </fqn>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <aliases type="type:Text[]">
      <documentation>
        aliases (required). TS type: type:Text[].
      </documentation>
    </aliases>
    <keywords type="type:Text[]">
      <documentation>
        keywords (required). TS type: type:Text[].
      </documentation>
    </keywords>
    <documentation type="type:Text">
      <documentation>
        documentation (required). TS type: type:Text.
      </documentation>
    </documentation>
    <file type="type:Text">
      <documentation>
        file (required). TS type: type:Text.
      </documentation>
    </file>
    <library type="type:Text">
      <documentation>
        library (optional). TS type: type:Text.
      </documentation>
    </library>
    <type type="type:Text">
      <documentation>
        type (optional). TS type: type:Text.
      </documentation>
    </type>
    <baseType type="type:Text">
      <documentation>
        baseType (optional). TS type: type:Text.
      </documentation>
    </baseType>
    <idea type="type:Text">
      <documentation>
        idea (optional). TS type: type:Text.
      </documentation>
    </idea>
  </properties>
</search:SearchDocument>
