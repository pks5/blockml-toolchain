<!--Search — SearchIndexOptions
  FQN: org.blockml.bml.search.SearchIndexOptions-->
<search:SearchIndexOptions xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    Project and cache location for index operations
  </is>
  <documentation>
    rootDir defaults to process.cwd(); srcDir defaults to blocks; indexDir defaults to {rootDir}/.blockml/search.
  </documentation>
  <properties>
    <rootDir type="type:Text">
      <documentation>
        rootDir (optional). TS type: type:Text.
      </documentation>
    </rootDir>
    <srcDir type="type:Text">
      <documentation>
        srcDir (optional). TS type: type:Text.
      </documentation>
    </srcDir>
    <libraries type="type:Text[]">
      <documentation>
        libraries (optional). TS type: type:Text[].
      </documentation>
    </libraries>
    <indexDir type="type:Text">
      <documentation>
        indexDir (optional). TS type: type:Text.
      </documentation>
    </indexDir>
  </properties>
</search:SearchIndexOptions>
