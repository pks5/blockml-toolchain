<!--Search — SearchIndexOptions
  FQN: org.blockml.bml.search.SearchIndexOptions-->
<search:SearchIndexOptions xmlns="http://blockml.org/bml"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    Project and cache location for index operations
  </is>
  <documentation>
    rootDir defaults to process.cwd(); srcDir defaults to blocks; indexDir defaults to {rootDir}/.blockml/search.
  </documentation>
  <properties>
    <rootDir type="type:Text">
      <documentation>
        rootDir (optional). TS type: type:Text.
      </documentation>
    </rootDir>
    <srcDir type="type:Text">
      <documentation>
        srcDir (optional). TS type: type:Text.
      </documentation>
    </srcDir>
    <libraries type="type:Text[]">
      <documentation>
        libraries (optional). TS type: type:Text[].
      </documentation>
    </libraries>
    <indexDir type="type:Text">
      <documentation>
        indexDir (optional). TS type: type:Text.
      </documentation>
    </indexDir>
  </properties>
</search:SearchIndexOptions>
