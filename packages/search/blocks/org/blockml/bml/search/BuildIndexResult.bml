<!--Search — BuildIndexResult
  FQN: org.blockml.bml.search.BuildIndexResult-->
<search:BuildIndexResult xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:search="org.blockml.bml.search"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    search:SearchType
  </baseType>
  <is>
    In-memory index plus bootstrap diagnostics
  </is>
  <documentation>
    Returned by buildIndex, rebuildIndex, and openIndex.
  </documentation>
  <properties>
    <index type="search:SearchType">
      <documentation>
        Opaque SearchIndex handle. (required)
      </documentation>
    </index>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics (required). TS type: bomcommon:Diagnostic[].
      </documentation>
    </diagnostics>
    <documents type="type:Integer">
      <documentation>
        documents (required). TS type: type:Integer.
      </documentation>
    </documents>
  </properties>
</search:BuildIndexResult>
