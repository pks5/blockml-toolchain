<!--
  Search — BuildIndexResult
  FQN: org.blockml.bml.search.BuildIndexResult
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type">

  <name>BuildIndexResult</name>
  <type>search:BuildIndexResult</type>
  <baseType>search:SearchType</baseType>
  <is>In-memory index plus bootstrap diagnostics</is>

  <documentation>Returned by buildIndex, rebuildIndex, and openIndex.</documentation>

  <properties>
    <index type="search:SearchType">
      <documentation>Opaque SearchIndex handle. (required)</documentation>
    </index>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>diagnostics (required). TS type: bomcommon:Diagnostic[].</documentation>
    </diagnostics>
    <documents type="type:Integer">
      <documentation>documents (required). TS type: type:Integer.</documentation>
    </documents>
  </properties>

</block>
