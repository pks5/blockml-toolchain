<!--Search Documentation — ArchitectureOverview
  FQN: org.blockml.bml.search.documentation.ArchitectureOverview-->
<searchdocumentation:ArchitectureOverview xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Corpus to index to Search API
  </is>
  <documentation>
    BML files → bootstrapFullProjectRegistry → TypeRegistry → SearchDocument[] → Orama index → .blockml/search/ cache → Search API.
    
    Search corpus == validate --all corpus. Index is a derived cache; BML remains source of truth.
    
    Ranking: exact FQN match (document id) first, then field boost (Orama): fqn 10, name 8, aliases 6, keywords 6, documentation 1.
    
    Persistence: .blockml/search/orama.json plus manifest.json (package.json/lockfile hashes, indexed file mtimes). Missing or stale index → full rebuild.
  </documentation>
  <references>
    <see type="searchdocumentation:V1Scope" relation="ReadNext" />
  </references>
</searchdocumentation:ArchitectureOverview>
