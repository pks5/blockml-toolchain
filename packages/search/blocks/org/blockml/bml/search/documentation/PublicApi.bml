<!--
  Search Documentation — PublicApi
  FQN: org.blockml.bml.search.documentation.PublicApi
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:search="org.blockml.bml.search"
  xmlns:searchcap="org.blockml.bml.search.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>PublicApi</name>
  <type>searchdocumentation:PublicApi</type>
  <baseType>core:Documentation</baseType>
  <is>Exported API from packages/search/src/index.ts</is>

  <documentation>buildIndex(options?) → BuildIndexResult
    search(query, options?) → SearchResult[]
    rebuildIndex(options?) → BuildIndexResult
    loadIndex(options?) → SearchIndex | undefined
    saveIndex(index, options?) → void
    getIndexStatus(options?) → IndexStatus
    openIndex(options?) → BuildIndexResult
    buildMemoryIndex(documents, diagnostics?) → SearchIndex

    Options: rootDir?, srcDir?, libraries?, indexDir?, limit? (search only).
    Orama types are not exported.</documentation>

  <references>
    <see type="searchcap:BuildIndex" relation="Defines" />
    <see type="searchcap:Search" relation="Defines" />
  </references>

</block>
