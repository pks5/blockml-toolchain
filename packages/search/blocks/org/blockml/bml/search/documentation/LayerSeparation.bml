<!--Search Documentation — LayerSeparation
  FQN: org.blockml.bml.search.documentation.LayerSeparation-->
<searchdocumentation:LayerSeparation xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Search vs framework vs parser vs CLI
  </is>
  <documentation>
    Layers:
    
    org.blockml.bml.search.* (@blockml/search) — SearchDocument mapping, Orama index, persistence, Search API.
    @blockml/framework — Discovery and TypeRegistry bootstrap (bootstrapFullProjectRegistry).
    @blockml/parser / @blockml/bom — Normalized aliases, keywords, documentation, FQNs.
    @blockml/cli — Human and --json CLI over this package.
    
    Search does not parse BML with a second XML/regex path. It does not own a separate corpus.
  </documentation>
  <references>
    <see type="searchdocumentation:ArchitectureOverview" relation="ReadNext" />
  </references>
</searchdocumentation:LayerSeparation>
