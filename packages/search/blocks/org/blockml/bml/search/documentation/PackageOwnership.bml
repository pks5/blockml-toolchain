<!--Search Documentation — PackageOwnership
  FQN: org.blockml.bml.search.documentation.PackageOwnership-->
<searchdocumentation:PackageOwnership xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Toolchain responsibilities for Search
  </is>
  <documentation>
    @blockml/search — index, persistence, Search API. Owns this BML library.
    
    @blockml/framework — project discovery and TypeRegistry bootstrap (same corpus as validate --all).
    @blockml/cli — blockml search command host.
    @blockml/bom — SearchDocument fields come from BlockDefinition.
  </documentation>
  <references>
    <see type="searchdocumentation:ScopeExclusions" relation="ReadNext" />
  </references>
</searchdocumentation:PackageOwnership>
