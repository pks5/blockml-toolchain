<!--Search Documentation — Introduction
  FQN: org.blockml.bml.search.documentation.Introduction-->
<searchdocumentation:Introduction xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:searchdocumentation="org.blockml.bml.search.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Purpose and scope of the Search package
  </is>
  <documentation>
    The @blockml/search package provides local full-text search over the effective BML corpus of a BlockML project. The corpus is the same set of documents bootstrapped by blockml validate --all.
    
    This library (org.blockml.bml.search.*) is the SSOT. TypeScript in packages/search/src/ implements it. Orama is an internal engine and is not part of the public API.
    
    Consumers (CLI, LSP, agents, replicator) call BlockML-owned interfaces only.
  </documentation>
  <references>
    <see type="searchdocumentation:LayerSeparation" relation="ReadNext" />
    <see type="fwcap:BootstrapFullProjectRegistry" relation="SeeAlso" />
  </references>
</searchdocumentation:Introduction>
