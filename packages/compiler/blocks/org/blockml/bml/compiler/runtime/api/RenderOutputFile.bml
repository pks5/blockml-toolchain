<!--Compiler Runtime API — RenderOutputFile
  FQN: org.blockml.bml.compiler.runtime.api.RenderOutputFile-->
<runapi:RenderOutputFile xmlns="http://blockml.org/bml"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:runapi="org.blockml.bml.compiler.runtime.api"
  xmlns:rundocumentation="org.blockml.bml.compiler.runtime.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    runtime:RuntimeType
  </baseType>
  <is>
    Single path/content pair in RenderOutput
  </is>
  <documentation>
    C4: targets emit zero or more files; host writes them.
  </documentation>
  <references>
    <see type="rundocumentation:PublicApi" relation="SeeAlso" />
  </references>
  <properties>
    <path type="type:Text">
      <documentation>
        Relative output path. (required)
      </documentation>
    </path>
    <content type="type:Text">
      <documentation>
        File content. (required)
      </documentation>
    </content>
  </properties>
</runapi:RenderOutputFile>
