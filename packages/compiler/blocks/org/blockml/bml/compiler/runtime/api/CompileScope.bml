<!--Compiler Runtime API — CompileScope
  FQN: org.blockml.bml.compiler.runtime.api.CompileScope-->
<runapi:CompileScope xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:cli="org.blockml.bml.cli"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:runtime="org.blockml.bml.compiler.runtime"
  xmlns:runapi="org.blockml.bml.compiler.runtime.api"
  xmlns:runcap="org.blockml.bml.compiler.runtime.capability"
  xmlns:runconfig="org.blockml.bml.compiler.runtime.config"
  xmlns:rundocumentation="org.blockml.bml.compiler.runtime.documentation"
  xmlns:type="org.blockml.bml.type"
  xmlns:validator="org.blockml.bml.compiler.validator">

  <baseType>
    runtime:RuntimeType
  </baseType>
  <is>
    Compile scope payload on CompileRequest
  </is>
  <documentation>
    C7 scope kinds with optional document, libraries, roots, includeDependencies.
  </documentation>
  <references>
    <see type="rundocumentation:PublicApi" relation="SeeAlso" />
  </references>
  <properties>
    <kind type="type:Text">
      <documentation>
        CompileScopeKind value. (required)
      </documentation>
    </kind>
    <document type="runapi:CompileInput">
      <documentation>
        Required when kind is document. (optional)
      </documentation>
    </document>
    <libraries type="type:Text">
      <documentation>
        Library.bml paths. (optional)
      </documentation>
    </libraries>
    <roots type="type:Text">
      <documentation>
        Corpus root directories. (optional)
      </documentation>
    </roots>
    <includeDependencies type="type:Boolean">
      <documentation>
        Reserved; host may pass through. (optional)
      </documentation>
    </includeDependencies>
  </properties>
</runapi:CompileScope>
