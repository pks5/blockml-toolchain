{
  "name": "@blockml/compiler",
  "version": "0.9.10",
  "description": "BlockML compiler — facade, target registry, render pipeline",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/compiler"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/compiler/runtime/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/compiler/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.9.10",
    "@blockml/core": "^1.4.0",
    "@blockml/framework": "^0.9.10",
    "@blockml/parser": "^0.9.10",
    "@blockml/validator": "^0.9.10"
  },
  "engines": {
    "node": ">=20"
  }
}
