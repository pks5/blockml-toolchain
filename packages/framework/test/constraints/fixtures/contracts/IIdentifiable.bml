<!--Test contract — id property with ValuePresent constraint-->
<test:IIdentifiable xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <baseType>
    core:Block
  </baseType>
  <is>
    Contract requiring an authored id value
  </is>
  <version>
    1.0.0
  </version>
  <properties>
    <id type="type:Text">
      <constraints>
        <constraint:ValuePresent validation="validation:Error" />
      </constraints>
    </id>
  </properties>
</test:IIdentifiable>
