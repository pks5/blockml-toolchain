<!--Test fixture — valid PropertyConstraint on property-->
<test:PropertyConstraintOnProperty xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <baseType>
    core:Block
  </baseType>
  <is>
    A constraint test fixture
  </is>
  <version>
    1.0.0
  </version>
  <properties>
    <token readOnly="true" type="type:Text">
      <constraints>
        <constraint:MustBeReadOnly validation="validation:Error" />
      </constraints>
      <value>fixed</value>
    </token>
  </properties>
</test:PropertyConstraintOnProperty>
