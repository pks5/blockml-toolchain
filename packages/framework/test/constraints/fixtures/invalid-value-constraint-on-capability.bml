<!--Test fixture — invalid ValueConstraint on Capability (BML_CONSTRAINT_TARGET_MISMATCH)-->
<test:InvalidValueOnCapability xmlns="http://blockml.org/bml"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <baseType>
    core:Block
  </baseType>
  <is>
    A constraint test fixture
  </is>
  <version>
    1.0.0
  </version>
  <capabilities>
    <render type="cap:Transformation">
      <constraints>
        <constraint:Min value="1" validation="validation:Error" />
      </constraints>
    </render>
  </capabilities>
</test:InvalidValueOnCapability>
