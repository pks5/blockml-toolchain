<!--Test fixture — visibility/override widening without a type-level default-->
<test:OverrideWithoutDefault xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:test="com.blockml.test.constraints"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A constraint test fixture
  </is>
  <version>
    1.0.0
  </version>
  <contracts>
    <test:IIdentifiable />
  </contracts>
  <properties>
    <id override="true" type="type:Text">
      <documentation>
        Filled at instance sites — not on this type definition.
      </documentation>
    </id>
  </properties>
</test:OverrideWithoutDefault>
