<!--Test fixture — valid Min on numeric Property
  See packages/framework/test/constraints/constraints.test-spec.yaml-->
<test:MinOnProperty xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <baseType>
    core:Block
  </baseType>
  <is>
    A constraint test fixture
  </is>
  <version>
    1.0.0
  </version>
  <properties>
    <count type="type:Integer">
      <constraints>
        <constraint:Min value="1" validation="validation:Error" />
      </constraints>
      <value>5</value>
    </count>
  </properties>
</test:MinOnProperty>
