<!--Test fixture — valid ValuePresent on Property-->
<test:ValuePresentOnProperty xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <baseType>
    core:Block
  </baseType>
  <is>
    A constraint test fixture
  </is>
  <version>
    1.0.0
  </version>
  <properties>
    <label type="type:Text">
      <constraints>
        <constraint:ValuePresent validation="validation:Error" />
      </constraints>
      <value>hello</value>
    </label>
  </properties>
</test:ValuePresentOnProperty>
