<!--Test fixture — constraint without validation (metadata only)-->
<test:MetadataOnlyConstraint xmlns="http://blockml.org/bml"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:test="com.blockml.test.constraints">

  <baseType>
    core:Block
  </baseType>
  <is>
    A constraint test fixture
  </is>
  <version>
    1.0.0
  </version>
  <properties>
    <count type="type:Integer">
      <constraints>
        <constraint:Min value="1" />
      </constraints>
      <value>0</value>
    </count>
  </properties>
</test:MetadataOnlyConstraint>
