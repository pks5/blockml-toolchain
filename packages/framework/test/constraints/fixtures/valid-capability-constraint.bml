<!--
  Test fixture — valid CapabilityConstraint
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:cap="org.blockml.bml.capability"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <type>test:CapabilityConstraint</type>
  <baseType>core:Block</baseType>
  <is>A constraint test fixture</is>
  <version>1.0.0</version>

  <capabilities>
    <render type="cap:Transformation">
      <constraints>
        <constraint:RequiresImplementation validation="validation:Error"/>
      </constraints>
      <implementation language="lang:PseudoCode">
        <![CDATA[/* stub */]]>
      </implementation>
    </render>
  </capabilities>
</block>
