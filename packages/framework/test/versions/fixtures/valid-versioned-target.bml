  xmlns:core="org.blockml.bml.core"
  xmlns:example="com.example.demo">

  <baseType>
    core:Block
  </baseType>
  <is>
    Versioned target block
  </is>
  <version>
    2.0.0
  </version>
</example:VersionedTarget>
