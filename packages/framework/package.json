{
  "name": "@blockml/framework",
  "version": "0.9.13",
  "description": "BlockML framework — TypeRegistry, fork/resolve, parseExpression, validateTypes",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/framework"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/framework/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/framework/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.9.13",
    "@blockml/core": "^1.4.5",
    "@blockml/parser": "^0.9.13"
  },
  "engines": {
    "node": ">=20"
  }
}
