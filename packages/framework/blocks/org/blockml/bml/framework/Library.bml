<!--
  BlockML Framework Library Descriptor
  FQN: org.blockml.bml.framework.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwconfig="org.blockml.bml.framework.config"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:fwregistry="org.blockml.bml.framework.registry"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation">

  <name>Library</name>
  <type>framework:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML Framework utilities package library catalog</is>

  <documentation>
    # The BlockML Framework utilities package library catalog

    Canonical framework specification for BlockML Stage-2 utilities — TypeRegistry,
    bootstrap, fork/resolve, parseExpression, validateTypes/validateConstraints.

    TypeScript in packages/framework/src/ implements this library.

    Urmodell types live in org.blockml.bml.bom.* (@blockml/bom).

    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.8.1</version>

  <language>
    <English />
  </language>

  <properties>
    <description override="true">
      <value>BlockML Framework utilities library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <framework:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
        <bom:Library />
        <parser:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition>
        <framework:FrameworkType />
        <fwregistry:BootstrapResult />
        <fwregistry:BootstrapTrace />
        <fwexpression:ExpressionNode />
        <fwexpression:LiteralExpressionNode />
        <fwexpression:ArrayExpressionNode />
        <fwexpression:ObjectExpressionEntry />
        <fwexpression:ObjectExpressionNode />
        <fwexpression:PropertyExpressionNode />
        <fwexpression:CallExpressionNode />
        <fwexpression:BinaryExpressionNode />
        <fwexpression:ParseExpressionResult />
        <fwexpression:ParseExpressionError />
        <fwexpression:ParseExpressionOutcome />
        <fwregistry:BootstrapOptions />
        <fwconfig:FrameworkDiagnosticCodes />
        <fwcap:TypeRegistry />
        <fwcap:BootstrapTypeRegistry />
        <fwcap:BootstrapFullProjectRegistry />
        <fwcap:DefaultBootstrapPaths />
        <fwcap:ResolveLibrarySeeds />
        <fwcap:ProjectSourceRoots />
        <fwcap:ProjectLibraryPackageRoots />
        <fwcap:ProjectLibraryPackageDirs />
        <fwcap:RegistryFilesUnderRoots />
        <fwcap:ForkBom />
        <fwcap:ResolveContracts />
        <fwcap:ResolveEffectiveMembers />
        <fwcap:CollectBaseTypeChain />
        <fwcap:MemberIdentityKey />
        <fwcap:ParseExpression />
        <fwcap:ValidateTypes />
        <fwcap:ValidateConstraints />
        <fwcap:ValidateVersions />
        <fwcap:RootFqnByFilePath />
        <fwcap:RootFqns />
        <fwcap:GetExportedFqns />
        <fwcap:PeekLibraryTypeFqn />
        <fwcap:ValidateEmbeddedBlocks />
        <fwcap:ValidateInstances />
        <fwcap:ValidatePresets />
        <fwcap:ValidateVisibility />
        <fwcap:ValidateReadOnly />
        <fwcap:GetPropertyNumericValue />
        <fwcap:IsLiteralValue />
        <fwdocumentation:Introduction />
        <fwdocumentation:LayerSeparation />
        <fwdocumentation:ArchitectureOverview />
        <fwdocumentation:PublicApi />
        <fwdocumentation:TypeRegistryBootstrap />
        <fwdocumentation:EffectiveMembers />
        <fwdocumentation:ExpressionParsing />
        <fwdocumentation:ConstraintValidation />
        <fwdocumentation:Diagnostics />
        <fwdocumentation:PackageOwnership />
        <fwdocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>

</block>
