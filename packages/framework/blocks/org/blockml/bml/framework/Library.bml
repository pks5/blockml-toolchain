<!--
  BlockML Framework Utilities Library (Phase B)
  FQN: org.blockml.bml.framework.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fw="org.blockml.bml.framework">

  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>Framework utilities — TypeRegistry, parseExpression, validation helpers</is>

  <documentation>
    TypeScript in packages/framework/src/ implements Stage-2 framework utilities.
    Language BML corpus remains in npm @blockml/core (node_modules).
  </documentation>

  <version>0.1.0</version>

</block>
