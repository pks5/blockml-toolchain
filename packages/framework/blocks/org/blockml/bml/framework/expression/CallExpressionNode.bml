<!--Framework — CallExpressionNode
  FQN: org.blockml.bml.framework.expression.CallExpressionNode-->
<fwexpression:CallExpressionNode xmlns="http://blockml.org/bml"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    fwexpression:ExpressionNode
  </baseType>
  <is>
    Function call expression AST node
  </is>
  <documentation>
    kind: call. callee: string. args: ExpressionNode[].
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        kind. TS type: type:Text. (required)
      </documentation>
      <value>call</value>
    </kind>
    <callee type="type:Text">
      <documentation>
        callee. TS type: type:Text. (required)
      </documentation>
    </callee>
    <args type="fwexpression:ExpressionNode[]">
      <documentation>
        args. TS type: fwexpression:ExpressionNode[]. (required)
      </documentation>
    </args>
  </properties>
</fwexpression:CallExpressionNode>
