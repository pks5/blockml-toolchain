<!--Framework — PropertyExpressionNode
  FQN: org.blockml.bml.framework.expression.PropertyExpressionNode-->
<fwexpression:PropertyExpressionNode xmlns="http://blockml.org/bml"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    fwexpression:ExpressionNode
  </baseType>
  <is>
    Property path expression AST node
  </is>
  <documentation>
    kind: property. path: string[] (dot-separated property access).
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        kind. TS type: type:Text. (required)
      </documentation>
      <value>property</value>
    </kind>
    <path type="type:Text[]">
      <documentation>
        path. TS type: type:Text[]. (required)
      </documentation>
    </path>
  </properties>
</fwexpression:PropertyExpressionNode>
