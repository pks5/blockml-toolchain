<!--Framework — ParseExpressionResult
  FQN: org.blockml.bml.framework.expression.ParseExpressionResult-->
<fwexpression:ParseExpressionResult xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Successful parseExpression result
  </is>
  <documentation>
    Returned when ParseExpressionOutcome.ok === true.
  </documentation>
  <properties>
    <ast type="fwexpression:ExpressionNode">
      <documentation>
        ast. TS type: fwexpression:ExpressionNode. (required)
      </documentation>
    </ast>
    <resultTypeFqn type="type:Text">
      <documentation>
        Optional resolved result type FQN. (optional)
      </documentation>
    </resultTypeFqn>
  </properties>
</fwexpression:ParseExpressionResult>
