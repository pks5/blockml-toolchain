<!--Framework — ExpressionNode
  FQN: org.blockml.bml.framework.expression.ExpressionNode-->
<fwexpression:ExpressionNode xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwexpression="org.blockml.bml.framework.expression">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Abstract union of expression AST node variants
  </is>
  <documentation>
    Discriminated by kind: literal | array | object | property | call | binary | interpolated.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="fwexpression:LiteralExpressionNode" relation="SeeAlso" />
  </references>
</fwexpression:ExpressionNode>
