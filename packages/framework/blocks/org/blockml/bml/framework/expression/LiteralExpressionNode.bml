<!--Framework — LiteralExpressionNode
  FQN: org.blockml.bml.framework.expression.LiteralExpressionNode-->
<fwexpression:LiteralExpressionNode xmlns="http://blockml.org/bml"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    fwexpression:ExpressionNode
  </baseType>
  <is>
    Literal expression AST node
  </is>
  <documentation>
    kind: literal. value: string | number | boolean | null. BML union covers primitives; null is documented only.
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        kind. TS type: type:Text. (required)
      </documentation>
      <value>literal</value>
    </kind>
    <value type="type:Text | type:Integer | type:Decimal | type:Boolean">
      <documentation>
        BML type gap: TS string | number | boolean | null. Union covers primitive cases; null is documented only. (required)
      </documentation>
    </value>
  </properties>
</fwexpression:LiteralExpressionNode>
