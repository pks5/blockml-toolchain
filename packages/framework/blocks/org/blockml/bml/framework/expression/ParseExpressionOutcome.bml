<!--Framework — ParseExpressionOutcome
  FQN: org.blockml.bml.framework.expression.ParseExpressionOutcome-->
<fwexpression:ParseExpressionOutcome xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Discriminated union result of parseExpression
  </is>
  <documentation>
    TS: { ok: true, result: ParseExpressionResult } | { ok: false, error: ParseExpressionError }.
  </documentation>
  <properties>
    <ok type="type:Boolean">
      <documentation>
        ok. TS type: type:Boolean. (required)
      </documentation>
    </ok>
    <result type="fwexpression:ParseExpressionResult">
      <documentation>
        Present when ok === true. (optional)
      </documentation>
    </result>
    <error type="fwexpression:ParseExpressionError">
      <documentation>
        Present when ok === false. (optional)
      </documentation>
    </error>
  </properties>
</fwexpression:ParseExpressionOutcome>
