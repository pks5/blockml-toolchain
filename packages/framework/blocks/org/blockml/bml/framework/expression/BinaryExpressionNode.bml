<!--Framework — BinaryExpressionNode
  FQN: org.blockml.bml.framework.expression.BinaryExpressionNode-->
<fwexpression:BinaryExpressionNode xmlns="http://blockml.org/bml"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    fwexpression:ExpressionNode
  </baseType>
  <is>
    Binary operator expression AST node
  </is>
  <documentation>
    <![CDATA[kind: binary. operator: + | - | * | / | < | > | <= | >= | == | !=.
    left/right: ExpressionNode. Precedence, left-associative: * / then + - then
    comparisons. >= <= == != are each one operator. No &&, ||, or !.]]>
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        kind. TS type: type:Text. (required)
      </documentation>
      <value>binary</value>
    </kind>
    <operator type="type:Text">
      <documentation>
        operator. TS type: type:Text. (required)
      </documentation>
    </operator>
    <left type="fwexpression:ExpressionNode">
      <documentation>
        left. TS type: fwexpression:ExpressionNode. (required)
      </documentation>
    </left>
    <right type="fwexpression:ExpressionNode">
      <documentation>
        right. TS type: fwexpression:ExpressionNode. (required)
      </documentation>
    </right>
  </properties>
</fwexpression:BinaryExpressionNode>
