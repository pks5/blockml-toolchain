<!--Framework — ParseExpressionError
  FQN: org.blockml.bml.framework.expression.ParseExpressionError-->
<fwexpression:ParseExpressionError xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Failed parseExpression error detail
  </is>
  <documentation>
    Returned when ParseExpressionOutcome.ok === false.
  </documentation>
  <properties>
    <message type="type:Text">
      <documentation>
        message. TS type: type:Text. (required)
      </documentation>
    </message>
    <offset type="type:Integer">
      <documentation>
        offset. TS type: type:Integer. (required)
      </documentation>
    </offset>
  </properties>
</fwexpression:ParseExpressionError>
