  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Failed parseExpression error detail
  </is>
  <documentation>
    Returned when ParseExpressionOutcome.ok === false.
  </documentation>
  <properties>
    <message type="type:Text">
      <documentation>
        message. TS type: type:Text. (required)
      </documentation>
    </message>
    <offset type="type:Integer">
      <documentation>
        offset. TS type: type:Integer. (required)
      </documentation>
    </offset>
  </properties>
</fwexpression:ParseExpressionError>
