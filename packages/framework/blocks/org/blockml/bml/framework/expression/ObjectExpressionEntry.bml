<!--Framework — ObjectExpressionEntry
  FQN: org.blockml.bml.framework.expression.ObjectExpressionEntry-->
<fwexpression:ObjectExpressionEntry xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    One key/value pair in an object expression
  </is>
  <documentation>
    <![CDATA[BML type gap: stands for TypeScript Record<string, ExpressionNode>. Core has no Map ValueType; this struct is the per-entry shape.]]>
  </documentation>
  <properties>
    <key type="type:Text">
      <documentation>
        key. TS type: type:Text. (required)
      </documentation>
    </key>
    <value type="fwexpression:ExpressionNode">
      <documentation>
        value. TS type: fwexpression:ExpressionNode. (required)
      </documentation>
    </value>
  </properties>
</fwexpression:ObjectExpressionEntry>
