<!--Framework Documentation — PublicApi
  FQN: org.blockml.bml.framework.documentation.PublicApi-->
<fwdocumentation:PublicApi xmlns="http://blockml.org/bml"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Framework public exports from index.ts
  </is>
  <documentation>
    <![CDATA[
    Public exports from @blockml/framework (packages/framework/src/index.ts):
    
    TypeRegistry — class; register/get/has/keys/size/withOverlay on BomDocument index
    bootstrapTypeRegistry(options?) → BootstrapResult
    bootstrapFullProjectRegistry({ rootDir, srcDir?, libraries? }) → BootstrapResult
    defaultBootstrapPaths(rootDir?) → string[]
    resolveLibrarySeeds(rootDir?, extras?) → string[]
    projectSourceRoots(rootDir, srcDir?) → string[]
    projectLibraryPackageRoots(rootDir) → string[]
    projectLibraryPackageDirs(rootDir) → string[]
    registryFilesUnderRoots(registry, roots) → string[]
    peekLibraryTypeFqn(libraryPath) → string | undefined
    BootstrapOptions — paths?, libraryPaths?, rootDir?
    BootstrapResult — registry, diagnostics, exportsByLibrary?, trace?
    BootstrapTrace — corpusPaths, seeds, searchRoots, librariesVisited, skippedCoveredRoots
    rootFqnByFilePath(registry) → Map<filePath, rootFqn>
    forkBom(document) → BomDocument
    resolveEffectiveMembers(block, registry) → MemberDefinition[]
    resolveContracts(block, registry) → MemberDefinition[] (contract slice; used by resolveEffectiveMembers)
    collectBaseTypeChain(block, registry) → BlockDefinition[]
    memberIdentityKey(member) → string
    findLocalMember(block, member) → MemberDefinition | undefined
    parseExpression(source) → ParseExpressionOutcome
    parseInterpolatedText(source) → ParseExpressionOutcome
    evaluateExpression(node, scope) → value
    evaluateInterpolatedText(source, scope) → Text
    validateTypes(document, registry) → Diagnostic[]
    validateVersions(document, registry) → Diagnostic[]
    validateInstances(document, registry) → Diagnostic[]
    validateGenerics(document, registry) → Diagnostic[]
    validateConstraints(document, registry) → Diagnostic[]
    getPropertyNumericValue(property) → number | undefined
    isLiteralValue(value) → boolean
    evaluateParseValue(typeFqn, raw, registry) → ok+value | skipped | ok:false
    evaluateCapability(typeFqn, capabilityName, args, registry) → ok+value | skipped | ok:false
    scanTypes(selectors, registry) → matching type FQNs or parse error
    scanPackages(selectors, registry) → matching package identifiers or parse error
    
    Types: BootstrapResult, BootstrapTrace, BootstrapOptions, ExpressionNode, ParseExpressionResult, ParseExpressionOutcome
    
    Not exported from index: getLiteralNumericValue (internal helper in validate-types.ts).
    ]]>
  </documentation>
  <references>
    <see type="fwdocumentation:TypeRegistryBootstrap" relation="ReadNext" />
    <see type="bomapi:TypeRegistryReader" relation="SeeAlso" />
  </references>
</fwdocumentation:PublicApi>
