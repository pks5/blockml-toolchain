<!--Framework Capability — ProjectLibraryPackageDirs
  FQN: org.blockml.bml.framework.capability.ProjectLibraryPackageDirs-->
<fwcap:ProjectLibraryPackageDirs xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Package directories that declare blockml.library
  </is>
  <documentation>
    This package and local packages/* that declare package.json blockml.library. Sorted, canonical, no node_modules walk.
  </documentation>
  <properties>
    <rootDir type="type:Text">
      <documentation>
        Project root. (required)
      </documentation>
    </rootDir>
    <dirs type="type:Text[]">
      <documentation>
        dirs. TS type: type:Text[]. (required)
      </documentation>
    </dirs>
  </properties>
</fwcap:ProjectLibraryPackageDirs>
