<!--Framework Capability — ScanTypes
  FQN: org.blockml.bml.framework.capability.ScanTypes-->
<fwcap:ScanTypes xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    List TypeRegistry FQNs matching TypeSelectors
  </is>
  <documentation>
    Parses each token as type:TypeSelector, then keeps registry.keys() (dotted FQNs)
    where any selector.matches. OR across selectors. Sorted. Invalid parse → error
    message. Matching is Core TypeSelector.matches — not copied here.
  </documentation>
  <references>
    <see type="fwcap:ScanPackages" relation="SeeAlso" />
    <see type="fwcap:EvaluateCapability" relation="SeeAlso" />
    <see type="type:TypeSelector" relation="SeeAlso" />
  </references>
  <properties>
    <selectors type="type:Text[]">
      <documentation>
        TypeSelector tokens. (required)
      </documentation>
    </selectors>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        registry. TS type: fwcap:TypeRegistry. (required)
      </documentation>
    </registry>
    <hits type="type:Text[]">
      <documentation>
        Matching type FQNs when ok. (required)
      </documentation>
    </hits>
    <message type="type:Text">
      <documentation>
        parseValue / eval error when not ok. (optional)
      </documentation>
    </message>
  </properties>
</fwcap:ScanTypes>
