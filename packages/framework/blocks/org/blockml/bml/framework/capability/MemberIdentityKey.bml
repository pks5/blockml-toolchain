<!--Framework Capability — MemberIdentityKey
  FQN: org.blockml.bml.framework.capability.MemberIdentityKey-->
<fwcap:MemberIdentityKey xmlns="http://blockml.org/bml"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Stable identity key for member collision detection
  </is>
  <documentation>
    Stable identity key for member collision detection
  </documentation>
  <properties>
    <member type="bommember:MemberDefinition">
      <documentation>
        member. TS type: bommember:MemberDefinition. (required)
      </documentation>
    </member>
    <key type="type:Text">
      <documentation>
        key. TS type: type:Text. (required)
      </documentation>
    </key>
  </properties>
</fwcap:MemberIdentityKey>
