<!--Framework Capability — ProjectLibraryPackageRoots
  FQN: org.blockml.bml.framework.capability.ProjectLibraryPackageRoots-->
<fwcap:ProjectLibraryPackageRoots xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    srcDir roots of local packages that declare blockml.library
  </is>
  <documentation>
    Stricter than projectSourceRoots: config-only packages are omitted. Does not walk parent workspaces or node_modules.
  </documentation>
  <properties>
    <rootDir type="type:Text">
      <documentation>
        Project root. (required)
      </documentation>
    </rootDir>
    <roots type="type:Text[]">
      <documentation>
        roots. TS type: type:Text[]. (required)
      </documentation>
    </roots>
  </properties>
</fwcap:ProjectLibraryPackageRoots>
