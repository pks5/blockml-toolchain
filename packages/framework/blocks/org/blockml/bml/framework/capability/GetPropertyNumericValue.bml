<!--Framework Capability — GetPropertyNumericValue
  FQN: org.blockml.bml.framework.capability.GetPropertyNumericValue-->
<fwcap:GetPropertyNumericValue xmlns="http://blockml.org/bml"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Extract numeric literal from PropertyDefinition value or values[]
  </is>
  <documentation>
    Extract numeric literal from PropertyDefinition value or values[]
  </documentation>
  <properties>
    <property type="bommember:PropertyDefinition">
      <documentation>
        property. TS type: bommember:PropertyDefinition. (required)
      </documentation>
    </property>
    <value type="type:Number">
      <documentation>
        undefined when no numeric literal. (optional)
      </documentation>
    </value>
  </properties>
</fwcap:GetPropertyNumericValue>
