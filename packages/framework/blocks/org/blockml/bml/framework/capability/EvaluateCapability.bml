<!--Framework Capability — EvaluateCapability
  FQN: org.blockml.bml.framework.capability.EvaluateCapability-->
<fwcap:EvaluateCapability xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Evaluate a named host-evaluable TypeScript Capability
  </is>
  <documentation>
    Host-evaluable Capability on a named primitive: looks up the named member, compiles
    its TypeScript arrow (parameter and return types stripped), and applies host args.
    
    - No member, abstract, non-TypeScript, or type missing from the registry → skipped
    - A thrown Error → ok:false + message
    - parseValue is evaluateCapability(typeFqn, parseValue, [raw])
    - matches is evaluateCapability(typeFqn, matches, [selector, candidate])
  </documentation>
  <references>
    <see type="fwcap:EvaluateParseValue" relation="SeeAlso" />
    <see type="fwcap:ResolveEffectiveMembers" relation="SeeAlso" />
  </references>
  <properties>
    <typeFqn type="type:Text">
      <documentation>
        Declared primitive FQN or type expression. (required)
      </documentation>
    </typeFqn>
    <capabilityName type="type:Text">
      <documentation>
        Capability member name. (required)
      </documentation>
    </capabilityName>
    <args type="type:Text">
      <documentation>
        Host argument list. (required)
      </documentation>
    </args>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        registry. TS type: fwcap:TypeRegistry. (required)
      </documentation>
    </registry>
    <result type="type:Text">
      <documentation>
        ok+value, ok+skipped, or ok:false+message. (required)
      </documentation>
    </result>
  </properties>
</fwcap:EvaluateCapability>
