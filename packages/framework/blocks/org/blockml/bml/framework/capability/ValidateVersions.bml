<!--Framework Capability — ValidateVersions
  FQN: org.blockml.bml.framework.capability.ValidateVersions-->
<fwcap:ValidateVersions xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Minimal effectiveBlockVersion and bml:version assert checks
  </is>
  <documentation>
    <![CDATA[
    # Effective block version
    
    - effectiveBlockVersion = own version | owning Library.version | unversioned
    - Library members inherit the Library version (nearest Library.bml at the same
      package level or above; search stops one level below the source folder)
    - Standalone blocks without a version are unversioned (no error)
    - `BML_UNKNOWN_VERSION` when a `bml:version` pin does not match the effective
      version, or pins an unversioned type
    - Third-party libraries are not exempted by namespace
    ]]>
  </documentation>
  <references>
    <see type="bomdocumentation:VersionRules" relation="SeeAlso" />
  </references>
  <properties>
    <document type="bomdoc:BomDocument">
      <documentation>
        document. TS type: bomdoc:BomDocument. (required)
      </documentation>
    </document>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        registry. TS type: fwcap:TypeRegistry. (required)
      </documentation>
    </registry>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics. TS type: bomcommon:Diagnostic[]. (required)
      </documentation>
    </diagnostics>
  </properties>
</fwcap:ValidateVersions>
