<!--Framework Capability — EvaluateExpression
  FQN: org.blockml.bml.framework.capability.EvaluateExpression-->
<fwcap:EvaluateExpression xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Evaluate an expression AST against the #this scope
  </is>
  <documentation>
    #this is the outer Block property map. Same lookup as full expressions: size ≡ #this.size, this ≡ #this.this, this.x ≡ #this.this.x.

    Evaluates the expression language, including + - * / and comparisons.
    The interpolation profile (only + among binary operators) is parseInterpolatedText, not this evaluation.
  </documentation>
  <properties>
    <node type="fwexpression:ExpressionNode">
      <documentation>
        node. TS type: fwexpression:ExpressionNode. (required)
      </documentation>
    </node>
    <value type="type:Text">
      <documentation>
        BML type gap: TS unknown evaluation result. (required)
      </documentation>
    </value>
  </properties>
</fwcap:EvaluateExpression>
