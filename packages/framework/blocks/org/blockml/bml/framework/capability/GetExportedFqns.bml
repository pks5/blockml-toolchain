<!--Framework Capability — GetExportedFqns
  FQN: org.blockml.bml.framework.capability.GetExportedFqns-->
<fwcap:GetExportedFqns xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwregistry="org.blockml.bml.framework.registry"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Exported block FQNs for a library path from BootstrapResult
  </is>
  <documentation>
    Location-based members of the Library (nearest Library.bml walking up from
    each file). Not an authored blocks aggregation.
  </documentation>
  <properties>
    <libraryPath type="type:Text">
      <documentation>
        libraryPath. TS type: type:Text. (required)
      </documentation>
    </libraryPath>
    <bootstrap type="fwregistry:BootstrapResult">
      <documentation>
        bootstrap. TS type: fwregistry:BootstrapResult. (required)
      </documentation>
    </bootstrap>
    <rootDir type="type:Text">
      <documentation>
        rootDir — default process.cwd(). (optional)
      </documentation>
    </rootDir>
    <exported type="type:Text">
      <documentation>
        Set&lt;exportedFqn> or undefined. (optional)
      </documentation>
    </exported>
  </properties>
</fwcap:GetExportedFqns>
