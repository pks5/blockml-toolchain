<!--Framework Capability — ParseExpression
  FQN: org.blockml.bml.framework.capability.ParseExpression-->
<fwcap:ParseExpression xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Parse expression source text into ExpressionNode AST
  </is>
  <documentation>
    Parse expression source text into ExpressionNode AST
  </documentation>
  <references>
    <see type="fwdocumentation:ExpressionParsing" relation="SeeAlso" />
  </references>
  <properties>
    <source type="type:Text">
      <documentation>
        source. TS type: type:Text. (required)
      </documentation>
    </source>
    <outcome type="fwexpression:ParseExpressionOutcome">
      <documentation>
        outcome. TS type: fwexpression:ParseExpressionOutcome. (required)
      </documentation>
    </outcome>
  </properties>
</fwcap:ParseExpression>
