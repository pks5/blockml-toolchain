<!--Framework Capability — ResolveEffectiveMembers
  FQN: org.blockml.bml.framework.capability.ResolveEffectiveMembers-->
<fwcap:ResolveEffectiveMembers xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwconfig="org.blockml.bml.framework.config"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:fwregistry="org.blockml.bml.framework.registry"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Merge members along baseType chain, contracts, and local declarations
  </is>
  <documentation>
    ## Merge order

    baseType chain (ancestors first) → contracts[] in declaration order → local
    members.

    ## What inherits

    Specified attributes replace; unspecified attributes inherit — except local
    declaration flags `abstract`, `final`, and `override`. Those describe only
    the current layer and are never copied from the parent. Omitted on a
    redeclaration → false (locally concrete). Restate `abstract="true"` (with
    `override="true"`) to keep a member abstract.

    ## What still propagates

    An unimplemented abstract ancestor stays an obligation; parent `final` still
    blocks further override.
  </documentation>
  <references>
    <see type="fwcap:CollectBaseTypeChain" relation="SeeAlso" />
    <see type="fwcap:MemberIdentityKey" relation="SeeAlso" />
    <see type="fwcap:ResolveContracts" relation="SeeAlso" />
  </references>
  <properties>
    <block type="bomblock:BlockDefinition">
      <documentation>
        block. TS type: bomblock:BlockDefinition. (required)
      </documentation>
    </block>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        registry. TS type: fwcap:TypeRegistry. (required)
      </documentation>
    </registry>
    <members type="bommember:MemberDefinition[]">
      <documentation>
        members. TS type: bommember:MemberDefinition[]. (required)
      </documentation>
    </members>
  </properties>
</fwcap:ResolveEffectiveMembers>
