<!--Framework Capability — ForkBom
  FQN: org.blockml.bml.framework.capability.ForkBom-->
<fwcap:ForkBom xmlns="http://blockml.org/bml"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Deep-clone Urmodell for pragmatic / validation working copy
  </is>
  <documentation>
    Deep-clone Urmodell for pragmatic / validation working copy
  </documentation>
  <references>
    <see type="bomdocumentation:PublicApi" relation="SeeAlso" />
  </references>
  <properties>
    <document type="bomdoc:BomDocument">
      <documentation>
        document. TS type: bomdoc:BomDocument. (required)
      </documentation>
    </document>
    <copy type="bomdoc:BomDocument">
      <documentation>
        copy. TS type: bomdoc:BomDocument. (required)
      </documentation>
    </copy>
  </properties>
</fwcap:ForkBom>
