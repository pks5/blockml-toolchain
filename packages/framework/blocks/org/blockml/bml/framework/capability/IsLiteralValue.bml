<!--Framework Capability — IsLiteralValue
  FQN: org.blockml.bml.framework.capability.IsLiteralValue-->
<fwcap:IsLiteralValue xmlns="http://blockml.org/bml"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Type guard for LiteralValue member values
  </is>
  <documentation>
    Type guard for LiteralValue member values
  </documentation>
  <properties>
    <value type="bomvalue:MemberValue">
      <documentation>
        Member value or undefined. (optional)
      </documentation>
    </value>
    <result type="type:Boolean">
      <documentation>
        result. TS type: type:Boolean. (required)
      </documentation>
    </result>
  </properties>
</fwcap:IsLiteralValue>
