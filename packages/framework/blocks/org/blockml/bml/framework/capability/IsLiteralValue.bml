  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Type guard for LiteralValue member values
  </is>
  <documentation>
    Type guard for LiteralValue member values
  </documentation>
  <properties>
    <value type="bomvalue:MemberValue">
      <documentation>
        Member value or undefined. (optional)
      </documentation>
    </value>
    <result type="type:Boolean">
      <documentation>
        result. TS type: type:Boolean. (required)
      </documentation>
    </result>
  </properties>
</fwcap:IsLiteralValue>
