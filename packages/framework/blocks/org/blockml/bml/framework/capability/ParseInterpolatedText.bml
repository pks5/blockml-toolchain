<!--Framework Capability — ParseInterpolatedText
  FQN: org.blockml.bml.framework.capability.ParseInterpolatedText-->
<fwcap:ParseInterpolatedText xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:fwexpression="org.blockml.bml.framework.expression"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Parse interpolated text into an InterpolatedStringNode AST
  </is>
  <documentation>
    Scan authored text for unescaped `${` holes. `\${` is a literal `${`; an even
    number of backslashes immediately before `$` leaves a hole (`\\${` → `\` +
    hole). Restricted profile — same #this lookup as full expressions; no @model,
    @bean, or capability calls.
  </documentation>
  <references>
    <see type="fwdocumentation:ExpressionParsing" relation="SeeAlso" />
  </references>
  <properties>
    <source type="type:Text">
      <documentation>
        source. TS type: type:Text. (required)
      </documentation>
    </source>
    <outcome type="fwexpression:ParseExpressionOutcome">
      <documentation>
        outcome. TS type: fwexpression:ParseExpressionOutcome. (required)
      </documentation>
    </outcome>
  </properties>
</fwcap:ParseInterpolatedText>
