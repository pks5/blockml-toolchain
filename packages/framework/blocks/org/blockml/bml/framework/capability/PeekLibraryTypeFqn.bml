<!--Framework Capability — PeekLibraryTypeFqn
  FQN: org.blockml.bml.framework.capability.PeekLibraryTypeFqn-->
<fwcap:PeekLibraryTypeFqn xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Root type FQN of a Library.bml file
  </is>
  <documentation>
    Reads Library.bml and returns document.block.type, or undefined if the file is missing or invalid. Used to compare library identity across realpaths (workspace vs npm copy).
  </documentation>
  <references>
    <see type="fwcap:ResolveLibrarySeeds" relation="SeeAlso" />
  </references>
  <properties>
    <libraryPath type="type:Text">
      <documentation>
        libraryPath. TS type: type:Text. (required)
      </documentation>
    </libraryPath>
    <typeFqn type="type:Text">
      <documentation>
        Library type FQN, or undefined. (optional)
      </documentation>
    </typeFqn>
  </properties>
</fwcap:PeekLibraryTypeFqn>
