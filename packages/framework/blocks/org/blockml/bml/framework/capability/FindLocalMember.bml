<!--Framework Capability — FindLocalMember
  FQN: org.blockml.bml.framework.capability.FindLocalMember-->
<fwcap:FindLocalMember xmlns="http://blockml.org/bml"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Find a member declared on this block, not inherited
  </is>
  <documentation>
    Looks up memberIdentityKey(member) in block.members only. Returns the local declaration, or undefined when the member is inherited or absent.
  </documentation>
  <references>
    <see type="fwcap:MemberIdentityKey" relation="SeeAlso" />
    <see type="fwcap:ResolveEffectiveMembers" relation="SeeAlso" />
  </references>
  <properties>
    <block type="bomblock:BlockDefinition">
      <documentation>
        block. TS type: bomblock:BlockDefinition. (required)
      </documentation>
    </block>
    <member type="bommember:MemberDefinition">
      <documentation>
        member. TS type: bommember:MemberDefinition. (required)
      </documentation>
    </member>
    <local type="bommember:MemberDefinition">
      <documentation>
        Declared member on this block, or undefined. (optional)
      </documentation>
    </local>
  </properties>
</fwcap:FindLocalMember>
