<!--Framework Capability — ValidateInstances
  FQN: org.blockml.bml.framework.capability.ValidateInstances-->
<fwcap:ValidateInstances xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:fwcap="org.blockml.bml.framework.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Instance member rules against TypeRegistry
  </is>
  <documentation>
    Instance member rules against TypeRegistry. Authored memberValues keys
    and aggregationCompositions names must exist on the instance type
    (BML_UNKNOWN_PROPERTY).
  </documentation>
  <properties>
    <document type="bomdoc:BomDocument">
      <documentation>
        document. TS type: bomdoc:BomDocument. (required)
      </documentation>
    </document>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        registry. TS type: fwcap:TypeRegistry. (required)
      </documentation>
    </registry>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics. TS type: bomcommon:Diagnostic[]. (required)
      </documentation>
    </diagnostics>
  </properties>
</fwcap:ValidateInstances>
