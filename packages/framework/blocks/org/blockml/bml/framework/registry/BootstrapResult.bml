<!--Framework — BootstrapResult
  FQN: org.blockml.bml.framework.registry.BootstrapResult-->
<fwregistry:BootstrapResult xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwregistry="org.blockml.bml.framework.registry"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Result of bootstrapTypeRegistry corpus walk
  </is>
  <documentation>
    Returned by fwcap:BootstrapTypeRegistry. Registry may be partially populated when diagnostics are present. exportsByLibrary is set in libraryPaths mode. trace lists corpus, seeds, search index, visited libraries, and skipped covered roots.
  </documentation>
  <properties>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        registry. TS type: fwcap:TypeRegistry. (required)
      </documentation>
    </registry>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics. TS type: bomcommon:Diagnostic[]. (required)
      </documentation>
    </diagnostics>
    <exportsByLibrary type="type:Text">
      <documentation>
        exportsByLibrary — Map&lt;libraryPath, Set&lt;exportedFqn>> when libraryPaths bootstrap. (optional)
      </documentation>
    </exportsByLibrary>
    <trace type="fwregistry:BootstrapTrace">
      <documentation>
        Bootstrap source trace for hosts such as CLI --verbose. (optional)
      </documentation>
    </trace>
  </properties>
</fwregistry:BootstrapResult>
