<!--Framework — BootstrapOptions
  FQN: org.blockml.bml.framework.registry.BootstrapOptions-->
<fwregistry:BootstrapOptions xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwregistry="org.blockml.bml.framework.registry"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Options for bootstrapTypeRegistry corpus or library graph modes
  </is>
  <documentation>
    paths — flat corpus scan roots. libraryPaths — Library.bml entry points for dependency-ordered library mode. rootDir — relative path resolution base.
  </documentation>
  <properties>
    <paths type="type:Text[]">
      <documentation>
        Corpus roots for flat scan mode. (optional)
      </documentation>
    </paths>
    <libraryPaths type="type:Text[]">
      <documentation>
        Library.bml file paths for library graph mode. (optional)
      </documentation>
    </libraryPaths>
    <rootDir type="type:Text">
      <documentation>
        Working directory for relative paths. (optional)
      </documentation>
    </rootDir>
  </properties>
</fwregistry:BootstrapOptions>
