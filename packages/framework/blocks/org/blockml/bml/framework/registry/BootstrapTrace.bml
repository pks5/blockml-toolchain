<!--Framework — BootstrapTrace
  FQN: org.blockml.bml.framework.registry.BootstrapTrace-->
<fwregistry:BootstrapTrace xmlns="http://blockml.org/bml"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwregistry="org.blockml.bml.framework.registry"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    framework:FrameworkType
  </baseType>
  <is>
    Resolved bootstrap sources for tracing
  </is>
  <documentation>
    corpusPaths — scanned corpus roots. seeds — libraryPaths used. searchRoots — discovery index (not a corpus dump). librariesVisited — graph order. skippedCoveredRoots — library trees skipped because they sit inside corpus srcDir.
  </documentation>
  <properties>
    <corpusPaths type="type:Text[]">
      <documentation>
        corpusPaths. TS type: type:Text[]. (required)
      </documentation>
    </corpusPaths>
    <seeds type="type:Text[]">
      <documentation>
        seeds. TS type: type:Text[]. (required)
      </documentation>
    </seeds>
    <searchRoots type="type:Text[]">
      <documentation>
        searchRoots. TS type: type:Text[]. (required)
      </documentation>
    </searchRoots>
    <librariesVisited type="type:Text[]">
      <documentation>
        librariesVisited. TS type: type:Text[]. (required)
      </documentation>
    </librariesVisited>
    <skippedCoveredRoots type="type:Text[]">
      <documentation>
        skippedCoveredRoots. TS type: type:Text[]. (required)
      </documentation>
    </skippedCoveredRoots>
  </properties>
</fwregistry:BootstrapTrace>
