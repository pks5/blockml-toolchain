<!--Validator Style Check — PreferTypeAsTag
  FQN: org.blockml.bml.compiler.validator.style.PreferTypeAsTag-->
<valstyle:PreferTypeAsTag xmlns="http://blockml.org/bml"
  xmlns:valstyle="org.blockml.bml.compiler.validator.style">

  <baseType>
    valstyle:StyleCheck
  </baseType>
  <is>
    Warn when a definition still uses the legacy block wrapper
  </is>
  <documentation>
    Matches a BlockDefinition whose wrapperForm is block — the legacy
    definition wrapper. Preferred form uses the type (root / embed) or name
    (Sub-Block) as the element tag (doc:DocumentFormat).
  </documentation>
</valstyle:PreferTypeAsTag>
