<!--
  Validator Style Rule — OmitSubBlockIdentity
  FQN: org.blockml.bml.compiler.validator.style.OmitSubBlockIdentity
-->
<style:OmitSubBlockIdentity
  xmlns="http://blockml.org/bml"
  xmlns:style="org.blockml.bml.compiler.validator.style">

  <name>OmitSubBlockIdentity</name>
  <baseType>style:StyleRule</baseType>
  <is>Omit child name and type on preferred-form Sub-Blocks</is>

  <documentation>On a preferred-form Sub-Block the unqualified tag is the name and
    the type is derived from the parent. Child name and type elements are
    redundant (doc:DocumentFormat, doc:TypeIdentityDerivation).</documentation>

  <properties>
    <code override="true">
      <value>BML_STYLE_REDUNDANT_SUBBLOCK_IDENTITY</value>
    </code>
    <severity override="true">
      <value>warning</value>
    </severity>
    <appliesTo override="true">
      <value>preferred-form Sub-Block</value>
    </appliesTo>
    <message override="true">
      <value>Omit child name and type on preferred-form Sub-Blocks; the tag is the name and the type is derived.</value>
    </message>
  </properties>

  <aggregations>
    <check override="true">
      <composition>
        <style:PreferOmitSubBlockIdentity />
      </composition>
    </check>
  </aggregations>

</style:OmitSubBlockIdentity>
