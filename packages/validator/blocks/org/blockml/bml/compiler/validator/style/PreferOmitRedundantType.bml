<!--Validator Style Check — PreferOmitRedundantType
  FQN: org.blockml.bml.compiler.validator.style.PreferOmitRedundantType-->
<valstyle:PreferOmitRedundantType xmlns="http://blockml.org/bml"
  xmlns:valstyle="org.blockml.bml.compiler.validator.style">

  <baseType>
    valstyle:StyleCheck
  </baseType>
  <is>
    Warn when a preferred-form Block still declares a type child
  </is>
  <documentation>
    Matches any preferred-form definition (root, Sub-Block, or embed)
    that still authors a child type element. The tag already supplies the
    type, or the Sub-Block type is derived (doc:DocumentFormat).
  </documentation>
</valstyle:PreferOmitRedundantType>
