<!--Validator Style Rule — OmitUnusedNamespace
  FQN: org.blockml.bml.compiler.validator.style.OmitUnusedNamespace-->
<valstyle:OmitUnusedNamespace xmlns="http://blockml.org/bml"
  xmlns:valstyle="org.blockml.bml.compiler.validator.style">

  <baseType>
    valstyle:StyleRule
  </baseType>
  <is>
    Warn on unused root xmlns prefixes
  </is>
  <documentation>
    <![CDATA[
    Root xmlns:&lt;prefix&gt; declarations that do not address any authored type
    QName or annotation used in the document should be omitted. Default xmlns is
    exempt. A nested type-level binding (bml → BmlAnnotation) is unused when the
    type is written with a parent package prefix (ann:BmlAnnotation). Emitted as
    BML_STYLE_UNUSED_NAMESPACE (warning) at the document-root start tag.
    QName-bearing property and instance values count as uses.
    ]]>
  </documentation>
  <properties>
    <code override="true">
      <value>BML_STYLE_UNUSED_NAMESPACE</value>
    </code>
    <severity override="true">
      <value>warning</value>
    </severity>
    <appliesTo override="true">
      <value>document root xmlns prefix</value>
    </appliesTo>
    <message override="true">
      <value>Remove unused xmlns prefix declarations from the document root.</value>
    </message>
  </properties>
  <aggregations>
    <check override="true">
      <composition>
        <valstyle:PreferOmitUnusedNamespace />
      </composition>
    </check>
  </aggregations>
</valstyle:OmitUnusedNamespace>
