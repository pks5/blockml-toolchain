<!--Inspect — InspectedProperty
  FQN: org.blockml.bml.inspect.InspectedProperty-->
<inspect:InspectedProperty xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:inspectcap="org.blockml.bml.inspect.capability"
  xmlns:inspectdocumentation="org.blockml.bml.inspect.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectedMember
  </baseType>
  <is>
    One effective property in an Inspect projection
  </is>
  <documentation>
    Projected property. type is the member type. value is a literal when authored.
  </documentation>
  <properties>
    <type type="inspect:InspectTypeRef">
      <documentation>
        Projected property type. (optional)
      </documentation>
    </type>
    <value type="type:Text">
      <documentation>
        Literal property value. TS: unknown. (optional)
      </documentation>
    </value>
  </properties>
</inspect:InspectedProperty>
