<!--Inspect — InspectedProperty
  FQN: org.blockml.bml.inspect.InspectedProperty-->
<inspect:InspectedProperty xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectedMember
  </baseType>
  <is>
    One effective property in an Inspect projection
  </is>
  <documentation>
    Projected property. type is the member type. value is a literal when authored.
  </documentation>
  <properties>
    <type type="inspect:InspectTypeRef">
      <documentation>
        Projected property type. (optional)
      </documentation>
    </type>
    <value type="type:Text">
      <documentation>
        Literal property value. TS: unknown. (optional)
      </documentation>
    </value>
  </properties>
</inspect:InspectedProperty>
