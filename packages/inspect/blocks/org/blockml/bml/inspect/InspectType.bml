<!--Inspect — InspectType
  FQN: org.blockml.bml.inspect.InspectType-->
<inspect:InspectType xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:inspect="org.blockml.bml.inspect">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for Inspect projection data-structure blocks
  </is>
  <documentation>
    InspectResult, InspectedBlock, and related ValueTypes used as capability payloads.
  </documentation>
  <abstract>
    true
  </abstract>
</inspect:InspectType>
