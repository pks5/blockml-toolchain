<!--Inspect — InspectedAssociation
  FQN: org.blockml.bml.inspect.InspectedAssociation-->
<inspect:InspectedAssociation xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:inspectcap="org.blockml.bml.inspect.capability"
  xmlns:inspectdocumentation="org.blockml.bml.inspect.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectedMember
  </baseType>
  <is>
    One effective association in an Inspect projection
  </is>
  <documentation>
    Projected association. type and cardinality only — no composition instances.
  </documentation>
  <properties>
    <type type="inspect:InspectTypeRef">
      <documentation>
        Projected association type. (optional)
      </documentation>
    </type>
    <cardinality type="type:Text">
      <documentation>
        Association cardinality. (optional)
      </documentation>
    </cardinality>
  </properties>
</inspect:InspectedAssociation>
