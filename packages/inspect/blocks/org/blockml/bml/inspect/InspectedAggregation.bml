<!--Inspect — InspectedAggregation
  FQN: org.blockml.bml.inspect.InspectedAggregation-->
<inspect:InspectedAggregation xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectedMember
  </baseType>
  <is>
    One effective aggregation in an Inspect projection
  </is>
  <documentation>
    Projected aggregation. instances holds authored composition children when present — enum literals, Library catalog refs, nested ModelOperation/Task fills.
  </documentation>
  <properties>
    <type type="inspect:InspectTypeRef">
      <documentation>
        Projected aggregation type. (optional)
      </documentation>
    </type>
    <cardinality type="type:Text">
      <documentation>
        Aggregation cardinality. (optional)
      </documentation>
    </cardinality>
  </properties>
  <aggregations>
    <instances type="inspect:InspectedInstance[]">
      <documentation>
        Authored composition children. (optional)
      </documentation>
    </instances>
  </aggregations>
</inspect:InspectedAggregation>
