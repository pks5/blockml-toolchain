<!--BlockML Inspect Library Descriptor
  FQN: org.blockml.bml.inspect.Library-->
<inspect:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:inspect="org.blockml.bml.inspect">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Inspect package library catalog
  </is>
  <version>
    0.9.18
  </version>
  <documentation>
    Canonical inspect-view specification for BlockML — ephemeral JSON projection
    of a Block from the validate --all TypeRegistry. TypeScript in packages/inspect/src/
    implements this library. Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Inspect library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <inspect:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <framework:Library />
      </composition>
    </dependencies>
  </aggregations>
</inspect:Library>
