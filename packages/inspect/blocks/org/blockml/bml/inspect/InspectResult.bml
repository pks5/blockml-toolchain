<!--Inspect — InspectResult
  FQN: org.blockml.bml.inspect.InspectResult-->
<inspect:InspectResult xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectType
  </baseType>
  <is>
    Ephemeral JSON inspect view for one root FQN
  </is>
  <documentation>
    <![CDATA[Not a canonical model format. TS blocks is Record<fqn, InspectedBlock>. unresolved, cycles, and truncated are FQN lists.]]>
  </documentation>
  <properties>
    <root type="type:Text">
      <documentation>
        Inspected root FQN. (required)
      </documentation>
    </root>
    <depth type="type:Integer">
      <documentation>
        Applied expansion depth. (required)
      </documentation>
    </depth>
    <unresolved type="type:Text">
      <documentation>
        FQNs not found in the registry. TS: Text[]. (required)
      </documentation>
    </unresolved>
    <cycles type="type:Text">
      <documentation>
        FQNs that closed an expansion cycle. TS: Text[]. (required)
      </documentation>
    </cycles>
    <truncated type="type:Text">
      <documentation>
        FQNs skipped after the block budget. TS: Text[]. (required)
      </documentation>
    </truncated>
  </properties>
  <aggregations>
    <blocks type="inspect:InspectedBlock[]">
      <documentation>
        Projected blocks. TS: Record keyed by FQN. (required)
      </documentation>
    </blocks>
  </aggregations>
</inspect:InspectResult>
