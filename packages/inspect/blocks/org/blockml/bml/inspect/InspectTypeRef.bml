<!--Inspect — InspectTypeRef
  FQN: org.blockml.bml.inspect.InspectTypeRef-->
<inspect:InspectTypeRef xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectType
  </baseType>
  <is>
    Compact TypeExpression projection
  </is>
  <documentation>
    kind is named, union, generic, anonymousStruct, self, genericParam, or grouped. Named FQNs stay as ref; they are not inlined.
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        TypeExpression kind. (required)
      </documentation>
    </kind>
    <ref type="type:Text">
      <documentation>
        Named type FQN. (optional)
      </documentation>
    </ref>
    <args type="inspect:InspectTypeRef[]">
      <documentation>
        Generic type arguments. (optional)
      </documentation>
    </args>
    <alternatives type="inspect:InspectTypeRef[]">
      <documentation>
        Union alternatives. (optional)
      </documentation>
    </alternatives>
    <name type="type:Text">
      <documentation>
        Generic parameter name. (optional)
      </documentation>
    </name>
    <multiplicity type="type:Text">
      <documentation>
        min..max label. (optional)
      </documentation>
    </multiplicity>
  </properties>
</inspect:InspectTypeRef>
