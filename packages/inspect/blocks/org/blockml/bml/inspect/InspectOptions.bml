<!--Inspect — InspectOptions
  FQN: org.blockml.bml.inspect.InspectOptions-->
<inspect:InspectOptions xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:inspectcap="org.blockml.bml.inspect.capability"
  xmlns:inspectdocumentation="org.blockml.bml.inspect.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectType
  </baseType>
  <is>
    Options for inspectBlock and inspectProject
  </is>
  <documentation>
    Default depth 1, max depth 3, default maxBlocks 48. inspectProject also accepts srcDir and libraries for bootstrapFullProjectRegistry.
  </documentation>
  <properties>
    <depth type="type:Integer">
      <documentation>
        Expansion depth. (optional)
      </documentation>
    </depth>
    <rootDir type="type:Text">
      <documentation>
        Project root for relative paths and origin. (optional)
      </documentation>
    </rootDir>
    <srcDir type="type:Text">
      <documentation>
        Source directory override. (optional)
      </documentation>
    </srcDir>
    <libraries type="type:Text">
      <documentation>
        Extra library paths. TS: Text[]. (optional)
      </documentation>
    </libraries>
    <maxBlocks type="type:Integer">
      <documentation>
        Expansion budget. (optional)
      </documentation>
    </maxBlocks>
  </properties>
</inspect:InspectOptions>
