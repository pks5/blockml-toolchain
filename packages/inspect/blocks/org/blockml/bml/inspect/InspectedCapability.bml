<!--Inspect — InspectedCapability
  FQN: org.blockml.bml.inspect.InspectedCapability-->
<inspect:InspectedCapability xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectedMember
  </baseType>
  <is>
    One effective capability in an Inspect projection
  </is>
  <documentation>
    Projected capability. Includes implementation (language + truncated source) when authored.
  </documentation>
  <properties>
    <inputType type="inspect:InspectTypeRef">
      <documentation>
        Capability input type. (optional)
      </documentation>
    </inputType>
    <outputType type="inspect:InspectTypeRef">
      <documentation>
        Capability output type. (optional)
      </documentation>
    </outputType>
    <throws type="type:Text">
      <documentation>
        Thrown type FQNs. TS: Text[]. (optional)
      </documentation>
    </throws>
    <implementation type="inspect:InspectedImplementation">
      <documentation>
        Authored capability implementation. (optional)
      </documentation>
    </implementation>
  </properties>
</inspect:InspectedCapability>
