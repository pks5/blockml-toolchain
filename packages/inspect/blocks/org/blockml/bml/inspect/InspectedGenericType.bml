<!--Inspect — InspectedGenericType
  FQN: org.blockml.bml.inspect.InspectedGenericType-->
<inspect:InspectedGenericType xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectType
  </baseType>
  <is>
    Declared generic type parameter projection
  </is>
  <documentation>
    One genericTypes entry from the inspected Block. baseType is the bound FQN. defaultType is the resolved default when authored (FQN or earlier parameter name). documentation is the first GenericType.documentations entry, truncated like Block and member documentation.
  </documentation>
  <properties>
    <name type="type:Text">
      <documentation>
        Parameter name (e.g. T). (required)
      </documentation>
    </name>
    <baseType type="inspect:InspectTypeRef">
      <documentation>
        Constraint type. (required)
      </documentation>
    </baseType>
    <defaultType type="inspect:InspectTypeRef">
      <documentation>
        Resolved default type when authored. (optional)
      </documentation>
    </defaultType>
    <documentation type="type:Text">
      <documentation>
        First authored genericTypes documentation entry. (optional)
      </documentation>
    </documentation>
    <documentationTruncated type="type:Boolean">
      <documentation>
        True when documentation was truncated. (optional)
      </documentation>
    </documentationTruncated>
  </properties>
</inspect:InspectedGenericType>
