<!--Inspect — InspectedMember
  FQN: org.blockml.bml.inspect.InspectedMember-->
<inspect:InspectedMember xmlns="http://blockml.org/bml"
  xmlns:inspect="org.blockml.bml.inspect"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    inspect:InspectType
  </baseType>
  <is>
    Shared fields for a projected member
  </is>
  <documentation>
    Abstract base for the four kind-specific inspect member types.
    
    No kind discriminator — the owning InspectedBlock aggregation names the kind.
    inheritedFrom is omitted when the member is declared on the inspected Block.
    First documentation entry is projected when present; truncated to 400 characters with documentationTruncated.
  </documentation>
  <abstract>
    true
  </abstract>
  <properties>
    <name type="type:Text">
      <documentation>
        Logical member name. (required)
      </documentation>
    </name>
    <documentation type="type:Text">
      <documentation>
        First documentation entry. Truncated to 400 characters with an ellipsis when longer. (optional)
      </documentation>
    </documentation>
    <documentationTruncated type="type:Boolean">
      <documentation>
        true when documentation was truncated. (optional)
      </documentation>
    </documentationTruncated>
    <inheritedFrom type="type:Text">
      <documentation>
        Declaring ancestor or contract FQN. (optional)
      </documentation>
    </inheritedFrom>
    <visibility type="type:Text">
      <documentation>
        Member visibility. (optional)
      </documentation>
    </visibility>
    <readOnly type="type:Boolean">
      <documentation>
        true when the member is read-only. (optional)
      </documentation>
    </readOnly>
    <abstract type="type:Boolean">
      <documentation>
        true when the member is abstract. (optional)
      </documentation>
    </abstract>
    <final type="type:Boolean">
      <documentation>
        true when the member is final. (optional)
      </documentation>
    </final>
    <override type="type:Boolean">
      <documentation>
        true when the member overrides an ancestor. (optional)
      </documentation>
    </override>
  </properties>
</inspect:InspectedMember>
