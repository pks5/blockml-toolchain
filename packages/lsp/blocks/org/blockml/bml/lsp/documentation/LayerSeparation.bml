<!--LSP Documentation — LayerSeparation
  FQN: org.blockml.bml.lsp.documentation.LayerSeparation-->
<lspdocumentation:LayerSeparation xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    LSP vs language-service vs language stack
  </is>
  <documentation>
    Layers:
    
    org.blockml.bml.lsp.* (@blockml/lsp) — LSP protocol adapter + language-service API.
    No semantic rules here.
    
    @blockml/parser — Stage 1 BML → BomDocument (including source spans for hover).
    @blockml/serializer — BomDocument → canonical BML XML (format).
    @blockml/validator — Stage 2 validate() orchestration.
    @blockml/framework — TypeRegistry bootstrap for workspace.
    
    External IDE packages — Language Client only; grammar and file associations stay IDE-local.
  </documentation>
  <references>
    <see type="lspdocumentation:ArchitectureOverview" relation="ReadNext" />
  </references>
</lspdocumentation:LayerSeparation>
