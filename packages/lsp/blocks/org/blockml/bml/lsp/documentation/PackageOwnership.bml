<!--LSP Documentation — PackageOwnership
  FQN: org.blockml.bml.lsp.documentation.PackageOwnership-->
<lspdocumentation:PackageOwnership xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Toolchain responsibilities for LSP
  </is>
  <documentation>
    @blockml/lsp — LSP server, language-service, workspace bootstrap. Owns this BML library.
    
    @blockml/parser / @blockml/serializer / @blockml/validator / @blockml/framework — semantic backend.
    External VS Code (or other) extension — Language Client, TextMate grammar, token colors, .bml file association.
  </documentation>
  <references>
    <see type="lspdocumentation:ScopeExclusions" relation="ReadNext" />
  </references>
</lspdocumentation:PackageOwnership>
