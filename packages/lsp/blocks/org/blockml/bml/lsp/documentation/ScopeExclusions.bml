<!--LSP Documentation — ScopeExclusions
  FQN: org.blockml.bml.lsp.documentation.ScopeExclusions-->
<lspdocumentation:ScopeExclusions xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Explicit out-of-scope for @blockml/lsp V1
  </is>
  <documentation>
    Out of scope:
    • IDE extension UI, TextMate grammar, token colors, and file associations — external packages
    • BomBuilder structural authoring (V3)
    • Completion, workspace/symbol
    • Range formatting, tab indent
    • Duplicate parse/validate/serialize logic — must delegate to parser/validator/serializer
  </documentation>
  <references>
    <see type="lspdocumentation:Introduction" relation="SeeAlso" />
  </references>
</lspdocumentation:ScopeExclusions>
