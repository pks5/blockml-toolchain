<!--
  LSP Documentation — Introduction
  FQN: org.blockml.bml.lsp.documentation.Introduction
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:valcap="org.blockml.bml.compiler.validator.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <name>Introduction</name>
  <type>lspdocumentation:Introduction</type>
  <baseType>core:Documentation</baseType>
  <is>Purpose and scope of the LSP package</is>

  <documentation>The @blockml/lsp package provides an editor-agnostic Language Server for BML.
    It is a thin LSP adapter over the existing language loop — not a second parser or AST.

    This library (org.blockml.bml.lsp.*) is the SSOT. TypeScript in packages/lsp/src/
    implements it. IDE-specific clients (VS Code extension with TextMate grammar, etc.)
    live outside this repository and connect via stdio LSP.

    V1: textDocument sync + publishDiagnostics (parse + Stage-2 validate)
    + textDocument/formatting (parse → serialize)
    + textDocument/hover (Urmodell hit-test + TypeRegistry).
    Semantics: @blockml/parser, @blockml/serializer, @blockml/validator, @blockml/framework.</documentation>

  <references>
    <see type="lspdocumentation:LayerSeparation" relation="ReadNext"></see>
    <see type="valdocumentation:Introduction" relation="SeeAlso"></see>
  </references>

</block>
