<!--
  LSP Documentation — ServerLifecycle
  FQN: org.blockml.bml.lsp.documentation.ServerLifecycle
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:valcap="org.blockml.bml.compiler.validator.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ServerLifecycle</name>
  <type>lspdocumentation:ServerLifecycle</type>
  <baseType>core:Documentation</baseType>
  <is>LSP server initialize and document handlers</is>

  <documentation>initialize: resolve workspace root from rootUri or workspaceFolders[0];
    createWorkspace(rootDir).

    onDidOpenTextDocument: store TextDocument, validate immediately.
    onDidChangeTextDocument: debounce 400ms, re-validate.
    onDidCloseTextDocument: clear diagnostics.

    onInitialized: if the client supports dynamic file watchers, register
    **/*.bml, **/bom.config.json, **/package.json.
    onDidChangeWatchedFiles: debounce 400ms, invalidateWorkspace, re-bootstrap,
    re-validate all open documents. node_modules paths are ignored.
    Refresh uses the disk snapshot — unsaved buffers are not overlaid into the registry.

    onDocumentFormatting: formatDocument on the in-memory buffer; one full-document
    TextEdit, empty list if unchanged, or none if parse cannot produce a document.

    onHover: hoverAt on the in-memory buffer; XML token at the cursor;
    language / type-QName / member Markdown. Parse-only — no validator.

    onDocumentSymbol: documentSymbols on the in-memory buffer; hierarchical
    Urmodell tree. Parse-only — no validator. selectionRange equals range.

    onDefinition / onReferences: XML-token hitAt on the in-memory buffer, then
    TypeRegistry from disk. F12 only on type QNames (LocationLink covers the
    whole QName). includeDeclaration controls whether the defining block.source
    is included.

    Bootstrap errors (BML_LIBRARY_*) published once per workspace on each document until fixed.</documentation>

  <references>
    <see type="lspcap:StartLanguageServer" relation="Defines"></see>
  </references>

</block>
