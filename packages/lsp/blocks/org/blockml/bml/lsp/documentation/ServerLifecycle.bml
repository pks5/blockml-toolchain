<!--LSP Documentation — ServerLifecycle
  FQN: org.blockml.bml.lsp.documentation.ServerLifecycle-->
<lspdocumentation:ServerLifecycle xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    LSP server initialize and document handlers
  </is>
  <documentation>
    initialize: resolve workspace root from rootUri or workspaceFolders[0];
    createWorkspace(rootDir).
    
    onDidOpenTextDocument: store TextDocument, validate immediately.
    onDidChangeTextDocument: debounce 400ms, re-validate. If an idle workspace
    pass is pending or running, cancel it and reschedule after 1500ms.
    onDidCloseTextDocument: drop the in-memory buffer; keep last-published
    diagnostics so the client can still mark the closed file.
    
    onInitialized: schedule idle analyzeWorkspace (1500ms) for project sources.
    If the client supports dynamic file watchers, register
    **/*.bml, **/blockml.config.json, **/package.json.
    onDidChangeWatchedFiles: debounce 400ms, invalidateWorkspace, re-bootstrap,
    re-validate all open documents, then schedule idle analyzeWorkspace.
    node_modules paths are ignored. Workspace pass yields every few files and
    skips URIs that have an open buffer. Refresh uses the disk snapshot —
    unsaved buffers are not overlaid into the registry.
    
    onDocumentFormatting: formatDocument on the in-memory buffer; one full-document
    TextEdit, empty list if unchanged, or none if parse cannot produce a document.
    
    onHover: hoverAt on the in-memory buffer; XML token at the cursor;
    language / type-QName / member Markdown. Parse-only — no validator.
    
    onDocumentSymbol: documentSymbols on the in-memory buffer; hierarchical
    Urmodell tree. Parse-only — no validator. selectionRange equals range.
    
    onDefinition / onReferences: XML-token hitAt on the in-memory buffer, then
    TypeRegistry from disk. F12 on type QNames (prefix:Local, dotted FQN, or
    unqualified type-or-name in a type slot), override="true" member opening
    tags (nearest inherited declaration), and instance member attribute names
    or opening tags (nearest declaration on the instance type). LocationLink
    covers the origin token. includeDeclaration controls whether the defining
    block.source is included.
    
    onSemanticTokens: semanticTokensFor on the in-memory buffer; XML-stack walk
    classified by FrameworkRoles position (no parser, no TypeRegistry). Nested
    block re-enters L1. Unused root xmlns prefixes set the unnecessary modifier.
    Legend token types map to *.bml TextMate scopes in the client.
    
    Bootstrap errors (BML_LIBRARY_*) published once per workspace on each document until fixed.
  </documentation>
  <references>
    <see type="lspcap:StartLanguageServer" relation="Defines" />
  </references>
</lspdocumentation:ServerLifecycle>
