<!--LSP Documentation — PublicApi
  FQN: org.blockml.bml.lsp.documentation.PublicApi-->
<lspdocumentation:PublicApi xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:valcap="org.blockml.bml.compiler.validator.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Exported API from packages/lsp/src/index.ts
  </is>
  <documentation>
    analyzeDocument(text, filePath, workspace): AnalysisResult
    analyzeWorkspace(workspace): WorkspaceAnalysisResult
    formatDocument(text, options?): string | null
    hoverAt(text, filePath, position, workspace): HoverInfo | null
    documentSymbols(text, filePath): OutlineSymbol[] | null
    definitionAt(text, filePath, position, workspace): LspLocationLink[] | null
    referencesAt(text, filePath, position, workspace, includeDeclaration?): LspLocation[] | null
    semanticTokensFor(text): SemanticTokensResult
    createWorkspace(rootDir): WorkspaceState
    loadBomConfig(rootDir): BomConfig
    invalidateWorkspace(rootDir): void
    bomLocationToRange(loc, documentText?): LSP Range
    bomSeverityToLsp(severity): LSP DiagnosticSeverity
    diagnosticToLsp(diagnostic, documentText?): LSP Diagnostic
    
    Server entry (not exported from index): packages/lsp/dist/server.js via bin blockml-lsp.
  </documentation>
  <references>
    <see type="lspcap:AnalyzeDocument" relation="Defines" />
    <see type="lspcap:AnalyzeWorkspace" relation="Defines" />
    <see type="lspcap:FormatDocument" relation="Defines" />
    <see type="lspcap:HoverAt" relation="Defines" />
    <see type="lspcap:DocumentSymbols" relation="Defines" />
    <see type="lspcap:DefinitionAt" relation="Defines" />
    <see type="lspcap:ReferencesAt" relation="Defines" />
    <see type="lspcap:SemanticTokensFor" relation="Defines" />
    <see type="lspdocumentation:DesignDecisions" relation="ReadNext" />
  </references>
</lspdocumentation:PublicApi>
