<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:valcap="org.blockml.bml.compiler.validator.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation"
  xmlns:doc="org.blockml.bml.documentation">

  <name>PublicApi</name>
  <type>lspdocumentation:PublicApi</type>
  <baseType>core:Documentation</baseType>
  <is>Exported API from packages/lsp/src/index.ts</is>

  <documentation>analyzeDocument(text, filePath, workspace): AnalysisResult
    formatDocument(text, options?): string | null
    createWorkspace(rootDir): WorkspaceState
    loadBomConfig(rootDir): BomConfig
    invalidateWorkspace(rootDir): void
    bomLocationToRange(loc, documentText?): LSP Range
    bomSeverityToLsp(severity): LSP DiagnosticSeverity
    diagnosticToLsp(diagnostic, documentText?): LSP Diagnostic

    Server entry (not exported from index): packages/lsp/dist/server.js via bin blockml-lsp.</documentation>

  <references>
    <see type="lspcap:AnalyzeDocument" relation="Defines"></see>
    <see type="lspcap:FormatDocument" relation="Defines"></see>
    <see type="lspdocumentation:DesignDecisions" relation="ReadNext"></see>
  </references>

</block>
