<!--LSP — LspRange
  FQN: org.blockml.bml.lsp.LspRange-->
<lsp:LspRange xmlns="http://blockml.org/bml"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    LSP text range
  </is>
  <documentation>
    BML type gap: stands for TypeScript LspRange (packages/lsp/src/positions.ts).
  </documentation>
  <properties>
    <start type="lsp:LspPosition">
      <documentation>
        start (required). TS type: lsp:LspPosition.
      </documentation>
    </start>
    <end type="lsp:LspPosition">
      <documentation>
        end (required). TS type: lsp:LspPosition.
      </documentation>
    </end>
  </properties>
</lsp:LspRange>
