<!--LSP — LspLocationLink
  FQN: org.blockml.bml.lsp.LspLocationLink-->
<lsp:LspLocationLink xmlns="http://blockml.org/bml"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    Go-to-definition origin range and target location
  </is>
  <documentation>
    BML type gap: stands for TypeScript LspLocationLink (packages/lsp/src/navigation.ts).
  </documentation>
  <properties>
    <originSelectionRange type="lsp:LspRange">
      <documentation>
        originSelectionRange (required). TS type: lsp:LspRange.
      </documentation>
    </originSelectionRange>
    <target type="lsp:LspLocation">
      <documentation>
        target (required). TS type: lsp:LspLocation.
      </documentation>
    </target>
  </properties>
</lsp:LspLocationLink>
