<!--LSP — LspPosition
  FQN: org.blockml.bml.lsp.LspPosition-->
<lsp:LspPosition xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    LSP 0-based text position
  </is>
  <documentation>
    BML type gap: stands for TypeScript LspPosition (packages/lsp/src/positions.ts). Core has no LSP protocol ValueType.
  </documentation>
  <properties>
    <line type="type:Integer">
      <documentation>
        0-based line. (required)
      </documentation>
    </line>
    <character type="type:Integer">
      <documentation>
        0-based character. (required)
      </documentation>
    </character>
  </properties>
</lsp:LspPosition>
