<!--LSP — MarkupContent
  FQN: org.blockml.bml.lsp.MarkupContent-->
<lsp:MarkupContent xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    Markdown hover contents
  </is>
  <documentation>
    BML type gap: stands for TypeScript MarkupContent (packages/lsp/src/hover.ts). kind is always markdown.
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        Always "markdown". (required)
      </documentation>
    </kind>
    <value type="type:Text">
      <documentation>
        value (required). TS type: type:Text.
      </documentation>
    </value>
  </properties>
</lsp:MarkupContent>
