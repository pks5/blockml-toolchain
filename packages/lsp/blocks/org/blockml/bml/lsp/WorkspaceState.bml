<!--LSP — WorkspaceState
  FQN: org.blockml.bml.lsp.WorkspaceState-->
<lsp:WorkspaceState xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    Cached workspace TypeRegistry and bootstrap diagnostics
  </is>
  <documentation>
    Per-root-dir language-service workspace. createWorkspace() builds and caches this.
  </documentation>
  <properties>
    <rootDir type="type:Text">
      <documentation>
        Absolute workspace root. (required)
      </documentation>
    </rootDir>
    <config type="type:Text">
      <documentation>
        Loaded BomConfig (srcDir, libraries). (required)
      </documentation>
    </config>
    <registry type="fwcap:TypeRegistry">
      <documentation>
        Bootstrapped TypeRegistry for this workspace. (required)
      </documentation>
    </registry>
    <bootstrapDiagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        Library-graph bootstrap errors kept for analysis. (required)
      </documentation>
    </bootstrapDiagnostics>
  </properties>
</lsp:WorkspaceState>
