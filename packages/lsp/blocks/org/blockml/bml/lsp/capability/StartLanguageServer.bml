<!--LSP Capability — StartLanguageServer
  FQN: org.blockml.bml.lsp.capability.StartLanguageServer-->
<lspcap:StartLanguageServer xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    stdio LSP server entry (bin blockml-lsp)
  </is>
  <documentation>
    packages/lsp/dist/server.js — document sync, publishDiagnostics (open buffers and idle project-source workspace pass), textDocument/formatting, textDocument/hover, textDocument/documentSymbol, textDocument/definition, textDocument/references, and textDocument/semanticTokens/full.
  </documentation>
  <references>
    <see type="lspdocumentation:ServerLifecycle" relation="SeeAlso" />
  </references>
</lspcap:StartLanguageServer>
