<!--LSP Capability — DefinitionAt
  FQN: org.blockml.bml.lsp.capability.DefinitionAt-->
<lspcap:DefinitionAt xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:fwcap="org.blockml.bml.framework.capability"
  xmlns:fwdocumentation="org.blockml.bml.framework.documentation"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:valcap="org.blockml.bml.compiler.validator.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Go-to-definition from a type QName or member use via TypeRegistry
  </is>
  <documentation>
    # Go-to-definition from a type QName or member use via TypeRegistry
    
    Parse-only XML-token hit-test. Jump targets:
    
    • Type QNames — prefix:Local, dotted FQN, or unqualified type-or-name in a type
      slot (implicit namespace). originSelectionRange covers the whole QName; target
      is registry.get(fqn).block.source with the open document overlaid.
    • Member override — opening tag of a domain member with override="true" jumps
      to the nearest higher declaration of the same member identity (parent
      baseType, then grandparent, then a contract on the current block).
    • Instance member — on a composition Block instance, the attribute name
      (before =) or the opening tag of a property / aggregation / association /
      capability child jumps to the nearest declaration on that instance type
      (the instance type itself, then parent, then grandparent). Closing tags
      and attribute values are not targets.
    
    Language tags are not definitions. Unknown FQN, no inherited member, no hit,
    or no document → null.
  </documentation>
  <references>
    <see type="lspdocumentation:PublicApi" relation="SeeAlso" />
    <see type="parcap:Parse" relation="SeeAlso" />
    <see type="fwcap:ResolveEffectiveMembers" relation="SeeAlso" />
    <see type="fwcap:CollectBaseTypeChain" relation="SeeAlso" />
    <see type="def:MemberDefinition" relation="SeeAlso" />
  </references>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <position type="lsp:LspPosition">
      <documentation>
        LSP 0-based Position { line, character }. (required)
      </documentation>
    </position>
    <workspace type="lsp:WorkspaceState">
      <documentation>
        workspace. TS type: lsp:WorkspaceState. (required)
      </documentation>
    </workspace>
    <result type="lsp:LspLocationLink[]">
      <documentation>
        LspLocationLink[] | null. (required)
      </documentation>
    </result>
  </properties>
</lspcap:DefinitionAt>
