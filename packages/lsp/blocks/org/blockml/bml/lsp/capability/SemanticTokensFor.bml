<!--LSP Capability — SemanticTokensFor
  FQN: org.blockml.bml.lsp.capability.SemanticTokensFor-->
<lspcap:SemanticTokensFor xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Position-based semantic tokens for a BML document
  </is>
  <documentation>
    <![CDATA[
    # Position-based semantic tokens for a BML document
    
    XML-stack walk (no parse() / TypeRegistry). Classifies each element name by nesting
    relative to the nearest document root or nested definition wrapper, matching
    org.blockml.bml.vscode.theme.FrameworkRoles:
    
    • root, block declaration/facet/container
    • member container/name/field/facet/sub-container
    • domain type, composition instance
    
    Domain type and composition-instance locals use the same type-or-name rule as
    parcap:IsDocumentRootLocalName (except legacy block): optional visibility
    underscores, then an uppercase letter, then letters, digits, or underscores.
    That includes TypeReferenceEntity empty-child sugar in type lists
    (diag:BML_INVALID_ROOT, _Utils, T00001_PoemTest_20260830T232831).
    
    Nested block re-enters L1. Lexical tokens cover attributes, strings, comments,
    interpolation, embed, and punctuation.
    
    Unused root xmlns:&lt;prefix&gt; declarations get the standard LSP modifier unnecessary
    so clients can fade / desaturate them. A prefix is used when it appears as an element
    or attribute QName (including the root tag) or as a type QName in text or attribute
    values. The default xmlns is never unused. Comments do not count as uses. The
    declaration itself is not a use. Legend tokenModifiers is [unnecessary].
    
    Returns LSP SemanticTokens.data (5-int groups). Used by textDocument/semanticTokens/full.
    ]]>
  </documentation>
  <references>
    <see type="lspdocumentation:PublicApi" relation="SeeAlso" />
    <see type="parcap:IsDocumentRootLocalName" relation="SeeAlso" />
  </references>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <result type="lsp:SemanticTokensResult">
      <documentation>
        LSP encoded semantic tokens. (required)
      </documentation>
    </result>
  </properties>
</lspcap:SemanticTokensFor>
