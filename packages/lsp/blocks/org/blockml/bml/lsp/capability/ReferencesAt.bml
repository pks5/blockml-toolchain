<!--LSP Capability — ReferencesAt
  FQN: org.blockml.bml.lsp.capability.ReferencesAt-->
<lspcap:ReferencesAt xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Find references to a type FQN from an LSP position
  </is>
  <documentation>
    # Find references to a type FQN from an LSP position
    
    Parse-only hit-test, then scan the TypeRegistry with the open document overlaid. Usages: baseTypeSource and member typeFqn. includeDeclaration (default true) also includes the defining block.source. No hit / no document → null. Hit with no usages → empty list.
  </documentation>
  <references>
    <see type="lspdocumentation:PublicApi" relation="SeeAlso" />
    <see type="parcap:Parse" relation="SeeAlso" />
  </references>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <position type="lsp:LspPosition">
      <documentation>
        LSP 0-based Position { line, character }. (required)
      </documentation>
    </position>
    <workspace type="lsp:WorkspaceState">
      <documentation>
        workspace. TS type: lsp:WorkspaceState. (required)
      </documentation>
    </workspace>
    <includeDeclaration type="type:Boolean">
      <documentation>
        includeDeclaration. TS type: type:Boolean. (optional)
      </documentation>
    </includeDeclaration>
    <result type="lsp:LspLocation[]">
      <documentation>
        LspLocation[] | null. (required)
      </documentation>
    </result>
  </properties>
</lspcap:ReferencesAt>
