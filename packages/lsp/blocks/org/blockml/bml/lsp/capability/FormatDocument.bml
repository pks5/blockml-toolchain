<!--LSP Capability — FormatDocument
  FQN: org.blockml.bml.lsp.capability.FormatDocument-->
<lspcap:FormatDocument xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Parse then serialize a BML document to canonical XML
  </is>
  <documentation>
    Editor-neutral format: parse(text) then serialize(). Returns null if parse cannot produce a document.
  </documentation>
  <references>
    <see type="lspdocumentation:PublicApi" relation="SeeAlso" />
    <see type="sercap:Serialize" relation="SeeAlso" />
    <see type="parcap:Parse" relation="SeeAlso" />
  </references>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <indent type="type:Integer">
      <documentation>
        indent. TS type: type:Integer. (optional)
      </documentation>
    </indent>
    <xmlDeclaration type="type:Boolean">
      <documentation>
        xmlDeclaration. TS type: type:Boolean. (optional)
      </documentation>
    </xmlDeclaration>
    <result type="type:Text">
      <documentation>
        result. TS type: type:Text. (required)
      </documentation>
    </result>
  </properties>
</lspcap:FormatDocument>
