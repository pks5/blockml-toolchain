<!--LSP Capability — AnalyzeDocument
  FQN: org.blockml.bml.lsp.capability.AnalyzeDocument-->
<lspcap:AnalyzeDocument xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:valcap="org.blockml.bml.compiler.validator.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Parse and validate a BML document in workspace context
  </is>
  <documentation>
    Editor-neutral analysis: parse(text) then validate with a TypeRegistry copy that
    overlays the open document (same FQN). Cached workspace registry stays disk-only.
  </documentation>
  <references>
    <see type="lspdocumentation:PublicApi" relation="SeeAlso" />
    <see type="valcap:Validate" relation="SeeAlso" />
    <see type="parcap:Parse" relation="SeeAlso" />
  </references>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <workspace type="lsp:WorkspaceState">
      <documentation>
        workspace. TS type: lsp:WorkspaceState. (required)
      </documentation>
    </workspace>
    <result type="lsp:AnalysisResult">
      <documentation>
        result. TS type: lsp:AnalysisResult. (required)
      </documentation>
    </result>
  </properties>
</lspcap:AnalyzeDocument>
