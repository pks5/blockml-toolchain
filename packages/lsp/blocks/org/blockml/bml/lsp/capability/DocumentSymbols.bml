<!--LSP Capability — DocumentSymbols
  FQN: org.blockml.bml.lsp.capability.DocumentSymbols-->
<lspcap:DocumentSymbols xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp"
  xmlns:lspcap="org.blockml.bml.lsp.capability"
  xmlns:lspdocumentation="org.blockml.bml.lsp.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Hierarchical document outline from the Urmodell
  </is>
  <documentation>
    Parse-only (no validator, no TypeRegistry). Walks Block members, subBlocks, and embeddedBlocks into a DocumentSymbol tree. selectionRange equals range. Returns null if parse cannot produce a document.
  </documentation>
  <references>
    <see type="lspdocumentation:PublicApi" relation="SeeAlso" />
    <see type="parcap:Parse" relation="SeeAlso" />
  </references>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <result type="lsp:OutlineSymbol[]">
      <documentation>
        OutlineSymbol[] | null. (required)
      </documentation>
    </result>
  </properties>
</lspcap:DocumentSymbols>
