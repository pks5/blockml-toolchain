<!--LSP — AnalysisResult
  FQN: org.blockml.bml.lsp.AnalysisResult-->
<lsp:AnalysisResult xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    Parse plus validate outcome for one document
  </is>
  <documentation>
    Returned by analyzeDocument(). document is null when parse cannot produce a BomDocument.
  </documentation>
  <properties>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        Parse and validate diagnostics. (required)
      </documentation>
    </diagnostics>
    <document type="bomdoc:BomDocument">
      <documentation>
        Parsed document, or omitted when parse failed. (optional)
      </documentation>
    </document>
  </properties>
</lsp:AnalysisResult>
