<!--LSP — SemanticTokensResult
  FQN: org.blockml.bml.lsp.SemanticTokensResult-->
<lsp:SemanticTokensResult xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    LSP semanticTokens/full payload
  </is>
  <documentation>
    BML type gap: stands for TypeScript SemanticTokensResult (packages/lsp/src/semantic-tokens.ts). data is the LSP 5-int delta encoding (deltaLine, deltaStart, length, tokenType, tokenModifiers).
  </documentation>
  <properties>
    <data type="type:Integer[]">
      <documentation>
        LSP SemanticTokens.data integer array. (required)
      </documentation>
    </data>
  </properties>
</lsp:SemanticTokensResult>
