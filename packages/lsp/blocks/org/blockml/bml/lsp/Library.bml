<!--BlockML LSP Library Descriptor
  FQN: org.blockml.bml.lsp.Library-->
<lsp:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:validator="org.blockml.bml.compiler.validator"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Language Server package library catalog
  </is>
  <version>
    0.9.18
  </version>
  <documentation>
    Canonical LSP specification for BlockML IDE integration — editor-agnostic language
    service and stdio server. TypeScript in packages/lsp/src/ implements this library.
    Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Language Server library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <lsp:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <parser:Library />
        <serializer:Library />
        <validator:Library />
        <framework:Library />
      </composition>
    </dependencies>
  </aggregations>
</lsp:Library>
