<!--LSP — LspLocation
  FQN: org.blockml.bml.lsp.LspLocation-->
<lsp:LspLocation xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    URI plus range for a workspace location
  </is>
  <documentation>
    BML type gap: stands for TypeScript LspLocation (packages/lsp/src/navigation.ts).
  </documentation>
  <properties>
    <uri type="type:Text">
      <documentation>
        uri (required). TS type: type:Text.
      </documentation>
    </uri>
    <range type="lsp:LspRange">
      <documentation>
        range (required). TS type: lsp:LspRange.
      </documentation>
    </range>
  </properties>
</lsp:LspLocation>
