<!--LSP — OutlineSymbol
  FQN: org.blockml.bml.lsp.OutlineSymbol-->
<lsp:OutlineSymbol xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    Hierarchical document-symbol outline node
  </is>
  <documentation>
    BML type gap: stands for TypeScript OutlineSymbol (packages/lsp/src/outline.ts). children is recursive.
  </documentation>
  <properties>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <detail type="type:Text">
      <documentation>
        detail (optional). TS type: type:Text.
      </documentation>
    </detail>
    <kind type="type:Integer">
      <documentation>
        LSP SymbolKind. (required)
      </documentation>
    </kind>
    <range type="lsp:LspRange">
      <documentation>
        range (required). TS type: lsp:LspRange.
      </documentation>
    </range>
    <selectionRange type="lsp:LspRange">
      <documentation>
        selectionRange (required). TS type: lsp:LspRange.
      </documentation>
    </selectionRange>
    <children type="lsp:OutlineSymbol[]">
      <documentation>
        children (optional). TS type: lsp:OutlineSymbol[].
      </documentation>
    </children>
  </properties>
</lsp:OutlineSymbol>
