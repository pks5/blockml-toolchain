<!--LSP — LspType
  FQN: org.blockml.bml.lsp.LspType-->
<lsp:LspType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for LSP implementation data-structure blocks
  </is>
  <documentation>
    Workspace, analysis, and LSP-protocol ValueTypes used as capability payloads (LspPosition, HoverInfo, OutlineSymbol, …).
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>
</lsp:LspType>
