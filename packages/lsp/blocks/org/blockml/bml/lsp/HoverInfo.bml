<!--LSP — HoverInfo
  FQN: org.blockml.bml.lsp.HoverInfo-->
<lsp:HoverInfo xmlns="http://blockml.org/bml"
  xmlns:lsp="org.blockml.bml.lsp">

  <baseType>
    lsp:LspType
  </baseType>
  <is>
    Hover result at an LSP position
  </is>
  <documentation>
    BML type gap: stands for TypeScript HoverInfo (packages/lsp/src/hover.ts).
  </documentation>
  <properties>
    <contents type="lsp:MarkupContent">
      <documentation>
        contents (required). TS type: lsp:MarkupContent.
      </documentation>
    </contents>
    <range type="lsp:LspRange">
      <documentation>
        range (required). TS type: lsp:LspRange.
      </documentation>
    </range>
  </properties>
</lsp:HoverInfo>
