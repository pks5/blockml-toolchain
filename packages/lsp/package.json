{
  "name": "@blockml/lsp",
  "version": "0.2.0",
  "description": "BlockML language server — diagnostics via parser and validator",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/lsp/Library.bml"
  },
  "bin": {
    "blockml-lsp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/lsp/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.2.0",
    "@blockml/framework": "^0.1.0",
    "@blockml/parser": "^0.2.0",
    "@blockml/serializer": "^0.1.0",
    "@blockml/validator": "^0.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "engines": {
    "node": ">=20"
  }
}
