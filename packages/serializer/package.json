{
  "name": "@blockml/serializer",
  "version": "0.9.8",
  "description": "BlockML serializer — BOM (Urmodell) to canonical BML XML",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pks5/blockml-toolchain.git",
    "directory": "packages/serializer"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "blockml": {
    "library": "./blocks/org/blockml/bml/compiler/serializer/Library.bml"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blocks"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build",
    "test": "vitest run packages/serializer/test"
  },
  "dependencies": {
    "@blockml/bom": "^0.9.8",
    "@blockml/core": "^1.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
