<!--Serializer Capability — EmitCharacterData
  FQN: org.blockml.bml.compiler.serializer.capability.EmitCharacterData-->
<sercap:EmitCharacterData xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Emit text or CDATA character data (D8)
  </is>
  <documentation>
    Emit text or CDATA character data (D8). Multiline values are written one XmlWriter line each so pretty-print indent applies per line; parse TrimText then recovers the BOM string (B13). Both forms run the same XML-safe sanitization as EscapeText before emit so U+FFFD and illegal XML 1.0 characters never reach the file.
  </documentation>
  <references>
    <see type="sercap:EscapeText" relation="SeeAlso" />
  </references>
  <properties>
    <writer type="seremit:XmlWriter">
      <documentation>
        writer. TS type: seremit:XmlWriter. (required)
      </documentation>
    </writer>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <form type="type:Text">
      <documentation>
        text | cdata — from authoredCharacterDataForm. (optional)
      </documentation>
    </form>
  </properties>
</sercap:EmitCharacterData>
