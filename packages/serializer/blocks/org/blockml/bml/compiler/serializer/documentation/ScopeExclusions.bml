<!--Serializer Documentation — ScopeExclusions
  FQN: org.blockml.bml.compiler.serializer.documentation.ScopeExclusions-->
<serdocumentation:ScopeExclusions xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Explicit out-of-scope for the serializer package
  </is>
  <documentation>
    Out of scope for @blockml/serializer:
    
    • Meta-driven bml:xml serializer (V2) — specified in org.blockml.bml.core; not V1
    • Render target emit (SCAD, JSON, MBOM serialize) — @blockml/compiler / domain packages
    • Semantic validation — @blockml/validator
    • Parser mapping (BML → BOM) — @blockml/parser
    • TypeRegistry bootstrap, effective member resolution — @blockml/core
    • BomBuilder (V3) — future; serializer accepts its output types only
    • File I/O (serializeFile), async, streaming — deferred API surfaces
    
    In scope: canonical BML XML roundtrip emit from any valid BomDocument.
  </documentation>
  <references>
    <see type="serdocumentation:Introduction" relation="SeeAlso" />
  </references>
</serdocumentation:ScopeExclusions>
