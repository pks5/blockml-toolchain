<!--Serializer Capability — QnameToParts
  FQN: org.blockml.bml.compiler.serializer.capability.QnameToParts-->
<sercap:QnameToParts xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Split prefixed QName into prefix and local name
  </is>
  <documentation>
    Split prefixed QName into prefix and local name
  </documentation>
  <properties>
    <qname type="type:Text">
      <documentation>
        qname. TS type: type:Text. (required)
      </documentation>
    </qname>
    <parts type="type:Text">
      <documentation>
        { prefix, local } (required)
      </documentation>
    </parts>
  </properties>
</sercap:QnameToParts>
