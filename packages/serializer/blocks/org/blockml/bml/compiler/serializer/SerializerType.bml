<!--Serializer — SerializerType
  FQN: org.blockml.bml.compiler.serializer.SerializerType-->
<serializer:SerializerType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:serializer="org.blockml.bml.compiler.serializer">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for serializer implementation data-structure blocks
  </is>
  <documentation>
    All org.blockml.bml.compiler.serializer.emit.* and .config.* types extend this marker. Distinct from bom:UrmodellType (parse-result data) and core:Capability (operations).
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>
</serializer:SerializerType>
