<!--Serializer Capability — EmitCompositionTemplate
  FQN: org.blockml.bml.compiler.serializer.capability.EmitCompositionTemplate-->
<sercap:EmitCompositionTemplate xmlns="http://blockml.org/bml"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Emit CompositionTemplate as &lt;composition> element tree
  </is>
  <documentation>
    <![CDATA[Emit CompositionTemplate as <composition> element tree]]>
  </documentation>
  <references>
    <see type="sercap:EmitCompositionNode" relation="SeeAlso" />
  </references>
  <properties>
    <writer type="seremit:XmlWriter">
      <documentation>
        writer. TS type: seremit:XmlWriter. (required)
      </documentation>
    </writer>
    <template type="bomcomp:CompositionTemplate">
      <documentation>
        template. TS type: bomcomp:CompositionTemplate. (required)
      </documentation>
    </template>
    <context type="seremit:EmitContext">
      <documentation>
        context. TS type: seremit:EmitContext. (required)
      </documentation>
    </context>
    <wrapInAggregation type="type:Text">
      <documentation>
        Optional aggregation local name wrapper. (optional)
      </documentation>
    </wrapInAggregation>
  </properties>
</sercap:EmitCompositionTemplate>
