<!--Serializer Capability — EmitBlockDefinition
  FQN: org.blockml.bml.compiler.serializer.capability.EmitBlockDefinition-->
<sercap:EmitBlockDefinition xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Emit full BlockDefinition tree in BLOCK_EMIT_ORDER (B12)
  </is>
  <documentation>
    <![CDATA[
    Walks serconfig:BlockEmitOrder; delegates to member/composition/type emit helpers.
    omitTypeChild is true when the wrapper tag already supplies the type (root, embed, or
    preferred Sub-Block). omitNameChild is true when a Sub-Block tag already supplies the name.
    ]]>
  </documentation>
  <references>
    <see type="serconfig:BlockEmitOrder" relation="SeeAlso" />
    <see type="serdocumentation:EmitOrder" relation="SeeAlso" />
  </references>
  <properties>
    <writer type="seremit:XmlWriter">
      <documentation>
        writer. TS type: seremit:XmlWriter. (required)
      </documentation>
    </writer>
    <block type="bomblock:BlockDefinition">
      <documentation>
        block. TS type: bomblock:BlockDefinition. (required)
      </documentation>
    </block>
    <context type="seremit:EmitContext">
      <documentation>
        context. TS type: seremit:EmitContext. (required)
      </documentation>
    </context>
    <omitTypeChild type="type:Boolean">
      <documentation>
        Skip child type when the wrapper tag already supplies it. TS type: type:Boolean. (optional)
      </documentation>
    </omitTypeChild>
    <omitNameChild type="type:Boolean">
      <documentation>
        Skip child name when a Sub-Block tag already supplies it. TS type: type:Boolean. (optional)
      </documentation>
    </omitNameChild>
  </properties>
</sercap:EmitBlockDefinition>
