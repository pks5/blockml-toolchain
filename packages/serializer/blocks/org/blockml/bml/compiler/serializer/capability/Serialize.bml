<!--Serializer Capability — Serialize
  FQN: org.blockml.bml.compiler.serializer.capability.Serialize-->
<sercap:Serialize xmlns="http://blockml.org/bml"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Public entry: BomDocument → canonical BML XML (B26)
  </is>
  <documentation>
    Orchestrates emit pipeline. Emit per B12–B25 / D8–D9. Does not call validator.
  </documentation>
  <references>
    <see type="serdocumentation:PublicApi" relation="SeeAlso" />
    <see type="bomapi:SerializeOptions" relation="SeeAlso" />
    <see type="bomapi:SerializeResult" relation="SeeAlso" />
  </references>
  <properties>
    <document type="bomdoc:BomDocument">
      <documentation>
        document. TS type: bomdoc:BomDocument. (required)
      </documentation>
    </document>
    <options type="bomapi:SerializeOptions">
      <documentation>
        Default indent=2, xmlDeclaration=false. (optional)
      </documentation>
    </options>
    <result type="bomapi:SerializeResult">
      <documentation>
        result. TS type: bomapi:SerializeResult. (required)
      </documentation>
    </result>
  </properties>
</sercap:Serialize>
