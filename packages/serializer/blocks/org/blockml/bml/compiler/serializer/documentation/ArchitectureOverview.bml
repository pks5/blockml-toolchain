<!--
  Serializer Documentation — ArchitectureOverview
  FQN: org.blockml.bml.compiler.serializer.documentation.ArchitectureOverview
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:doc="org.blockml.bml.documentation">

  <name>ArchitectureOverview</name>
  <type>serdocumentation:ArchitectureOverview</type>
  <baseType>core:Documentation</baseType>
  <is>Emit pipeline and module decomposition</is>

  <documentation><![CDATA[Entry point: serialize(document, options?) → SerializeResult (B26).

    Pipeline:
    1. Read document.source.namespaceBindings (default { "": "http://blockml.org/bml" })
    2. createEmitContext(bindings, indent) → EmitContext { bindings, useQName, indent }
    3. new XmlWriter(indent) — line-oriented XML builder with depth/indent
    4. Optional <?xml version="1.0" encoding="UTF-8"?> when xmlDeclaration=true
    5. emitRootStartTag — authored root tag (block or type) with xmlns* and optional xsi (B25)
    6. emitBlockDefinition — walk BlockDefinition in BLOCK_EMIT_ORDER (B12); omit child type when rootForm is type
    7. Return { text: writer.toString(), diagnostics, success }

    Module decomposition (packages/serializer/src/):
    • serialize.ts → capability:Serialize orchestrates the pipeline
    • emit/context.ts → seremit:EmitContext, sercap:CreateEmitContext
    • emit/xml.ts → seremit:XmlWriter, escaping/format helpers
    • emit/block.ts → sercap:EmitBlockDefinition, sercap:EmitRootStartTag
    • emit/composition.ts → composition tree emit (templates, instances, directives)
    • emit/type-expression.ts → sercap:EmitTypeExpression (TypeExpression → attribute string)
    • emit/qname.ts → FQN↔QName, visibility prefixes (B14, B21)
    • emit/constants.ts → serconfig:SerializerConstants (XSI_NS, BML_XMLNS)

    Internal types extend serializer:SerializerType. Public operations are sercap:* capabilities.]]></documentation>

  <references>
    <see type="serdocumentation:V1Scope" relation="ReadNext" />
    <see type="sercap:Serialize" relation="Defines" />
  </references>

</block>
