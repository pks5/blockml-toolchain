<!--Serializer Capability — EscapeAttr
  FQN: org.blockml.bml.compiler.serializer.capability.EscapeAttr-->
<sercap:EscapeAttr xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Escape string for XML attribute value
  </is>
  <documentation>
    Escape string for XML attribute value. Same XML-safe sanitization
    as EscapeText (illegal XML 1.0 chars and U+FFFD become `\uXXXX`),
    then `&amp;` `"` `&lt;`.
  </documentation>
  <properties>
    <value type="type:Text">
      <documentation>
        value. TS type: type:Text. (required)
      </documentation>
    </value>
    <escaped type="type:Text">
      <documentation>
        escaped. TS type: type:Text. (required)
      </documentation>
    </escaped>
  </properties>
</sercap:EscapeAttr>
