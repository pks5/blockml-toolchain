<!--Serializer Capability — EmitTypeExpression
  FQN: org.blockml.bml.compiler.serializer.capability.EmitTypeExpression-->
<sercap:EmitTypeExpression xmlns="http://blockml.org/bml"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Serialize TypeExpression to attribute string
  </is>
  <documentation>
    Named, union, struct, multiplicity, generic, self refs. Uses FqnToQName when context.useQName.
  </documentation>
  <references>
    <see type="sercap:FqnToQName" relation="SeeAlso" />
    <see type="serdocumentation:EmitRules" relation="SeeAlso" />
  </references>
  <properties>
    <expression type="bomtype:TypeExpression">
      <documentation>
        expression. TS type: bomtype:TypeExpression. (required)
      </documentation>
    </expression>
    <context type="seremit:EmitContext">
      <documentation>
        context. TS type: seremit:EmitContext. (required)
      </documentation>
    </context>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
  </properties>
</sercap:EmitTypeExpression>
