<!--
  Serializer Documentation — PackageOwnership
  FQN: org.blockml.bml.compiler.serializer.documentation.PackageOwnership
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>PackageOwnership</name>
  <type>serdocumentation:PackageOwnership</type>
  <baseType>core:Documentation</baseType>
  <is>Toolchain package responsibilities for serialization</is>

  <documentation>@blockml/serializer — BomDocument → canonical BML XML; serialize() → SerializeResult.
    Owns emit rules B12–B25 (serializer-side), emit architecture, this BML library.

    @blockml/bom — Urmodell types, SerializeOptions/SerializeResult (B26), Diagnostic,
    bomEquals/stripProvenance (B20). Serializer consumes; does not redefine.

    @blockml/core — TypeRegistry, Definition meta-model, bml:xml directive spec (D1–D9).
    V2 serializer consumes; V1 uses hardcoded snapshot.

    @blockml/parser — BML → BomDocument; inverse mapping owned separately.

    @blockml/lsp (V2) — format document → @blockml/serializer.

    @blockml/compiler / render targets — NOT canonical BML roundtrip; separate emit paths.</documentation>

  <references>
    <see type="serdocumentation:ScopeExclusions" relation="ReadNext"></see>
    <see type="bomdocumentation:PackageOwnership" relation="SeeAlso"></see>
  </references>

</block>
