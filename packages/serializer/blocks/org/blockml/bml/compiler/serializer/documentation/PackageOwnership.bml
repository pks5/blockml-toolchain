<!--Serializer Documentation — PackageOwnership
  FQN: org.blockml.bml.compiler.serializer.documentation.PackageOwnership-->
<serdocumentation:PackageOwnership xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Toolchain package responsibilities for serialization
  </is>
  <documentation>
    @blockml/serializer — BomDocument → canonical BML XML; serialize() → SerializeResult.
    Owns emit rules B12–B25 (serializer-side), emit architecture, this BML library.
    
    @blockml/bom — Urmodell types, SerializeOptions/SerializeResult (B26), Diagnostic,
    bomEquals/stripProvenance (B20). Serializer consumes; does not redefine.
    
    @blockml/framework — TypeRegistry, Definition meta-model, bml:xml directive spec (D1–D9).
    V2 serializer consumes; V1 uses hardcoded snapshot.
    
    @blockml/parser — BML → BomDocument; inverse mapping owned separately.
    
    @blockml/lsp (V2) — format document → @blockml/serializer.
    
    @blockml/compiler / render targets — NOT canonical BML roundtrip; separate emit paths.
  </documentation>
  <references>
    <see type="serdocumentation:ScopeExclusions" relation="ReadNext" />
    <see type="bomdocumentation:PackageOwnership" relation="SeeAlso" />
  </references>
</serdocumentation:PackageOwnership>
