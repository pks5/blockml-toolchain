<!--
  BlockML Serializer Library Descriptor
  FQN: org.blockml.bml.compiler.serializer.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability">

  <name>Library</name>
  <type>serializer:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML Serializer compiler package library catalog</is>

  <documentation>
    # The BlockML Serializer compiler package library catalog

    Canonical serializer specification for BlockML — emit rules (B12–B25), emit architecture,
    and serialize() contract. TypeScript in packages/serializer/src/ implements this library.

    Input/output Urmodell types live in org.blockml.bml.bom.* (@blockml/bom).

    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.8.1</version>

  <language>
    <English />
  </language>

  <properties>
    <description override="true">
      <value>BlockML Serializer library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <serializer:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
        <bom:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition>
        <serializer:SerializerType />
        <seremit:EmitContext />
        <seremit:XmlWriter />
        <serconfig:BlockEmitOrder />
        <serconfig:SerializerConstants />
        <sercap:Serialize />
        <sercap:CreateEmitContext />
        <sercap:EmitBlockDefinition />
        <sercap:EmitRootStartTag />
        <sercap:EmitTypeExpression />
        <sercap:EmitCompositionTemplate />
        <sercap:EmitCompositionNode />
        <sercap:EmitBlockInstance />
        <sercap:EmitConstraintInstances />
        <sercap:EmitTypeReferenceEntity />
        <sercap:HasBmlSemanticQNameBindings />
        <sercap:FqnToQName />
        <sercap:QnameToParts />
        <sercap:VisibilityPrefix />
        <sercap:EscapeAttr />
        <sercap:EscapeText />
        <sercap:NeedsCData />
        <sercap:EmitCharacterData />
        <sercap:FormatBoolean />
        <sercap:FormatMemberValue />
        <sercap:ShouldUseQName />
        <serdocumentation:Introduction />
        <serdocumentation:LayerSeparation />
        <serdocumentation:ArchitectureOverview />
        <serdocumentation:V1Scope />
        <serdocumentation:PublicApi />
        <serdocumentation:EmitOrder />
        <serdocumentation:EmitRules />
        <serdocumentation:XmlCommentsEmit />
        <serdocumentation:RoundtripContract />
        <serdocumentation:DesignDecisions />
        <serdocumentation:Diagnostics />
        <serdocumentation:PackageOwnership />
        <serdocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>

</block>
