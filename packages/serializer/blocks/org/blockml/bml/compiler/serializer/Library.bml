<!--
  BlockML Serializer Library Descriptor
  FQN: org.blockml.bml.compiler.serializer.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation">

  <name>Library</name>
  <type>serializer:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML Serializer compiler package library catalog</is>

  <documentation>
    Canonical serializer specification for BlockML — emit rules (B12–B25), emit architecture,
    and serialize() contract. TypeScript in packages/serializer/src/ implements this library.
    Input/output Urmodell types live in org.blockml.bml.bom.* (@blockml/bom).
    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.5.0</version>

  <language>
    <English />
  </language>

  <properties>
    <description>
      <value>BlockML Serializer library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <serializer:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
      </composition>
      <composition>
        <bom:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition><serializer:SerializerType /></composition>
      <composition><seremit:EmitContext /></composition>
      <composition><seremit:XmlWriter /></composition>
      <composition><serconfig:BlockEmitOrder /></composition>
      <composition><serconfig:SerializerConstants /></composition>
      <composition><sercap:Serialize /></composition>
      <composition><sercap:CreateEmitContext /></composition>
      <composition><sercap:EmitBlockDefinition /></composition>
      <composition><sercap:EmitRootStartTag /></composition>
      <composition><sercap:EmitTypeExpression /></composition>
      <composition><sercap:EmitCompositionTemplate /></composition>
      <composition><sercap:EmitCompositionNode /></composition>
      <composition><sercap:EmitBlockInstance /></composition>
      <composition><sercap:EmitConstraintInstances /></composition>
      <composition><sercap:EmitTypeReferenceEntity /></composition>
      <composition><sercap:HasBmlSemanticQNameBindings /></composition>
      <composition><sercap:FqnToQName /></composition>
      <composition><sercap:QnameToParts /></composition>
      <composition><sercap:VisibilityPrefix /></composition>
      <composition><sercap:EscapeAttr /></composition>
      <composition><sercap:EscapeText /></composition>
      <composition><sercap:NeedsCData /></composition>
      <composition><sercap:EmitCharacterData /></composition>
      <composition><sercap:FormatBoolean /></composition>
      <composition><sercap:FormatMemberValue /></composition>
      <composition><sercap:ShouldUseQName /></composition>
      <composition><serdocumentation:Introduction /></composition>
      <composition><serdocumentation:LayerSeparation /></composition>
      <composition><serdocumentation:ArchitectureOverview /></composition>
      <composition><serdocumentation:V1Scope /></composition>
      <composition><serdocumentation:PublicApi /></composition>
      <composition><serdocumentation:EmitOrder /></composition>
      <composition><serdocumentation:EmitRules /></composition>
      <composition><serdocumentation:XmlCommentsEmit /></composition>
      <composition><serdocumentation:RoundtripContract /></composition>
      <composition><serdocumentation:DesignDecisions /></composition>
      <composition><serdocumentation:Diagnostics /></composition>
      <composition><serdocumentation:PackageOwnership /></composition>
      <composition><serdocumentation:ScopeExclusions /></composition>
    </blocks>
  </aggregations>

</block>
