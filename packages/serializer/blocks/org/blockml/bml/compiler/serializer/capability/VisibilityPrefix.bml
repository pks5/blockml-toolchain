<!--Serializer Capability — VisibilityPrefix
  FQN: org.blockml.bml.compiler.serializer.capability.VisibilityPrefix-->
<sercap:VisibilityPrefix xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map visibility enum to XML localName prefix (B14)
  </is>
  <documentation>
    Map visibility enum to XML localName prefix (B14)
  </documentation>
  <references>
    <see type="serdocumentation:EmitRules" relation="SeeAlso" />
  </references>
  <properties>
    <visibility type="type:Text">
      <documentation>
        private | protected | public | undefined (optional)
      </documentation>
    </visibility>
    <prefix type="type:Text">
      <documentation>
        __ | _ | (empty) (required)
      </documentation>
    </prefix>
  </properties>
</sercap:VisibilityPrefix>
