<!--Serializer Capability — EmitRootStartTag
  FQN: org.blockml.bml.compiler.serializer.capability.EmitRootStartTag-->
<sercap:EmitRootStartTag xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Emit document root opening tag with xmlns and optional xsi attrs (B25)
  </is>
  <documentation>
    Re-emits namespaceBindings, schemaLocation, noNamespaceSchemaLocation from SourceInfo.
    rootTag is block for the legacy form, or the type QName / TypeIdentifier when
    SourceInfo.rootForm is type (doc:DocumentFormat). Do not invent schemaLocation or xsi.
  </documentation>
  <references>
    <see type="serdocumentation:EmitRules" relation="SeeAlso" />
  </references>
  <properties>
    <writer type="seremit:XmlWriter">
      <documentation>
        writer. TS type: seremit:XmlWriter. (required)
      </documentation>
    </writer>
    <bindings type="type:Text">
      <documentation>
        bindings. TS type: type:Text. (required)
      </documentation>
    </bindings>
    <schemaLocation type="type:Text">
      <documentation>
        schemaLocation. TS type: type:Text. (optional)
      </documentation>
    </schemaLocation>
    <noNamespaceSchemaLocation type="type:Text">
      <documentation>
        noNamespaceSchemaLocation. TS type: type:Text. (optional)
      </documentation>
    </noNamespaceSchemaLocation>
    <unknownAttributes type="type:Text">
      <documentation>
        unknownAttributes. TS type: type:Text. (optional)
      </documentation>
    </unknownAttributes>
    <rootTag type="type:Text">
      <documentation>
        Document root tag. Defaults to block. TS type: type:Text. (optional)
      </documentation>
    </rootTag>
  </properties>
</sercap:EmitRootStartTag>
