<!--Serializer Documentation — XmlCommentsEmit
  FQN: org.blockml.bml.compiler.serializer.documentation.XmlCommentsEmit-->
<serdocumentation:XmlCommentsEmit xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Comment re-emit layout (B11/B22)
  </is>
  <documentation>
    <![CDATA[
    Cross-ref: org.blockml.bml.bom.documentation.XmlComments for parse-side binding (B11).
    
    Serializer re-emit:
    • leadingComments → <!-- body --> lines immediately before the element
    • trailingComments → next line after element end tag (B22 — not same-line)
    • blank line after trailing-comment block so comment reads as trailing to previous element
    
    Whitespace/layout is not part of BOM equality (B10/B13). Parse accepts same-line trailing;
    serializer normalizes to next-line layout.
    ]]>
  </documentation>
  <references>
    <see type="bomdocumentation:XmlComments" relation="SeeAlso" />
    <see type="serdocumentation:RoundtripContract" relation="ReadNext" />
  </references>
</serdocumentation:XmlCommentsEmit>
