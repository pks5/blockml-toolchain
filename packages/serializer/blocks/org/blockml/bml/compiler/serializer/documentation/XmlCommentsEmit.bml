  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
>

  <name>XmlCommentsEmit</name>
  <type>serdocumentation:XmlCommentsEmit</type>
  <baseType>core:Documentation</baseType>
  <is>Comment re-emit layout (B11/B22)</is>

  <documentation>Cross-ref: org.blockml.bml.bom.documentation.XmlComments for parse-side binding (B11).

    Serializer re-emit:
    • leadingComments → &lt;!-- body --> lines immediately before the element
    • trailingComments → next line after element end tag (B22 — not same-line)
    • blank line after trailing-comment block so comment reads as trailing to previous element

    Whitespace/layout is not part of BOM equality (B10/B13). Parse accepts same-line trailing;
    serializer normalizes to next-line layout.</documentation>

  <references>
    <see type="bomdocumentation:XmlComments" relation="SeeAlso"></see>
    <see type="serdocumentation:RoundtripContract" relation="ReadNext"></see>
  </references>

</block>
