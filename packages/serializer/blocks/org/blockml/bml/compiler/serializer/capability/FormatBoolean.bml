    Format boolean value as lowercase true/false (B15)
  </documentation>
  <references>
    <see type="serdocumentation:EmitRules" relation="SeeAlso" />
  </references>
  <properties>
    <value type="type:Boolean">
      <documentation>
        value. TS type: type:Boolean. (required)
      </documentation>
    </value>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
  </properties>
</sercap:FormatBoolean>
