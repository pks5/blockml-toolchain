<!--Serializer Capability — FormatMemberValue
  FQN: org.blockml.bml.compiler.serializer.capability.FormatMemberValue-->
<sercap:FormatMemberValue xmlns="http://blockml.org/bml"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Format MemberValue for XML attribute emission
  </is>
  <documentation>
    Format MemberValue for XML attribute emission.
    
    ExpressionValue emits `${ raw }`. InterpolatedTextValue emits authored raw
    unchanged (escapes and holes). String LiteralValue re-escapes every `${` as
    `\${` (and doubles backslashes that precede `${`) so ParseMemberValue
    round-trips to the same literal. JSON arrays/objects are not interpolation-
    escaped — they stay structural tokens (compact collection form). Repeated
    instance tags are emitted by the composition writer when
    authoredPlacement is element and the literal is an array.
  </documentation>
  <references>
    <see type="sercap:FormatBoolean" relation="SeeAlso" />
    <see type="sercap:EscapeAttr" relation="SeeAlso" />
  </references>
  <properties>
    <value type="bomvalue:MemberValue">
      <documentation>
        value. TS type: bomvalue:MemberValue. (required)
      </documentation>
    </value>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
  </properties>
</sercap:FormatMemberValue>
