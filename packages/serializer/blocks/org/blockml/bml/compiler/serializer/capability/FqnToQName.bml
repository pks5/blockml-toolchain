<!--Serializer Capability — FqnToQName
  FQN: org.blockml.bml.compiler.serializer.capability.FqnToQName-->
<sercap:FqnToQName xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Convert resolved FQN to prefixed QName using bindings (B21)
  </is>
  <documentation>
    Picks the longest matching package URI so a type tag stays a TypeIdentifier
    (workspace:Library, not blockml:workspace.Library). On missing binding in
    QName mode, emit BML_NAMESPACE_UNBOUND diagnostic.
  </documentation>
  <references>
    <see type="serdocumentation:EmitRules" relation="SeeAlso" />
    <see type="serdocumentation:Diagnostics" relation="SeeAlso" />
  </references>
  <properties>
    <fqn type="type:Text">
      <documentation>
        fqn. TS type: type:Text. (required)
      </documentation>
    </fqn>
    <bindings type="type:Text">
      <documentation>
        bindings. TS type: type:Text. (required)
      </documentation>
    </bindings>
    <qname type="type:Text">
      <documentation>
        qname. TS type: type:Text. (required)
      </documentation>
    </qname>
  </properties>
</sercap:FqnToQName>
