<!--Serializer Documentation — Diagnostics
  FQN: org.blockml.bml.compiler.serializer.documentation.Diagnostics-->
<serdocumentation:Diagnostics xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:core="org.blockml.bml.core"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Serializer diagnostics and host policy
  </is>
  <documentation>
    BML_NAMESPACE_UNBOUND — emitted when QName-emit mode requires a namespace prefix
    that is not bound in document.source.namespaceBindings. Error severity; prefer still
    emitting text when possible so host can decide abort policy.
    
    Host policy (CLI / IDE): whether to refuse serialize after Stage-2 diagnostics is an
    orchestrator decision. The serializer package does not call the validator.
    
    Diagnostic type: org.blockml.bml.bom.common.Diagnostic (shared with parser/compiler).
  </documentation>
  <references>
    <see type="bomcommon:Diagnostic" relation="SeeAlso" />
    <see type="serdocumentation:PackageOwnership" relation="ReadNext" />
  </references>
</serdocumentation:Diagnostics>
