<!--Serializer Documentation — PublicApi
  FQN: org.blockml.bml.compiler.serializer.documentation.PublicApi-->
<serdocumentation:PublicApi xmlns="http://blockml.org/bml"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    serialize() entry point (B26)
  </is>
  <documentation>
    <![CDATA[
    serialize(document: BomDocument, options?: SerializeOptions): SerializeResult
    
    SerializeOptions (owned by @blockml/bom):
    • indent — default 2; pretty-print spaces (B13); 0 = compact
    • xmlDeclaration — default false; omit <?xml …?> (B17/B24)
    
    SerializeResult (owned by @blockml/bom):
    • text — string | null (null only if serialize cannot produce text)
    • diagnostics — Diagnostic[]
    • success — false if any diagnostic has severity === "error"
    
    Behaviour:
    • Emit per B12–B25 / D8–D9 (authoredPlacement, authoredCharacterDataForm)
    • BML_NAMESPACE_UNBOUND → error diagnostic; prefer still emitting text when possible
    • Does NOT call the validator — host decides abort-on-diagnostics
    • Sync only; no throw on recoverable errors
    • Never write UTF-8 BOM on output
    
    Not in V1 API: serializeFile, async variants, streaming.
    ]]>
  </documentation>
  <references>
    <see type="bomapi:SerializeOptions" relation="Defines" />
    <see type="bomapi:SerializeResult" relation="Defines" />
    <see type="sercap:Serialize" relation="Defines" />
    <see type="serdocumentation:EmitOrder" relation="ReadNext" />
  </references>
</serdocumentation:PublicApi>
