<!--Serializer — BlockEmitOrder
  FQN: org.blockml.bml.compiler.serializer.config.BlockEmitOrder-->
<serconfig:BlockEmitOrder xmlns="http://blockml.org/bml"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    serializer:SerializerType
  </baseType>
  <is>
    V1 hardcoded canonical &lt;block> child sequence (B12)
  </is>
  <documentation>
    Frozen snapshot of Definition member declaration order for Phase A. V2 reads Definition .bml dynamically.
  </documentation>
  <properties>
    <entries type="type:Text[]">
      <documentation>
        Ordered: name, type, baseType, is, isNot, version, definition, since, status, summary, documentation, abstract, final, keywords, changelog, examples, references, constraints, aliases, language, genericTypes, contracts, properties, aggregations, associations, capabilities, subBlocks, embeddedBlocks, bml:xml (required)
      </documentation>
    </entries>
  </properties>
</serconfig:BlockEmitOrder>
