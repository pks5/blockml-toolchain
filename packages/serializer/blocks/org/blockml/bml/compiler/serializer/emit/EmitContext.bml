<!--Serializer — EmitContext
  FQN: org.blockml.bml.compiler.serializer.emit.EmitContext-->
<seremit:EmitContext xmlns="http://blockml.org/bml"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    serializer:SerializerType
  </baseType>
  <is>
    Per-serialize emit configuration and namespace mode
  </is>
  <documentation>
    Created by createEmitContext(). useQName is true when document has BML-semantic prefixed xmlns bindings (B21).
  </documentation>
  <properties>
    <bindings type="type:Text">
      <documentation>
        Map: prefix → namespace URI from SourceInfo.namespaceBindings. (required)
      </documentation>
    </bindings>
    <useQName type="type:Boolean">
      <documentation>
        true when hasBmlSemanticQNameBindings(bindings). (required)
      </documentation>
    </useQName>
    <indent type="type:Integer">
      <documentation>
        Pretty-print indent spaces; 0 = compact (B13). (required)
      </documentation>
    </indent>
  </properties>
</seremit:EmitContext>
