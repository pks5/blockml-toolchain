<!--Serializer Capability — EscapeText
  FQN: org.blockml.bml.compiler.serializer.capability.EscapeText-->
<sercap:EscapeText xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Escape string for XML text content
  </is>
  <documentation>
    Escape string for XML text content. Replaces XML 1.0 illegal
    characters and U+FFFD with `\uXXXX` (or `\u{XXXXXX}` above BMP)
    before escaping `&amp;` and `&lt;`. U+FFFD is a legal XML Char
    but @xmldom/xmldom reports it as an encoding error
    (BML_MALFORMED_XML).
  </documentation>
  <properties>
    <value type="type:Text">
      <documentation>
        value. TS type: type:Text. (required)
      </documentation>
    </value>
    <escaped type="type:Text">
      <documentation>
        escaped. TS type: type:Text. (required)
      </documentation>
    </escaped>
  </properties>
</sercap:EscapeText>
