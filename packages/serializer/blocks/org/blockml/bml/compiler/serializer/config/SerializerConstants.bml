<!--Serializer — SerializerConstants
  FQN: org.blockml.bml.compiler.serializer.config.SerializerConstants-->
<serconfig:SerializerConstants xmlns="http://blockml.org/bml"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    serializer:SerializerType
  </baseType>
  <is>
    Well-known namespace URIs used during emit
  </is>
  <documentation>
    Excluded from BML-semantic QName binding detection (B21/B25).
  </documentation>
  <properties>
    <XSI_NS type="type:Text">
      <documentation>
        XSI_NS. TS type: type:Text. (required)
      </documentation>
    </XSI_NS>
    <BML_XMLNS type="type:Text">
      <documentation>
        BML_XMLNS. TS type: type:Text. (required)
      </documentation>
    </BML_XMLNS>
  </properties>
</serconfig:SerializerConstants>
