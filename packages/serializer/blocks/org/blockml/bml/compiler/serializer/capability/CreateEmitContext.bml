<!--Serializer Capability — CreateEmitContext
  FQN: org.blockml.bml.compiler.serializer.capability.CreateEmitContext-->
<sercap:CreateEmitContext xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Build EmitContext from namespace bindings and indent
  </is>
  <documentation>
    Sets useQName via HasBmlSemanticQNameBindings.
  </documentation>
  <references>
    <see type="seremit:EmitContext" relation="SeeAlso" />
    <see type="sercap:HasBmlSemanticQNameBindings" relation="SeeAlso" />
  </references>
  <properties>
    <bindings type="type:Text">
      <documentation>
        Record&lt;string, string> namespace bindings. (required)
      </documentation>
    </bindings>
    <indent type="type:Integer">
      <documentation>
        indent. TS type: type:Integer. (required)
      </documentation>
    </indent>
    <context type="seremit:EmitContext">
      <documentation>
        context. TS type: seremit:EmitContext. (required)
      </documentation>
    </context>
  </properties>
</sercap:CreateEmitContext>
