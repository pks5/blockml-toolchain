<!--
  Serializer Capability — CreateEmitContext
  FQN: org.blockml.bml.compiler.serializer.capability.CreateEmitContext
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability">

  <name>CreateEmitContext</name>
  <type>sercap:CreateEmitContext</type>
  <baseType>core:Capability</baseType>
  <is>Build EmitContext from namespace bindings and indent</is>

  <documentation>Sets useQName via HasBmlSemanticQNameBindings.</documentation>

  <references>
    <see type="seremit:EmitContext" relation="SeeAlso" />
    <see type="sercap:HasBmlSemanticQNameBindings" relation="SeeAlso" />
  </references>

  <properties>
    <bindings type="type:Text">
      <documentation>Record&lt;string, string> namespace bindings. (required)</documentation>
    </bindings>
    <indent type="type:Integer">
      <documentation>indent. TS type: type:Integer. (required)</documentation>
    </indent>
    <context type="seremit:EmitContext">
      <documentation>context. TS type: seremit:EmitContext. (required)</documentation>
    </context>
  </properties>

</block>
