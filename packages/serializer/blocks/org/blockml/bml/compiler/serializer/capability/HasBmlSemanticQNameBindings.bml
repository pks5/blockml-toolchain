<!--Serializer Capability — HasBmlSemanticQNameBindings
  FQN: org.blockml.bml.compiler.serializer.capability.HasBmlSemanticQNameBindings-->
<sercap:HasBmlSemanticQNameBindings xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Detect QName-emit mode from namespace bindings (B21)
  </is>
  <documentation>
    Returns true when any non-default, non-xsi, non-bml-default binding exists.
  </documentation>
  <references>
    <see type="serconfig:SerializerConstants" relation="SeeAlso" />
    <see type="serdocumentation:EmitRules" relation="SeeAlso" />
  </references>
  <properties>
    <bindings type="type:Text">
      <documentation>
        bindings. TS type: type:Text. (required)
      </documentation>
    </bindings>
    <result type="type:Boolean">
      <documentation>
        result. TS type: type:Boolean. (required)
      </documentation>
    </result>
  </properties>
</sercap:HasBmlSemanticQNameBindings>
