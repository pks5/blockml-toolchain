    Detect whether text requires CDATA wrapping (D8)
  </documentation>
  <properties>
    <text type="type:Text">
      <documentation>
        text. TS type: type:Text. (required)
      </documentation>
    </text>
    <result type="type:Boolean">
      <documentation>
        result. TS type: type:Boolean. (required)
      </documentation>
    </result>
  </properties>
</sercap:NeedsCData>
