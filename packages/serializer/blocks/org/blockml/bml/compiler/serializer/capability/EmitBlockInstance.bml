<!--Serializer Capability — EmitBlockInstance
  FQN: org.blockml.bml.compiler.serializer.capability.EmitBlockInstance-->
<sercap:EmitBlockInstance xmlns="http://blockml.org/bml"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:core="org.blockml.bml.core"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Emit BlockInstance with member values, nested aggregations, and directives
  </is>
  <documentation>
    <![CDATA[
    Emit BlockInstance composition element with member values and
    directives. Nested aggregations are filled by member name without a
    <composition> wrapper.
    ]]>
  </documentation>
  <references>
    <see type="sercap:VisibilityPrefix" relation="SeeAlso" />
    <see type="sercap:FormatMemberValue" relation="SeeAlso" />
  </references>
  <properties>
    <writer type="seremit:XmlWriter">
      <documentation>
        writer. TS type: seremit:XmlWriter. (required)
      </documentation>
    </writer>
    <instance type="bomcomp:BlockInstance">
      <documentation>
        instance. TS type: bomcomp:BlockInstance. (required)
      </documentation>
    </instance>
    <context type="seremit:EmitContext">
      <documentation>
        context. TS type: seremit:EmitContext. (required)
      </documentation>
    </context>
  </properties>
</sercap:EmitBlockInstance>
