<!--Serializer Capability — EmitBlockInstance
  FQN: org.blockml.bml.compiler.serializer.capability.EmitBlockInstance-->
<sercap:EmitBlockInstance xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:serializer="org.blockml.bml.compiler.serializer"
  xmlns:sercap="org.blockml.bml.compiler.serializer.capability"
  xmlns:serconfig="org.blockml.bml.compiler.serializer.config"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:seremit="org.blockml.bml.compiler.serializer.emit"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Emit BlockInstance with member values, nested aggregations, and directives
  </is>
  <documentation>
    <![CDATA[
    Emit BlockInstance composition element with member values and
    directives. Nested aggregations are filled by member name without a
    <composition> wrapper.
    ]]>
  </documentation>
  <references>
    <see type="sercap:VisibilityPrefix" relation="SeeAlso" />
    <see type="sercap:FormatMemberValue" relation="SeeAlso" />
  </references>
  <properties>
    <writer type="seremit:XmlWriter">
      <documentation>
        writer. TS type: seremit:XmlWriter. (required)
      </documentation>
    </writer>
    <instance type="bomcomp:BlockInstance">
      <documentation>
        instance. TS type: bomcomp:BlockInstance. (required)
      </documentation>
    </instance>
    <context type="seremit:EmitContext">
      <documentation>
        context. TS type: seremit:EmitContext. (required)
      </documentation>
    </context>
  </properties>
</sercap:EmitBlockInstance>
