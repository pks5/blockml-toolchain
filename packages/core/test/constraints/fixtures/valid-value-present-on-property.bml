<!--
  Test fixture — valid ValuePresent on Property
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:btype="org.blockml.bml.type"
  xmlns:test="com.blockml.test.constraints">
  <type>test:ValuePresentOnProperty</type>
  <baseType>core:Block</baseType>
  <is>Constraint test — ValuePresent</is>
  <version>1.0.0</version>

  <properties>
    <label type="btype:Text">
      <value>hello</value>
      <constraints>
        <constraint:ValuePresent validation="validation:Error"/>
      </constraints>
    </label>
  </properties>
</block>
