<!--
  Test fixture — valid AggregationConstraint
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">
  <type>test:AggregationConstraint</type>
  <baseType>core:Block</baseType>
  <is>Constraint test — AllowedChildType on aggregation</is>
  <version>1.0.0</version>

  <aggregations>
    <children type="core:Block[]">
      <constraints>
        <constraint:AllowedChildType type="core:Block" validation="validation:Error"/>
      </constraints>
    </children>
  </aggregations>
</block>
