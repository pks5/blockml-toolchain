<!--
  Test fixture — roundtrip: constraints on block and multiple member kinds
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:type="org.blockml.bml.type"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">
  <type>test:RoundtripConstraints</type>
  <baseType>core:Block</baseType>
  <is>A constraint test fixture</is>
  <version>1.0.0</version>

  <constraints>
    <constraint:RequiresMember name="width" validation="validation:Warning"/>
  </constraints>

  <properties>
    <width type="type:Integer">
      <value>1</value>
      <constraints>
        <constraint:Min value="0" validation="validation:Error"/>
      </constraints>
    </width>
  </properties>

  <aggregations>
    <children type="core:Block[]">
      <constraints>
        <constraint:AllowedChildType type="core:Block"/>
      </constraints>
    </children>
  </aggregations>

  <capabilities>
    <ping type="cap:Inbound">
      <constraints>
        <constraint:RequiresImplementation/>
      </constraints>
    </ping>
  </capabilities>
</block>
