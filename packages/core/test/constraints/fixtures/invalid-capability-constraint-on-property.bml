<!--
  Test fixture — invalid CapabilityConstraint on Property (BML_CONSTRAINT_TARGET_MISMATCH)
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:btype="org.blockml.bml.type">

  <idea>Constraint test — RequiresImplementation under property (invalid)</idea>
  <type>com.blockml.test.constraints.InvalidCapabilityOnProperty</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <properties>
    <name type="btype:Text">
      <constraints>
        <constraint:RequiresImplementation validation="validation:Error"/>
      </constraints>
    </name>
  </properties>
</block>
