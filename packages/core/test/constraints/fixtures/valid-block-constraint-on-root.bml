<!--
  Test fixture — valid BlockConstraint on root block
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <type>test:BlockConstraintOnRoot</type>
  <baseType>core:Block</baseType>
  <is>A constraint test fixture</is>
  <version>1.0.0</version>

  <constraints>
    <constraint:RequiresMember name="width" validation="validation:Error"/>
  </constraints>

  <properties>
    <width type="type:Integer">
      <value>10</value>
    </width>
  </properties>
</block>
