<!--
  Test fixture — valid AssociationConstraint
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:test="com.blockml.test.constraints">

  <idea>Constraint test — NoSelfReference on association</idea>
  <type>
    <test:AssociationConstraint />
  </type>
  <baseType>
    <core:Block />
  </baseType>
  <version>1.0.0</version>

  <associations>
    <parent type="core:Block">
      <constraints>
        <constraint:NoSelfReference validation="validation:Error"/>
      </constraints>
    </parent>
  </associations>
</block>
