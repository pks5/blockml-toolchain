<!--
  Test fixture — inherited ValuePresent from contract (effective member constraints)
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:btype="org.blockml.bml.type">

  <idea>Constraint test — inherited constraints via contract</idea>
  <type>com.blockml.test.constraints.InheritedConstraints</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <contracts>
    <core:Entity />
  </contracts>

  <properties>
    <id type="btype:Text">
      <value>entity-1</value>
    </id>
  </properties>
</block>
