  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:btype="org.blockml.bml.type"
  xmlns:test="com.blockml.test.constraints">
  <type>test:InheritedConstraints</type>
  <baseType>core:Block</baseType>
  <idea>Constraint test — inherited constraints via contract</idea>
  <version>1.0.0</version>

  <contracts>
    <core:Entity />
  </contracts>
  <properties>
    <id type="btype:Text">
      <value>entity-1</value>
    </id>
  </properties>
</block>
