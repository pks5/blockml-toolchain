<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Primitive BlockML property type for fixed-precision decimal numbers.</idea>

  <documentation>BOM Core primitive ValueType for decimal numbers. Unqualified name Decimal resolves
    to org.blockml.type.Decimal. Extends org.blockml.type.Number.</documentation>
  <name>Decimal</name>
  <type>btype:Decimal</type>
  <baseType>btype:Number</baseType>
</block>
