<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Primitive BlockML property type for fixed-precision decimal numbers.</idea>

  <documentation>BOM Core primitive ValueType for decimal numbers — the default type for all
    non-integer numeric values (3.5, 12.75, 0.1). Unqualified name Decimal resolves to
    org.blockml.type.Decimal. Extends org.blockml.type.Number. Represents mathematical decimal
    numbers; the renderer decides target representation (BigDecimal, decimal, number, …).
    Values are stored in Properties — not on the Decimal type itself.</documentation>
  <name>Decimal</name>
  <type>btype:Decimal</type>
  <baseType>btype:Number</baseType>
</block>
