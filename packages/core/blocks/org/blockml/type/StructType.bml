<!--
  BlockML Core — struct type branch (product types)

  FQN: org.blockml.type.StructType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Branch for product types — composite values with named fields.</idea>

  <documentation>Abstract branch for struct ValueTypes — complex values described by normal
    Properties. No special struct syntax.</documentation>
  <name>StructType</name>
  <type>btype:StructType</type>
  <baseType>core:ValueType</baseType>
  <abstract />

</block>
