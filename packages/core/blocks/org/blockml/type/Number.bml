<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Abstract branch for numeric primitive ValueTypes.</idea>

  <documentation>Numeric primitive branch under org.blockml.core.PrimitiveType. Concrete types:
    org.blockml.type.Integer, org.blockml.type.Float, org.blockml.type.Decimal. Not in the
    unqualified-name whitelist — use Integer, Float, or Decimal explicitly.</documentation>
  <name>Number</name>
  <type>btype:Number</type>
  <baseType>core:PrimitiveType</baseType>
  <version>1.0.0</version>
  <abstract />
</block>
