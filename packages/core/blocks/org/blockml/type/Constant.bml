<!--
  BlockML Core — constant (singleton) value type

  FQN: org.blockml.type.Constant
  See docs/21_constant_value_type.md
       docs/20_value_type_instance_configuration.md
       docs/17_type_system_bml.md — Unions · Generics
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>A ValueType that permits exactly one configured literal value.</idea>

  <documentation>
    Generic StructType for singleton (constant) values in type expressions — without a dedicated
    literal-type language feature. Unqualified name Constant resolves to org.blockml.type.Constant.

    Constant(T) binds the generic parameter T to any ValueType. Instance configuration supplies
    the single allowed value via the value Property — for example Constant(Text){value="auto"} or
    Constant(Integer){value=5}. The generic type argument is mandatory; bare Constant or
    Constant{value="auto"} without (T) is invalid.

    Used primarily as a union alternative alongside ordinary ValueTypes:

    Boolean | Constant(Text){value="auto"}

    Validation is fully type-safe: the configured value must match T. No type inference is
    required — T is always authored explicitly at the reference site.

    Future literal union syntax (Boolean | "auto") desugars to this form. See
    21_constant_value_type.md.
  </documentation>

  <references>
    <see file="21_constant_value_type.md">
      Constant ValueType — syntax, validation, and future literal sugar.
    </see>
    <see file="20_value_type_instance_configuration.md">
      ValueType instance configuration via {…} on type references.
    </see>
    <see file="17_type_system_bml.md">
      Union type expressions and generic application syntax.
    </see>
    <see block="btype:StructType">
      Branch base for parameterized value types.
    </see>
  </references>

  <name>Constant</name>
  <type>btype:Constant</type>
  <baseType>btype:StructType</baseType>

  <genericTypes>
    <genericType name="T" baseType="core:ValueType" />
  </genericTypes>

  <properties>
    <value type="T">
      <documentation>The single allowed value. Required on every Constant(T) reference via
        instance configuration — Constant(T){value=…}. Validated against the bound type T at
        compile time.</documentation>
      <valueRequired>true</valueRequired>
    </value>
  </properties>
</block>
