<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Primitive BlockML property type capable of holding a float number.</idea>

  <documentation>BOM Core primitive ValueType for floating-point numbers. Unqualified name Float
    resolves to org.blockml.type.Float. Extends org.blockml.type.Number.</documentation>
  <name>Float</name>
  <type>Float</type>
  <baseType>btype:Number</baseType>
  <version>1.0.0</version>
</block>