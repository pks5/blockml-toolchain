<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Primitive BlockML property type capable of holding a whole number.</idea>

  <documentation>BOM Core primitive ValueType for whole numbers. Unqualified name Integer resolves
    to org.blockml.type.Integer. Extends org.blockml.type.Number. Scalar role on Properties
    (inline literal); instance role elsewhere (&lt;Integer value="5"/&gt;).</documentation>
  <name>Integer</name>
  <type>Integer</type>
  <baseType>btype:Number</baseType>
</block>