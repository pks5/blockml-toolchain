<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Primitive BlockML property type capable of holding true or false.</idea>

  <documentation>BOM Core primitive ValueType for true/false values. Unqualified name Boolean
    resolves to org.blockml.type.Boolean.</documentation>
  <name>Boolean</name>
  <type>Boolean</type>
  <baseType>core:PrimitiveType</baseType>
  <version>1.0.0</version>
</block>