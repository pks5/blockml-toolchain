<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.type"
  xmlns:core="org.blockml.core">

  <idea>Boolean primitive value as an Entity in composition or aggregation.</idea>

  <documentation>Concrete Entity wrapping a Boolean primitive. Binds T = Boolean on
    org.blockml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
  <name>BooleanEntity</name>
  <type>btype:BooleanEntity</type>
  <baseType>core:PrimitiveEntity(btype:Boolean)</baseType>
</block>
