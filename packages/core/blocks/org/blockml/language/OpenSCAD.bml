<!--
  BlockML Core — OpenSCAD implementation language

  FQN: org.blockml.language.OpenSCAD
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language">

  <idea>OpenSCAD as an implementation language for sync capabilities.</idea>

  <documentation>LanguageBlock for OpenSCAD function implementations on Transformation Capabilities.
    Emitted by the MachineBlocks SCAD renderer with FQN-prefixed function names.</documentation>

  <name>OpenSCAD</name>
  <type>lang:OpenSCAD</type>
  <baseType>core:LanguageBlock</baseType>
  <version>1.0.0</version>
  <abstract>true</abstract>
</block>