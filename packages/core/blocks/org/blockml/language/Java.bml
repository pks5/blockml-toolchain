<!--
  BlockML Core — Java implementation language

  FQN: org.blockml.language.Java
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language">

  <idea>Java as an implementation language for capabilities.</idea>

  <documentation>ProgrammingLanguage for Java method implementations on Capabilities.</documentation>

  <name>Java</name>
  <type>lang:Java</type>
  <baseType>core:ProgrammingLanguage</baseType>
  <version>1.0.0</version>

</block>
