<!--
  BlockML Core — PseudoCode implementation language

  FQN: org.blockml.language.PseudoCode
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">Free-form pseudocode as an implementation language for capabilities.</idea>

  <documentation bml:status="status:Stable">ProgrammingLanguage for free-form pseudocode implementations. The code must be
    internally consistent but is otherwise unconstrained — an LLM may interpret it.</documentation>

  <status>status:Stable</status>
  <name>PseudoCode</name>
  <type>lang:PseudoCode</type>
  <baseType>core:ProgrammingLanguage</baseType>
  <version>1.0.0</version>
  
</block>
