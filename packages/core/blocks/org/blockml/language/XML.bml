<!--
  BlockML Core — XML implementation language

  FQN: org.blockml.language.XML
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language">

  <idea>XML as an implementation language for capabilities.</idea>

  <documentation>MarkupLanguage for XML document implementations on Capabilities — templates,
    configuration, or structured markup.</documentation>

  <name>XML</name>
  <type>lang:XML</type>
  <baseType>core:MarkupLanguage</baseType>
  <version>1.0.0</version>

</block>
