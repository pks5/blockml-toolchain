<!--
  BlockML Core — Unity implementation language

  FQN: org.blockml.language.Unity
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">Unity C# as an implementation language for capabilities.</idea>

  <documentation bml:status="status:Stable">C# dialect for Unity script implementations on Capabilities — MonoBehaviour methods,
    UnityEngine APIs, and game-logic code.</documentation>

  <status>status:Stable</status>
  <name>Unity</name>
  <type>lang:Unity</type>
  <baseType>lang:CSharp</baseType>
  <version>1.0.0</version>

</block>
