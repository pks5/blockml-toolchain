<!--
  BlockML Core — English implementation language

  FQN: org.blockml.language.English
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language">

  <idea>English prose as an implementation language for capabilities.</idea>

  <documentation>Language for natural-language capability implementations in English.</documentation>
  <name>English</name>
  <type>lang:English</type>
  <baseType>core:Language</baseType>
</block>
