<!--
  BlockML Core — TypeScript implementation language

  FQN: org.blockml.language.TypeScript
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd">

  <idea>TypeScript as an implementation language for sync capabilities.</idea>

  <documentation>LanguageBlock for TypeScript arrow-function implementations on Transformation Capabilities. V1: compile-time execution when all arguments are literals.</documentation>

  <name>TypeScript</name>
  <type>org.blockml.language.TypeScript</type>
  <baseType>org.blockml.core.LanguageBlock</baseType>
  <version>1.0.0</version>
  <abstract>true</abstract>
</block>
