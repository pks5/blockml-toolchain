<!--
  BlockML Core — TypeScript implementation language

  FQN: org.blockml.language.TypeScript
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">TypeScript as an implementation language for capabilities.</idea>

  <documentation bml:status="status:Stable">ProgrammingLanguage for TypeScript arrow-function implementations on Capabilities.
    V1: compile-time execution when all arguments are literals.</documentation>

  <status>status:Stable</status>
  <name>TypeScript</name>
  <type>lang:TypeScript</type>
  <baseType>core:ProgrammingLanguage</baseType>
  <version>1.0.0</version>
  
</block>
