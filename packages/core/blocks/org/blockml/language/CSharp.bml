<!--
  BlockML Core — C# implementation language

  FQN: org.blockml.language.CSharp
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language">

  <idea>C# as an implementation language for capabilities.</idea>

  <documentation>ProgrammingLanguage for C# method implementations on Capabilities.</documentation>
  <name>CSharp</name>
  <type>lang:CSharp</type>
  <baseType>lang:ProgrammingLanguage</baseType>
</block>
