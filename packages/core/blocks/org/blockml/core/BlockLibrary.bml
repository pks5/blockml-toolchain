<!--
  BlockML Core — library descriptor (blocks, types, presets, dependencies)

  FQN: org.blockml.core.BlockLibrary

  Entry type Schema is a Sub-Block of BlockLibrary. Aggregations use short type names
  (type="Schema") — parser resolves against subBlocks[] in the same file.
  _dependencies and _blocks hold Block instances (FQN via element name + xmlns prefix,
  version via bml:version) — not wrapper Sub-Blocks.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>Catalog of block and type definitions published as a package.</idea>

  <documentation>Publishable library unit — groups exported Block and ValueType definitions, optional XSD schemas,
    and dependencies on other libraries. Replaces the legacy library.xml descriptor.
    Dependencies and exported blocks are declared as Block instances in _dependencies and _blocks
    (element name resolves to FQN; bml:version pins the required definition version).</documentation>
  <name>BlockLibrary</name>
  <type>core:BlockLibrary</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <abstract />

  <subTypes>
    <core:Block />
  </subTypes>

  <properties>
    <description type="String">
      <documentation>Human-readable summary of what this library provides.</documentation>
    </description>
    <package type="String">
      <documentation bml:status="status:Draft">The package name of the library.</documentation>
    </package>
  </properties>

  <aggregations>
    <_dependencies type="core:BlockLibrary[]" validate="false" />
    <_schemas type="Schema[]" />
    <_blocks type="core:Block[]" validate="false" />
  </aggregations>

  <subBlocks>

    <block>
      <idea>Optional XSD schema exported alongside library types.</idea>

      <documentation>Optional XSD schema file exported by a BlockLibrary — legacy type/enum definitions.</documentation>
      <name>Schema</name>
      <baseType>core:Block</baseType>
      <version>1.0.0</version>
      <final />
      <properties>
        <ref type="String">
          <documentation>Path to the .xsd file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

  </subBlocks>

</block>
