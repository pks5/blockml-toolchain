<!--
  BlockML Core — library descriptor (blocks, types, presets, dependencies)

  FQN: org.blockml.core.BlockLibrary

  Entry types (Dependency, Schema, BlockRef) are Sub-Blocks
  of BlockLibrary. Aggregations use short type names (type="Dependency") — parser
  resolves against subBlocks[] in the same file.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core">

  <idea>Catalog of block and type definitions published as a package.</idea>

  <documentation>Publishable library unit — groups exported Block and TypeBlock definitions, optional XSD schemas,
    and dependencies on other libraries. Replaces the legacy library.xml descriptor.</documentation>

  <name>BlockLibrary</name>
  <type>core:BlockLibrary</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <abstract />

  <subTypes>
    <subType type="core:Block" />
  </subTypes>

  <properties>
    <description type="String">
      <documentation>Human-readable summary of what this library provides.</documentation>
    </description>
  </properties>

  <aggregations>
    <_dependencies type="Dependency[]" />
    <_schemas type="Schema[]" />
    <_blocks type="BlockRef[]" />
  </aggregations>

  <subBlocks>

    <block>
      <idea>Declared dependency on another published Library package.</idea>

      <documentation>Dependency on another BlockLibrary — pins required library FQN and exact semantic
        version.</documentation>
      <name>Dependency</name>
      <baseType>core:Block</baseType>
      <version>1.0.0</version>
      <final />
      <properties>
        <ref type="String">
          <documentation>FQN of the required BlockLibrary (e.g. com.machineblocks.core.CoreLibrary).</documentation>
        </ref>
        <version type="String">
          <documentation>Exact semantic version required — no implicit latest.</documentation>
        </version>
      </properties>
    </block>

    <block>
      <idea>Optional XSD schema exported alongside library types.</idea>

      <documentation>Optional XSD schema file exported by a BlockLibrary — legacy type/enum definitions.</documentation>
      <name>Schema</name>
      <baseType>core:Block</baseType>
      <version>1.0.0</version>
      <final />
      <properties>
        <ref type="String">
          <documentation>Path to the .xsd file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

    <block>
      <idea>Pointer to a block or type definition file in this library.</idea>

      <documentation>Reference to a Block or TypeBlock definition file (StructType, EnumType, composable Block, …)
        exported by this BlockLibrary.</documentation>
      <name>BlockRef</name>
      <baseType>core:Block</baseType>
      <version>1.0.0</version>
      <final />
      <properties>
        <ref type="String">
          <documentation>Path to the .bml file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

  </subBlocks>

</block>
