<!--
  BlockML Core — abstract library descriptor base type

  FQN: org.blockml.core.BlockLibrary

  Framework base type — lives in core, not exported via any Library _blocks.
  Concrete Library blocks (Library.bml) inherit from BlockLibrary.
  Entry type Schema is a Sub-Block of BlockLibrary.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>Abstract base for publishable library descriptors.</idea>

  <documentation>Abstract publishable library unit — groups exported Block and ValueType definitions,
    optional XSD schemas, and dependencies on other libraries. Replaces the legacy library.xml descriptor.
    Framework base type in org.blockml.core — not exported via Library _blocks.
    Concrete Library.bml files inherit from BlockLibrary and declare _dependencies / _blocks.</documentation>
  <name>BlockLibrary</name>
  <type>core:BlockLibrary</type>
  <baseType>core:Block</baseType>

  <abstract />

  <subTypes>
    <core:Block />
  </subTypes>

  <properties>
    <description type="String">
      <documentation>Human-readable summary of what this library provides.</documentation>
    </description>
  </properties>

  <aggregations>
    <_dependencies type="core:BlockLibrary[]" />
    <_schemas type="Schema[]" />
    <_blocks type="core:Block[]" />
  </aggregations>

  <subBlocks>

    <block>
      <idea>Optional XSD schema exported alongside library types.</idea>

      <documentation>Optional XSD schema file exported by a BlockLibrary — legacy type/enum definitions.</documentation>
      <name>Schema</name>
      <baseType>core:Block</baseType>
      <final />
      <properties>
        <ref type="String">
          <documentation>Path to the .xsd file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

  </subBlocks>

</block>
