<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.core">

  <idea>A fully qualified name of a block.</idea>

  <documentation>A fully qualified name of a block.</documentation>

  <genericTypes>
    <genericType name="T" baseType="core:Block" />
  </genericTypes>

  <name>FullyQualifiedName</name>
  <type>core:FullyQualifiedName</type>
  <baseType>core:ValueType</baseType>
</block>