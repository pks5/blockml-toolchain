<!--
  BlockML Core — abstract ServiceBlock base

  FQN: org.blockml.core.ServiceBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core">

  <idea>Reusable logic unit addressable as a service in expressions.</idea>

  <documentation>Abstract base for built-in ServiceBlocks — addressable logic units invoked via
    stud:// or expressions, with no sub-blocks.</documentation>

  <name>ServiceBlock</name>
  <type>core:ServiceBlock</type>
  <baseType>core:Entity</baseType>
  <version>1.0.0</version>

  <abstract />

</block>