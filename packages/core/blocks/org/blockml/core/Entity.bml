<!--
  BlockML Core — type Block branch (property / payload types)

  FQN: org.blockml.core.Entity
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable"></idea>

  <documentation bml:status="status:Stable"></documentation>

  <status>status:Stable</status>
  <name>Entity</name>
  <type>core:Entity</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <abstract />

</block>