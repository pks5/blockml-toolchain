<!--
  BlockML Core — primitive value as Entity

  FQN: org.blockml.core.PrimitiveEntity
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:btype="org.blockml.type">

  <idea>Wraps a primitive value when it must exist as an Entity in composition or aggregation.</idea>

  <documentation>Abstract generic Entity for primitive values that must appear as Block instances
    inside a composition or aggregation. Follows the general generic resolution rule: T belongs
    exclusively to this Block and is never inherited. Derived Blocks bind or forward T explicitly
    through baseType (for example baseType = PrimitiveEntity(Integer) binds T = Integer and yields
    value : Integer).

    Cannot be instantiated directly — concrete specializations (IntegerEntity, TextEntity,
    DecimalEntity, …) bind all generic parameters and become normal, instantiable Blocks.

    Properties continue to store primitive values directly — PrimitiveEntity exists only when the
    primitive value itself must become an Entity with identity, documentation, or metadata.

    See docs/17_type_system_bml.md — PrimitiveEntity · Generic resolution through inheritance.</documentation>
  <name>PrimitiveEntity</name>
  <type>core:PrimitiveEntity</type>
  <baseType>core:Entity</baseType>
  <abstract />

  <genericTypes>
    <genericType name="T" baseType="btype:PrimitiveType" />
  </genericTypes>

  <properties>
    <value type="T">
      <documentation>The primitive value owned by this Entity instance.</documentation>
    </value>
  </properties>
</block>
