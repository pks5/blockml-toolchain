<!--
  BlockML Core — ProgrammingLanguage branch (formal code languages)

  FQN: org.blockml.core.ProgrammingLanguage
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">A formal programming language for capability implementations.</idea>

  <documentation bml:status="status:Stable">Abstract branch for programming languages — TypeScript, OpenSCAD, PseudoCode, and
    other languages with defined or interpretable syntax.</documentation>

  <status>status:Stable</status>
  <name>ProgrammingLanguage</name>
  <type>core:ProgrammingLanguage</type>
  <baseType>core:Language</baseType>
  <version>1.0.0</version>

  <abstract />

</block>
