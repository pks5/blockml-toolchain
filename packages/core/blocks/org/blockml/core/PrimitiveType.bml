<!--
  BlockML Core — primitive type branch

  FQN: org.blockml.core.PrimitiveType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">Branch for scalar value types — single atomic values.</idea>

  <documentation bml:status="status:Stable">Abstract branch for built-in scalar ValueTypes (Integer, Float, String, Boolean).</documentation>

  <status>status:Stable</status>
  <name>PrimitiveType</name>
  <type>core:PrimitiveType</type>
  <baseType>core:ValueType</baseType>
  <version>1.0.0</version>

  <abstract />

  <properties>
    <value type="_self">
      <documentation bml:status="status:Stable">The value of the primitive.</documentation>
    </value>
  </properties>
</block>