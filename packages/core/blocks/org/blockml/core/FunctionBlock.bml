<!--
  BlockML Core — FunctionBlock base (Sync Capability implementations)

  FQN: org.blockml.core.FunctionBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      ">

  <idea>Service whose capabilities behave like callable functions.</idea>

  <documentation>Abstract base for FunctionBlocks — ServiceBlocks whose Sync Capabilities may carry
    TypeScript or OpenSCAD implementations. Used for #math, #strings, and similar expression
    utilities.</documentation>

  <name>FunctionBlock</name>
  <type>org.blockml.core.FunctionBlock</type>
  <baseType>org.blockml.core.ServiceBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <implTypes>
    <implType type="org.blockml.language.OpenSCAD" />
    <implType type="org.blockml.language.TypeScript" />
  </implTypes>

</block>