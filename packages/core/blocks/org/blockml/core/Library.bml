<!--
  BlockML Core — library descriptor (blocks, types, presets, dependencies)

  FQN: org.blockml.core.Library

  Entry types (Dependency, Schema, TypeRef, BlockRef) are Sub-Blocks
  of Library. Aggregations use short type names (type="Dependency") — parser
  resolves against subBlocks[] in the same file.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <idea>Catalog of block and type definitions published as a package.</idea>

  <documentation>Publishable library unit — groups exported Block definitions, optional XSD schemas, and dependencies on other libraries. Replaces the legacy library.xml descriptor.</documentation>

  <name>Library</name>
  <type>org.blockml.core.Library</type>
  <baseType>org.blockml.core.Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <subTypes>
    <subType type="org.blockml.core.Block" />
  </subTypes>

  <properties>
    <description type="String">
      <documentation>Human-readable summary of what this library provides.</documentation>
    </description>
  </properties>

  <aggregations>
    <_dependencies type="Dependency[]" />
    <_schemas     type="Schema[]" />
    <_types        type="TypeRef[]" />
    <_blocks       type="BlockRef[]" />
  </aggregations>

  <subBlocks>

    <block>
      <idea>Declared dependency on another published Library package.</idea>

      <documentation>Dependency on another Library — pins required library FQN and exact semantic version.</documentation>
      <name>Dependency</name>
      <baseType>org.blockml.core.Block</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <properties>
        <ref type="String">
          <documentation>FQN of the required Library (e.g. com.machineblocks.core.CoreLibrary).</documentation>
        </ref>
        <version type="String">
          <documentation>Exact semantic version required — no implicit latest.</documentation>
        </version>
      </properties>
    </block>

    <block>
      <idea>Optional XSD schema exported alongside library types.</idea>

      <documentation>Optional XSD schema file exported by a Library — legacy type/enum definitions.</documentation>
      <name>Schema</name>
      <baseType>org.blockml.core.Block</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <properties>
        <ref type="String">
          <documentation>Path to the .xsd file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

    <block>
      <idea>Pointer to a type definition file in this library.</idea>

      <documentation>Reference to a TypeBlock definition file (StructType, EnumType, …) exported by this Library.</documentation>
      <name>TypeRef</name>
      <baseType>org.blockml.core.Block</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <properties>
        <ref type="String">
          <documentation>Path to the type .bml file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

    <block>
      <idea>Pointer to a block definition file in this library.</idea>

      <documentation>Reference to a Block definition file exported by this Library.</documentation>
      <name>BlockRef</name>
      <baseType>org.blockml.core.Block</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <properties>
        <ref type="String">
          <documentation>Path to the block .bml file relative to the library package root.</documentation>
        </ref>
      </properties>
    </block>

  </subBlocks>

</block>
