<!--
  BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.core.Capability
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core">

  <idea>Representation of a capability.</idea>

  <documentation>Capability type branch of BlockML. Declares an capablity type.</documentation>

  <name>CapabilityType</name>
  <type>core:CapabilityType</type>
  <baseType>core:ValueType</baseType>
  <version>1.0.0</version>

  <abstract />

  <properties>
    <hasInput type="Boolean" readOnly="true">
      <value>false</value>
      <documentation>Whether the capabality has an input and thus requires a specified inputType.</documentation>
    </hasInput>
    <hasOutput type="Boolean" readOnly="true">
      <value>false</value>
      <documentation>Whether the capabality has an output and thus requires a specified outputType.</documentation>
    </hasOutput>
  </properties>
</block>