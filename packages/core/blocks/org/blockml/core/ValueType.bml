<!--
  BlockML Core — value type branch (property / payload types)

  FQN: org.blockml.core.ValueType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">A type in the BlockML grammar — values that properties and capabilities may carry.</idea>

  <documentation bml:status="status:Stable">ValueType branch of BlockML. Semantic unit for property and Capability types
    (primitives, structs, enums, generics). Only ValueTypes may appear as property type or
    Capability payloadType/returnType.</documentation>

  <status>status:Stable</status>
  <name>ValueType</name>
  <type>core:ValueType</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <abstract />

</block>
