<!--
  BlockML Core — maturity / lifecycle status branch

  FQN: org.blockml.core.Status
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core">

  <idea>Maturity or lifecycle marker for BlockML definitions — not a string or boolean flag.</idea>

  <documentation>Abstract branch for status blocks. Status values are Block references following the
    Everything-is-a-Block principle. Standard implementations live in org.blockml.status.*;
    domain libraries may define additional status blocks. Implicit default when omitted:
    org.blockml.status.Stable. Status is inherited downward — declare &lt;status&gt; or bml:status
    only when deviating from the effective inherited status.</documentation>
  <name>Status</name>
  <type>core:Status</type>
  <baseType>core:Block</baseType>
  <version>1.0.0</version>

  <abstract />

</block>
