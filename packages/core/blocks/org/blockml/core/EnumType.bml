<!--
  BlockML Core — enum type branch (closed value sets)

  FQN: org.blockml.core.EnumType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">Branch for closed sets of named literal values.</idea>

  <documentation bml:status="status:Stable">Abstract branch for closed enum ValueTypes. Enum values are Block instances in the
    default _values aggregation — no special enum syntax.</documentation>

  <status>status:Stable</status>
  <name>EnumType</name>
  <type>core:EnumType</type>
  <baseType>core:ValueType</baseType>
  <version>1.0.0</version>

  <abstract />

  <aggregations>
    <_values
      type="_self[]"
      default="true" />
  </aggregations>
</block>