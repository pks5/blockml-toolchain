<!--
  BlockML Core — enum type branch (closed value sets)

  FQN: org.blockml.core.EnumType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      ">

  <idea>Branch for closed sets of named literal values.</idea>

  <documentation>Abstract branch for closed enum TypeBlocks. Enum values are Block instances in the
    default _values aggregation — no special enum syntax.</documentation>

  <name>EnumType</name>
  <type>org.blockml.core.EnumType</type>
  <baseType>org.blockml.core.TypeBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <aggregations>
    <_values
      type="_self[]"
      default="true" />
  </aggregations>
</block>