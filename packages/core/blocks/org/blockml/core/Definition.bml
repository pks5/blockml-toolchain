<!--
  BlockML Core — Definition metadata

  FQN: org.blockml.core.Definition

  Abstract base type for all BlockML definition elements.
  Defines the common documentation model shared by blocks,
  properties, aggregations, associations, capabilities, and
  future definition elements.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>
    Represents a reusable BlockML definition that documents another language element.
  </idea>

  <documentation>
    Abstract base type for all BlockML definition elements. It provides the common
    documentation model consisting of documentation text, version information,
    change history, examples, and references. Concrete definition types inherit
    these members to describe themselves consistently.
  </documentation>
  <name>Defintion</name>
  <type>core:Defintion</type>
  <baseType>core:Block</baseType>
  <abstract />

  <!--
  Property definitions are grouped inside the <properties> element.
  Each property is rendered as a direct XML child element named after the
  property itself (for example <documentation> or <since>).
-->
  <properties>
    <documentation type="String" bml:xml="element">
      <documentation>The documentation of the definition.</documentation>
    </documentation>
    <since type="btype:VersionNumber" bml:xml="element">
      <documentation>The version in which this definition became available.</documentation>
    </since>
    <status type="core:Status" bml:xml="element">
      <documentation>The status of the definition.</documentation>
    </status>
  </properties>

  <!--
  Aggregation definitions are grouped inside the <aggregations> element.
  Each aggregation is rendered as a direct XML child element named after the
  aggregation itself (for example <changelog>, <examples>, or <references>).
-->
  <aggregations>
    <changelog type="def:ChangeDefinition[]">
      <documentation>The changelog of the definition.</documentation>
    </changelog>
    <examples type="def:ExampleDefinition[]">
      <documentation>The examples of the definition.</documentation>
    </examples>
    <references type="def:ReferenceDefinition[]">
      <documentation>The references of the definition.</documentation>
    </references>
  </aggregations>
</block>