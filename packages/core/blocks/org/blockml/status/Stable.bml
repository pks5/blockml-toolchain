<!--
  BlockML Core — stable status

  FQN: org.blockml.status.Stable
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status">

  <idea>Definition is complete, tested, and reliable.</idea>

  <documentation>Implemented, validated, and mapping complete. Behavior is reliable and may be
    depended on by downstream definitions and tooling. Implicit default when no status is declared
    on an element — omit &lt;status&gt; and bml:status on Stable content.</documentation>
  <name>Stable</name>
  <type>status:Stable</type>
  <baseType>core:Status</baseType>
  <version>1.0.0</version>

</block>
