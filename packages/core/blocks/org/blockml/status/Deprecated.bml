<!--
  BlockML Core — deprecated status

  FQN: org.blockml.status.Deprecated
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status">

  <idea>Definition is retained for compatibility but must not be used in new work.</idea>

  <documentation>Superseded by another definition. Existing references may remain during migration;
    validators and editors should warn on new usage. Document the replacement in
    &lt;documentation&gt;.</documentation>
  <name>Deprecated</name>
  <type>status:Deprecated</type>
  <baseType>core:Status</baseType>
</block>
