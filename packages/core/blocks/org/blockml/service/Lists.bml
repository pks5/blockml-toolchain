<!--
  BlockML Core Services

  Name: Lists Service
  Filename: Lists.bml
  FQN: org.blockml.service.Lists
  Expression prefix: #lists.*
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      ">

  <idea>Built-in list utilities callable as #lists in expressions.</idea>

  <documentation>Built-in lists FunctionBlock. Expression prefix #lists.* — list construction,
    indexing, and aggregation utilities.</documentation>

  <name>Lists</name>
  <type>org.blockml.service.Lists</type>
  <baseType>org.blockml.core.FunctionBlock</baseType>
  <version>1.0.0</version>

  <capabilities>

    <!-- #lists.size(list) -->
    <size
      type="org.blockml.capability.Transformation"
      inputType="Array<Object>"
      outputType="org.blockml.type.Integer">
      <documentation>
        Returns the number of elements in list.
        Examples:
        #lists.size([1, 2, 3]) → 3
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (list: unknown[]): number => list.length
      ]]></implementation>
    </size>

    <!-- #lists.isEmpty(list) -->
    <isEmpty
      type="org.blockml.capability.Transformation"
      inputType="Array<Object>"
      outputType="org.blockml.type.Boolean">
      <documentation>
        Returns true if list has no elements.
        Examples:
        #lists.isEmpty([]) → true
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (list: unknown[]): boolean => list.length === 0
      ]]></implementation>
    </isEmpty>

    <!-- #lists.contains(list, element) -->
    <contains
      type="org.blockml.capability.Transformation"
      inputType="{ list: Array<Object>, element: Object }"
      outputType="org.blockml.type.Boolean">
      <documentation>
        Returns true if list contains element.
        Examples:
        #lists.contains([1, 2, 3], 2) → true
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (list: unknown[], element: unknown): boolean => list.includes(element)
      ]]></implementation>
    </contains>

    <!-- #lists.first(list) -->
    <first
      type="org.blockml.capability.Transformation"
      inputType="Array<Object>"
      outputType="org.blockml.type.Float">
      <documentation>
        Returns the first element of list.
        Return type follows list element type at runtime.
        Examples:
        #lists.first([10, 20, 30]) → 10
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (list: unknown[]): unknown => list[0]
      ]]></implementation>
    </first>

    <!-- #lists.last(list) -->
    <last
      type="org.blockml.capability.Transformation"
      inputType="Array<Object>"
      outputType="org.blockml.type.Float">
      <documentation>
        Returns the last element of list.
        Return type follows list element type at runtime.
        Examples:
        #lists.last([10, 20, 30]) → 30
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (list: unknown[]): unknown => list[list.length - 1]
      ]]></implementation>
    </last>

    <!-- #lists.get(list, index) -->
    <get
      type="org.blockml.capability.Transformation"
      inputType="{ list: Array<Object>, index: Integer }"
      outputType="org.blockml.type.Float">
      <documentation>
        Returns the element at index in list.
        Return type follows list element type at runtime.
        Examples:
        #lists.get([10, 20, 30], 1) → 20
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (list: unknown[], index: number): unknown => list[index]
      ]]></implementation>
    </get>

    <!-- #lists.concat(a, b, ...) -->
    <concat
      type="org.blockml.capability.Transformation"
      inputType="Array<Array<Object>>"
      outputType="Array<Object>">
      <documentation>
        Concatenates all list arguments into a single list.
        Examples:
        #lists.concat([1, 2], [3, 4]) → [1, 2, 3, 4]
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (...lists: unknown[][]): unknown[] => lists.flat()
      ]]></implementation>
    </concat>

    <!--
      #lists.sequence(start, end)  or  #lists.sequence(start, end, step)
      Generates a numeric sequence from start to end (inclusive) with optional step.
      When step is omitted, defaults to 1 (or -1 when start &gt; end).
    -->
    <sequence
      type="org.blockml.capability.Transformation"
      inputType="{ start: Integer, end: Integer, step: Integer }"
      outputType="Array<Integer>">
      <documentation>
        Generates a sequence of integers from start to end (inclusive).
        step defaults to 1 when start &lt;= end, -1 when start &gt; end.
        Examples:
        #lists.sequence(1, 5) → [1, 2, 3, 4, 5]
        #lists.sequence(0, 10, 2) → [0, 2, 4, 6, 8, 10]
        #lists.sequence(5, 1) → [5, 4, 3, 2, 1]
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (start: number, end: number, step?: number): number[] => {
          const s = step ?? (start <= end ? 1 : -1);
          const result: number[] = [];
          if (s > 0) {
            for (let i = start; i <= end; i += s) result.push(i);
          } else if (s < 0) {
            for (let i = start; i >= end; i += s) result.push(i);
          }
          return result;
        }
      ]]></implementation>
    </sequence>

  </capabilities>

</block>