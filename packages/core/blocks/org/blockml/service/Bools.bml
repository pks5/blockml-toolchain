<!--
  BlockML Core Services

  Name: Bools Service
  Filename: Bools.bml
  FQN: org.blockml.service.Bools
  Expression prefix: #bools.*
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.type"
  xmlns:cap="org.blockml.capability"
  xmlns:core="org.blockml.core"
  xmlns:lang="org.blockml.language"
  xmlns:service="org.blockml.service">

  <idea>Built-in boolean utilities callable as #bools in expressions.</idea>

  <documentation>Built-in booleans FunctionBlock. Expression prefix #bools.* — logical and boolean
    conversion utilities.</documentation>

  <name>Bools</name>
  <type>service:Bools</type>
  <baseType>core:FunctionBlock</baseType>
  <version>1.0.0</version>

  <capabilities>

    <!-- #bools.isTrue(x) -->
    <isTrue
      type="cap:Transformation"
      inputType="Boolean"
      outputType="Boolean">
      <documentation>
        Returns true if x is strictly true.
        Examples:
        #bools.isTrue(true) → true
        #bools.isTrue(1) → false
      </documentation>
      <implementation type="lang:TypeScript"><![CDATA[
        (x: boolean): boolean => x === true
      ]]></implementation>
    </isTrue>

    <!-- #bools.isFalse(x) -->
    <isFalse
      type="cap:Transformation"
      inputType="Boolean"
      outputType="Boolean">
      <documentation>
        Returns true if x is strictly false.
        Examples:
        #bools.isFalse(false) → true
        #bools.isFalse(0) → false
      </documentation>
      <implementation type="lang:TypeScript"><![CDATA[
        (x: boolean): boolean => x === false
      ]]></implementation>
    </isFalse>

  </capabilities>

</block>