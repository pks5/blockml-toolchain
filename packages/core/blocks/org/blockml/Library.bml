<!--
  BlockML Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.Library

  BlockML core library — exports framework blocks, value types, and services.
  Block .bml sources live under blocks/org/blockml/.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:blockml="org.blockml"
  xmlns:bcore="org.blockml.core"
  xmlns:cap="org.blockml.capability"
  xmlns:constraint="org.blockml.constraint"
  xmlns:lang="org.blockml.language"
  xmlns:service="org.blockml.service"
  xmlns:status="org.blockml.status"
  xmlns:btype="org.blockml.type">

  <idea>Published catalog of the BlockML library including core blocks and value types.</idea>

  <documentation>Published catalog of the BlockML library including core blocks and value types.</documentation>
  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>blockml:BlockLibrary</baseType>
  <version>3.0.0</version>

  <properties>
    <description>
      <value>BlockML library</value>
    </description>
  </properties>

  <aggregations>
    <!-- Optional legacy XSD — omit when all types are exported via _blocks -->
    <_schemas>
      <composition>
        <Schema ref="blockml-library.xsd" />
      </composition>
    </_schemas>

    <_blocks>
      <composition>
        <bcore:Block />
        <blockml:BlockLibrary />
        <bcore:CapabilityType />
        <bcore:Constraint />
        <bcore:Entity />
        <bcore:EnumType />
        <bcore:Language />
        <bcore:MarkupLanguage />
        <bcore:PrimitiveType />
        <bcore:ProgrammingLanguage />
        <bcore:Status />
        <bcore:StructType />
        <bcore:ValueType />
        <cap:Inbound />
        <cap:Outbound />
        <cap:Transformation />
        <constraint:Max />
        <constraint:MaxItems />
        <constraint:MaxLength />
        <constraint:Min />
        <constraint:MinItems />
        <constraint:MinLength />
        <constraint:Pattern />
        <lang:C />
        <lang:CPP />
        <lang:CSharp />
        <lang:Chinese />
        <lang:English />
        <lang:French />
        <lang:German />
        <lang:JSON />
        <lang:Japanese />
        <lang:Java />
        <lang:JavaScript />
        <lang:OpenSCAD />
        <lang:PseudoCode />
        <lang:Python />
        <lang:Russian />
        <lang:Spanish />
        <lang:TypeScript />
        <lang:Unity />
        <lang:XML />
        <lang:YML />
        <service:Bools />
        <service:Lists />
        <service:Math />
        <service:Numbers />
        <service:Strings />
        <status:Deprecated />
        <status:Draft />
        <status:Stable />
        <status:Stub />
        <btype:Boolean />
        <btype:Decimal />
        <btype:Float />
        <btype:Integer />
        <btype:Number />
        <btype:String />
      </composition>
    </_blocks>
  </aggregations>

</block>
