<!--
  BlockML Library Descriptor

  Name: BricksLibrary
  Filename: BricksLibrary.bml
  FQN: com.machineblocks.bricks.BricksLibrary

  MachineBlocks brick library — exports block definitions and optional XSD.
  Block .bml sources live under blocks/ (scad-lib submodule in full deployment).
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:blockml="org.blockml"
  xmlns:bcore="org.blockml.core"
  xmlns:cap="org.blockml.capability"
  xmlns:constraint="org.blockml.constraint"
  xmlns:lang="org.blockml.language"
  xmlns:service="org.blockml.service"
  xmlns:status="org.blockml.status"
  xmlns:btype="org.blockml.type">

  <idea>Published catalog of the BlockML library including core blocks and value types.</idea>

  <documentation>Published catalog of the BlockML library including core blocks and value types.</documentation>
  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>bcore:BlockLibrary</baseType>
  <version>3.0.0</version>

  <properties>
    <description>
      <value>BlockML library</value>
    </description>
  </properties>

  <aggregations>
    <!-- Optional legacy XSD — omit when all types are exported via _blocks -->
    <_schemas>
      <composition>
        <Schema ref="blockml-library.xsd" />
      </composition>
    </_schemas>

    <_blocks>
      <composition>
        <bcore:Block bml:version="1.0.0" />
        <bcore:BlockLibrary bml:version="1.0.0" />
        <bcore:CapabilityType bml:version="1.0.0" />
        <bcore:Constraint bml:version="1.0.0" />
        <bcore:Entity bml:version="1.0.0" />
        <bcore:EnumType bml:version="1.0.0" />
        <bcore:Language bml:version="1.0.0" />
        <bcore:MarkupLanguage bml:version="1.0.0" />
        <bcore:PrimitiveType bml:version="1.0.0" />
        <bcore:ProgrammingLanguage bml:version="1.0.0" />
        <bcore:Status bml:version="1.0.0" />
        <bcore:StructType bml:version="1.0.0" />
        <bcore:ValueType bml:version="1.0.0" />
        <cap:Inbound bml:version="1.0.0" />
        <cap:Outbound bml:version="1.0.0" />
        <cap:Transformation bml:version="1.0.0" />
        <constraint:Max bml:version="1.0.0" />
        <constraint:MaxItems bml:version="1.0.0" />
        <constraint:MaxLength bml:version="1.0.0" />
        <constraint:Min bml:version="1.0.0" />
        <constraint:MinItems bml:version="1.0.0" />
        <constraint:MinLength bml:version="1.0.0" />
        <constraint:Pattern bml:version="1.0.0" />
        <lang:C bml:version="1.0.0" />
        <lang:CPP bml:version="1.0.0" />
        <lang:CSharp bml:version="1.0.0" />
        <lang:Chinese bml:version="1.0.0" />
        <lang:English bml:version="1.0.0" />
        <lang:French bml:version="1.0.0" />
        <lang:German bml:version="1.0.0" />
        <lang:JSON bml:version="1.0.0" />
        <lang:Japanese bml:version="1.0.0" />
        <lang:Java bml:version="1.0.0" />
        <lang:JavaScript bml:version="1.0.0" />
        <lang:OpenSCAD bml:version="1.0.0" />
        <lang:PseudoCode bml:version="1.0.0" />
        <lang:Python bml:version="1.0.0" />
        <lang:Russian bml:version="1.0.0" />
        <lang:Spanish bml:version="1.0.0" />
        <lang:TypeScript bml:version="1.0.0" />
        <lang:Unity bml:version="1.0.0" />
        <lang:XML bml:version="1.0.0" />
        <lang:YML bml:version="1.0.0" />
        <service:Bools bml:version="1.0.0" />
        <service:Lists bml:version="1.0.0" />
        <service:Math bml:version="1.0.0" />
        <service:Numbers bml:version="1.0.0" />
        <service:Strings bml:version="1.0.0" />
        <status:Deprecated bml:version="1.0.0" />
        <status:Draft bml:version="1.0.0" />
        <status:Stable bml:version="1.0.0" />
        <status:Stub bml:version="1.0.0" />
        <btype:Boolean bml:version="1.0.0" />
        <btype:Decimal bml:version="1.0.0" />
        <btype:Float bml:version="1.0.0" />
        <btype:Integer bml:version="1.0.0" />
        <btype:Number bml:version="1.0.0" />
        <btype:String bml:version="1.0.0" />
      </composition>
    </_blocks>
  </aggregations>

</block>
