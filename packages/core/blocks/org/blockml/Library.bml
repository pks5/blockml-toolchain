<!--
  BlockML Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.Library

  BlockML core library — exports framework blocks, value types, and services.
  Block .bml sources live under blocks/org/blockml/.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:blockml="org.blockml"
  xmlns:bcore="org.blockml.core"
  xmlns:cap="org.blockml.capability"
  xmlns:constraint="org.blockml.constraint"
  xmlns:def="org.blockml.definition"
  xmlns:lang="org.blockml.language"
  xmlns:service="org.blockml.service"
  xmlns:status="org.blockml.status"
  xmlns:btype="org.blockml.type">

  <idea>Published catalog of the BlockML core library — framework blocks, value types, and services.</idea>

  <documentation>
    Publishable BlockML core library (org.blockml.Library). Exports the framework grammar:
    core branches (Block, ValueType, Language, Status, Constraint, Capability, Definition),
    concrete value types and constraints, implementation languages, built-in services, lifecycle
    status blocks, and the Definition meta-model branch (org.blockml.definition.*).

    Membership is defined exclusively by this file's _blocks list — not by directory layout.
    Framework base type org.blockml.core.BlockLibrary is not exported here. Version 3.0.0 applies
    to all exported blocks (framework convention: version only on Library.bml).

    See docs/02_mbml.md — Library · docs/16_framework_base_types.md — Bootstrap Order ·
    docs/12_bom_object_model.md — Library.
  </documentation>
  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>bcore:BlockLibrary</baseType>
  <version>3.0.0</version>

  <properties>
    <description>
      <value>BlockML core library</value>
    </description>
  </properties>

  <aggregations>
    <!-- Optional legacy XSD — omit when all types are exported via _blocks -->
    <_schemas>
      <composition>
        <Schema ref="blockml-library.xsd" />
      </composition>
    </_schemas>

    <_blocks>
      <composition>
        <bcore:Block />
        <bcore:Capability />
        <bcore:Constraint />
        <bcore:Definition />
        <bcore:Entity />
        <bcore:PrimitiveEntity />
        <bcore:Language />
        <bcore:Status />
        <bcore:ValueType />
        <def:AggregationDefinition />
        <def:AssociationDefinition />
        <def:BlockDefinition />
        <def:CapabilityDefinition />
        <def:ChangeDefinition />
        <def:ContractDefinition />
        <def:ExampleDefinition />
        <def:GenericTypeDefinition />
        <def:PropertyDefinition />
        <def:ReferenceDefinition />
        <cap:Inbound />
        <cap:Outbound />
        <cap:Transformation />
        <constraint:Max />
        <constraint:MaxItems />
        <constraint:MaxLength />
        <constraint:Min />
        <constraint:MinItems />
        <constraint:MinLength />
        <constraint:Pattern />
        <lang:C />
        <lang:CPP />
        <lang:MarkupLanguage />
        <lang:CSharp />
        <lang:Chinese />
        <lang:English />
        <lang:French />
        <lang:German />
        <lang:JSON />
        <lang:Japanese />
        <lang:Java />
        <lang:JavaScript />
        <lang:OpenSCAD />
        <lang:PseudoCode />
        <lang:ProgrammingLanguage />
        <lang:Python />
        <lang:Russian />
        <lang:Spanish />
        <lang:TypeScript />
        <lang:Unity />
        <lang:XML />
        <lang:YML />
        <service:Bools />
        <service:Lists />
        <service:Math />
        <service:Numbers />
        <service:Strings />
        <status:Deprecated />
        <status:Draft />
        <status:Stable />
        <status:Stub />
        <btype:Boolean />
        <btype:BooleanEntity />
        <btype:Decimal />
        <btype:DecimalEntity />
        <btype:EnumType />
        <btype:FilePath />
        <btype:FilePathEntity />
        <btype:Float />
        <btype:FloatEntity />
        <btype:FullyQualifiedName />
        <btype:FullyQualifiedNameEntity />
        <btype:Integer />
        <btype:IntegerEntity />
        <btype:MimeType />
        <btype:MimeTypeEntity />
        <btype:Number />
        <btype:PrimitiveType />
        <btype:StructType />
        <btype:Text />
        <btype:TextEntity />
        <btype:URI />
        <btype:URIEntity />
        <btype:URL />
        <btype:URLEntity />
        <btype:Version />
        <btype:VersionEntity />
      </composition>
    </_blocks>
  </aggregations>

</block>
