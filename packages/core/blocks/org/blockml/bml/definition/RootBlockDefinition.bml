<!--
  BlockML Definition — root block definition meta-model type

  FQN: org.blockml.bml.definition.RootBlockDefinition
  Describes the parse-time shape of root <block> documents.
  See docs/12_bom_object_model.md — BlockDefinition.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>The structural shape of root Block definition documents in BlockML.</idea>

  <documentation>Meta-model type for root block documents. Extends
    org.blockml.bml.definition.NestedBlockDefinition with the definition property, the subBlocks
    aggregation for nested Sub-Block definitions, and the embeddedBlocks aggregation for inline
    foreign Block definitions under the root block of a BomDocument.

    The definition property selects which Definition meta-model type shapes this Block's definition
    document. It determines which fields exist when the definition is accessed via bml:Self in
    definition reflection — for example com.foo.Bar.definition or additional fields declared on a
    custom definition model. Blocks may supply a specialized definition model (extending
    RootBlockDefinition) to store domain-specific metadata alongside the standard block shape.

    embeddedBlocks holds inline definitions of additional Block documents within the same
    BomDocument — equivalent to multiple separate BML files co-located in one source file.
    Embedded blocks may belong to any package namespace, not only the root block's package.
    Each embedded block's FQN is the fully qualified value of its mandatory &lt;type&gt; element.
    Within this document's resolution scope, an embedded definition shadows the corresponding
    library or file-based BlockDefinition; externally it remains invisible.</documentation>

  <references>
    <see file="12_bom_object_model.md">
      BlockDefinition BOM structure.
    </see>
    <see file="02_mbml.md">
      Block definition authoring format and Sub-Block rules.
    </see>
    <see block="def:NestedBlockDefinition">
      Shared block definition shape — identity, members, and metadata.
    </see>
  </references>

  <name>RootBlockDefinition</name>
  <type>def:RootBlockDefinition</type>
  <baseType>def:NestedBlockDefinition</baseType>

  <properties>
    <definition type="FullyQualifiedName(def:RootBlockDefinition)">
      <value>def:RootBlockDefinition</value>
      <documentation>Definition meta-model type for this Block's definition document (root block
        only). Selects which fields exist when accessing the definition via bml:Self in definition
        reflection — for example com.foo.Bar.idea or additional properties on a custom definition
        model. Omitted = org.blockml.bml.definition.RootBlockDefinition.

        Authored as FQN, xmlns QName, or unqualified name — unqualified names at this site resolve
        via implicit namespace org.blockml.bml.definition.* (for example RootBlockDefinition or
        definition:RootBlockDefinition). The referenced type must extend
        org.blockml.bml.definition.RootBlockDefinition. Addressable as com.foo.Bar.definition.</documentation>
    </definition>
  </properties>

  <aggregations>
    <subBlocks type="def:NestedBlockDefinition[]">
      <documentation>Sub-Block definitions nested under the root block of this BomDocument (root block
        only — forbidden on Sub-Blocks, BML_SUBBLOCKS_ON_SUBBLOCK). Each Sub-Block is a full
        NestedBlockDefinition except it must not declare its own subBlocks or embeddedBlocks
        (BML_EMBEDDED_BLOCKS_ON_SUBBLOCK). Canonical type is derived from parent type + Sub-Block
        name when type is omitted; explicit type must match (BML_SUBBLOCK_TYPE_MISMATCH). Sub-Block
        name is required (BML_MISSING_SUBBLOCK_NAME).</documentation>
    </subBlocks>
    <embeddedBlocks type="def:NestedBlockDefinition[]">
      <documentation>Inline Block definitions embedded in this BomDocument (root block only —
        forbidden on Sub-Blocks and embedded blocks, BML_EMBEDDED_BLOCKS_ON_SUBBLOCK,
        BML_EMBEDDED_BLOCKS_ON_EMBEDDED_BLOCK). Allows multiple BML files to be defined inline in
        one source document — including Blocks from packages that do not belong to the root block's
        namespace. Each entry is a NestedBlockDefinition with a mandatory, fully qualified
        &lt;type&gt; (BML_MISSING_EMBEDDED_BLOCK_TYPE, BML_UNQUALIFIED_EMBEDDED_BLOCK_TYPE). The
        embedded block's FQN is exactly resolve(type) — not nested under the root block's FQN (for
        example com.other.ForeignBlock, not com.foo.Bar.embeddedBlocks.com.other.ForeignBlock).
        Within this document, the embedded definition shadows the corresponding library or
        file-based BlockDefinition; externally it remains invisible. Embedded blocks must not
        declare subBlocks (BML_SUBBLOCKS_ON_EMBEDDED_BLOCK) or embeddedBlocks. Composition
        references from within this document must use the fully qualified Block type. Addressable as
        com.other.ForeignBlock.* (canonical paths of the embedded Block itself).</documentation>
    </embeddedBlocks>
  </aggregations>
</block>
