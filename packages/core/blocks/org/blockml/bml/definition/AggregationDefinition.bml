<!--
  BlockML Definition — aggregation member meta-model type

  FQN: org.blockml.bml.definition.AggregationDefinition
  See docs/12_bom_object_model.md — AggregationDefinition · 02_mbml.md — Aggregations.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>An owned collection member that may hold composition children.</idea>

  <documentation>Describes a Block member representing composition ownership — a typed collection
    that may contain nested Block instances via a composition child. Rendered as a child element
    inside the aggregations container; the XML element name is the aggregation name
    (bml:xml="${ #this.name }"). An optional XML prefix on the element name supplies the member
    namespace — resolved via xmlns to BOM namespace; unprefixed elements use the default namespace
    (empty string). Member identity is (resolvedNamespace, localName). Maps to BOM
    AggregationDefinition (kind: "aggregation") with typeFqn,
    cardinality (from type multiplicity), optional defaultAggregation flag, nested composition
    template, and optional service binding (beanName, scope). Any Block FQN is valid as aggregation
    type — not limited to ValueTypes. Bare top-level composition is sugar for the single default
    aggregation.</documentation>

  <references>
    <see file="12_bom_object_model.md">
      AggregationDefinition BOM structure.
    </see>
    <see file="02_mbml.md">
      Aggregations and composition authoring rules.
    </see>
  </references>

  <name>AggregationDefinition</name>
  <type>def:AggregationDefinition</type>
  <baseType>def:MemberDefinition</baseType>
</block>
