<!--
  BlockML Definition — generic type parameter meta-model type

  FQN: org.blockml.bml.definition.GenericTypeDefinition
  See docs/16_framework_base_types.md — genericTypes · 12_bom_object_model.md — GenericType.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:btype="org.blockml.bml.type"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A type parameter declared on a Block definition (e.g. T on Box of T).</idea>

  <documentation>Declares one generic type parameter on a root Block definition. Rendered inside
    the genericTypes container as an element whose local name is the parameter identifier (root
    block only). Maps to BOM GenericType { name, baseType } — name is derived from the XML element
    name, not from a child or attribute. The name is substituted in type references within this
    Block (e.g. type="T" → GenericParameterReference). baseType is the FQN constraint — each
    concrete type argument at reference sites must inherit from that branch
    (BML_GENERIC_CONSTRAINT_VIOLATION on mismatch). Parameter name must differ from the Block name
    and every Sub-Block name.</documentation>

  <references>
    <see file="16_framework_base_types.md">
      genericTypes aggregation on Block definitions.
    </see>
    <see file="17_type_system_bml.md">
      Generic type parameters and constraints.
    </see>
    <see file="12_bom_object_model.md">
      GenericType BOM structure.
    </see>
  </references>

  <name>GenericTypeDefinition</name>
  <type>def:GenericTypeDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>${ #this.name }</bml:xml>

  <properties>
    <name type="Text">
      <documentation>Parameter identifier — derived from the XML element name at parse time (e.g.
        &lt;T baseType="…"/&gt; → name = "T"). Must not collide with the Block name or any
        Sub-Block name in the same document. Not authored as an attribute or child element.</documentation>
    </name>
    <baseType type="FullyQualifiedName(def:BlockDefinition)" bml:xml="attribute">
      <documentation>FQN constraint for concrete type arguments. Each supplied type argument at
        reference sites (e.g. Box of Integer) must inherit from this baseType branch.</documentation>
    </baseType>
  </properties>
</block>
