<!--
  BlockML Definition — block member meta-model base type

  FQN: org.blockml.bml.definition.MemberDefinition
  See docs/12_bom_object_model.md — MemberDefinitionBase · 02_mbml.md — Members.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>Abstract base for a declared member on a Block definition.</idea>

  <documentation>Abstract base type for Block member declarations — properties, aggregations,
    associations, and capabilities. Rendered as a child element inside the corresponding member
    container on BlockDefinition; the XML element name is the member name (bml:xml="${ #this.name }").
    An optional XML prefix on the element name supplies the member namespace — resolved via xmlns to
    BOM namespace; unprefixed elements use the default namespace (empty string). Member identity is
    (resolvedNamespace, localName). Inherits abstract and final modifiers from
    org.blockml.bml.definition.StructuralDefinition.

    Member declaration modes are orthogonal:
    • new — neither override nor implementation
    • override="true" — refines or replaces a same-named parent member (abstract or concrete).
      abstract on the override is optional; refining an abstract parent without implementation
      keeps the member abstract for descendants
    • implementation="true" — completes a same-named abstract parent member (implies override;
      override="true" not required)

    org.blockml.bml.definition.CapabilityDefinition will specialize implementation later. Maps to BOM
    MemberDefinitionBase fields shared by all member kinds.</documentation>

  <references>
    <see file="12_bom_object_model.md">
      MemberDefinitionBase and member kind unions in the BOM.
    </see>
    <see file="02_mbml.md">
      Member containers, abstract, override, and implementation rules.
    </see>
    <see block="def:BlockDefinition">
      Parent block shape — properties, aggregations, associations, capabilities containers.
    </see>
    <see block="def:StructuralDefinition">
      Parent type — shared documentation model for definition elements.
    </see>
  </references>

  <name>MemberDefinition</name>
  <type>def:MemberDefinition</type>
  <baseType>def:StructuralDefinition</baseType>
  <abstract />
  <bml:xml>${ #this.name }</bml:xml>

  <properties>
    <override type="Boolean" bml:xml="attribute">
      <value>false</value>
      <documentation>When true, this member declaration overrides a same-named parent member. The
        validator requires a matching parent member in the baseType chain (BML_OVERRIDE_WITHOUT_PARENT).
        The parent may be abstract or concrete. abstract on this declaration is optional — when
        overriding an abstract parent without implementation="true", the effective member stays
        abstract and descendants see the refined shape. Use to change inherited attributes (for
        example narrowing type) while keeping the contract open, or to replace attributes and values
        on a concrete member. Do not set override="false" together with implementation="true" (BML_IMPLEMENTATION_WITH_OVERRIDE_FALSE).
        implementation already implies override.</documentation>
    </override>
    <implementation type="Boolean" bml:xml="attribute">
      <value>false</value>
      <documentation>When true, this member fully implements a same-named abstract parent member.
        Implies override — omit override or set override="true"; do not set override="false"
        (BML_IMPLEMENTATION_WITH_OVERRIDE_FALSE). The validator requires a matching
        abstract parent member (BML_IMPLEMENTATION_WITHOUT_PARENT,
        BML_IMPLEMENTATION_PARENT_NOT_ABSTRACT). The declaring block must supply the missing parts;
        usual member checks then apply (type present, value set where required, and so on). Emits
        BML_ABSTRACT_MEMBER_NOT_IMPLEMENTED when an abstract member on a concrete block remains
        unimplemented. org.blockml.bml.definition.CapabilityDefinition overrides this property with
        a full Implementation value type for capability members.</documentation>
    </implementation>
  </properties>

</block>
