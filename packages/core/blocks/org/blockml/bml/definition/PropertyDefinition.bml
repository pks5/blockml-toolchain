<!--
  BlockML Definition — property member meta-model type

  FQN: org.blockml.bml.definition.PropertyDefinition
  See docs/12_bom_object_model.md — PropertyDefinition · 02_mbml.md — Members.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:btype="org.blockml.bml.type"
  xmlns:bml="http://blockml.org/schema/bml">
  <name>PropertyDefinition</name>
  <type>def:PropertyDefinition</type>
  <baseType>def:MemberDefinition</baseType>
  <is>A typed value member</is>

  <documentation>Describes a Block member that carries a scalar or structured value. Rendered as a
    child element inside the properties container; the XML element name is the property name
    (bml:xml="${ #this.name }"). An optional XML prefix on the element name supplies the member
    namespace — for example ui5:width resolves via xmlns:ui5 to the canonical namespace stored in
    BOM namespace; unprefixed elements belong to the default namespace (empty string). The prefix
    itself is never stored. Member identity is (resolvedNamespace, localName). Maps to BOM
    PropertyDefinition (kind: "property") with typeFqn, value, optional group,
    and optional constraints (via ConstrainableDefinition) and suggestions. Property type must resolve to a
    ValueType branch. Scalar member fields (type, value, group) follow
    org.blockml.bml.definition.MemberDefinition placement rules — element preferred on definitions,
    attribute preferred on Block instances. Structured suggestions remain a child element. Every
    Property behaves as Optional — it has a value or has no value; there
    is no null. Declaration order among properties is significant for StructType positional mapping
    and Capability parameter order.</documentation>

  <references>
    <see file="12_bom_object_model.md" relation="DeepDive">
      PropertyDefinition BOM structure.
    </see>
    <see file="02_mbml.md" relation="AuthoringGuide">
      Members and properties authoring rules.
    </see>
    <see type="core:ValueType" relation="Requires">
      Required branch for property payload types.
    </see>
    <see file="18_constraints_and_suggestions.md" relation="AuthoringGuide">
      Suggestions authoring rules and BML_SUGGESTIONS_ON_ENUM.
    </see>
  </references>

  <properties>
    <type type="TypeReference(core:ValueType)" bml:xml="element|attribute">
      <documentation>FQN of the property's ValueType (TypeExpression). Non-ValueType FQNs are invalid
        (BML_INVALID_PROPERTY_TYPE). Multiplicity, unions, generic applications, and instance
        configuration are expressed in the type string — e.g. Text{maxLength=100}. On definitions,
        element form is preferred (&lt;type&gt;Integer&lt;/type&gt;); on Block instances, attribute
        form is preferred (type="Integer" on the property element).</documentation>
    </type>
    <value type="Text" bml:xml="element|attribute">
      <documentation>Default or computed value on the Block definition, or inline value on Block
        instances. May be a literal or a ${ … } expression. On definitions, element form is
        preferred (&lt;value&gt;…&lt;/value&gt;); on Block instances, attribute form is preferred
        (value="…" on the property element). Absent value means Optional.empty — not null.</documentation>
    </value>
    <group type="Text" bml:xml="element|attribute">
      <documentation>Optional editor grouping hint — organizes properties in UI display only; no
        compiler or validator effect. On definitions, element form is preferred
        (&lt;group&gt;Dimensions&lt;/group&gt;); on Block instances, attribute form is preferred
        (group="Dimensions" on the property element). Maps to BOM PropertyDefinition.group.</documentation>
    </group>
  </properties>

  <aggregations>
    <suggestions type="core:ValueType[]" bml:xml="element">
      <documentation>Property-only metadata — suggested values for editors and renderers. Each child
        element is a Block instance of the same type as this property's typeFqn (Stage [8] validates
        compatibility — BML_SUGGESTION_TYPE_MISMATCH). Document order preserved in BOM
        suggestions[]. Must not appear on properties typed with an EnumType (BML_SUGGESTIONS_ON_ENUM).
        Suggestions are not enforced — authors may enter any compatible value. Always rendered as a
        suggestions child element; children use their declared type tag (same pattern as composition
        instances).</documentation>
    </suggestions>
  </aggregations>
</block>
