<!--
  BlockML Definition — block definition meta-model base type

  FQN: org.blockml.bml.definition.BlockDefinition
  Describes the shared parse-time shape of all <block> definition documents.
  See docs/12_bom_object_model.md — BlockDefinition · 16_framework_base_types.md — Definition Branch.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lang="org.blockml.bml.language"
  xmlns:btype="org.blockml.bml.type"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>The shared structural shape of Block definition documents in BlockML.</idea>

  <documentation>Abstract meta-model base for all Block definition documents — root blocks,
    Sub-Blocks, and embedded blocks. Semantically a Class: declarative type shape without instance
    state. Parsed into BomDocument.block and nested block definition trees. Generic type parameter B
    binds this definition to the Block type it describes — conceptually BlockDefinition of
    com.foo.Bar when B resolves to com.foo.Bar.

    Declares identity (idea, name, type, baseType, version), generic parameters, contracts,
    allowed Sub-Blocks and languages, and member declaration containers (properties, aggregations,
    associations, capabilities). Type modifiers abstract and final are inherited from
    org.blockml.bml.definition.StructuralDefinition. Every definition element is addressable via
    its canonical structural path within the Block FQN (for example com.foo.Bar.properties.width).
    Member declaration order in BML is preserved in BOM and is significant for StructType
    positional mapping and render targets.

    Specialized by org.blockml.bml.definition.SubBlockDefinition (nested Sub-Blocks, default
    definition meta-model) and org.blockml.bml.definition.RootBlockDefinition (document root and
    embedded blocks with embeddedBlocks). Type references (type, baseType, composition tags,
    member type attributes) accept FQN, xmlns QName, context-bound unqualified fallback, or
    Sub-Block-relative names — all normalized to a canonical FQN during resolution
    (BML_UNKNOWN_TYPE, BML_AMBIGUOUS_TYPE, BML_UNKNOWN_NAMESPACE_PREFIX).</documentation>

  <references>
    <see file="12_bom_object_model.md">
      BlockDefinition BOM structure.
    </see>
    <see file="02_mbml.md">
      Block definition authoring format and type reference rules.
    </see>
    <see file="16_framework_base_types.md">
      Definition Addressing and genericTypes aggregation.
    </see>
    <see block="core:Block">
      Sole inheritance root — omits baseType on root blocks.
    </see>
    <see block="def:SubBlockDefinition">
      Nested Sub-Block definition shape — extends this type.
    </see>
    <see block="def:RootBlockDefinition">
      Root and embedded block shape — extends SubBlockDefinition.
    </see>
  </references>

  <name>BlockDefinition</name>
  <type>def:BlockDefinition</type>
  <baseType>def:ConstrainableDefinition</baseType>
  <abstract />

  <!-- Block definitions render as the root <block> element. -->
  <bml:xml>block</bml:xml>

  <!--
    Type parameter of BlockDefinition itself — not the described Block's genericTypes aggregation.
    Binds this definition to the Block type it describes. Defaults to org.blockml.bml.core.Block.
  -->
  <genericTypes>
    <B baseType="core:Block">
      <documentation>The Block type this BlockDefinition describes. Conceptually BlockDefinition of
        com.foo.Bar when B binds to com.foo.Bar.</documentation>
    </B>
  </genericTypes>

  <!--
    Scalar Block metadata. Each property renders as a direct XML child element
    named after the property (for example <idea>, <name>, <type>, or <version>).
  -->
  <properties>
    <idea type="Text" bml:xml="element">
      <documentation>Short semantic description — what this Block represents in meaning. Required
        first child on every Block definition (root blocks and Sub-Blocks). Addressable as
        com.foo.Bar.idea.</documentation>
    </idea>
    <language type="lang:NaturalLanguage" bml:xml="element">
      <documentation>Natural language for documentation prose on this Block definition and its
        members. Omitted = inherit from enclosing Library, then org.blockml.bml.core.Block default
        (English). Unqualified child names resolve via implicit namespace org.blockml.bml.language.*.
        Example titles always use this effective language.</documentation>
    </language>
    <name type="Text">
      <documentation>Short class name (PascalCase). Required on Sub-Blocks. Optional on root blocks —
        when omitted, derived as lastSegment(resolve(type)). When present on a root block, must
        equal lastSegment(resolve(type)) (BML_BLOCK_NAME_TYPE_MISMATCH). Format: [A-Z][a-zA-Z0-9]*
        (BML_INVALID_BLOCK_NAME).</documentation>
    </name>
    <type type="FullyQualifiedName(core:Block)">
      <documentation>Canonical Block type identity. Required on root blocks (BML_MISSING_BLOCK_TYPE).
        Authored as FQN, xmlns QName, or unqualified name when a context fallback namespace applies.
        Optional on Sub-Blocks — when omitted, derived as resolve(parent.type) + "." + name; when
        present, must equal that expected value (BML_SUBBLOCK_TYPE_MISMATCH). Sub-Block QNames may
        use a relative path in the local part (foo:Bar.MySubBlock).</documentation>
    </type>
    <baseType type="FullyQualifiedName(core:Block)">
      <documentation>Parent type FQN. Required on all definitions except the sole inheritance root.
        No default — validator resolves effective members via the baseType chain.</documentation>
    </baseType>
    <version type="Version">
      <documentation>Semantic version of this Block definition. Required on root blocks.
        Addressable as com.foo.Bar.version.</documentation>
    </version>
  </properties>

  <!--
    Block-level collections and member declaration containers. Each aggregation
    renders as a direct XML child element named after the aggregation
    (for example <genericTypes>, <properties>, or <subBlocks>).
  -->
  <aggregations>
    <genericTypes type="def:GenericTypeDefinition[]">
      <documentation>Generic type parameters declared on this Block (root block only). Each entry
        has a name and a baseType constraint for concrete type arguments at reference sites.</documentation>
    </genericTypes>
    <languages type="core:Language[]">
      <documentation>Language FQNs permitted on capability implementation bindings for this Block.
        Omitted = inherit from baseType chain.</documentation>
    </languages>
    <subTypes type="core:Block[]">
      <documentation>Block FQNs allowed in subBlocks[]. Omitted = inherit effective subTypes from
        baseType chain; explicit empty list = override to forbid Sub-Blocks.</documentation>
    </subTypes>
    <contracts type="core:Block[]">
      <documentation>Contract Block references merged into this Block after the baseType chain
        (root block only). Each child is a direct Block reference (element name = FQN via xmlns
        prefix) — same pattern as languages and subTypes. Declaration order is significant —
        later contracts override earlier ones; local Block declarations override all contracts.</documentation>
    </contracts>
    <properties type="def:PropertyDefinition[]">
      <documentation>Property member declarations. Mapped to members[] in XML document order.
        Order is significant for StructType field indices and positional array literals.</documentation>
    </properties>
    <aggregations type="def:AggregationDefinition[]">
      <documentation>Aggregation member declarations — owned collections that may hold composition
        children. Mapped to members[] in XML document order.</documentation>
    </aggregations>
    <associations type="def:AssociationDefinition[]">
      <documentation>Association member declarations — loose references without composition
        ownership. Mapped to members[] in XML document order.</documentation>
    </associations>
    <capabilities type="def:CapabilityDefinition[]">
      <documentation>Capability member declarations — communication endpoints (inbound, outbound,
        transformation). Mapped to members[] in XML document order.</documentation>
    </capabilities>
  </aggregations>
</block>
