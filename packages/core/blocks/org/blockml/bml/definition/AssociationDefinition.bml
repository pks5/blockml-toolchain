<!--
  BlockML Definition — association member meta-model type

  FQN: org.blockml.bml.definition.AssociationDefinition
  See docs/12_bom_object_model.md — AssociationDefinition · 02_mbml.md — Associations.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A loose reference member without composition ownership.</idea>

  <documentation>Describes a Block member for non-owning references to other Blocks — semantically
    loose links without lifecycle ownership (WOT: Associations). Rendered as a child element inside
    the associations container; the XML element name is the association name (bml:xml="${ #this.name }").
    An optional XML prefix on the element name supplies the member namespace — resolved via xmlns to
    BOM namespace; unprefixed elements use the default namespace (empty string). Member identity is
    (resolvedNamespace, localName). Maps to BOM AssociationDefinition (kind: "association") with
    typeFqn and cardinality 0..1 or 0..n. Any Block FQN is valid as association type. Domain
    examples include basePresets on MachineBlocks Block types.</documentation>

  <references>
    <see file="12_bom_object_model.md">
      AssociationDefinition BOM structure.
    </see>
    <see file="02_mbml.md">
      Associations authoring rules.
    </see>
  </references>

  <name>AssociationDefinition</name>
  <type>def:AssociationDefinition</type>
  <baseType>def:MemberDefinition</baseType>
</block>
