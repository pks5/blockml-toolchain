<!--
  BlockML Core — millimeter length unit

  FQN: org.blockml.bml.unit.Millimeter
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit">
  <name>Millimeter</name>
  <type>unit:Millimeter</type>
  <baseType>btype:Unit</baseType>
  <is>Millimeter (mm)</is>

  <documentation>Length unit — millimeter (mm).</documentation>
</block>
