<!--
  BlockML Core — inch length unit

  FQN: org.blockml.bml.unit.Inch
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:btype="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit">
  <name>Inch</name>
  <type>unit:Inch</type>
  <baseType>btype:Unit</baseType>
  <is>Inch (in)</is>

  <documentation>Length unit — inch (in).</documentation>
</block>
