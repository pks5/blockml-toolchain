<!--
  BlockML Core — then-execute relation

  FQN: org.blockml.bml.relation.ThenExecute
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <name>ThenExecute</name>
  <type>relation:ThenExecute</type>
  <baseType>core:Relation</baseType>
  <is>A after-reading-execute Relation</is>

  <documentation>Use on concrete Library &lt;see&gt; entries to point at the library's Bootstrap
    SPOE after the human/LLM reading entry. Sequence on Library.bml: ReadFirst → ReadMe (required),
    then ThenExecute → Bootstrap when the library declares a bootstrap aggregation. Distinct from
    ReadNext (narrative learning chain between documentation blocks) and from TaskIndex / TaskStep
    (task catalog). Signals: after reading, continue by executing the automation entry.</documentation>

  <references>
    <see type="relation:ReadFirst" relation="SeeAlso">
      Required Library reading-entry edge — precedes ThenExecute.
    </see>
    <see type="core:Bootstrap" relation="Requires">
      Typical ThenExecute target on a concrete Library.
    </see>
    <see type="core:BlockLibrary" relation="SeeAlso">
      Concrete Library references rule — at most ReadFirst + ThenExecute.
    </see>
  </references>

</block>
