<!--
  BlockML Core — extends relation

  FQN: org.blockml.bml.relation.Extends
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <name>Extends</name>
  <type>relation:Extends</type>
  <baseType>core:Relation</baseType>
  <is>An inheritance Relation</is>

  <documentation>Use when the referenced Block is in the baseType chain or represents a branch the
    current type belongs to. Typical block= targets only — not for file or url references.</documentation>

</block>
