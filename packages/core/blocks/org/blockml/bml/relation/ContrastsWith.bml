<!--
  BlockML Core — contrasts-with relation

  FQN: org.blockml.bml.relation.ContrastsWith
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <idea>Target is similar but must not be confused with the current definition.</idea>

  <documentation>Use to disambiguate easily confused concepts — for example Sub-Block vs embedded Block,
    contract vs baseType, Inbound vs Outbound capability. The context text body must explain the
    difference explicitly.</documentation>

  <name>ContrastsWith</name>
  <type>relation:ContrastsWith</type>
  <baseType>core:Relation</baseType>
</block>
