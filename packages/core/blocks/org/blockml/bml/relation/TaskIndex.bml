<!--
  BlockML Core — task index relation

  FQN: org.blockml.bml.relation.TaskIndex
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">
  <name>TaskIndex</name>
  <type>relation:TaskIndex</type>
  <baseType>core:Relation</baseType>
  <idea>Catalog entry — this TaskGuide is available from the current Bootstrap or entry point.</idea>

  <documentation>Use on &lt;see&gt; entries in README blocks and other Bootstrap entry points to
    list accomplishable tasks. Distinct from ReadFirst (mental learning order) and SeeAlso (optional
    peer link). Tooling filters relation=TaskIndex to build a task menu for humans, agents, or CI.
    Target should reference an org.blockml.bml.task.* TaskGuide block.</documentation>

</block>
