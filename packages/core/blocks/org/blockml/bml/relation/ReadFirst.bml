<!--
  BlockML Core — read-first relation

  FQN: org.blockml.bml.relation.ReadFirst
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">
  <name>ReadFirst</name>
  <type>relation:ReadFirst</type>
  <baseType>core:Relation</baseType>
  <idea>Curated entry in a ReadMe learning path — read before exploring further.</idea>

  <documentation>Use on &lt;see&gt; entries in README / ReadMe blocks to declare mental learning
    order. ReadFirst entries should appear first in &lt;references&gt;, in reading order. Distinct
    from Library.readFirst (which names the ReadMe block itself). One references mechanism for all
    cross-links inside the ReadMe.</documentation>

</block>
