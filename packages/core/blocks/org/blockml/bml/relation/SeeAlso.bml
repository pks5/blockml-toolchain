<!--
  BlockML Core — see-also relation

  FQN: org.blockml.bml.relation.SeeAlso
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">
  <name>SeeAlso</name>
  <type>relation:SeeAlso</type>
  <baseType>core:Relation</baseType>
  <idea>General related reference — peer cross-link without a stronger semantic tie.</idea>

  <documentation>Default relation when relation is omitted on &lt;see&gt;. Use for related Blocks,
    documentation files, or URLs that help understand the current definition but do not extend,
    require, or define it. Omitted relation= on &lt;see&gt; resolves to this block.</documentation>

</block>
