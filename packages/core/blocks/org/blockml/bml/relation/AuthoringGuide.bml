<!--
  BlockML Core — authoring-guide relation

  FQN: org.blockml.bml.relation.AuthoringGuide
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:relation="org.blockml.bml.relation">

  <idea>Target explains how to author or use the current definition in practice.</idea>

  <documentation>Typical file= targets — repository markdown with authoring rules, examples, or
    migration notes. Use when the link is procedural (&quot;how to write…&quot;) rather than structural
    (Extends) or optional background (SeeAlso).</documentation>

  <name>AuthoringGuide</name>
  <type>relation:AuthoringGuide</type>
  <baseType>core:Relation</baseType>
</block>
