<!--
  BlockML Core — Definition base type

  FQN: org.blockml.bml.core.Definition

  Abstract base type for all BlockML definition elements.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>Abstract base type for BlockML definition elements.</idea>

  <documentation>
    Abstract base type for the Definition branch. Structural definition elements that describe
    block structure in BlockML's own language inherit from org.blockml.bml.definition.StructuralDefinition.
  </documentation>

  <name>Definition</name>
  <type>core:Definition</type>
  <baseType>core:Block</baseType>
  <abstract />

</block>
