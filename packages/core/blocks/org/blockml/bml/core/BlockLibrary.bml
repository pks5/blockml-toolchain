<!--
  BlockML Core — abstract library descriptor base type

  FQN: org.blockml.bml.core.BlockLibrary

  Framework base type — lives in core, not exported via any Library _blocks.
  Concrete Library blocks (Library.bml) inherit from BlockLibrary.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:btype="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>Abstract base for publishable library descriptors.</idea>

  <documentation>
    Abstract publishable library unit — groups exported Block and ValueType definitions,
    optional XSD schemas, dependencies on other libraries, and nested sub-libraries.
    Replaces the legacy library.xml descriptor.

    Framework base type in org.blockml.bml.core — not exported via Library _blocks.
    Concrete Library.bml files inherit from BlockLibrary and declare aggregations explicitly.

    Aggregations (each aggregation= attribute is required; none is default):
    • bootstrap — library entry point (Bootstrap block, typically org.blockml.bml.README).
      Curated reading order on the concrete Bootstrap block uses references with relation=ReadFirst.
    • _dependencies — other Library blocks this library depends on (typical: inner library
      depends on outer)
    • _subLibraries — nested child Library blocks grouped under this library
    • _schemas — optional legacy XSD paths as FilePathEntity instances
    • _blocks — exported Block and ValueType definitions (membership SSOT)

    bootstrap holds a Bootstrap block instance as type reference — element name resolves to FQN.
    _dependencies, _subLibraries, and _blocks hold empty Block instances as type references —
    element name resolves to FQN. bml:version is forbidden on these children.
    _schemas holds FilePathEntity composition children; value is the relative .xsd path from
    the library package root (directory containing Library.bml).
  </documentation>

  <references>
    <see file="02_mbml.md">
      Library Format — structure, nested libraries, _blocks membership rules.
    </see>
    <see file="12_bom_object_model.md">
      BlockLibrary BOM structure and nested-library rules.
    </see>
    <see block="doc:LibrarySystem">
      Libraries, packages, namespaces, versioning, and imports.
    </see>
    <see block="btype:FilePathEntity">
      Entity wrapper used for _schemas entries.
    </see>
    <see block="core:Bootstrap">
      Abstract base for library bootstrap entry points (README blocks).
    </see>
    <see block="core:TypeReference">
      Type-reference marker for bootstrap, _dependencies, _subLibraries, and _blocks.
    </see>
  </references>

  <name>BlockLibrary</name>
  <type>
    <core:BlockLibrary />
  </type>
  <baseType>
    <core:Block />
  </baseType>
  <abstract>true</abstract>

  <subTypes type="core:TypeReference(core:Block)[]">
    <core:Block />
  </subTypes>
  <properties>
    <description type="Text">
      <documentation>Human-readable summary of what this library provides.</documentation>
    </description>
  </properties>

  <aggregations>
    <language type="core:TypeReference(lang:NaturalLanguage)">
      <documentation>Default natural language for documentation prose on all blocks exported
        from this library catalogue. Singular TypeReference aggregation — one child (for example
        &lt;English/&gt;). Inherited by block definitions unless overridden. Unqualified child
        names resolve via implicit namespace org.blockml.bml.language.*.</documentation>
    </language>
    <bootstrap type="core:TypeReference(core:Bootstrap)">
      <documentation>Library bootstrap entry point — typically a README block with a readFirst
      documentation list. Type-reference aggregation — child element name resolves to FQN.
      bml:version is forbidden.</documentation>
    </bootstrap>
    <_dependencies type="core:TypeReference(core:BlockLibrary)[]">
      <documentation>Other Library blocks this library depends on. Typical pattern: an inner
      library lists the outer library here. Holds empty Block instances as type references —
      element name resolves to FQN. bml:version is forbidden.</documentation>
    </_dependencies>
    <_subLibraries type="core:TypeReference(core:BlockLibrary)[]">
      <documentation>Nested child Library blocks grouped under this library. A library may declare
      sub-libraries alongside _blocks. Holds empty Block instances as type references — element
      name resolves to FQN. bml:version is forbidden. The outer library must not re-export inner
      library blocks in _blocks — consumers depend on the inner library directly.</documentation>
    </_subLibraries>
    <_schemas type="btype:FilePathEntity[]">
      <documentation>Optional legacy XSD schema paths during migration. Each entry is a
        FilePathEntity composition child; value is the relative .xsd path from the library package
        root. Omit when all types are exported via _blocks.</documentation>
    </_schemas>
    <_blocks type="core:TypeReference(core:Block)[]">
      <documentation>Exported Block and ValueType definitions. Membership is defined exclusively by
      this list — not by directory layout. Holds empty Block instances as type references —
      element name resolves to FQN. bml:version is forbidden.</documentation>
    </_blocks>
  </aggregations>

</block>
