<!--
  BlockML Core — abstract documentation block base type

  FQN: org.blockml.bml.core.Documentation
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core">
  <name>Documentation</name>
  <type>core:Documentation</type>
  <baseType>core:Block</baseType>
  <idea>Abstract base type for narrative documentation blocks in the BlockML core library.</idea>

  <documentation>
    Abstract base for org.blockml.bml.documentation.* blocks — curated reading material that
    explains BlockML concepts in mental learning order. Each concrete documentation block
    carries idea, documentation, and references; cross-links belong in references, not in
    documentation prose. Listed via relation=ReadFirst on README and other ReadMe blocks.
    Procedural how-to blocks extend org.blockml.bml.core.TaskGuide instead.
  </documentation>

  <references>
    <see block="core:ReadMe">
      Library reading entry — ReadFirst and TaskIndex on references.
    </see>
    <see block="core:TaskGuide">
      Procedural task guides — org.blockml.bml.task.* blocks.
    </see>
    <see file="02_mbml.md">
      Block documentation model — idea, documentation, references, examples.
    </see>
  </references>

  <abstract>true</abstract>

</block>
