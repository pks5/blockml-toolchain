<!--
  BlockML Core — library/process automation SPOE role

  FQN: org.blockml.bml.core.Bootstrap
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">
  <name>Bootstrap</name>
  <type>core:Bootstrap</type>
  <baseType>core:Block</baseType>
  <is>Abstract role marker — single point of entry for automated library or process startup.</is>

  <documentation>Abstract empty branch for Bootstrap blocks — the optional single point of entry
    (SPOE) for automated startup: tasks, agents, CI pipelines, and similar process logic. Intentionally
    empty — no properties or aggregations. Concrete subtypes add scenario-specific members when
    needed.

    Distinct from org.blockml.bml.core.ReadMe, which is the required human/LLM reading entry on a
    Library (readFirst aggregation). A Library may omit bootstrap (0..1) when it has no automated
    startup SPOE; it must never declare more than one Bootstrap.

    Human/LLM orientation (curated ReadFirst reading order, TaskIndex catalog) lives on ReadMe
    blocks — not on Bootstrap.</documentation>

  <references>
    <see block="core:ReadMe">
      Human/LLM reading entry — Library.readFirst, not bootstrap.
    </see>
    <see block="core:BlockLibrary">
      Optional bootstrap aggregation (0..1 SPOE).
    </see>
    <see block="doc:BootstrapModel">
      TypeRegistry bootstrap vs library ReadMe / Bootstrap roles.
    </see>
  </references>

  <abstract>true</abstract>

</block>
