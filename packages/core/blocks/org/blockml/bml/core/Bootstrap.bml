<!--
  BlockML Core — library bootstrap entry-point role

  FQN: org.blockml.bml.core.Bootstrap
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core">

  <idea>Abstract role marker — this Block is a library or process entry point.</idea>

  <documentation>Abstract branch for bootstrap entry-point blocks. A Bootstrap block declares where
    a consumer starts — humans, LLMs, TypeRegistry loaders, agents, or automated pipelines.
    org.blockml.bml.README is the standard human/LLM entry point for libraries; other subtypes may
    follow for other scenarios (for example agent bootstrap or CI pipeline bootstrap).

    Bootstrap blocks carry the normal documentation model (idea, documentation, references). Curated
    reading or load order is expressed via &lt;references&gt; with relation=ReadFirst — not via a
    separate readFirst aggregation. Concrete Bootstrap subtypes add scenario-specific members when
    needed; the abstract base declares no aggregations.</documentation>

  <name>Bootstrap</name>
  <type>
    <core:Bootstrap />
  </type>
  <baseType>
    <core:Block />
  </baseType>
  <abstract>true</abstract>

</block>
