<!--
  BlockML Core — root Block type

  FQN: org.blockml.bml.core.Block
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:lang="org.blockml.bml.language"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>The universal semantic unit of BlockML — every definable concept in the grammar.</idea>

  <language>
    <English />
  </language>
  <documentation>
    Root semantic unit of BlockML — the sole inheritance root for all Block definitions.
    Every concept in the grammar is a Block: composable domain types, ValueTypes, Languages,
    Status values, Constraints, Capabilities, Services, Libraries, and Definition meta-model
    types. Unqualified name Block resolves to this type.

    Role and constraints:
    • Sole inheritance root — omits &lt;baseType&gt;; all other definitions must declare a non-empty parent FQN
    • Declares language (NaturalLanguage) — default English for documentation prose
    • Abstract — not used directly as a composition instance type
    • Further members defined by sub-types — Properties, Aggregations,
      Associations, and Capabilities via the baseType chain
    • Composition instance identity uses bml:id and bml:version (not member attributes)

    Type reference rules:
    • Any Block FQN may appear in aggregation and association member types
    • Property and Capability payload types must resolve to a ValueType
    • Capability implementation language attributes reference org.blockml.bml.language.* — unqualified names permitted

    Documentation model (on every root block definition):
    • &lt;idea&gt; — required first child; semantic meaning of the Block
    • &lt;language&gt; — optional; natural language for documentation prose (inherits from Library,
      then org.blockml.bml.core.Block default English)
    • &lt;documentation&gt; — required second child; technical description; optional language
      attribute when prose deviates from effective block language
    • Optional extensions: &lt;since&gt;, &lt;changelog&gt;, &lt;examples&gt;, &lt;references&gt;
    Omitted idea or documentation on root blocks → BML_MISSING_IDEA / BML_MISSING_DOCUMENTATION
    (warning V1).

    Serialization:
    • bml:xml ${ bml:Self } — composable instances render under their declared type tag
      (for example &lt;core:Block&gt;, &lt;myns:Wall&gt;)
    • Definition branch types describe block structure and carry their own bml:xml rules
  </documentation>

  <references>
    <see block="core:ValueType" relation="Extends">
      Property and capability payload types.
    </see>
    <see block="core:Language" relation="Extends">
      Implementation language bindings and NaturalLanguage branch.
    </see>
    <see block="core:Status" relation="Extends">
      Lifecycle status references.
    </see>
    <see block="core:Relation" relation="Extends">
      Cross-reference relationship categories on see entries.
    </see>
    <see block="core:Constraint" relation="Extends">
      Property validation constraints.
    </see>
    <see block="core:Capability" relation="Extends">
      Capability implementation contracts.
    </see>
    <see block="core:Definition" relation="Extends">
      Meta-model for block structure (WIP).
    </see>
    <see block="core:Block" property="language" relation="Defines">
      NaturalLanguage property — documentation prose default on every block.
    </see>
    <see block="def:StructuralDefinition" relation="Defines">
      Shared documentation model for structural definition elements.
    </see>
    <see block="mbcore:Block" relation="SeeAlso">
      Example domain base — domain-specific branches extend Block.
    </see>
    <see file="00_bom_core.md" relation="DeepDive">
      Block and Block Instance — fundamental architecture principles.
    </see>
    <see file="02_mbml.md" relation="AuthoringGuide">
      Block Definition — idea, documentation, and documentation extensions.
    </see>
    <see file="16_framework_base_types.md" relation="AuthoringGuide">
      Root Type Exception and Definition Branch.
    </see>
    <see file="17_type_system_bml.md" relation="AuthoringGuide">
      Everything is a Block — type system overview.
    </see>
    <see file="19_definition_blocks_and_bml_xml.md" relation="AuthoringGuide">
      Definition branch bml:xml serialization rules.
    </see>
  </references>

  <name>Block</name>
  <type>
    <core:Block />
  </type>
  <!-- Blocks are rendered as xml elements with the name of the block type -->
  <bml:xml>${ bml:Self }</bml:xml>
  
  <!-- Root block is abstract -->
  <abstract>true</abstract>

  <properties>
    <language type="lang:NaturalLanguage">
      <documentation>Effective natural language for documentation prose on this Block definition
        and its members. Inherited downward unless a child documentation element or nested
        definition declares a deviation via its own language attribute or element. Root default on
        org.blockml.bml.core.Block is English. Unqualified child names resolve via implicit
        namespace org.blockml.bml.language.*.</documentation>
    </language>
  </properties>

</block>
