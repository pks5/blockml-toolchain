<!--
  BlockML Core — Russian implementation language

  FQN: org.blockml.bml.language.Russian
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">
  <name>Russian</name>
  <type>lang:Russian</type>
  <baseType>lang:NaturalLanguage</baseType>
  <idea>Russian prose — documentation and natural-language capability implementations.</idea>

  <documentation>Natural language for documentation prose, example titles, and Russian
    natural-language capability implementations.</documentation>
</block>
