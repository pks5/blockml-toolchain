<!--
  BlockML Core — Markdown implementation language

  FQN: org.blockml.bml.language.Markdown
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <name>Markdown</name>
  <type>lang:Markdown</type>
  <baseType>lang:MarkupLanguage</baseType>
  <is>The Markdown markup language</is>

  <documentation>MarkupLanguage for Markdown document implementations on Capabilities — prose
    with lightweight structure (headings, lists, links, code fences). Inherits MarkupLanguage.L
    (NaturalLanguage, default English) for the content/text language of the Markdown body.</documentation>
</block>
