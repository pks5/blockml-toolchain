<!--
  BlockML Core — JSON implementation language

  FQN: org.blockml.bml.language.JSON
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <idea>JSON as an implementation language for capabilities.</idea>

  <documentation>MarkupLanguage for JSON document implementations on Capabilities — configuration,
    structured data, or templates.</documentation>
  <name>JSON</name>
  <type>
    <lang:JSON />
  </type>
  <baseType>
    <lang:MarkupLanguage />
  </baseType>
</block>
