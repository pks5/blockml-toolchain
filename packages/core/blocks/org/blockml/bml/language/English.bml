<!--
  BlockML Core — English implementation language

  FQN: org.blockml.bml.language.English
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">
  <name>English</name>
  <type>lang:English</type>
  <baseType>lang:NaturalLanguage</baseType>
  <is>English prose — documentation and natural-language capability implementations.</is>

  <documentation>Natural language for documentation prose, example titles, and English
    natural-language capability implementations.</documentation>
</block>
