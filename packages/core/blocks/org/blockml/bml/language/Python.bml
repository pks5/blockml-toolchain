<!--
  BlockML Core — Python implementation language

  FQN: org.blockml.bml.language.Python
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">
  <name>Python</name>
  <type>lang:Python</type>
  <baseType>lang:ProgrammingLanguage</baseType>
  <is>The Python programming language</is>

  <documentation>ProgrammingLanguage for Python function implementations on Capabilities.</documentation>
</block>
