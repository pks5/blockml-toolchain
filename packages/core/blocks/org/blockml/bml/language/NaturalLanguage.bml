<!--
  BlockML Core — NaturalLanguage branch (human documentation prose)

  FQN: org.blockml.bml.language.NaturalLanguage
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">
  <name>NaturalLanguage</name>
  <type>lang:NaturalLanguage</type>
  <baseType>core:Language</baseType>
  <is>Natural human language for documentation prose and example titles.</is>

  <documentation>Abstract branch for natural languages used in documentation text, example
    titles, and natural-language capability implementations. All locale-specific language blocks
    (English, German, French, Spanish, Chinese, Japanese, Russian, …) must extend this branch —
    not org.blockml.bml.core.Language directly. Distinct from implementation languages
    (ProgrammingLanguage, MarkupLanguage) used in capability bodies and example content.</documentation>

  <abstract>true</abstract>

</block>
