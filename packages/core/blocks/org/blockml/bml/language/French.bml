<!--
  BlockML Core — French implementation language

  FQN: org.blockml.bml.language.French
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <name>French</name>
  <type>lang:French</type>
  <baseType>lang:NaturalLanguage</baseType>
  <is>The French natural language</is>

  <documentation>Natural language for documentation prose, example titles, and French
    natural-language capability implementations.</documentation>
</block>
