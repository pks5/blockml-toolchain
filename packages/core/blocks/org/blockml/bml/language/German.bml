<!--
  BlockML Core — German implementation language

  FQN: org.blockml.bml.language.German
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <idea>German prose as an implementation language for capabilities.</idea>

  <documentation>Language for natural-language capability implementations in German.</documentation>
  <name>German</name>
  <type>lang:German</type>
  <baseType>core:Language</baseType>
</block>
