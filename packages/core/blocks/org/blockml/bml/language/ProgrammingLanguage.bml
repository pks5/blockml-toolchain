<!--
  BlockML Core — ProgrammingLanguage branch (formal code languages)

  FQN: org.blockml.bml.language.ProgrammingLanguage
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language">

  <idea>A formal programming language for capability implementations.</idea>

  <documentation>Abstract branch for programming languages — TypeScript, OpenSCAD, PseudoCode, and
    other languages with defined or interpretable syntax.</documentation>
  <name>ProgrammingLanguage</name>
  <type>
    <lang:ProgrammingLanguage />
  </type>
  <baseType>
    <core:Language />
  </baseType>
  <abstract>true</abstract>

</block>
