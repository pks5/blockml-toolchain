<!--
  BlockML Core — pattern constraint

  FQN: org.blockml.bml.constraint.Pattern
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>Pattern</name>
  <type>constraint:Pattern</type>
  <baseType>constraint:ValueConstraint</baseType>
  <is>A text pattern rule</is>

  <documentation>T binds to org.blockml.bml.type.Text. The value property holds the regex pattern.</documentation>
  <genericTypes>
    <T baseType="String"/>
  </genericTypes>

  <properties>
    <value type="Text">
      <documentation>Regular expression the property value must match.</documentation>
    </value>
  </properties>

</block>
