<!--
  BlockML Core — pattern constraint

  FQN: org.blockml.bml.constraint.Pattern
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:btype="org.blockml.bml.type"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core">

  <idea>Regular-expression pattern for a string property value.</idea>

  <documentation>T binds to org.blockml.bml.type.Text. The value property holds the regex pattern.</documentation>
  <name>Pattern</name>
  <type>constraint:Pattern</type>
  <baseType>core:ValueConstraint</baseType>
  <genericTypes>
    <T baseType="String"/>
  </genericTypes>

  <properties>
    <value type="Text">
      <documentation>Regular expression the property value must match.</documentation>
    </value>
  </properties>

</block>
