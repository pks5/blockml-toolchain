<!--
  BlockML Core — minimum length constraint

  FQN: org.blockml.bml.constraint.MinLength
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:btype="org.blockml.bml.type"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core">

  <idea>Minimum length for a string or collection element.</idea>

  <documentation>T binds to the property type for scalar String properties, or to the element type when the property is a collection (e.g. String[]). The value property is always Integer — the minimum length threshold.</documentation>
  <name>MinLength</name>
  <type>constraint:MinLength</type>
  <baseType>constraint:ValueConstraint</baseType>
  <genericTypes>
    <T baseType="core:ValueType"/>
  </genericTypes>

  <properties>
    <value type="Integer">
      <documentation>Minimum length (inclusive).</documentation>
    </value>
  </properties>

</block>
