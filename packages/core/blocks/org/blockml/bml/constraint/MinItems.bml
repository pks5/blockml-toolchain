<!--
  BlockML Core — minimum items constraint

  FQN: org.blockml.bml.constraint.MinItems
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:btype="org.blockml.bml.type"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:core="org.blockml.bml.core">
  <name>MinItems</name>
  <type>constraint:MinItems</type>
  <baseType>constraint:ValueConstraint</baseType>
  <is>Minimum number of elements in a collection property.</is>

  <documentation>T binds to the property collection type (e.g. String[]). The value property is Integer — the minimum item count.</documentation>
  <genericTypes>
    <T baseType="core:ValueType"/>
  </genericTypes>

  <properties>
    <value type="Integer">
      <documentation>Minimum number of items (inclusive).</documentation>
    </value>
  </properties>

</block>
