<!--
  BlockML Constraint — aggregation structural constraint branch

  FQN: org.blockml.bml.constraint.AggregationConstraint
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition">

  <idea>Constraint that validates an AggregationDefinition or its children.</idea>

  <documentation>Abstract branch for constraints on Aggregation members. Generic T binds to the
    effective AggregationDefinition. Valid only under an Aggregation's &lt;constraints&gt; container
    (BML_CONSTRAINT_TARGET_MISMATCH otherwise).</documentation>

  <name>AggregationConstraint</name>
  <type>
    <constraint:AggregationConstraint />
  </type>
  <baseType>
    <constraint:MemberConstraint />
  </baseType>
  <abstract>true</abstract>

  <genericTypes>
    <T baseType="def:AggregationDefinition">
      <documentation>Bound to the effective AggregationDefinition of the enclosing Aggregation member.</documentation>
    </T>
  </genericTypes>

</block>
