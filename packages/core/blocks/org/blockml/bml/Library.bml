      <btype:URL />
      <btype:URLEntity />
      <btype:Version />
      <btype:VersionEntity />
      <unit:None />
      <unit:Millimeter />
      <unit:Centimeter />
      <unit:Meter />
      <unit:Inch />
      <doc:Introduction />
      <doc:EverythingIsABlock />
      <doc:BlockAndInstance />
      <doc:DefinitionModel />
      <doc:TypeSystemOverview />
      <doc:ValueTypeConfiguration />
      <doc:CapabilitySemantics />
      <doc:Expressions />
      <doc:CompilerArchitecture />
      <doc:RendererFreedom />
      <doc:LibrarySystem />
      <doc:BmlNamespace />
      <doc:ImplicitNamespaceResolution />
      <doc:DocumentationModel />
      <doc:BootstrapModel />
      <doc:ModelingGuidelines />
      <doc:PseudoCode />
      <doc:TaskGuideModel />
      <doc:WOTFoundation />
      <task:AuthorNewBlock />
