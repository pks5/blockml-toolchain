      <constraint:Pattern />
      <constraint:PropertyConstraint />
      <constraint:RequiresImplementation />
      <constraint:RequiresMember />
      <constraint:StructuralConstraint />
      <constraint:ValueConstraint />
      <constraint:ValuePresent />
      <lang:C />
      <lang:CPP />
      <lang:MarkupLanguage />
      <lang:NaturalLanguage />
      <lang:CSharp />
      <lang:Chinese />
      <lang:English />
      <lang:French />
      <lang:German />
      <lang:JSON />
      <lang:Japanese />
      <lang:Java />
      <lang:JavaScript />
      <lang:Markdown />
      <lang:OpenSCAD />
      <lang:PseudoCode />
      <lang:ProgrammingLanguage />
      <lang:Python />
      <lang:Russian />
      <lang:Spanish />
      <lang:TypeScript />
      <lang:Unity />
      <lang:XML />
      <lang:YML />
      <mapping:FunctionMapping />
      <meta:FixedKeyword />
      <meta:FixedAlias />
      <meta:FreeTextKeyword />
      <meta:FreeTextAlias />
      <service:Bools />
      <service:Lists />
      <service:Math />
      <service:Numbers />
      <service:Strings />
      <relation:AuthoringGuide />
      <relation:ContrastsWith />
      <relation:DeepDive />
      <relation:Defines />
      <relation:Extends />
      <relation:Prerequisite />
      <relation:ReadFirst />
      <relation:ReadNext />
      <relation:Requires />
      <relation:Resolves />
      <relation:SeeAlso />
      <relation:TaskIndex />
