<!--
  BlockML Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.bml.Library

  BlockML core library — exports framework blocks, value types, and services.
  Block .bml sources live under blocks/org/blockml/bml/.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bcore="org.blockml.bml.core"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lang="org.blockml.bml.language"
  xmlns:mapping="org.blockml.bml.mapping"
  xmlns:service="org.blockml.bml.service"
  xmlns:status="org.blockml.bml.status"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:btype="org.blockml.bml.type">

  <idea>Published catalog of the BlockML core library — framework blocks, value types, and services.</idea>

  <documentation>
    Publishable BlockML core library (org.blockml.bml.Library). Exports the framework grammar:
    core branches (Block, ValueType, Language, Status, Constraint, Validation, Capability, Definition),
    concrete value types and constraints, implementation languages, built-in services, lifecycle
    status blocks, the Definition meta-model branch (org.blockml.bml.definition.*), and bootstrap
    documentation blocks (org.blockml.bml.documentation.*).

    Membership is defined exclusively by this file's _blocks list — not by directory layout.
    Version 3.0.0 applies to all exported blocks (framework convention: version only on
    Library.bml).
  </documentation>

  <references>
    <see file="02_mbml.md">
      Library format and publishable catalog rules.
    </see>
    <see file="16_framework_base_types.md">
      Bootstrap order for framework base types.
    </see>
    <see file="12_bom_object_model.md">
      Library BOM data structure.
    </see>
    <see block="bcore:BlockLibrary">
      Framework base type — not exported from this catalog.
    </see>
  </references>

  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>bcore:BlockLibrary</baseType>
  <version>3.0.0</version>

  <properties>
    <description>
      <value>BlockML core library</value>
    </description>
  </properties>

  <aggregations>
    <!-- Optional legacy XSD — omit when all types are exported via _blocks -->
    <_schemas>
      <composition>
        <Schema ref="blockml-library.xsd" />
      </composition>
    </_schemas>

    <_blocks>
      <composition>
        <bcore:Block />
        <bcore:Capability />
        <bcore:Constraint />
        <bcore:Definition />
        <bcore:Entity />
        <bcore:PrimitiveEntity />
        <bcore:Language />
        <bcore:Mapping />
        <bcore:Status />
        <bcore:Validation />
        <bcore:ValueType />
        <def:AggregationDefinition />
        <def:AssociationDefinition />
        <def:BlockDefinition />
        <def:CapabilityDefinition />
        <def:ChangeDefinition />
        <def:ExampleDefinition />
        <def:GenericTypeDefinition />
        <def:PropertyDefinition />
        <def:ReferenceDefinition />
        <cap:Inbound />
        <cap:Outbound />
        <cap:Transformation />
        <constraint:Max />
        <constraint:MaxItems />
        <constraint:MaxLength />
        <constraint:Min />
        <constraint:MinItems />
        <constraint:MinLength />
        <constraint:Pattern />
        <lang:C />
        <lang:CPP />
        <lang:MarkupLanguage />
        <lang:CSharp />
        <lang:Chinese />
        <lang:English />
        <lang:French />
        <lang:German />
        <lang:JSON />
        <lang:Japanese />
        <lang:Java />
        <lang:JavaScript />
        <lang:OpenSCAD />
        <lang:PseudoCode />
        <lang:ProgrammingLanguage />
        <lang:Python />
        <lang:Russian />
        <lang:Spanish />
        <lang:TypeScript />
        <lang:Unity />
        <lang:XML />
        <lang:YML />
        <mapping:FunctionMapping />
        <service:Bools />
        <service:Lists />
        <service:Math />
        <service:Numbers />
        <service:Strings />
        <status:Deprecated />
        <status:Draft />
        <status:Stable />
        <status:Stub />
        <validation:Error />
        <validation:Information />
        <validation:Warning />
        <btype:Boolean />
        <btype:BooleanEntity />
        <btype:Constant />
        <btype:ConstantType />
        <btype:Decimal />
        <btype:DecimalEntity />
        <btype:EnumType />
        <btype:FilePath />
        <btype:FilePathEntity />
        <btype:Float />
        <btype:FloatEntity />
        <btype:FullyQualifiedName />
        <btype:FullyQualifiedNameEntity />
        <btype:Integer />
        <btype:IntegerEntity />
        <btype:MimeType />
        <btype:MimeTypeEntity />
        <btype:Number />
        <btype:PrimitiveType />
        <btype:StructType />
        <btype:Text />
        <btype:TextEntity />
        <btype:URI />
        <btype:URIEntity />
        <btype:URL />
        <btype:URLEntity />
        <btype:Version />
        <btype:VersionEntity />
        <doc:Introduction />
        <doc:EverythingIsABlock />
        <doc:BlockAndInstance />
        <doc:DefinitionModel />
        <doc:TypeSystemOverview />
        <doc:ValueTypeConfiguration />
        <doc:CapabilitySemantics />
        <doc:Expressions />
        <doc:CompilerArchitecture />
        <doc:RendererFreedom />
        <doc:LibrarySystem />
        <doc:BmlNamespace />
        <doc:DocumentationModel />
        <doc:BootstrapModel />
        <doc:ModelingGuidelines />
        <doc:PseudoCode />
        <doc:WOTFoundation />
      </composition>
    </_blocks>
  </aggregations>

</block>
