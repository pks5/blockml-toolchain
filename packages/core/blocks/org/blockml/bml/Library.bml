<!--
  BlockML Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.bml.Library

  BlockML core library — exports framework blocks, value types, and services.
  Block .bml sources live under blocks/org/blockml/bml/.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bcore="org.blockml.bml.core"
  xmlns:cap="org.blockml.bml.capability"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:lang="org.blockml.bml.language"
  xmlns:mapping="org.blockml.bml.mapping"
  xmlns:service="org.blockml.bml.service"
  xmlns:relation="org.blockml.bml.relation"
  xmlns:status="org.blockml.bml.status"
  xmlns:task="org.blockml.bml.task"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:meta="org.blockml.bml.meta"
  xmlns:validation="org.blockml.bml.validation"
  xmlns:btype="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit">
  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>bcore:BlockLibrary</baseType>
  <is>A BlockML core library catalog</is>

  <documentation>
    Publishable BlockML core library (org.blockml.bml.Library). Exports the framework grammar:
    core branches (Block, ValueType, Language, Status, Relation, Constraint, Validation, Capability, Definition),
    concrete value types and constraints, implementation languages, built-in services, lifecycle
    status blocks, the Definition meta-model branch (org.blockml.bml.definition.*), bootstrap
    documentation blocks (org.blockml.bml.documentation.*), task guides (org.blockml.bml.task.*),
    diagnostic blocks (org.blockml.bml.diagnostic.*), and definition metadata entities
    (org.blockml.bml.meta.FixedKeyword, org.blockml.bml.meta.FixedAlias,
    org.blockml.bml.meta.FreeTextKeyword, org.blockml.bml.meta.FreeTextAlias). FreeText* extends
    Fixed* and widens protected members to public attributes. Domain libraries extend FixedKeyword
    and FixedAlias for catalogue-controlled tags and alternative names.

    Membership is defined exclusively by this file's blocks list — not by directory layout.
    Version 3.0.0 applies to all exported blocks (framework convention: version only on
    Library.bml).
  </documentation>

  <references>
    <see file="02_mbml.md" relation="AuthoringGuide">
      Library format and publishable catalog rules.
    </see>
    <see file="16_framework_base_types.md" relation="AuthoringGuide">
      Bootstrap order for framework base types.
    </see>
    <see file="12_bom_object_model.md" relation="DeepDive">
      Library BOM data structure.
    </see>
    <see type="bcore:BlockLibrary" relation="Extends">
      Framework base type — not exported from this catalog.
    </see>
  </references>

  <version>3.0.0</version>

  <language>
    <English />
  </language>
  <properties>
    <description>
      <value>BlockML core library</value>
    </description>
  </properties>

  <aggregations>
    <readFirst>
      <blockml:README />
    </readFirst>
    <!-- Optional legacy XSD — omit when all types are exported via blocks -->
    <schemas>
      <composition>
        <btype:FilePathEntity value="blockml-library.xsd" />
      </composition>
    </schemas>

    <blocks>
      <bcore:Block />
      <bcore:Bootstrap />
      <bcore:ReadMe />
      <bcore:Documentation />
      <bcore:Keyword />
      <bcore:Alias />
      <bcore:TaskGuide />
      <bcore:Diagnostic />
      <bcore:Capability />
      <bcore:Constraint />
      <bcore:Definition />
      <bcore:Entity />
      <bcore:PrimitiveEntity />
      <bcore:Language />
      <bcore:Mapping />
      <bcore:Status />
      <bcore:Relation />
      <bcore:Validation />
      <bcore:ValueType />
      <def:AggregationDefinition />
      <def:AssociationDefinition />
      <def:ConstrainableDefinition />
      <def:BlockDefinition />
      <def:SubBlockDefinition />
      <def:RootBlockDefinition />
      <def:CapabilityDefinition />
      <def:GenericTypeDefinition />
      <def:MemberDefinition />
      <def:PropertyDefinition />
      <def:StructuralDefinition />
      <cap:Inbound />
      <cap:Outbound />
      <cap:Transformation />
      <constraint:AllowedChildType />
      <constraint:AggregationConstraint />
      <constraint:AssociationConstraint />
      <constraint:BlockConstraint />
      <constraint:CapabilityConstraint />
      <constraint:Max />
      <constraint:MaxItems />
      <constraint:MaxLength />
      <constraint:Min />
