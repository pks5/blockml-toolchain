      <btype:PropertyReference />
      <btype:AggregationReference />
      <btype:AssociationReference />
      <btype:CapabilityReference />
      <btype:Integer />
      <btype:IntegerEntity />
      <btype:MimeType />
      <btype:MimeTypeEntity />
      <btype:Number />
      <btype:PrimitiveType />
      <btype:StructType />
      <btype:Text />
      <btype:TextEntity />
      <btype:Unit />
      <btype:URI />
