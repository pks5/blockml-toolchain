<!--
  BlockML Core — free-text alias entity

  FQN: org.blockml.bml.meta.FreeTextAlias
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:meta="org.blockml.bml.meta"
  xmlns:btype="org.blockml.bml.type">
  <name>FreeTextAlias</name>
  <type>meta:FreeTextAlias</type>
  <baseType>core:Alias</baseType>
  <is>Ad-hoc alternative name for a Block type — free-text label.</is>

  <documentation>Standard free-text implementation of org.blockml.bml.core.Alias for colloquial or
    legacy alternative names on Block definitions. Rendered as a direct child inside &lt;aliases&gt;
    (for example &lt;meta:FreeTextAlias name="Sub-Block" /&gt;). Comma-separated plain text on
    &lt;aliases&gt; is shorthand that expands to FreeTextAlias instances only. For catalogue-controlled
    alternative names, domain libraries define concrete Alias blocks extending
    org.blockml.bml.meta.FixedAlias (catalogue, members on definition) or org.blockml.bml.core.Alias
    directly for empty identity-only aliases.

    Instance configuration: FreeTextAlias{name="Sub-Block"}. Block-level only — members do not carry
    aliases. Not XML namespace prefix aliases.</documentation>

  <properties>
    <name type="Text" bml:xml="attribute">
      <documentation>Required alternative name text. Stored in BOM AliasEntry.name when typeFqn is
        org.blockml.bml.meta.FreeTextAlias — Entity property name, not Block definition
        &lt;name&gt;.</documentation>
    </name>
    <language type="TypeReference(lang:NaturalLanguage)" bml:xml="attribute">
      <documentation>Optional NaturalLanguage when this alias is written in a language other than the
        effective language of the enclosing block definition. Unqualified names resolve via
        org.blockml.bml.language.*. Omitted = inherit effective language.</documentation>
    </language>
    <legacy type="Boolean" bml:xml="attribute">
      <documentation>When true, marks a deprecated or legacy name — prefer the canonical Block name
        and idea in new prose. Default false when omitted.</documentation>
    </legacy>
  </properties>
</block>
