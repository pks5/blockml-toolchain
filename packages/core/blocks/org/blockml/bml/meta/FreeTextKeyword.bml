<!--
  BlockML Core — free-text keyword entity

  FQN: org.blockml.bml.meta.FreeTextKeyword
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:meta="org.blockml.bml.meta">

  <name>FreeTextKeyword</name>
  <type>meta:FreeTextKeyword</type>
  <baseType>meta:FixedKeyword</baseType>
  <is>An ad-hoc free-text search tag</is>

  <documentation>Standard free-text specialization of org.blockml.bml.meta.FixedKeyword for ad-hoc RAG
    and discovery tags. Extends FixedKeyword and widens protected catalogue members to public
    attributes via visibility widening (`_term` → `term`, same for language and weight) — see
    doc:MemberVisibility. Types are inherited from FixedKeyword
    and omitted on these overrides. Rendered as a direct child inside &lt;keywords&gt; (for example
    &lt;meta:FreeTextKeyword term="inheritance" /&gt;). Comma-separated plain text on &lt;keywords&gt;
    is shorthand that expands to FreeTextKeyword instances — one term per trimmed token. For
    controlled vocabulary tags, domain libraries define concrete Keyword blocks extending
    FixedKeyword (members stay protected on the definition) or org.blockml.bml.core.Keyword directly
    for empty identity-only tags.

    Instance configuration at type reference sites: FreeTextKeyword{term: "inheritance"}. Not to be
    confused with XML namespace prefix aliases.</documentation>

  <properties>
    <term override="true" bml:xml="attribute">
      <documentation>Required search tag text — public override of FixedKeyword._term. Stored in BOM
        KeywordEntry.term when typeFqn is org.blockml.bml.meta.FreeTextKeyword. Authored as attribute
        on &lt;keywords&gt; reference sites.</documentation>
    </term>
    <language override="true" bml:xml="attribute">
      <documentation>Optional NaturalLanguage — public override of FixedKeyword._language. When this
        tag is written in a language other than the effective language of the enclosing definition
        element. Unqualified names resolve via org.blockml.bml.language.*. Omitted = inherit effective
        language from Block or Library.</documentation>
    </language>
    <weight override="true" bml:xml="attribute">
      <documentation>Optional RAG ranking hint — public override of FixedKeyword._weight. Higher
        values rank stronger in discovery indexes. Omitted = default weight.</documentation>
    </weight>
  </properties>
</block>
