<!--
  BlockML Core — free-text keyword entity

  FQN: org.blockml.bml.meta.FreeTextKeyword
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:meta="org.blockml.bml.meta"
  xmlns:btype="org.blockml.bml.type">
  <name>FreeTextKeyword</name>
  <type>meta:FreeTextKeyword</type>
  <baseType>core:Keyword</baseType>
  <is>Ad-hoc search tag — free-text term on a definition element.</is>

  <documentation>Standard free-text implementation of org.blockml.bml.core.Keyword for ad-hoc RAG and
    discovery tags. Rendered as a direct child inside &lt;keywords&gt; (for example
    &lt;meta:FreeTextKeyword term="inheritance" /&gt;). Comma-separated plain text on
    &lt;keywords&gt; is shorthand that expands to FreeTextKeyword instances — one term per trimmed
    token.     For controlled vocabulary tags, domain libraries define concrete Keyword blocks extending
    org.blockml.bml.meta.FixedKeyword (catalogue, members on definition) or org.blockml.bml.core.Keyword
    directly for empty identity-only tags.

    Instance configuration at type reference sites: FreeTextKeyword{term="inheritance"}. Not to be
    confused with XML namespace prefix aliases.</documentation>

  <properties>
    <term type="Text" bml:xml="attribute">
      <documentation>Required search tag text. Stored in BOM KeywordEntry.term when typeFqn is
        org.blockml.bml.meta.FreeTextKeyword.</documentation>
    </term>
    <language type="TypeReference(lang:NaturalLanguage)" bml:xml="attribute">
      <documentation>Optional NaturalLanguage when this tag is written in a language other than the
        effective language of the enclosing definition element. Unqualified names resolve via
        org.blockml.bml.language.*. Omitted = inherit effective language from Block or Library.</documentation>
    </language>
    <weight type="Integer" bml:xml="attribute">
      <documentation>Optional RAG ranking hint — higher values rank stronger in discovery indexes.
        Omitted = default weight.</documentation>
    </weight>
  </properties>
</block>
