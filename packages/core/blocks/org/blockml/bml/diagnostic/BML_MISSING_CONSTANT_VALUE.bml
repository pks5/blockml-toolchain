<!--
  BlockML Core — BML_MISSING_CONSTANT_VALUE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_CONSTANT_VALUE
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_MISSING_CONSTANT_VALUE</name>
  <type>diag:BML_MISSING_CONSTANT_VALUE</type>
  <baseType>core:Diagnostic</baseType>
  <is>A missing-constant-value diagnostic</is>

  <summary>Emitted when Constant(T) omits required {value: …} configuration.</summary>

  <keywords>BML_MISSING_CONSTANT_VALUE</keywords>

  <documentation>
    Emitted when Constant(T) omits required {value: …} configuration. Remedy: Write Constant(T){value:
    …}.
  </documentation>

  <references>
    <see type="doc:ConstantValueType" relation="AuthoringGuide">
      Constant surface syntax.
    </see>
  </references>

</block>
