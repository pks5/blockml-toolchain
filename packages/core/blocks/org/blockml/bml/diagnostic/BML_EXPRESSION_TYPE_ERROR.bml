<!--
  BlockML Core — BML_EXPRESSION_TYPE_ERROR diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPRESSION_TYPE_ERROR
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_EXPRESSION_TYPE_ERROR</name>
  <type>diag:BML_EXPRESSION_TYPE_ERROR</type>
  <baseType>core:Diagnostic</baseType>
  <is>An expression-type-error diagnostic</is>

  <summary>Legacy/alias style expression type error — prefer BML_EXPR_TYPE_MISMATCH where applicable.</summary>

  <keywords>BML_EXPRESSION_TYPE_ERROR</keywords>

  <documentation>
    Legacy/alias style expression type error — prefer BML_EXPR_TYPE_MISMATCH where applicable.
    Align expression result type with the target member type.
  </documentation>

  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Expression typing.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Fix expression types.
    </see>
  </references>

</block>
