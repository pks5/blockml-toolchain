<!--
  BlockML Core — BML_CONSTRAINT_VALUE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_VALUE_MISMATCH
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_CONSTRAINT_VALUE_MISMATCH</name>
  <type>diag:BML_CONSTRAINT_VALUE_MISMATCH</type>
  <baseType>core:Diagnostic</baseType>
  <is>A constraint-value mismatch diagnostic</is>

  <summary>Emitted when a constraint instance property value is incompatible with bound T.</summary>

  <keywords>BML_CONSTRAINT_VALUE_MISMATCH</keywords>

  <documentation>
    Emitted when a constraint instance property value is incompatible with bound T. Remedy: Fix
    the constraint parameter value types (e.g. Min.value).
  </documentation>

  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Constraint instance values.
    </see>
    <see type="task:AddConstraint" relation="Resolves">
      Fix constraint parameters.
    </see>
  </references>

</block>
