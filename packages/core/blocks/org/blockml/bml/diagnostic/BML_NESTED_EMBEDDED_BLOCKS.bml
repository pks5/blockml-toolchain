<!--
  BlockML Core — BML_NESTED_EMBEDDED_BLOCKS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_NESTED_EMBEDDED_BLOCKS
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_NESTED_EMBEDDED_BLOCKS</name>
  <type>diag:BML_NESTED_EMBEDDED_BLOCKS</type>
  <baseType>core:Diagnostic</baseType>
  <is>A nested-embeddedBlocks diagnostic</is>

  <summary>Emitted when an embedded Block itself declares embeddedBlocks.</summary>

  <keywords>BML_NESTED_EMBEDDED_BLOCKS</keywords>

  <documentation>
    Emitted when an embedded Block itself declares embeddedBlocks. Remedy: Compose artifacts
    by listing virtual files flat at the root. Bundlers flatten when merging packages.
  </documentation>

  <references>
    <see type="doc:SubBlockModel" relation="AuthoringGuide">
      No nested embeds.
    </see>
    <see type="def:EmbeddedBlockDefinition" relation="Defines">
      Embedded block shape.
    </see>
    <see type="def:RootBlockDefinition" relation="SeeAlso">
      Sole owner of embeddedBlocks.
    </see>
  </references>

</block>
