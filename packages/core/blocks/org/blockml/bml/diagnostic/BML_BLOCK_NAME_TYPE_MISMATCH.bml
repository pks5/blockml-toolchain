<!--
  BlockML Core — BML_BLOCK_NAME_TYPE_MISMATCH diagnostic

  FQN: org.blockml.bml.diagnostic.BML_BLOCK_NAME_TYPE_MISMATCH
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_BLOCK_NAME_TYPE_MISMATCH</name>
  <type>diag:BML_BLOCK_NAME_TYPE_MISMATCH</type>
  <baseType>core:Diagnostic</baseType>
  <is>A name/type mismatch diagnostic</is>

  <summary>Emitted when an explicit root name does not equal lastSegment(resolve(type)).</summary>

  <keywords>BML_BLOCK_NAME_TYPE_MISMATCH</keywords>

  <documentation>
    Emitted when an explicit root name does not equal lastSegment(resolve(type)). Remedy: Root
    design principle: type is canonical; name is a redundant short form of the last type segment.
  </documentation>

  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Root name vs type rule.
    </see>
    <see type="doc:BlockNameConvention" relation="SeeAlso">
      PascalCase name format.
    </see>
    <see type="task:FixTypeIdentity" relation="Resolves">
      Align name with type last segment.
    </see>
  </references>

</block>
