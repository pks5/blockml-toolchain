<!--
  BlockML Core — BML_CONSTRAINT_VIOLATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_VIOLATION
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_CONSTRAINT_VIOLATION</name>
  <type>diag:BML_CONSTRAINT_VIOLATION</type>
  <baseType>core:Diagnostic</baseType>
  <is>A constraint-violation diagnostic</is>

  <summary>Emitted when a constraint fails with validation=Error.</summary>

  <keywords>BML_CONSTRAINT_VIOLATION</keywords>

  <documentation>
    Emitted when a constraint fails with validation=Error. Remedy: Change the authored value
    or relax/remove the constraint.
  </documentation>

  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Error severity.
    </see>
    <see type="task:AddConstraint" relation="Resolves">
      Resolve the failing constraint.
    </see>
  </references>

</block>
