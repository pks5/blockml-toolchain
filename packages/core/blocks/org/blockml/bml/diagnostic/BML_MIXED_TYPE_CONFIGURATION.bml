<!--
  BlockML Core — BML_MIXED_TYPE_CONFIGURATION diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MIXED_TYPE_CONFIGURATION
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_MIXED_TYPE_CONFIGURATION</name>
  <type>diag:BML_MIXED_TYPE_CONFIGURATION</type>
  <baseType>core:Diagnostic</baseType>
  <is>A mixed type-configuration diagnostic</is>

  <summary>Emitted when named and positional ValueType instance configuration are mixed in one {...} block.</summary>

  <keywords>BML_MIXED_TYPE_CONFIGURATION</keywords>

  <documentation>
    Emitted when named and positional ValueType instance configuration are mixed in one {...}
    block. Remedy: Use either named key: value pairs or positional values by property declaration
    order — not both.
  </documentation>

  <references>
    <see type="doc:ValueTypeConfiguration" relation="AuthoringGuide">
      Named vs positional configuration.
    </see>
    <see type="doc:FunctionMappingModel" relation="SeeAlso">
      Shared declaration-order principle.
    </see>
  </references>

</block>
