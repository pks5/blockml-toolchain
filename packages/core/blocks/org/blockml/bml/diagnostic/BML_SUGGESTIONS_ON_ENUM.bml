<!--
  BlockML Core — BML_SUGGESTIONS_ON_ENUM diagnostic

  FQN: org.blockml.bml.diagnostic.BML_SUGGESTIONS_ON_ENUM
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_SUGGESTIONS_ON_ENUM</name>
  <type>diag:BML_SUGGESTIONS_ON_ENUM</type>
  <baseType>core:Diagnostic</baseType>
  <is>A suggestions-on-enum diagnostic</is>

  <summary>Emitted when &lt;suggestions&gt; appears on an EnumType-typed property.</summary>

  <keywords>BML_SUGGESTIONS_ON_ENUM</keywords>

  <documentation>
    Emitted when &lt;suggestions&gt; appears on an EnumType-typed property. Remedy: Enum values
    come from the EnumType values aggregation — remove suggestions.
  </documentation>

  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Suggestions rules.
    </see>
    <see type="def:PropertyDefinition" relation="Defines">
      suggestions aggregation.
    </see>
  </references>

</block>
