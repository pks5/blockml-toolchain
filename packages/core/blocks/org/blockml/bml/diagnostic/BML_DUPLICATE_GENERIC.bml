<!--
  BlockML Core — BML_DUPLICATE_GENERIC diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_GENERIC
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_DUPLICATE_GENERIC</name>
  <type>diag:BML_DUPLICATE_GENERIC</type>
  <baseType>core:Diagnostic</baseType>
  <is>A duplicate-generic-parameter diagnostic</is>

  <summary>Emitted when two genericTypes entries share the same parameter name.</summary>

  <keywords>BML_DUPLICATE_GENERIC</keywords>

  <documentation>
    Emitted when two genericTypes entries share the same parameter name. Remedy: Rename one parameter.
  </documentation>

  <references>
    <see type="doc:GenericsModel" relation="AuthoringGuide">
      genericTypes declarations.
    </see>
  </references>

</block>
