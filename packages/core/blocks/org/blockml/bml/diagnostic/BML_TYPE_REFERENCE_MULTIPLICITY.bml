<!--
  BlockML Core — BML_TYPE_REFERENCE_MULTIPLICITY diagnostic

  FQN: org.blockml.bml.diagnostic.BML_TYPE_REFERENCE_MULTIPLICITY
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_TYPE_REFERENCE_MULTIPLICITY</name>
  <type>diag:BML_TYPE_REFERENCE_MULTIPLICITY</type>
  <baseType>core:Diagnostic</baseType>
  <is>A TypeReference-multiplicity diagnostic</is>

  <summary>Emitted when multiplicity is applied illegally to a TypeReference site that forbids it.</summary>

  <keywords>BML_TYPE_REFERENCE_MULTIPLICITY</keywords>

  <documentation>
    Emitted when multiplicity is applied illegally to a TypeReference site that forbids it. Remedy:
    Check the site's type attribute rules — some TypeReference usages are singular only.
  </documentation>

  <references>
    <see type="type:TypeReference" relation="Defines">
      TypeReference rules.
    </see>
    <see type="doc:TypeExpressions" relation="SeeAlso">
      Multiplicity.
    </see>
  </references>

</block>
