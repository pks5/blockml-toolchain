<!--
  BlockML Core — BML_UNKNOWN_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_TARGET
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_UNKNOWN_TARGET</name>
  <type>diag:BML_UNKNOWN_TARGET</type>
  <baseType>core:Diagnostic</baseType>
  <is>An unknown-render-target diagnostic</is>

  <summary>Emitted when a configured render target name is not registered.</summary>

  <keywords>BML_UNKNOWN_TARGET</keywords>

  <documentation>
    Emitted when a configured render target name is not registered. Remedy: Register the target
    package or fix targets[] configuration.
  </documentation>

  <references>
    <see type="doc:CompilerArchitecture" relation="AuthoringGuide">
      Targets.
    </see>
  </references>

</block>
