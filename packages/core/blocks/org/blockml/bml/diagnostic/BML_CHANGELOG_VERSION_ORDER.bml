<!--
  BlockML Core — BML_CHANGELOG_VERSION_ORDER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CHANGELOG_VERSION_ORDER
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_CHANGELOG_VERSION_ORDER</name>
  <type>diag:BML_CHANGELOG_VERSION_ORDER</type>
  <baseType>core:Diagnostic</baseType>
  <is>A changelog version-order diagnostic</is>

  <summary>Emitted when changelog entries are not in oldest-first version order.</summary>

  <keywords>BML_CHANGELOG_VERSION_ORDER</keywords>

  <documentation>
    Emitted when changelog entries are not in oldest-first version order. Remedy: Order &lt;change&gt;
    entries ascending by version.
  </documentation>

  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      changelog rules.
    </see>
  </references>

</block>
