<!--
  BlockML Core — BML_UNKNOWN_STATUS diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_STATUS
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_UNKNOWN_STATUS</name>
  <type>diag:BML_UNKNOWN_STATUS</type>
  <baseType>core:Diagnostic</baseType>
  <is>An unknown-status diagnostic</is>

  <summary>Emitted when status does not resolve to org.blockml.bml.status.*.</summary>

  <keywords>BML_UNKNOWN_STATUS</keywords>

  <documentation>
    Emitted when status does not resolve to org.blockml.bml.status.*. Remedy: Use Draft, Stable,
    Deprecated, Stub (or library Status blocks).
  </documentation>

  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      status.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="SeeAlso">
      status implicit NS.
    </see>
  </references>

</block>
