<!--
  BlockML Core — BML_IDENTITY_TYPE_CHILD_ELEMENT diagnostic

  FQN: org.blockml.bml.diagnostic.BML_IDENTITY_TYPE_CHILD_ELEMENT
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_IDENTITY_TYPE_CHILD_ELEMENT</name>
  <type>diag:BML_IDENTITY_TYPE_CHILD_ELEMENT</type>
  <baseType>core:Diagnostic</baseType>
  <is>An identity-type child-element diagnostic</is>

  <summary>Emitted when type/baseType identity fields are authored as illegal child shapes.</summary>

  <keywords>BML_IDENTITY_TYPE_CHILD_ELEMENT</keywords>

  <documentation>
    Emitted when type/baseType identity fields are authored as illegal child shapes. Remedy:
    Author type/baseType as TypeReference text (element or attribute) per MemberDefinition placement.
  </documentation>

  <references>
    <see type="doc:TypeIdentityDerivation" relation="AuthoringGuide">
      Identity fields.
    </see>
  </references>

</block>
