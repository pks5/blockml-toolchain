<!--
  BlockML Core — BML_PROPERTY_CYCLE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_PROPERTY_CYCLE
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_PROPERTY_CYCLE</name>
  <type>diag:BML_PROPERTY_CYCLE</type>
  <baseType>core:Diagnostic</baseType>
  <is>A property-expression-cycle diagnostic</is>

  <summary>Emitted when &lt;value&gt; expressions form a cyclic dependency among Properties.</summary>

  <keywords>BML_PROPERTY_CYCLE</keywords>

  <documentation>
    Emitted when &lt;value&gt; expressions form a cyclic dependency among Properties. Remedy:
    value expressions may reference own Block Properties and #built-ins only; resolve via topological
    sort.
  </documentation>

  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      value expression scope rules.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Break the property dependency cycle.
    </see>
  </references>

</block>
