<!--
  BlockML Core — BML_MISSING_IMPLEMENTATION_LANGUAGE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_IMPLEMENTATION_LANGUAGE
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_MISSING_IMPLEMENTATION_LANGUAGE</name>
  <type>diag:BML_MISSING_IMPLEMENTATION_LANGUAGE</type>
  <baseType>core:Diagnostic</baseType>
  <is>A missing-implementation-language diagnostic</is>

  <summary>Emitted when &lt;implementation&gt; omits required language.</summary>

  <keywords>BML_MISSING_IMPLEMENTATION_LANGUAGE</keywords>

  <documentation>
    Emitted when &lt;implementation&gt; omits required language. Remedy: Set language to an org.blockml.bml.language.*
    FQN.
  </documentation>

  <references>
    <see type="doc:CapabilitySemantics" relation="AuthoringGuide">
      implementation.
    </see>
    <see type="def:CapabilityDefinition" relation="Defines">
      implementation child.
    </see>
  </references>

</block>
