<!--
  BlockML Core — BML_MISSING_AGGREGATION_TYPE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_MISSING_AGGREGATION_TYPE
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_MISSING_AGGREGATION_TYPE</name>
  <type>diag:BML_MISSING_AGGREGATION_TYPE</type>
  <baseType>core:Diagnostic</baseType>
  <is>A missing-aggregation-type diagnostic</is>

  <summary>Emitted when a new aggregation declaration omits required type.</summary>

  <keywords>BML_MISSING_AGGREGATION_TYPE</keywords>

  <documentation>
    Emitted when a new aggregation declaration omits required type. Remedy: Provide type on new
    aggregations; inherited overrides may omit unchanged type.
  </documentation>

  <references>
    <see type="doc:CompositionModel" relation="AuthoringGuide">
      Aggregation declarations.
    </see>
    <see type="doc:PartialMemberOverrides" relation="SeeAlso">
      Omit unchanged type.
    </see>
  </references>

</block>
