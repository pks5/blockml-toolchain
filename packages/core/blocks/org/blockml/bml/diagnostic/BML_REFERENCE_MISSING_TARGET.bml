<!--
  BlockML Core — BML_REFERENCE_MISSING_TARGET diagnostic

  FQN: org.blockml.bml.diagnostic.BML_REFERENCE_MISSING_TARGET
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_REFERENCE_MISSING_TARGET</name>
  <type>diag:BML_REFERENCE_MISSING_TARGET</type>
  <baseType>core:Diagnostic</baseType>
  <is>A missing-reference-target diagnostic</is>

  <summary>Emitted when a &lt;see&gt; entry has no target attribute.</summary>

  <keywords>BML_REFERENCE_MISSING_TARGET</keywords>

  <documentation>
    Emitted when a &lt;see&gt; entry has no target attribute. Remedy: Provide type, instance,
    file, url, or member path target.
  </documentation>

  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      see targets.
    </see>
  </references>

</block>
