<!--
  BlockML Core — BML_UNKNOWN_FUNCTION_PARAMETER diagnostic

  FQN: org.blockml.bml.diagnostic.BML_UNKNOWN_FUNCTION_PARAMETER
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_UNKNOWN_FUNCTION_PARAMETER</name>
  <type>diag:BML_UNKNOWN_FUNCTION_PARAMETER</type>
  <baseType>core:Diagnostic</baseType>
  <is>An unknown function-parameter diagnostic</is>

  <summary>Emitted when a named call argument is not a field of the Capability inputType.</summary>

  <keywords>BML_UNKNOWN_FUNCTION_PARAMETER</keywords>

  <documentation>
    Emitted when a named call argument is not a field of the Capability inputType. Remedy: Named
    keys must match StructType / anonymous struct field names.
  </documentation>

  <references>
    <see type="doc:FunctionMappingModel" relation="AuthoringGuide">
      Named call form.
    </see>
  </references>

</block>
