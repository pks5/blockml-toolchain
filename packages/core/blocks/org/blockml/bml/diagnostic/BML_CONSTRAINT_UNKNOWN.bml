<!--
  BlockML Core — BML_CONSTRAINT_UNKNOWN diagnostic

  FQN: org.blockml.bml.diagnostic.BML_CONSTRAINT_UNKNOWN
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_CONSTRAINT_UNKNOWN</name>
  <type>diag:BML_CONSTRAINT_UNKNOWN</type>
  <baseType>core:Diagnostic</baseType>
  <is>An unknown-constraint diagnostic</is>

  <summary>Emitted when a constraint type is not in TypeRegistry or not a Constraint subtype.</summary>

  <keywords>BML_CONSTRAINT_UNKNOWN</keywords>

  <documentation>
    Emitted when a constraint type is not in TypeRegistry or not a Constraint subtype. Remedy:
    Export the constraint via Library.blocks and use a valid Constraint FQN.
  </documentation>

  <references>
    <see type="doc:ConstraintsModel" relation="AuthoringGuide">
      Constraint catalogue.
    </see>
    <see type="task:DebugUnknownType" relation="Resolves">
      Related type-registry debugging.
    </see>
  </references>

</block>
