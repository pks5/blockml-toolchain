<!--
  BlockML Core — BML_DUPLICATE_PROPERTY_VALUE diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DUPLICATE_PROPERTY_VALUE
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_DUPLICATE_PROPERTY_VALUE</name>
  <type>diag:BML_DUPLICATE_PROPERTY_VALUE</type>
  <baseType>core:Diagnostic</baseType>
  <is>A duplicate-property-value diagnostic</is>

  <summary>Emitted when property value facets collide on the same annotation namespace.</summary>

  <keywords>BML_DUPLICATE_PROPERTY_VALUE</keywords>

  <documentation>
    Emitted when property value facets collide on the same annotation namespace. Remedy: One
    value entry per namespace; facets multiply along Annotation namespaces.
  </documentation>

  <references>
    <see type="def:PropertyDefinition" relation="Defines">
      Property value facets.
    </see>
    <see type="doc:AnnotationModel" relation="AuthoringGuide">
      Annotation namespaces and value-facet rules.
    </see>
  </references>

</block>
