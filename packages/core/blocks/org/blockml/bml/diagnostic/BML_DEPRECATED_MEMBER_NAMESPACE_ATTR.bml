<!--
  BlockML Core — BML_DEPRECATED_MEMBER_NAMESPACE_ATTR diagnostic

  FQN: org.blockml.bml.diagnostic.BML_DEPRECATED_MEMBER_NAMESPACE_ATTR
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task"
  xmlns:type="org.blockml.bml.type">

  <name>BML_DEPRECATED_MEMBER_NAMESPACE_ATTR</name>
  <type>diag:BML_DEPRECATED_MEMBER_NAMESPACE_ATTR</type>
  <baseType>core:Diagnostic</baseType>
  <is>A deprecated namespace-attribute diagnostic</is>

  <summary>Emitted when a legacy namespace= attribute appears on a member element.</summary>

  <keywords>BML_DEPRECATED_MEMBER_NAMESPACE_ATTR</keywords>

  <documentation>
    Emitted when a legacy namespace= attribute appears on a member element. Remedy: Use XML element
    QName / xmlns prefixes for member namespaces — no namespace attribute.
  </documentation>

  <references>
    <see type="doc:MemberVisibility" relation="SeeAlso">
      Member identity.
    </see>
    <see type="doc:BmlNamespace" relation="AuthoringGuide">
      xmlns conventions.
    </see>
  </references>

</block>
