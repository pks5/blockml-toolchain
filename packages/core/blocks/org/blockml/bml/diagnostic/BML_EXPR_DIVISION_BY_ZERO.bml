<!--
  BlockML Core — BML_EXPR_DIVISION_BY_ZERO diagnostic

  FQN: org.blockml.bml.diagnostic.BML_EXPR_DIVISION_BY_ZERO
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>BML_EXPR_DIVISION_BY_ZERO</name>
  <type>diag:BML_EXPR_DIVISION_BY_ZERO</type>
  <baseType>core:Diagnostic</baseType>
  <is>A division-by-zero diagnostic</is>

  <summary>Emitted for compile-time division by zero when both operands are literals.</summary>

  <keywords>BML_EXPR_DIVISION_BY_ZERO</keywords>

  <documentation>
    Emitted for compile-time division by zero when both operands are literals. Only literal operand
    cases are checked at validate time; runtime division remains renderer concern.
  </documentation>

  <references>
    <see type="doc:Expressions" relation="AuthoringGuide">
      Operators and validation.
    </see>
    <see type="task:FixExpressionErrors" relation="Resolves">
      Fix the literal divisor.
    </see>
  </references>

</block>
