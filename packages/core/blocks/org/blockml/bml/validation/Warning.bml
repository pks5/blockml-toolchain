<!--
  BlockML Core — warning validation

  FQN: org.blockml.bml.validation.Warning
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:validation="org.blockml.bml.validation">

  <idea>Constraint violation emits a warning; compilation succeeds.</idea>

  <documentation>When a constraint with validation="Warning" is violated, the BlockML
    validator emits BML_CONSTRAINT_WARNING. Compilation continues.</documentation>
  <name>Warning</name>
  <type>
    <validation:Warning />
  </type>
  <baseType>
    <core:Validation />
  </baseType>
</block>
