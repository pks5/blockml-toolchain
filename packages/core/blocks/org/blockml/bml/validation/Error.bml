<!--
  BlockML Core — error validation

  FQN: org.blockml.bml.validation.Error
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:validation="org.blockml.bml.validation">

  <name>Error</name>
  <type>validation:Error</type>
  <baseType>core:Validation</baseType>
  <is>A failing Validation severity</is>

  <documentation>When a constraint with validation="Error" is violated, the BlockML
    validator emits BML_CONSTRAINT_VIOLATION and compilation fails.</documentation>
</block>
