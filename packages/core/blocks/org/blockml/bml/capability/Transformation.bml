<!--
  BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.bml.core.Capability
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:cap="org.blockml.bml.capability"
  xmlns:core="org.blockml.bml.core">

  <idea>Representation of an Transformation capability.</idea>

  <documentation>Transformation capability.</documentation>
  <name>Transformation</name>
  <type>cap:Transformation</type>
  <baseType>core:Capability</baseType>
  <properties>
    <_hasInput>
      <value>true</value>
    </_hasInput>
    <_hasOutput>
      <value>true</value>
    </_hasOutput>
  </properties>


</block>