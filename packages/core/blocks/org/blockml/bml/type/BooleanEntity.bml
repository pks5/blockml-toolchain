<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">
  <name>BooleanEntity</name>
  <type>type:BooleanEntity</type>
  <baseType>core:PrimitiveEntity(type:Boolean)</baseType>
  <is>A true-or-false value as an Entity</is>

  <documentation>Concrete Entity wrapping a Boolean primitive. Binds T = Boolean on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
</block>
