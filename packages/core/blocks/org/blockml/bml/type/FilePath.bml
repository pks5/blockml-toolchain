<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type">
  <name>FilePath</name>
  <type>btype:FilePath</type>
  <baseType>btype:Text</baseType>
  <is>File system path text.</is>

  <documentation>Textual primitive subtype for file path values. Unqualified name FilePath resolves
    to org.blockml.bml.type.FilePath.</documentation>
</block>
