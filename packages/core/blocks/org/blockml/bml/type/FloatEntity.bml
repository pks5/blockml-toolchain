<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core">
  <name>FloatEntity</name>
  <type>btype:FloatEntity</type>
  <baseType>core:PrimitiveEntity(btype:Float)</baseType>
  <is>A floating-point number as an Entity</is>

  <documentation>Concrete Entity wrapping a Float primitive. Binds T = Float on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
</block>
