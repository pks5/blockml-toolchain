<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core">
  <name>Number</name>
  <type>btype:Number</type>
  <baseType>btype:PrimitiveType</baseType>
  <idea>Abstract branch for numeric primitive ValueTypes.</idea>

  <documentation>Abstract numeric primitive branch under org.blockml.bml.type.PrimitiveType.
    Concrete types: Integer (whole numbers), Decimal (default for non-integer numeric values),
    Float (binary floating-point — only when IEEE754 semantics are explicitly required).
    Abstract numeric branch — not resolvable via Property.type implicit namespace; use Integer, Decimal, or Float explicitly.
    Numeric types describe semantics only; values are stored in Properties.</documentation>
  <abstract>true</abstract>
</block>
