<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>DecimalEntity</name>
  <type>type:DecimalEntity</type>
  <baseType>core:PrimitiveEntity(type:Decimal)</baseType>
  <is>A decimal number as an Entity</is>

  <documentation>Concrete Entity wrapping a Decimal primitive. Binds T = Decimal on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
</block>
