<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:unit="org.blockml.bml.unit">
  <name>Integer</name>
  <type>btype:Integer</type>
  <baseType>btype:Number(N)</baseType>
  <is>A whole number</is>

  <documentation>BOM Core primitive ValueType for whole numbers. Unqualified name Integer resolves
    to org.blockml.bml.type.Integer. Extends org.blockml.bml.type.Number. Payload values are stored on
    Properties — not on the Integer type itself.

    Generic parameter N (Unit, default unit:None) is forwarded from Number — e.g.
    Integer(unit:Millimeter). Bare Integer is dimensionless.

    Optional configuration Properties (min, max) configure a Property's owned Integer instance via
    inline type syntax — Integer{min=0, max=100}. Positional order: min, max. See
    20_value_type_instance_configuration.md.</documentation>

  <genericTypes>
    <N baseType="core:Unit" defaultType="unit:None"/>
  </genericTypes>

  <properties>
    <min type="Integer">
      <documentation>Minimum allowed value (inclusive). Configured via Integer{min=n}.</documentation>
    </min>
    <max type="Integer">
      <documentation>Maximum allowed value (inclusive). Configured via Integer{max=n}.</documentation>
    </max>
  </properties>
</block>
