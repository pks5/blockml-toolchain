<!--
  BlockML Core — member definition path reference value type

  FQN: org.blockml.bml.type.MemberReference
  See docs/16_framework_base_types.md — Definition Addressing · references
       docs/17_type_system_bml.md — TypeReference · MemberReference
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>MemberReference</name>
  <type>type:MemberReference</type>
  <baseType>type:TypeReference(B)</baseType>
  <is>A path to a Block member</is>

  <documentation>Abstract ValueType for references to Block member definitions — properties,
    aggregations, associations, and capabilities. Extends TypeReference(B); adds D to constrain
    which MemberDefinition branch the path may target.

    Value forms:
    • Canonical definition path — for example com.foo.Bar.properties.width
    • Local member name when paired with a type qualifier (for example see type="com.foo.Bar"
      property="width" → com.foo.Bar.properties.width)

    Generic parameters:
    • B (from TypeReference) — owning Block branch for the member's enclosing type
    • D (baseType def:MemberDefinition) — member definition kind constraint

    Concrete specializations bind D:
    • PropertyReference     → D = def:PropertyDefinition
    • AggregationReference  → D = def:AggregationDefinition
    • AssociationReference  → D = def:AssociationDefinition
    • CapabilityReference   → D = def:CapabilityDefinition

    Primary use — StructuralDefinition Reference (see) member target attributes. Not for Block type
    identity (use TypeReference), instance pointers (use InstanceReference), or type-reference
    aggregations (use TypeReferenceEntity).</documentation>

  <references>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      Definition addressing and see targets.
    </see>
    <see type="doc:DocumentationModel" relation="AuthoringGuide">
      references — separate target attributes.
    </see>
    <see type="type:TypeReference" relation="SeeAlso">
      Parent ValueType — Block type FQNs only.
    </see>
    <see type="def:MemberDefinition" relation="Defines">
      Abstract member meta-model branch bound by D.
    </see>
    <see type="def:StructuralDefinition" relation="SeeAlso">
      Reference sub-block — property / aggregation / association / capability attributes.
    </see>
    <see type="type:PropertyReference" relation="SeeAlso">
      Concrete specialization for PropertyDefinition paths.
    </see>
  </references>

  <abstract>true</abstract>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch — forwarded from TypeReference.B. Defaults to core:Block.
      </documentation>
    </B>
    <D baseType="def:MemberDefinition">
      <documentation>Member definition kind. Bound by concrete children (PropertyReference, …).
      </documentation>
    </D>
  </genericTypes>
</block>
