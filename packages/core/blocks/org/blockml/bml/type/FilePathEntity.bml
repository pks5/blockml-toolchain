<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:btype="org.blockml.bml.type">
  <name>FilePathEntity</name>
  <type>btype:FilePathEntity</type>
  <baseType>core:PrimitiveEntity(btype:FilePath)</baseType>
  <is>A filesystem path as an Entity</is>

  <documentation>Concrete Entity wrapping a FilePath primitive. Binds T = FilePath on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
</block>
