<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <name>FilePathEntity</name>
  <type>type:FilePathEntity</type>
  <baseType>core:PrimitiveEntity(type:FilePath)</baseType>
  <is>A filesystem path as an Entity</is>

  <documentation>Concrete Entity wrapping a FilePath primitive. Binds T = FilePath on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
</block>
