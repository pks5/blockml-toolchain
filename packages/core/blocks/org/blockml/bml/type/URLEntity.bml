<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:core="org.blockml.bml.core"
  xmlns:btype="org.blockml.bml.type">
  <name>URLEntity</name>
  <type>btype:URLEntity</type>
  <baseType>core:PrimitiveEntity(btype:URL)</baseType>
  <is>A web address as an Entity</is>

  <documentation>Concrete Entity wrapping a URL primitive. Binds T = URL on
    org.blockml.bml.core.PrimitiveEntity via baseType — inherits the value property automatically.</documentation>
</block>
