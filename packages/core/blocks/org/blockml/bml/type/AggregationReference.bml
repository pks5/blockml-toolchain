<!--
  BlockML Core — AggregationDefinition path reference

  FQN: org.blockml.bml.type.AggregationReference
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">
  <name>AggregationReference</name>
  <type>btype:AggregationReference</type>
  <baseType>btype:MemberReference(B, def:AggregationDefinition)</baseType>
  <is>A path naming an AggregationDefinition on a Block.</is>

  <documentation>Concrete MemberReference binding D = AggregationDefinition. Value is a canonical
    aggregation path (com.foo.Bar.aggregations.children) or a local aggregation name when paired
    with a Block qualifier. Used as the type of see aggregation=.</documentation>

  <references>
    <see block="btype:MemberReference">
      Abstract member path ValueType.
    </see>
    <see block="def:AggregationDefinition">
      Target member meta-model type.
    </see>
    <see block="def:StructuralDefinition">
      see aggregation attribute.
    </see>
  </references>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch. Defaults to core:Block.</documentation>
    </B>
  </genericTypes>
</block>
