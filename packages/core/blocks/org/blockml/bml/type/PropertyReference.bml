<!--
  BlockML Core — PropertyDefinition path reference

  FQN: org.blockml.bml.type.PropertyReference
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">
  <name>PropertyReference</name>
  <type>btype:PropertyReference</type>
  <baseType>btype:MemberReference(B, def:PropertyDefinition)</baseType>
  <is>A path naming a PropertyDefinition on a Block.</is>

  <documentation>Concrete MemberReference binding D = PropertyDefinition. Value is a canonical
    property path (com.foo.Bar.properties.width) or a local property name when paired with a Block
    qualifier. Used as the type of see property= and other PropertyDefinition reference sites.
  </documentation>

  <references>
    <see block="btype:MemberReference">
      Abstract member path ValueType.
    </see>
    <see block="def:PropertyDefinition">
      Target member meta-model type.
    </see>
    <see block="def:StructuralDefinition">
      see property attribute.
    </see>
  </references>

  <genericTypes>
    <B baseType="core:Block" defaultType="core:Block">
      <documentation>Owning Block branch. Defaults to core:Block — bare PropertyReference is valid.
      </documentation>
    </B>
  </genericTypes>
</block>
