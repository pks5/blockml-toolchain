<!--
  BlockML Core — semantic version primitive type

  FQN: org.blockml.bml.type.Version
-->
<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd"
  xmlns:btype="org.blockml.bml.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:bml="http://blockml.org/schema/bml">
  <name>Version</name>
  <type>btype:Version</type>
  <baseType>btype:Text</baseType>
  <is>A version number</is>

  <documentation>Textual primitive subtype for semantic version numbers (semver). Values use
    MAJOR.MINOR.PATCH form (for example 1.0.0, 1.3.2). Unqualified name Version resolves to
    org.blockml.bml.type.Version.

    Used wherever BlockML tracks or compares definition and reference versions: &lt;version&gt; on
    Block and Library definitions, &lt;since&gt; on members, changelog entries, and bml:version on
    composition instances. Concrete version strings are stored in Properties — not on the Version
    type itself.</documentation>

  <references>
    <see file="02_mbml.md">
      Version attribute on Block and Library definitions.
    </see>
    <see file="12_bom_object_model.md">
      Version comparison and reference rules.
    </see>
  </references>

</block>
