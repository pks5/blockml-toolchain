    </see>
    <see type="mapping:FunctionMapping" relation="SeeAlso">
      Default function mapping rules for capability calls and positional StructType access.
    </see>
    <see type="service:Math" relation="SeeAlso">
      Built-in #math.* expression utilities.
    </see>
    <see type="service:Strings" relation="SeeAlso">
      Built-in #strings.* expression utilities.
    </see>
    <see type="core:Capability" relation="SeeAlso">
