    </see>
    <see type="diag:BML_UNCLOSED_EMBEDDED_EXPRESSION" relation="SeeAlso">
      Unclosed &lt;$ delimiter.
    </see>
    <see type="diag:BML_INVALID_EMBEDDED_EXPRESSION" relation="SeeAlso">
