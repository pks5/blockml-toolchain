    </see>
    <see file="01_system.md" relation="DeepDive">
      Self-hosting bootstrap and BML self-description roadmap (V1/V2/V3).
    </see>
    <see block="core:BlockLibrary" relation="Defines">
      Library descriptor base — bootstrap aggregation links to README.
    </see>
    <see block="core:Bootstrap" relation="Defines">
      Abstract bootstrap role marker — no readFirst aggregation.
    </see>
    <see block="blockml:README" relation="SeeAlso">
      Standard human/LLM library entry point — ReadFirst references in mental learning order.
    </see>
    <see block="core:Documentation" relation="Defines">
      Base type for documentation blocks listed with relation=ReadFirst.
    </see>
    <see block="relation:ReadFirst" relation="Defines">
      Relation block for curated bootstrap reading path entries on references.
    </see>
    <see block="relation:TaskIndex" relation="Defines">
      Relation block for task catalog entries on README and Bootstrap blocks.
    </see>
    <see block="doc:TaskGuideModel" relation="SeeAlso">
      TaskGuide blocks, task relations, and diagnostic fix paths.
    </see>
    <see block="doc:Introduction" relation="ReadFirst">
      First ReadFirst entry on org.blockml.bml.README — BlockML goals and overview.
    </see>
    <see block="doc:ModelingGuidelines" relation="SeeAlso">
      Recommended patterns for modeling Blocks — later in the ReadFirst path.
    </see>
  </references>

  <name>BootstrapModel</name>
  <type>
    <doc:BootstrapModel />
  </type>
  <baseType>
    <core:Documentation />
  </baseType>
</block>
