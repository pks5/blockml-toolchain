<!--
  BlockML Core — add constraint task

  FQN: org.blockml.bml.task.AddConstraint
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:constraint="org.blockml.bml.constraint"
  xmlns:def="org.blockml.bml.definition"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:relation="org.blockml.bml.relation"
  xmlns:task="org.blockml.bml.task">
  <name>AddConstraint</name>
  <type>task:AddConstraint</type>
  <baseType>core:TaskGuide</baseType>
  <is>A how-to for attaching Constraints</is>

  <summary>Declare a constraints container on a ConstrainableDefinition element and add a Constraint
    reference as a direct child. The embedding context binds the constraint target automatically —
    no target property in BML.</summary>

  <keywords>constraint, validation, Min, Max, Pattern, member constraint</keywords>

  <documentation>
    Procedure for adding a constraint:
    1. Confirm the definition element extends ConstrainableDefinition (Block or member).
    2. Add a constraints container if absent.
    3. Insert a Constraint Block reference (element name = FQN via xmlns prefix).
    4. Optionally attach a validation reference on the constraint instance for rule enforcement.
    5. Run the validator — BML_CONSTRAINT_TARGET_MISMATCH when branch compatibility fails.
  </documentation>

  <references>
    <see type="doc:DefinitionModel" relation="Prerequisite">
      Understand member containers and definition metadata first.
    </see>
    <see type="def:ConstrainableDefinition" relation="TaskStep">
      Step 1 — confirm the target element supports a constraints container.
    </see>
    <see file="18_constraints_and_suggestions.md" relation="TaskStep">
      Step 2 — choose constraint branch and target binding rules.
    </see>
    <see type="constraint:Min" relation="TaskStep">
      Step 3 — pick a concrete constraint block (Min, Max, Pattern, RequiresMember, …).
    </see>
    <see type="core:Validation" relation="TaskStep">
      Step 4 — optionally wire validation for enforced rules.
    </see>
  </references>

</block>
