<!--
  BlockML Core — debug unknown type task

  FQN: org.blockml.bml.task.DebugUnknownType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:blockml="org.blockml.bml"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:relation="org.blockml.bml.relation"
  xmlns:task="org.blockml.bml.task">
  <name>DebugUnknownType</name>
  <type>task:DebugUnknownType</type>
  <baseType>core:TaskGuide</baseType>
  <is>Fix BML_UNKNOWN_TYPE — unresolved type, baseType, or member type reference.</is>

  <summary>Verify FQN spelling, xmlns prefix resolution, Library _blocks membership, and bootstrap
    load order so the referenced type is registered in TypeRegistry before validation.</summary>

  <keywords>BML_UNKNOWN_TYPE, unknown type, unresolved FQN, TypeRegistry, bootstrap</keywords>

  <documentation>
    Procedure when the validator reports BML_UNKNOWN_TYPE:
    1. Locate the failing type reference site (type, baseType, member type, contract, language).
    2. Confirm the expanded FQN matches a registered BlockDefinition.
    3. Check xmlns prefix maps to the intended namespace on this document.
    4. Confirm the defining block is listed in Library _blocks when loaded via a library.
    5. Verify dependency libraries and bootstrap order load the defining catalogue first.
  </documentation>

  <references>
    <see block="diag:BML_UNKNOWN_TYPE" relation="SeeAlso">
      Diagnostic block for this error code — entry point from validator output.
    </see>
    <see block="doc:ImplicitNamespaceResolution" relation="TaskStep">
      Step 1 — verify xmlns prefix and implicit namespace resolution at the reference site.
    </see>
    <see block="doc:LibrarySystem" relation="TaskStep">
      Step 2 — confirm Library _blocks exports the defining type.
    </see>
    <see file="16_framework_base_types.md" relation="TaskStep">
      Step 3 — review bootstrap order — framework BML before project content.
    </see>
    <see file="17_type_system_bml.md" relation="TaskStep">
      Step 4 — check type reference forms (FQN, QName, context-bound unqualified names).
    </see>
    <see block="doc:BootstrapModel" relation="TaskStep">
      Step 5 — confirm TypeRegistry bootstrap loaded dependencies before this document.
    </see>
  </references>

</block>
