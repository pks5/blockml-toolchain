<!--
  BlockML Core — fix type identity task

  FQN: org.blockml.bml.task.FixTypeIdentity
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:diag="org.blockml.bml.diagnostic"
  xmlns:doc="org.blockml.bml.documentation"
  xmlns:task="org.blockml.bml.task">

  <name>FixTypeIdentity</name>
  <type>task:FixTypeIdentity</type>
  <baseType>core:TaskGuide</baseType>
  <is>A how-to for fixing type identity errors</is>

  <summary>Resolve root/Sub-Block/embedded identity mismatches, ambiguous or unqualified references,
    and definition-role errors.</summary>

  <keywords>type identity, Sub-Block, embedded, BML_SUBBLOCK_TYPE_MISMATCH, BML_AMBIGUOUS_TYPE</keywords>

  <documentation>
    Procedure when type identity or reference resolution fails:
    1. Classify the Block role — root, Sub-Block, or embedded virtual file.
    2. Root — require type; optional name must equal lastSegment(resolve(type)).
    3. Sub-Block — require name; omit type or match parentType + "." + name from the immediate
       enclosing block; never declare embeddedBlocks.
    4. Embedded — require fully qualified type; FQN is not nested under the root; no nested embeds.
    5. Unqualified names — use nested resolution (innermost first) or context-bound implicit
       namespace; grandchildren need a relative path; otherwise qualify with xmlns/FQN.
    6. Ambiguous short Sub-Block names that match the root — rename or use qualified references.
  </documentation>

  <references>
    <see type="doc:TypeIdentityDerivation" relation="TaskStep">
      Step 1 — four reference forms and canonical derivation summary.
    </see>
    <see type="doc:SubBlockModel" relation="TaskStep">
      Step 2 — Sub-Block vs Embedded vs Root rules.
    </see>
    <see type="doc:ImplicitNamespaceResolution" relation="TaskStep">
      Step 3 — context-bound unqualified sites.
    </see>
    <see type="doc:BlockNameConvention" relation="TaskStep">
      Step 4 — PascalCase name format.
    </see>
    <see type="diag:BML_SUBBLOCK_TYPE_MISMATCH" relation="SeeAlso">
      Example Sub-Block identity diagnostic.
    </see>
    <see type="diag:BML_AMBIGUOUS_TYPE" relation="SeeAlso">
      Ambiguous unqualified type name.
    </see>
    <see type="task:DebugUnknownType" relation="SeeAlso">
      Related task when the type is simply not registered.
    </see>
  </references>

</block>
