<!--
  BlockML Definition — root Block definition type

  FQN: org.blockml.definition.BlockDefinition
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>Structure of a block.</idea>

  <documentation>Describes the structure of a block.</documentation>
  <name>BlockDefinition</name>
  <type>def:BlockDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>block</bml:xml>

  <properties>
    <name type="String">
      <documentation>The name of the block.</documentation>
    </name>
    <type type="core:FullyQualifiedName(core:Block)">
      <documentation>The full qualified name of the block.</documentation>
    </type>
    <baseType type="core:FullyQualifiedName(core:Block)">
      <documentation>The base type of the block.</documentation>
    </baseType>
    <abstract type="Boolean">
      <value>false</value>
      <documentation>Whether the block is abstract.</documentation>
    </abstract>
    <final type="Boolean">
      <value>false</value>
      <documentation>Whether the block is final.</documentation>
    </final>
  </properties>
  <aggregations>
    <genericTypes type="def:GenericTypeDefinition[]">

    </genericTypes>
    <languages type="core:Language[]">

    </languages>
    <subTypes type="core:Block[]">

    </subTypes>
    <contracts type="def:ContractDefinition[]">

    </contracts>
    <properties type="def:PropertyDefinition[]">

    </properties>
    <aggregations type="def:AggregationDefinition[]">

    </aggregations>
    <associations type="def:AssociationDefinition[]">

    </associations>
    <subBlocks type="def:BlockDefinition[]">

    </subBlocks>
  </aggregations>
</block>