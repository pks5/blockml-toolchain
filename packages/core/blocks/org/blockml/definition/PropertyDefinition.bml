<!--
  BlockML Definition — property definition type

  FQN: org.blockml.definition.PropertyDefinition
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea></idea>

  <documentation>Defines a property of a block.</documentation>
  <name>PropertyDefinition</name>
  <type>def:PropertyDefinition</type>
  <baseType>core:Definition</baseType>

</block>