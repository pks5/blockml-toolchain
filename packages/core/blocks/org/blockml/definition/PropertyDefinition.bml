<!--
  BlockML Definition — property member meta-model type

  FQN: org.blockml.definition.PropertyDefinition
  See docs/12_bom_object_model.md — PropertyDefinition · 02_mbml.md — Members.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:btype="org.blockml.type"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A typed value member on a Block definition.</idea>

  <documentation>Describes a Block member that carries a scalar or structured value. Rendered as a
    child element inside the properties container; the XML element name is the property name
    (bml:xml="${ #this.name }"). Maps to BOM PropertyDefinition (kind: "property") with typeFqn, value,
    valueRequired, and optional constraints and suggestions. Property type must resolve to a
    ValueType branch. Every Property behaves as Optional — it has a value or has no value; there
    is no null. Declaration order among properties is significant for StructType positional mapping
    and Capability parameter order.</documentation>

  <references>
    <see file="12_bom_object_model.md">
      PropertyDefinition BOM structure.
    </see>
    <see file="02_mbml.md">
      Members and properties authoring rules.
    </see>
    <see block="org.blockml.core.ValueType">
      Required branch for property payload types.
    </see>
  </references>

  <name>PropertyDefinition</name>
  <type>def:PropertyDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>${ #this.name }</bml:xml>

  <properties>
    <!-- Without bml:xml, type renders as an XML attribute on the property element. -->
    <type type="btype:FullyQualifiedName(core:Block)">
      <documentation>FQN of the property's ValueType. Non-ValueType FQNs are invalid here
        (BML_INVALID_PROPERTY_TYPE). Multiplicity, unions, and generic applications are expressed
        in the type attribute string as TypeExpressions.</documentation>
    </type>
    <!-- Rendered as <value> element or inline attribute depending on bml:xml placement. -->
    <value type="Text" bml:xml="element|attribute">
      <documentation>Default or computed member value on the Block definition. On instances, the
        same member is set directly without a value wrapper element. May be a literal or a
        ${ … } expression. Absent value means Optional.empty — not null.</documentation>
    </value>
    <valueRequired type="Boolean" bml:xml="attribute">
      <documentation>When true, the Property must contain a value in BlockML — otherwise the
        Validator reports an error. When false, the Property may remain empty; the Renderer decides
        how to interpret missing values (compile error, Optional.empty(), undefined, omit, …).</documentation>
    </valueRequired>
  </properties>
</block>
