<!--
  BlockML Definition — capability member meta-model type

  FQN: org.blockml.definition.CapabilityDefinition
  See docs/12_bom_object_model.md — CapabilityDefinition · 02_mbml.md — Capabilities.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A communication endpoint on a Block — inbound, outbound, or transformation.</idea>

  <documentation>Describes a Block member defining how the Block communicates. Rendered as a child
    element inside the capabilities container; the XML element name is the capability name
    (bml:xml="${ #this.name }"). Maps to BOM CapabilityDefinition (kind: "capability") with typeFqn,
    inputType, outputType, and optional implementation binding to a Language Block. Inbound requires
    inputType; Outbound requires outputType; Transformation requires both. inputType and outputType
    use TypeExpression syntax and must resolve to ValueTypes.</documentation>

  <references>
    <see file="12_bom_object_model.md">
      CapabilityDefinition BOM structure.
    </see>
    <see file="02_mbml.md">
      Capabilities authoring rules.
    </see>
    <see block="org.blockml.capability.Inbound">
      Capability typeFqn — requires inputType.
    </see>
    <see block="org.blockml.capability.Outbound">
      Capability typeFqn — requires outputType.
    </see>
    <see block="org.blockml.capability.Transformation">
      Capability typeFqn — requires inputType and outputType.
    </see>
    <see block="org.blockml.core.Language">
      Implementation language bindings.
    </see>
    <see block="org.blockml.core.ValueType">
      inputType and outputType payload types.
    </see>
  </references>

  <name>CapabilityDefinition</name>
  <type>def:CapabilityDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>${ #this.name }</bml:xml>

</block>
