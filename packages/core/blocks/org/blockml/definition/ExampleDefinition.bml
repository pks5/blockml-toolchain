<!--
  BlockML Definition — example definition type

  FQN: org.blockml.definition.ExampleDefinition
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea></idea>

  <documentation>Defines a property of a block.</documentation>
  <name>ExampleDefinition</name> 
  <type>def:ExampleDefinition</type>
  <baseType>core:Definition</baseType>

  <!-- Example definitions are rendered as xml <example> elements. -->
  <bml:xml>example</bml:xml>

  <properties>
    <!--
      bml:xml="attribute" renders this Property as an XML attribute
      of the containing Block element.
    -->
    <title type="String" bml:xml="attribute">
      <documentation>The title of the example.</documentation>
    </title>
    <!--
      bml:xml="text|cdata" renders the Property as character content.
      The XML renderer may use plain text or CDATA depending on the value.
    -->
    <text type="String" bml:xml="text|cdata">
      <documentation>The text of the example.</documentation>
    </text>
  </properties>
</block>