<!--
  BlockML Definition — generic type parameter meta-model type

  FQN: org.blockml.definition.GenericTypeDefinition
  See docs/16_framework_base_types.md — genericTypes · 12_bom_object_model.md — GenericType.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:btype="org.blockml.type"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A type parameter declared on a Block definition (e.g. T on Box of T).</idea>

  <documentation>Declares one generic type parameter on a root Block definition. Rendered as
    genericType inside the genericTypes container (root block only). Maps to BOM GenericType
    { name, baseType }. The name is substituted in type references within this Block (e.g.
    type="T" → GenericParameterReference). baseType is the FQN constraint — each concrete type
    argument at reference sites must inherit from that branch (BML_GENERIC_CONSTRAINT_VIOLATION on
    mismatch). Parameter name must differ from the Block name and every Sub-Block name.
    See 16_framework_base_types.md — genericTypes · 17_type_system_bml.md — Generics.</documentation>
  <name>GenericTypeDefinition</name>
  <type>def:GenericTypeDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>genericType</bml:xml>

  <properties>
    <name type="String">
      <documentation>Parameter identifier used in type references within this Block (e.g. T).
        Must not collide with the Block name or any Sub-Block name in the same document.</documentation>
    </name>
    <baseType type="btype:FullyQualifiedName(def:BlockDefinition)">
      <documentation>FQN constraint for concrete type arguments. Each supplied type argument at
        reference sites (e.g. Box of Integer) must inherit from this baseType branch.</documentation>
    </baseType>
  </properties>
</block>
