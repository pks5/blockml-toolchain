<!--
  BlockML Definition — cross-reference meta-model type

  FQN: org.blockml.definition.ReferenceDefinition
  Declared on org.blockml.core.Definition as the references aggregation.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:btype="org.blockml.type"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A cross-reference to a related Block or definition element.</idea>

  <documentation>Records a link from documentation metadata to another Block or definition element.
    Rendered as a reference element inside the references container on any
    org.blockml.core.Definition (alongside changelog and examples). Keeps API documentation,
    version history, examples, and related-type links at the definition site — single source of
    truth inside BML files. See 02_mbml.md — Documentation extensions ·
    16_framework_base_types.md — Definition Branch.</documentation>
  <name>ReferenceDefinition</name>
  <type>def:ReferenceDefinition</type>
  <baseType>core:Definition</baseType>
  <!-- Cross-references render as <reference> elements inside <references>. -->
  <bml:xml>reference</bml:xml>

  <properties>
    <type type="btype:FullyQualifiedName(core:Block, core:Definition)">
      <documentation>FQN of the Block or Definition being referenced. Rendered as the type
        attribute on the reference element.</documentation>
    </type>
    <!-- Optional context renders as text content of the <reference> element. -->
    <context type="String" bml:xml="text">
      <documentation>Optional human-readable explanation of why or how the referenced element
        relates to this definition. Rendered as character content of the reference element.</documentation>
    </context>
  </properties>
</block>
