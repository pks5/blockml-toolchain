<!--
  BlockML Definition — association member meta-model type

  FQN: org.blockml.definition.AssociationDefinition
  See docs/12_bom_object_model.md — AssociationDefinition · 02_mbml.md — Associations.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A loose reference member without composition ownership.</idea>

  <documentation>Describes a Block member for non-owning references to other Blocks — semantically
    loose links without lifecycle ownership (WOT: Associations). Rendered as a child element inside
    the associations container; the XML element name is the association name (bml:xml="${ #this.name }").
    Maps to BOM AssociationDefinition (kind: "association") with typeFqn and cardinality 0..1 or
    0..n. Any Block FQN is valid as association type. Domain examples include basePresets on
    MachineBlocks Block types. See 12_bom_object_model.md — AssociationDefinition ·
    02_mbml.md — Associations.</documentation>

  <name>AssociationDefinition</name>
  <type>def:AssociationDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>${ #this.name }</bml:xml>
</block>
