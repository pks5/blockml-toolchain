<!--
  BlockML Definition — contract reference meta-model type

  FQN: org.blockml.definition.ContractDefinition
  See docs/02_mbml.md — Contracts · 12_bom_object_model.md — Contract Merge.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:btype="org.blockml.type"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>A reusable partial Block definition merged into the declaring Block.</idea>

  <documentation>References a contract Block whose member fragments are merged into the declaring
    Block after the baseType chain and before the Block's own declarations. Contracts replace
    interfaces, traits, and mixins — reusable partial definitions that may supply incomplete
    members the Block completes or overrides. Scope: Properties, Aggregations, Associations,
    Capabilities, Constraints, Suggestions, documentation, examples, and optional default
    Capability implementations. Ignored on contract Blocks: subBlocks and compositions (no
    transitive contract merge). Merge order: baseType chain → contracts (declaration order,
    later wins) → Block local declarations (override all). Root block only.</documentation>

  <references>
    <see file="02_mbml.md">
      Contracts authoring rules.
    </see>
    <see file="12_bom_object_model.md">
      Contract merge semantics.
    </see>
  </references>

  <name>ContractDefinition</name>
  <type>def:ContractDefinition</type>
  <baseType>core:Definition</baseType>
  <bml:xml>contract</bml:xml>

  <properties>
    <type type="btype:FullyQualifiedName(core:Block)">
      <documentation>FQN of the contract Block whose partial definition is merged into this Block.
        Required on every contract reference in the contracts container (root block only).</documentation>
    </type>
  </properties>
</block>
