<!--
  BlockML Definition — changelog entry meta-model type

  FQN: org.blockml.definition.ChangeDefinition
  See docs/02_mbml.md — Documentation extensions · changelog · 12_bom_object_model.md — ChangelogEntry.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:core="org.blockml.core"
  xmlns:def="org.blockml.definition"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea>One version history entry for a definition element.</idea>

  <documentation>Describes a single changelog entry in a changelog container on any definition
    element (block, property, aggregation, …). Rendered as a change element with a required
    version attribute and a trimmed text body describing what changed. Maps to BOM
    ChangelogEntry { version, text }. Entries must be ordered chronologically by version —
    oldest first (BML_CHANGELOG_VERSION_ORDER when out of order).</documentation>

  <references>
    <see file="02_mbml.md">
      Changelog documentation extension authoring.
    </see>
    <see file="12_bom_object_model.md">
      ChangelogEntry BOM structure.
    </see>
  </references>

  <name>ChangeDefinition</name> 
  <type>def:ChangeDefinition</type>
  <baseType>core:Definition</baseType>

  <!-- Changelog entries render as <change> elements inside <changelog>. -->
  <bml:xml>change</bml:xml>

  <properties>
    <!-- bml:xml="attribute" renders version as an XML attribute on <change>. -->
    <version type="btype:Version" bml:xml="attribute">
      <documentation>Semantic version this change applies to. Required attribute on every change
        entry.</documentation>
    </version>
    <!-- bml:xml="text" renders the description as character content of <change>. -->
    <description type="Text" bml:xml="text">
      <documentation>Human-readable description of what changed at this version. Stored as trimmed
        text body in BOM ChangelogEntry.text.</documentation>
    </description>
  </properties>
</block>
