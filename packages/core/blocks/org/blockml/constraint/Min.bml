<!--
  BlockML Core — minimum value constraint

  FQN: org.blockml.constraint.Min
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:constraint="org.blockml.constraint"
  xmlns:core="org.blockml.core"
  xmlns:btype="org.blockml.type">

  <idea>Lower bound for a numeric property value.</idea>

  <documentation>Scalar constraint: T binds to the property type. Compatible with Integer, Float,
    and Decimal properties. The value property must match T.</documentation>
  <name>Min</name>
  <type>constraint:Min</type>
  <baseType>core:Constraint</baseType>
  <genericTypes>
    <genericType name="T" baseType="btype:Number"/>
  </genericTypes>

  <properties>
    <value type="T">
      <documentation>Minimum allowed value (inclusive).</documentation>
    </value>
  </properties>

</block>
