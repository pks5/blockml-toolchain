<!--
  BlockML Core — maximum items constraint

  FQN: org.blockml.constraint.MaxItems
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:btype="org.blockml.type"
  xmlns:constraint="org.blockml.constraint"
  xmlns:core="org.blockml.core">

  <idea>Maximum number of elements in a collection property.</idea>

  <documentation>T binds to the property collection type (e.g. String[]). The value property is Integer — the maximum item count.</documentation>
  <name>MaxItems</name>
  <type>constraint:MaxItems</type>
  <baseType>core:Constraint</baseType>
  <genericTypes>
    <genericType name="T" baseType="core:ValueType"/>
  </genericTypes>

  <properties>
    <value type="Integer">
      <documentation>Maximum number of items (inclusive).</documentation>
    </value>
  </properties>

</block>
