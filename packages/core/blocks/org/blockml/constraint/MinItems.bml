<!--
  BlockML Core — minimum items constraint

  FQN: org.blockml.constraint.MinItems
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:btype="org.blockml.type"
  xmlns:constraint="org.blockml.constraint"
  xmlns:core="org.blockml.core">

  <idea>Minimum number of elements in a collection property.</idea>

  <documentation>T binds to the property collection type (e.g. String[]). The value property is Integer — the minimum item count.</documentation>

  <name>MinItems</name>
  <type>constraint:MinItems</type>
  <baseType>core:Constraint</baseType>
  <version>1.0.0</version>

  <genericTypes>
    <genericType name="T" baseType="core:ValueType"/>
  </genericTypes>

  <properties>
    <value type="Integer">
      <documentation>Minimum number of items (inclusive).</documentation>
    </value>
  </properties>

</block>
