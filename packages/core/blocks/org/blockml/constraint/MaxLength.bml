<!--
  BlockML Core — maximum length constraint

  FQN: org.blockml.constraint.MaxLength
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  "
  xmlns:btype="org.blockml.type"
  xmlns:constraint="org.blockml.constraint"
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">Maximum length for a string or collection element.</idea>

  <documentation bml:status="status:Stable">T binds to the property type for scalar String properties, or to the element type when the property is a collection (e.g. String[]). The value property is always Integer — the maximum length threshold.</documentation>

  <status>status:Stable</status>
  <name>MaxLength</name>
  <type>constraint:MaxLength</type>
  <baseType>core:Constraint</baseType>
  <version>1.0.0</version>

  <genericTypes>
    <genericType name="T" baseType="core:ValueType"/>
  </genericTypes>

  <properties>
    <value type="Integer">
      <documentation bml:status="status:Stable">Maximum length (inclusive).</documentation>
    </value>
  </properties>

</block>
