<!--
  BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.core.Capability
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <idea>Representation of an Transformation capability.</idea>

  <documentation>Transformation capability.</documentation>

  <name>Transformation</name>
  <type>org.blockml.capability.Transformation</type>
  <baseType>org.blockml.core.Capability</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <properties>
    <hasInput >
      <value>true</value>
    </hasInput>
    <hasOutput >
      <value>true</value>
    </hasOutput>
  </properties>


</block>
