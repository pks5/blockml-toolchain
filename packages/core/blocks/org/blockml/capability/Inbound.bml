<!--
  BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.core.Capability
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:cap="org.blockml.capability"
  xmlns:core="org.blockml.core">

  <idea>Representation of an Inbound capability.</idea>

  <documentation>Inbound capability.</documentation>

  <name>Inbound</name>
  <type>cap:Inbound</type>
  <baseType>core:CapabilityType</baseType>
  <version>1.0.0</version>

  <abstract />

  <properties>
    <hasInput>
      <value>true</value>
    </hasInput>
  </properties>
</block>