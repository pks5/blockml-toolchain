<!--
  BlockML Core — capbility type branch (capability implementation contract)

  FQN: org.blockml.core.Capability
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      "
  xmlns:cap="org.blockml.capability"
  xmlns:core="org.blockml.core"
  xmlns:status="org.blockml.status"
  xmlns:bml="http://blockml.org/schema/bml">

  <idea bml:status="status:Stable">Representation of an Outbound capability.</idea>

  <documentation bml:status="status:Stable">Outbound capability.</documentation>

  <status>status:Stable</status>
  <name>Outbound</name>
  <type>cap:Outbound</type>
  <baseType>core:CapabilityType</baseType>
  <version>1.0.0</version>

  <properties>
    <hasOutput>
      <value>true</value>
    </hasOutput>
  </properties>
</block>