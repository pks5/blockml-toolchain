<!--
  BlockML Core Services — FunctionBlock base (Sync Capability implementations)

  FQN: org.blockml.service.FunctionBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Abstract base for FunctionBlocks — ServiceBlocks whose Sync Capabilities may carry TypeScript or OpenSCAD implementations. Used for #math, #strings, and similar expression utilities.</documentation>

  <name>FunctionBlock</name>
  <type>org.blockml.service.FunctionBlock</type>
  <baseType>org.blockml.service.ServiceBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <implTypes>
    <implType type="org.blockml.language.OpenSCAD" />
    <implType type="org.blockml.language.TypeScript" />
  </implTypes>

</block>
