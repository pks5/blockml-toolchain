<!--
  BlockML Core Services

  Name: Strings Service
  Filename: Strings.bml
  FQN: org.blockml.service.Strings
  Expression prefix: #strings.*
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <idea>Built-in text utilities callable as #strings in expressions.</idea>

  <documentation>Built-in strings FunctionBlock. Expression prefix #strings.* — concat, length, substring, and related text utilities.</documentation>

  <name>Strings</name>
  <type>org.blockml.service.Strings</type>
  <baseType>org.blockml.core.FunctionBlock</baseType>
  <version>1.0.0</version>

  <capabilities>

    <!-- #strings.trim(s) -->
    <capability name="trim"
                type="org.blockml.capability.Sync"
                payloadType="org.blockml.type.String"
                returnType="org.blockml.type.String">
      <documentation>
        Removes leading and trailing whitespace from s.
        Examples:
          #strings.trim('  hello  ')  → "hello"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string): string => s.trim()
      ]]></implementation>
    </capability>

    <!-- #strings.toUpperCase(s) -->
    <capability name="toUpperCase"
                type="org.blockml.capability.Sync"
                payloadType="org.blockml.type.String"
                returnType="org.blockml.type.String">
      <documentation>
        Converts s to uppercase.
        Examples:
          #strings.toUpperCase('abc')  → "ABC"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string): string => s.toUpperCase()
      ]]></implementation>
    </capability>

    <!-- #strings.toLowerCase(s) -->
    <capability name="toLowerCase"
                type="org.blockml.capability.Sync"
                payloadType="org.blockml.type.String"
                returnType="org.blockml.type.String">
      <documentation>
        Converts s to lowercase.
        Examples:
          #strings.toLowerCase('ABC')  → "abc"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string): string => s.toLowerCase()
      ]]></implementation>
    </capability>

    <!-- #strings.concat(a, b, ...) -->
    <capability name="concat"
                type="org.blockml.capability.Sync"
                payloadType="Array<String>"
                returnType="org.blockml.type.String">
      <documentation>
        Concatenates all string arguments.
        Examples:
          #strings.concat('a', 'b', 'c')  → "abc"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (...parts: string[]): string => parts.join('')
      ]]></implementation>
    </capability>

    <!-- #strings.length(s) -->
    <capability name="length"
                type="org.blockml.capability.Sync"
                payloadType="org.blockml.type.String"
                returnType="org.blockml.type.Integer">
      <documentation>
        Returns the length of s.
        Examples:
          #strings.length('hello')  → 5
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string): number => s.length
      ]]></implementation>
    </capability>

    <!-- #strings.contains(s, fragment) -->
    <capability name="contains"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, fragment: String }"
                returnType="org.blockml.type.Boolean">
      <documentation>
        Returns true if s contains fragment.
        Examples:
          #strings.contains('hello', 'ell')  → true
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, fragment: string): boolean => s.includes(fragment)
      ]]></implementation>
    </capability>

    <!-- #strings.startsWith(s, prefix) -->
    <capability name="startsWith"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, prefix: String }"
                returnType="org.blockml.type.Boolean">
      <documentation>
        Returns true if s starts with prefix.
        Examples:
          #strings.startsWith('hello', 'he')  → true
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, prefix: string): boolean => s.startsWith(prefix)
      ]]></implementation>
    </capability>

    <!-- #strings.endsWith(s, suffix) -->
    <capability name="endsWith"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, suffix: String }"
                returnType="org.blockml.type.Boolean">
      <documentation>
        Returns true if s ends with suffix.
        Examples:
          #strings.endsWith('hello', 'lo')  → true
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, suffix: string): boolean => s.endsWith(suffix)
      ]]></implementation>
    </capability>

    <!-- #strings.indexOf(s, fragment) -->
    <capability name="indexOf"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, fragment: String }"
                returnType="org.blockml.type.Integer">
      <documentation>
        Returns the index of fragment in s, or -1 if not found.
        Examples:
          #strings.indexOf('hello', 'll')  → 2
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, fragment: string): number => s.indexOf(fragment)
      ]]></implementation>
    </capability>

    <!-- #strings.substring(s, start, end) -->
    <capability name="substring"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, start: Integer, end: Integer }"
                returnType="org.blockml.type.String">
      <documentation>
        Returns the substring of s from start (inclusive) to end (exclusive).
        Examples:
          #strings.substring('hello', 1, 4)  → "ell"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, start: number, end: number): string => s.substring(start, end)
      ]]></implementation>
    </capability>

    <!-- #strings.replace(s, target, replacement) -->
    <capability name="replace"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, target: String, replacement: String }"
                returnType="org.blockml.type.String">
      <documentation>
        Replaces the first occurrence of target in s with replacement.
        Examples:
          #strings.replace('a-b-c', '-', '_')  → "a_b-c"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, target: string, replacement: string): string =>
            s.replace(target, replacement)
      ]]></implementation>
    </capability>

    <!-- #strings.replaceAll(s, target, replacement) -->
    <capability name="replaceAll"
                type="org.blockml.capability.Sync"
                payloadType="{ s: String, target: String, replacement: String }"
                returnType="org.blockml.type.String">
      <documentation>
        Replaces all occurrences of target in s with replacement.
        Examples:
          #strings.replaceAll('a-b-c', '-', '_')  → "a_b_c"
      </documentation>
      <implementation type="org.blockml.language.TypeScript"><![CDATA[
        (s: string, target: string, replacement: string): string =>
            s.split(target).join(replacement)
      ]]></implementation>
    </capability>

  </capabilities>

</block>
