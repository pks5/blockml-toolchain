<!--
  BlockML Core Services — abstract ServiceBlock base

  FQN: org.blockml.service.ServiceBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <name>ServiceBlock</name>
  <fullQualifiedName>org.blockml.service.ServiceBlock</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <allowedSubBlockTypes />

</block>
