<block xmlns="http://blockml.org/schema/block" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd">

  <documentation>BOM Core primitive TypeBlock for true/false values. Unqualified name Boolean resolves to org.blockml.type.Boolean.</documentation>

  <name>Boolean</name>
  <type>org.blockml.type.Boolean</type>
  <baseType>org.blockml.core.PrimitiveType</baseType>
  <version>1.0.0</version>
  <abstract>true</abstract>
</block>
