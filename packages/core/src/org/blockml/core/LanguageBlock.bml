<!--
  BlockML Core — language Block branch (capability implementation contract)

  FQN: org.blockml.core.LanguageBlock
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>LanguageBlock branch of BlockML. Declares an implementation language permitted on Sync Capability implementations (OpenSCAD, TypeScript, …).</documentation>

  <name>LanguageBlock</name>
  <fullQualifiedName>org.blockml.core.LanguageBlock</fullQualifiedName>
  <baseType>org.blockml.core.Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

</block>
