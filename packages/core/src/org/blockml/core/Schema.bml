<!--
  BlockML Core — library XSD schema entry (optional; types may live in BML instead)

  FQN: org.blockml.core.Schema
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Optional XSD schema file exported by a Library — legacy type/enum definitions. May be omitted when all types are StructType/EnumType BML; a future tool can generate XSD from Library type blocks instead.</documentation>

  <name>Schema</name>
  <fullQualifiedName>org.blockml.core.Schema</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <allowedSubBlockTypes />

  <properties>
    <property name="ref" type="String">
      <documentation>Path to the .xsd file relative to the library package root.</documentation>
    </property>
  </properties>

</block>
