<!--
  BlockML Core — exported PresetCollection reference in a Library

  FQN: org.blockml.core.PresetsRef
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Reference to a PresetCollection block file exported by this Library — path relative to library root.</documentation>

  <name>PresetsRef</name>
  <fullQualifiedName>org.blockml.core.PresetsRef</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <allowedSubBlockTypes />

  <properties>
    <property name="ref" type="String">
      <documentation>Path to the PresetCollection .bml / .mbml file relative to the library package root.</documentation>
    </property>
  </properties>

</block>
