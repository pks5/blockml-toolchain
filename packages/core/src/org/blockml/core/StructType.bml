<!--
  BlockML Core — struct type branch (product types)

  FQN: org.blockml.core.StructType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Abstract branch for struct TypeBlocks — complex values described by normal Properties. No special struct syntax.</documentation>

  <name>StructType</name>
  <type>org.blockml.core.StructType</type>
  <baseType>org.blockml.core.TypeBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

</block>
