<!--
  BlockML Core — exported block definition reference in a Library

  FQN: org.blockml.core.BlockRef
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Reference to a Block definition file exported by this Library — path relative to library root.</documentation>

  <name>BlockRef</name>
  <fullQualifiedName>org.blockml.core.BlockRef</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <allowedSubBlockTypes />

  <properties>
    <property name="ref" type="String">
      <documentation>Path to the block .bml / .mbml file relative to the library package root.</documentation>
    </property>
  </properties>

</block>
