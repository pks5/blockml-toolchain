<!--
  BlockML Core — enum type branch (closed value sets)

  FQN: org.blockml.core.EnumType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Abstract branch for closed enum TypeBlocks with a fixed set of named values (e.g. Direction, Face).</documentation>

  <name>EnumType</name>
  <fullQualifiedName>org.blockml.core.EnumType</fullQualifiedName>
  <baseType>org.blockml.core.TypeBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

</block>
