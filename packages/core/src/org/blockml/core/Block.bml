<!--
  BlockML Core — root Block type

  FQN: org.blockml.core.Block
  Sole inheritance root — omits baseType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Root semantic unit of BlockML. Sole inheritance root for all Block definitions — composable blocks, TypeBlocks, LanguageBlocks, ServiceBlocks, and domain types. Every Block instance carries the meta property id (not declared). Any Block FQN may appear in aggregation and association types. Property and Capability types must resolve to org.blockml.core.TypeBlock.</documentation>

  <name>Block</name>
  <fullQualifiedName>org.blockml.core.Block</fullQualifiedName>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <aggregations>
    <aggregation name="customData"
                 type="org.blockml.core.CustomData[]" />
  </aggregations>

</block>
