<!--
  BlockML Core — generic type branch (parameterized types)

  FQN: org.blockml.core.GenericType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Abstract branch for generic TypeBlocks. Declares type parameters via generics; concrete use via type arguments (e.g. Box&lt;Integer&gt;).</documentation>

  <name>GenericType</name>
  <type>org.blockml.core.GenericType</type>
  <baseType>org.blockml.core.TypeBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

</block>
