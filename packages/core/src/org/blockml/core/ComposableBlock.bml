<!--
  BlockML Core — composable Block branch

  FQN: org.blockml.core.ComposableBlock
  Walls, Bricks, ServiceBlocks, Sets — composition · capabilities · instance id
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <name>ComposableBlock</name>
  <fullQualifiedName>org.blockml.core.ComposableBlock</fullQualifiedName>
  <baseType>org.blockml.core.Block</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <properties>
    <property name="id" type="String">
      <documentation>Composition instance identity (partId). Required when referenced or in bml:each.</documentation>
    </property>
  </properties>

  <aggregations>
    <aggregation name="customData"
                 cardinality="0..n"
                 type="org.blockml.core.CustomData"
                 visibility="hidden" />
  </aggregations>

</block>
