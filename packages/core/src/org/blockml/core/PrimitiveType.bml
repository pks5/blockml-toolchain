<!--
  BlockML Core — primitive type branch

  FQN: org.blockml.core.PrimitiveType
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <idea>Branch for scalar value types — single atomic values.</idea>

  <documentation>Abstract branch for built-in scalar TypeBlocks (Integer, Float, String, Boolean, Null).</documentation>

  <name>PrimitiveType</name>
  <type>org.blockml.core.PrimitiveType</type>
  <baseType>org.blockml.core.TypeBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <properties>
    <property name="value" type="_self">
      <documentation>The value of the primitive.</documentation>
    </property>
  </properties>
</block>
