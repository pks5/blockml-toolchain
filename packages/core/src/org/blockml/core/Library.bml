<!--
  BlockML Core — library descriptor (blocks, types, presets, dependencies)

  FQN: org.blockml.core.Library

  Entry types (Dependency, Schema, TypeRef, BlockRef, PresetsRef) are Sub-Blocks
  of Library — not separate framework files. Any block with baseType Library
  resolves them by short name in compositions.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Publishable library unit — groups exported Block definitions, PresetCollections, optional XSD schemas, and dependencies on other libraries. Replaces the legacy library.xml descriptor.</documentation>

  <name>Library</name>
  <fullQualifiedName>org.blockml.core.Library</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <allowedSubBlockTypes />

  <properties>
    <property name="description" type="String">
      <documentation>Human-readable summary of what this library provides.</documentation>
    </property>
  </properties>

  <aggregations>
    <aggregation name="_dependencies"
                 cardinality="0..n"
                 type="org.blockml.core.Library.Dependency"
                 visibility="hidden" />
    <aggregation name="_schemas"
                 cardinality="0..n"
                 type="org.blockml.core.Library.Schema"
                 visibility="hidden" />
    <aggregation name="_types"
                 cardinality="0..n"
                 type="org.blockml.core.Library.TypeRef"
                 visibility="hidden" />
    <aggregation name="_blocks"
                 cardinality="0..n"
                 type="org.blockml.core.Library.BlockRef"
                 visibility="hidden" />
    <aggregation name="_presets"
                 cardinality="0..n"
                 type="org.blockml.core.Library.PresetsRef"
                 visibility="hidden" />
  </aggregations>

  <subBlocks>

    <block>
      <documentation>Dependency on another Library — pins required library FQN and exact semantic version.</documentation>
      <name>Dependency</name>
      <baseType>org.blockml.core.ComposableBlock</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <allowedSubBlockTypes />
      <properties>
        <property name="ref" type="String">
          <documentation>FQN of the required Library (e.g. com.machineblocks.core.CoreLibrary).</documentation>
        </property>
        <property name="version" type="String">
          <documentation>Exact semantic version required — no implicit latest.</documentation>
        </property>
      </properties>
    </block>

    <block>
      <documentation>Optional XSD schema file exported by a Library — legacy type/enum definitions.</documentation>
      <name>Schema</name>
      <baseType>org.blockml.core.ComposableBlock</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <allowedSubBlockTypes />
      <properties>
        <property name="ref" type="String">
          <documentation>Path to the .xsd file relative to the library package root.</documentation>
        </property>
      </properties>
    </block>

    <block>
      <documentation>Reference to a TypeBlock definition file (StructType, EnumType, …) exported by this Library.</documentation>
      <name>TypeRef</name>
      <baseType>org.blockml.core.ComposableBlock</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <allowedSubBlockTypes />
      <properties>
        <property name="ref" type="String">
          <documentation>Path to the type .bml / .mbml file relative to the library package root.</documentation>
        </property>
      </properties>
    </block>

    <block>
      <documentation>Reference to a Block definition file exported by this Library.</documentation>
      <name>BlockRef</name>
      <baseType>org.blockml.core.ComposableBlock</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <allowedSubBlockTypes />
      <properties>
        <property name="ref" type="String">
          <documentation>Path to the block .bml / .mbml file relative to the library package root.</documentation>
        </property>
      </properties>
    </block>

    <block>
      <documentation>Reference to a PresetCollection block file exported by this Library.</documentation>
      <name>PresetsRef</name>
      <baseType>org.blockml.core.ComposableBlock</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <allowedSubBlockTypes />
      <properties>
        <property name="ref" type="String">
          <documentation>Path to the PresetCollection .bml / .mbml file relative to the library package root.</documentation>
        </property>
      </properties>
    </block>

  </subBlocks>

</block>
