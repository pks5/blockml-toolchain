<!--
  BlockML Core — collection of Preset instances

  FQN: org.blockml.core.PresetCollection

  Preset is a Sub-Block of PresetCollection. Aggregation uses type="Preset[]" —
  parser resolves against subBlocks[] in the same file.
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Block that groups named Preset instances in its composition. Each Preset may carry a block instance with property overrides and/or inherit from other presets via basePresets. Replaces the legacy blockPresets document type.</documentation>

  <name>PresetCollection</name>
  <fullQualifiedName>org.blockml.core.PresetCollection</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <abstract>true</abstract>

  <allowedSubBlockTypes />

  <aggregations>
    <aggregation name="_presets"
                 type="Preset[]"
                 default="true" />
  </aggregations>

  <subBlocks>

    <block>
      <documentation>Named property preset for a Block type. Carries optional block instance and optional basePresets association for inheritance.</documentation>
      <name>Preset</name>
      <baseType>org.blockml.core.ComposableBlock</baseType>
      <version>1.0.0</version>
      <final>true</final>
      <allowedSubBlockTypes />
      <properties>
        <property name="name" type="String">
          <documentation>Human-readable display name (SCAD Customizer, editor UI). The id property is the stable reference key.</documentation>
        </property>
      </properties>
      <aggregations>
        <aggregation name="block"
                     type="org.blockml.core.Block"
                     default="true" />
      </aggregations>
      <associations>
        <association name="basePresets"
                     type="Preset[]" />
      </associations>
    </block>

  </subBlocks>

</block>
