<!--
  BlockML Core — library dependency entry

  FQN: org.blockml.core.Dependency
-->
<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
  ">

  <documentation>Dependency on another Library — pins required library FQN and exact semantic version.</documentation>

  <name>Dependency</name>
  <fullQualifiedName>org.blockml.core.Dependency</fullQualifiedName>
  <baseType>org.blockml.core.ComposableBlock</baseType>
  <version>1.0.0</version>

  <final>true</final>

  <allowedSubBlockTypes />

  <properties>
    <property name="ref" type="String">
      <documentation>FQN of the required Library (e.g. com.machineblocks.core).</documentation>
    </property>
    <property name="version" type="String">
      <documentation>Exact semantic version required — no implicit latest.</documentation>
    </property>
  </properties>

</block>
