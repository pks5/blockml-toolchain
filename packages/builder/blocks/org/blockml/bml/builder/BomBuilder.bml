<!--Builder — BomBuilder
  FQN: org.blockml.bml.builder.BomBuilder-->
<builder:BomBuilder xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    builder:BuilderType
  </baseType>
  <is>
    Writable authoring session over a BOM draft
  </is>
  <documentation>
    Session created by Create or Edit. Mutations apply only to the draft.
    seal() returns an immutable BomDocument (Urmodell). Does not parse, serialize,
    validate, or write files. Does not use forkBom (resolve-only).
  </documentation>
  <references>
    <see type="buildercap:Create" relation="SeeAlso" />
    <see type="buildercap:Edit" relation="SeeAlso" />
    <see type="buildercap:Seal" relation="SeeAlso" />
    <see type="bomdoc:BomDocument" relation="SeeAlso" />
  </references>
</builder:BomBuilder>
