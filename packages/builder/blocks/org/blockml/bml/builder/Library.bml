<!--BlockML Builder Library Descriptor
  FQN: org.blockml.bml.builder.Library-->
<builder:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML Builder package library catalog
  </is>
  <version>
    0.9.4
  </version>
  <documentation>
    Canonical BomBuilder specification for BlockML — writable authoring session
    that create/edit/seal BomDocument graphs. TypeScript in packages/builder/src/
    implements this library. Membership is defined exclusively by this blocks list.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML Builder library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <builder:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
        <bom:Library />
        <framework:Library />
      </composition>
    </dependencies>
    <blocks override="true">
      <composition>
        <builder:BuilderType />
        <builder:BomBuilder />
        <builder:CreateBlockOptions />
        <builder:AddPropertyOptions />
        <builder:AddAggregationOptions />
        <buildercap:Create />
        <buildercap:Edit />
        <buildercap:Seal />
        <buildercap:QuerySelector />
        <buildercap:AddProperty />
        <buildercap:AddAggregation />
        <buildercap:AddCompositionChild />
        <buildercap:SetMemberValue />
        <buildercap:EnsureNamespaceBinding />
        <builderdocumentation:Introduction />
        <builderdocumentation:LayerSeparation />
        <builderdocumentation:ArchitectureOverview />
        <builderdocumentation:V1Scope />
        <builderdocumentation:PublicApi />
        <builderdocumentation:PackageOwnership />
        <builderdocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>
</builder:Library>
