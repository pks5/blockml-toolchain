<!--Builder Capability — AddCompositionChild
  FQN: org.blockml.bml.builder.capability.AddCompositionChild-->
<buildercap:AddCompositionChild xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Append a composition instance under a named aggregation
  </is>
  <documentation>
    Used to add a Library.blocks catalog export. Creates the composition
    wrapper when missing. Skips when typeFqn is already a child. Ensures xmlns
    for the child package.
  </documentation>
  <references>
    <see type="builder:BomBuilder" relation="SeeAlso" />
  </references>
  <properties>
    <aggregationName type="type:Text">
      <documentation>
        Target aggregation name, e.g. blocks. (required)
      </documentation>
    </aggregationName>
    <typeFqn type="type:Text">
      <documentation>
        Child block FQN. (required)
      </documentation>
    </typeFqn>
    <result type="builder:BomBuilder">
      <documentation>
        This session. (required)
      </documentation>
    </result>
  </properties>
</buildercap:AddCompositionChild>
