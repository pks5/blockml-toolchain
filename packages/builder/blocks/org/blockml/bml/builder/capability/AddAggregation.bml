<!--Builder Capability — AddAggregation
  FQN: org.blockml.bml.builder.capability.AddAggregation-->
<buildercap:AddAggregation xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Declare an aggregation on the draft block
  </is>
  <documentation>
    Appends an aggregation member with a named type expression.
    Duplicate names throw.
  </documentation>
  <references>
    <see type="builder:AddAggregationOptions" relation="SeeAlso" />
  </references>
  <properties>
    <options type="builder:AddAggregationOptions">
      <documentation>
        options (required).
      </documentation>
    </options>
    <result type="builder:BomBuilder">
      <documentation>
        This session. (required)
      </documentation>
    </result>
  </properties>
</buildercap:AddAggregation>
