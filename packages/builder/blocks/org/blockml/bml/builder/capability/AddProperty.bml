<!--Builder Capability — AddProperty
  FQN: org.blockml.bml.builder.capability.AddProperty-->
<buildercap:AddProperty xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Declare a property on the draft block
  </is>
  <documentation>
    Appends a property member. Ensures a namespace binding for typeFqn.
    Duplicate names throw.
  </documentation>
  <references>
    <see type="builder:AddPropertyOptions" relation="SeeAlso" />
  </references>
  <properties>
    <options type="builder:AddPropertyOptions">
      <documentation>
        options (required).
      </documentation>
    </options>
    <result type="builder:BomBuilder">
      <documentation>
        This session. (required)
      </documentation>
    </result>
  </properties>
</buildercap:AddProperty>
