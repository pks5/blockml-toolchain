<!--Builder Capability — SetMemberValue
  FQN: org.blockml.bml.builder.capability.SetMemberValue-->
<buildercap:SetMemberValue xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Set a literal value on a declared property
  </is>
  <documentation>
    Finds a property by name and sets its literal value. Throws when the
    member is missing or not a property.
  </documentation>
  <properties>
    <name type="type:Text">
      <documentation>
        Property name. (required)
      </documentation>
    </name>
    <value type="type:Text">
      <documentation>
        Literal value. (required)
      </documentation>
    </value>
    <result type="builder:BomBuilder">
      <documentation>
        This session. (required)
      </documentation>
    </result>
  </properties>
</buildercap:SetMemberValue>
