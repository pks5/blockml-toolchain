<!--Builder Capability — QuerySelector
  FQN: org.blockml.bml.builder.capability.QuerySelector-->
<buildercap:QuerySelector xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Find a declared member by section path
  </is>
  <documentation>
    <![CDATA[
    V1 selectors: properties.<name> and aggregations.<name>.
    Returns the member or undefined.
    ]]>
  </documentation>
  <references>
    <see type="builder:BomBuilder" relation="SeeAlso" />
  </references>
  <properties>
    <selector type="type:Text">
      <documentation>
        Member path. (required)
      </documentation>
    </selector>
    <result type="type:Text">
      <documentation>
        Found member name, or empty when missing. (optional)
      </documentation>
    </result>
  </properties>
</buildercap:QuerySelector>
