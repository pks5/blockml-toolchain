<!--Builder Capability — QuerySelector
  FQN: org.blockml.bml.builder.capability.QuerySelector-->
<buildercap:QuerySelector xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Find a declared member by section path
  </is>
  <documentation>
    <![CDATA[
    V1 selectors: properties.<name> and aggregations.<name>.
    Returns the member or undefined.
    ]]>
  </documentation>
  <references>
    <see type="builder:BomBuilder" relation="SeeAlso" />
  </references>
  <properties>
    <selector type="type:Text">
      <documentation>
        Member path. (required)
      </documentation>
    </selector>
    <result type="type:Text">
      <documentation>
        Found member name, or empty when missing. (optional)
      </documentation>
    </result>
  </properties>
</buildercap:QuerySelector>
