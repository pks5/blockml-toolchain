<!--Builder Capability — Edit
  FQN: org.blockml.bml.builder.capability.Edit-->
<buildercap:Edit xmlns="http://blockml.org/bml"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Start a BomBuilder session from an existing Urmodell
  </is>
  <documentation>
    BomBuilder.edit(document). Deep-clones the document into the session.
    Does not use forkBom. The original BomDocument is not mutated.
  </documentation>
  <references>
    <see type="bomdoc:BomDocument" relation="SeeAlso" />
    <see type="builder:BomBuilder" relation="SeeAlso" />
  </references>
  <properties>
    <document type="bomdoc:BomDocument">
      <documentation>
        Parse-origin or previously sealed document. (required)
      </documentation>
    </document>
    <result type="builder:BomBuilder">
      <documentation>
        Writable session. (required)
      </documentation>
    </result>
  </properties>
</buildercap:Edit>
