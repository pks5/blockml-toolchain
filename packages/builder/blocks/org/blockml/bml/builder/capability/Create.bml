<!--Builder Capability — Create
  FQN: org.blockml.bml.builder.capability.Create-->
<buildercap:Create xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core"
  xmlns:doc="org.blockml.bml.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Start a BomBuilder session from scratch
  </is>
  <documentation>
    # Start a BomBuilder session from scratch
    
    `BomBuilder.create(options)` builds a draft BlockDefinition with xmlns bindings
    for the BML URI, the block package, the baseType package, and
    xmlns:bml (org.blockml.bml.annotation.BmlAnnotation) so bml:id is a bound prefix.
    
    - Sets `SourceInfo.rootForm` to `type` (doc:DocumentFormat preferred form)
    - Omits `xmlns:xsi` and `xsi:schemaLocation` unless the caller adds them later
  </documentation>
  <references>
    <see type="builder:CreateBlockOptions" relation="SeeAlso" />
    <see type="builder:BomBuilder" relation="SeeAlso" />
    <see type="doc:DocumentFormat" relation="SeeAlso" />
  </references>
  <properties>
    <options type="builder:CreateBlockOptions">
      <documentation>
        options (required).
      </documentation>
    </options>
    <result type="builder:BomBuilder">
      <documentation>
        Writable session. (required)
      </documentation>
    </result>
  </properties>
</buildercap:Create>
