<!--
  Builder Capability — Create
  FQN: org.blockml.bml.builder.capability.Create
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type"
  xmlns:doc="org.blockml.bml.documentation">

  <name>Create</name>
  <type>buildercap:Create</type>
  <baseType>core:Capability</baseType>
  <is>Start a BomBuilder session from scratch</is>
  <documentation>
    # Start a BomBuilder session from scratch

    `BomBuilder.create(options)` builds a draft BlockDefinition with xmlns bindings
    for the BML URI, the block package, and the baseType package.

    - Sets `SourceInfo.rootForm` to `type` (doc:DocumentFormat preferred form)
    - Omits `xmlns:xsi` and `xsi:schemaLocation` unless the caller adds them later
  </documentation>
  <references>
    <see type="builder:CreateBlockOptions" relation="SeeAlso" />
    <see type="builder:BomBuilder" relation="SeeAlso" />
    <see type="doc:DocumentFormat" relation="SeeAlso" />
  </references>
  <properties>
    <options type="builder:CreateBlockOptions">
      <documentation>options (required).</documentation>
    </options>
    <result type="builder:BomBuilder">
      <documentation>Writable session. (required)</documentation>
    </result>
  </properties>
</block>
