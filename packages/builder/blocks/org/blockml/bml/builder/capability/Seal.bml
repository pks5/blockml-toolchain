<!--Builder Capability — Seal
  FQN: org.blockml.bml.builder.capability.Seal-->
<buildercap:Seal xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Freeze the draft as an immutable Urmodell
  </is>
  <documentation>
    session.seal() → BomDocument. Deep-clones the draft. Does not serialize
    or validate. Callers pass the result to @blockml/serializer or @blockml/validator.
  </documentation>
  <references>
    <see type="bomdoc:BomDocument" relation="SeeAlso" />
  </references>
  <properties>
    <result type="bomdoc:BomDocument">
      <documentation>
        Sealed Urmodell. (required)
      </documentation>
    </result>
  </properties>
</buildercap:Seal>
