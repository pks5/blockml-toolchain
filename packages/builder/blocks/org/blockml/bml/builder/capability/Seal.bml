<!--Builder Capability — Seal
  FQN: org.blockml.bml.builder.capability.Seal-->
<buildercap:Seal xmlns="http://blockml.org/bml"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Freeze the draft as an immutable Urmodell
  </is>
  <documentation>
    session.seal() → BomDocument. Deep-clones the draft. Does not serialize
    or validate. Callers pass the result to @blockml/serializer or @blockml/validator.
  </documentation>
  <references>
    <see type="bomdoc:BomDocument" relation="SeeAlso" />
  </references>
  <properties>
    <result type="bomdoc:BomDocument">
      <documentation>
        Sealed Urmodell. (required)
      </documentation>
    </result>
  </properties>
</buildercap:Seal>
