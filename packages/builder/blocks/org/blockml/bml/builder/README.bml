<!--
  BlockML Builder — README
  FQN: org.blockml.bml.builder.README
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>README</name>
  <type>builder:README</type>
  <baseType>core:ReadMe</baseType>
  <is>Reading entry for the Builder library</is>
  <documentation>The @blockml/builder package provides BomBuilder, a writable authoring
    session that creates or edits a BOM graph and seal()s it to an immutable
    Urmodell (BomDocument). Serializer and validator consume that document.

    Start at org.blockml.bml.builder.documentation.Introduction.</documentation>
  <references>
    <see type="builderdocumentation:Introduction" relation="ReadFirst" />
    <see type="builderdocumentation:PublicApi" relation="SeeAlso" />
  </references>
</block>
