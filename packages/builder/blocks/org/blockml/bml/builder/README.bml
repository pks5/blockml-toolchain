<!--BlockML Builder — README
  FQN: org.blockml.bml.builder.README-->
<builder:README xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:ReadMe
  </baseType>
  <is>
    Reading entry for the Builder library
  </is>
  <documentation>
    The @blockml/builder package provides BomBuilder, a writable authoring
    session that creates or edits a BOM graph and seal()s it to an immutable
    Urmodell (BomDocument). Serializer and validator consume that document.
    
    Start at org.blockml.bml.builder.documentation.Introduction.
  </documentation>
  <references>
    <see type="builderdocumentation:Introduction" relation="ReadFirst" />
    <see type="builderdocumentation:PublicApi" relation="SeeAlso" />
  </references>
</builder:README>
