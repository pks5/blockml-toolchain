<!--
  Builder Documentation — ScopeExclusions
  FQN: org.blockml.bml.builder.documentation.ScopeExclusions
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>ScopeExclusions</name>
  <type>builderdocumentation:ScopeExclusions</type>
  <baseType>core:Documentation</baseType>
  <is>Explicit out-of-scope for @blockml/builder V1</is>
  <documentation>Out of scope:
    • Schema-aware rejection of unknown members inside the session
    • querySelectorAll, parent/child DOM walk, instance-level selectors
    • File I/O, parse, serialize, validate
    • forkBom structural authoring
    • Changing BlockML meta-model / Definition grammar (V4)
    • Transformer or LSP refactors
    • Overwriting existing .bml files from blockml new</documentation>
  <references>
    <see type="builderdocumentation:Introduction" relation="SeeAlso" />
  </references>
</block>
