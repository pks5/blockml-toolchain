<!--
  Builder Documentation — PackageOwnership
  FQN: org.blockml.bml.builder.documentation.PackageOwnership
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>PackageOwnership</name>
  <type>builderdocumentation:PackageOwnership</type>
  <baseType>core:Documentation</baseType>
  <is>Toolchain responsibilities for Builder</is>
  <documentation>@blockml/builder — BomBuilder session, mutations, seal(). Owns this BML library.

    @blockml/bom — BomDocument and member types.
    @blockml/framework — TypeRegistry (CLI lookup of owning Library / baseType).
    @blockml/parser — load existing documents for edit.
    @blockml/serializer — emit BML after seal.
    @blockml/cli — blockml new command host.</documentation>
  <references>
    <see type="builderdocumentation:ScopeExclusions" relation="ReadNext" />
  </references>
</block>
