<!--Builder Documentation — V1Scope
  FQN: org.blockml.bml.builder.documentation.V1Scope-->
<builderdocumentation:V1Scope xmlns="http://blockml.org/bml"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Explicit V1 capabilities
  </is>
  <documentation>
    <![CDATA[
    In scope V1:
    • BomBuilder.create / edit / seal
    • Identity setters (name, type, baseType, is, documentation, filePath)
    • ensureNamespaceBinding
    • addProperty, addAggregation, addCompositionChild, setMemberValue
    • querySelector for properties.<name> and aggregations.<name>
    • CLI: blockml new FQN (host in @blockml/cli)
    
    Out of scope: see ScopeExclusions.
    ]]>
  </documentation>
  <references>
    <see type="builderdocumentation:ScopeExclusions" relation="SeeAlso" />
  </references>
</builderdocumentation:V1Scope>
