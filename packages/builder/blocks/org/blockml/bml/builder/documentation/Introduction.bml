<!--
  Builder Documentation — Introduction
  FQN: org.blockml.bml.builder.documentation.Introduction
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>Introduction</name>
  <type>builderdocumentation:Introduction</type>
  <baseType>core:Documentation</baseType>
  <is>Purpose and scope of the Builder package</is>
  <documentation>The @blockml/builder package provides BomBuilder, the writable authoring API
    for BlockML. A session builds or edits a BOM graph and seal() produces a normal
    Urmodell (BomDocument). Parser-origin and builder-origin documents share types.

    This library (org.blockml.bml.builder.*) is the SSOT. TypeScript in
    packages/builder/src/ implements it. File I/O lives in @blockml/cli (blockml new).</documentation>
  <references>
    <see type="builderdocumentation:LayerSeparation" relation="ReadNext" />
    <see type="buildercap:Create" relation="SeeAlso" />
    <see type="bomdoc:BomDocument" relation="SeeAlso" />
  </references>
</block>
