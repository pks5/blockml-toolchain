<!--Builder Documentation — ArchitectureOverview
  FQN: org.blockml.bml.builder.documentation.ArchitectureOverview-->
<builderdocumentation:ArchitectureOverview xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Create or edit session to sealed Urmodell
  </is>
  <documentation>
    BomBuilder.create(options) or BomBuilder.edit(document) → draft mutations
    → seal() → BomDocument. Serializer and validator consume the sealed document
    regardless of Parser or Builder provenance.
    
    create starts a new root block. edit deep-clones an existing Urmodell.
    Authoring never mutates a sealed document in place.
  </documentation>
  <references>
    <see type="builderdocumentation:V1Scope" relation="ReadNext" />
  </references>
</builderdocumentation:ArchitectureOverview>
