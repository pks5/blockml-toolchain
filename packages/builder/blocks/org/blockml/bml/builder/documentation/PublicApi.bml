  Builder Documentation — PublicApi
  FQN: org.blockml.bml.builder.documentation.PublicApi
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <name>PublicApi</name>
  <type>builderdocumentation:PublicApi</type>
  <baseType>core:Documentation</baseType>
  <is>Exported API from packages/builder/src/index.ts</is>
  <documentation><![CDATA[
    Exported API from packages/builder/src/index.ts:

    • BomBuilder.create(options) → BomBuilder
    • BomBuilder.edit(document) → BomBuilder
    • session.seal() → BomDocument
    • session.setName / setType / setBaseType / setIs / setDocumentation / setFilePath
    • session.ensureNamespaceBinding(prefix, namespace)
    • session.addProperty(options) / addAggregation(options)
    • session.addCompositionChild(aggregationName, typeFqn)
    • session.setMemberValue(name, value)
    • session.querySelector(selector) → MemberDefinition | undefined
    • packageOfFqn / prefixForPackage helpers
  ]]></documentation>
  <references>
    <see type="buildercap:Create" relation="Defines" />
    <see type="buildercap:Seal" relation="Defines" />
  </references>
</block>
