<!--Builder Documentation — PublicApi
  FQN: org.blockml.bml.builder.documentation.PublicApi-->
<builderdocumentation:PublicApi xmlns="http://blockml.org/bml"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Exported API from packages/builder/src/index.ts
  </is>
  <documentation>
    <![CDATA[
    Exported API from packages/builder/src/index.ts:
    
    • BomBuilder.create(options) → BomBuilder
    • BomBuilder.edit(document) → BomBuilder
    • session.seal() → BomDocument
    • session.setName / setType / setBaseType / setIs / setVersion / setDocumentation / setFilePath
    • session.ensureNamespaceBinding(prefix, namespace)
    • session.addProperty(options) / addAggregation(options)
    • session.addCompositionChild(aggregationName, typeFqn)
    • session.setMemberValue(name, value)
    • session.querySelector(selector) → MemberDefinition | undefined
    • packageOfFqn / prefixForPackage helpers
    ]]>
  </documentation>
  <references>
    <see type="buildercap:Create" relation="Defines" />
    <see type="buildercap:Seal" relation="Defines" />
  </references>
</builderdocumentation:PublicApi>
