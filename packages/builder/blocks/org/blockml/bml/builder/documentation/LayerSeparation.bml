<!--Builder Documentation — LayerSeparation
  FQN: org.blockml.bml.builder.documentation.LayerSeparation-->
<builderdocumentation:LayerSeparation xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:buildercap="org.blockml.bml.builder.capability"
  xmlns:builderdocumentation="org.blockml.bml.builder.documentation"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:framework="org.blockml.bml.framework"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Builder vs BOM vs framework vs CLI
  </is>
  <documentation>
    Layers:
    
    org.blockml.bml.builder.* (@blockml/builder) — writable session, mutations, seal().
    @blockml/bom — Urmodell types only.
    @blockml/framework — TypeRegistry, forkBom (resolve only; not authoring).
    @blockml/parser — BML → BomDocument for Edit.
    @blockml/serializer — BomDocument → BML after seal().
    @blockml/cli — blockml new host (paths, Library catalog, file write).
    
    Builder does not parse, serialize, validate, or write files.
  </documentation>
  <references>
    <see type="builderdocumentation:ArchitectureOverview" relation="ReadNext" />
  </references>
</builderdocumentation:LayerSeparation>
