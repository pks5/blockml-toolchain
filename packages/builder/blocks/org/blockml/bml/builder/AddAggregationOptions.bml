<!--Builder — AddAggregationOptions
  FQN: org.blockml.bml.builder.AddAggregationOptions-->
<builder:AddAggregationOptions xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    builder:BuilderType
  </baseType>
  <is>
    Declared aggregation to append on the draft block
  </is>
  <properties>
    <name type="type:Text">
      <documentation>
        Logical aggregation name. (required)
      </documentation>
    </name>
    <typeFqn type="type:Text">
      <documentation>
        Element type FQN. (required)
      </documentation>
    </typeFqn>
  </properties>
</builder:AddAggregationOptions>
