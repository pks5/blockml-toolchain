<!--Builder — BuilderType
  FQN: org.blockml.bml.builder.BuilderType-->
<builder:BuilderType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for Builder implementation data-structure blocks
  </is>
  <documentation>
    BomBuilder, CreateBlockOptions, and related ValueTypes used as capability payloads.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="bom:UrmodellType" relation="SeeAlso" />
  </references>
</builder:BuilderType>
