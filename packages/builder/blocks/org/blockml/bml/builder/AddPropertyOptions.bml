<!--Builder — AddPropertyOptions
  FQN: org.blockml.bml.builder.AddPropertyOptions-->
<builder:AddPropertyOptions xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    builder:BuilderType
  </baseType>
  <is>
    Declared property to append on the draft block
  </is>
  <properties>
    <name type="type:Text">
      <documentation>
        Logical property name. (required)
      </documentation>
    </name>
    <typeFqn type="type:Text">
      <documentation>
        Property type FQN. (required)
      </documentation>
    </typeFqn>
    <value type="type:Text">
      <documentation>
        Optional literal value. (optional)
      </documentation>
    </value>
  </properties>
</builder:AddPropertyOptions>
