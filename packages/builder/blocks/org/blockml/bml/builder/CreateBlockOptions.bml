<!--Builder — CreateBlockOptions
  FQN: org.blockml.bml.builder.CreateBlockOptions-->
<builder:CreateBlockOptions xmlns="http://blockml.org/bml"
  xmlns:builder="org.blockml.bml.builder"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    builder:BuilderType
  </baseType>
  <is>
    Identity and source options for BomBuilder.create
  </is>
  <documentation>
    type is the root FQN. name defaults to the last FQN segment.
    baseType defaults to org.blockml.bml.core.Block. is defaults to name.
    version is optional definition version (required later for Library.bml).
    filePath is stored on SourceInfo for later serialize.
  </documentation>
  <properties>
    <typeFqn type="type:Text">
      <documentation>
        Root block FQN. TS field: type. (required)
      </documentation>
    </typeFqn>
    <name type="type:Text">
      <documentation>
        Short class name. Defaults to last FQN segment. (optional)
      </documentation>
    </name>
    <baseType type="type:Text">
      <documentation>
        Parent type FQN. (optional)
      </documentation>
    </baseType>
    <is type="type:Text">
      <documentation>
        Idea (Urbild) prose. (optional)
      </documentation>
    </is>
    <documentationText type="type:Text">
      <documentation>
        Optional documentation prose. TS field: documentation. (optional)
      </documentation>
    </documentationText>
    <version type="type:Text">
      <documentation>
        Optional definition version on the created Block. (optional)
      </documentation>
    </version>
    <filePath type="type:Text">
      <documentation>
        SourceInfo.filePath. (optional)
      </documentation>
    </filePath>
  </properties>
</builder:CreateBlockOptions>
