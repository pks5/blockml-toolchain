<!--Parser Capability — ElementLocalName
  FQN: org.blockml.bml.compiler.parser.capability.ElementLocalName-->
<parcap:ElementLocalName xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Get element local name (without prefix)
  </is>
  <documentation>
    Get element local name (without prefix)
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <localName type="type:Text">
      <documentation>
        localName. TS type: type:Text. (required)
      </documentation>
    </localName>
  </properties>
</parcap:ElementLocalName>
