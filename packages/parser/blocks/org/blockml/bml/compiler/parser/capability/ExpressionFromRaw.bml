<!--Parser Capability — ExpressionFromRaw
  FQN: org.blockml.bml.compiler.parser.capability.ExpressionFromRaw-->
<parcap:ExpressionFromRaw xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Wrap raw ${…} text as ExpressionValue (B4)
  </is>
  <documentation>
    Wrap raw ${…} text as ExpressionValue (B4)
  </documentation>
  <properties>
    <raw type="type:Text">
      <documentation>
        raw. TS type: type:Text. (required)
      </documentation>
    </raw>
    <source type="bomcommon:SourceLocation">
      <documentation>
        source. TS type: bomcommon:SourceLocation. (optional)
      </documentation>
    </source>
    <value type="bomvalue:ExpressionValue">
      <documentation>
        value. TS type: bomvalue:ExpressionValue. (required)
      </documentation>
    </value>
  </properties>
</parcap:ExpressionFromRaw>
