<!--Parser Capability — GetCharacterData
  FQN: org.blockml.bml.compiler.parser.capability.GetCharacterData-->
<parcap:GetCharacterData xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Extract text/CDATA content and authoredCharacterDataForm (D8)
  </is>
  <documentation>
    Extract text/CDATA content and authoredCharacterDataForm (D8). Character data is passed through TrimText before the value is stored on the BOM (B13).
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <data type="parmap:CharacterData">
      <documentation>
        data. TS type: parmap:CharacterData. (required)
      </documentation>
    </data>
  </properties>
</parcap:GetCharacterData>
