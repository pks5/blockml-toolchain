<!--Parser Capability — ExtractNamespaceBindings
  FQN: org.blockml.bml.compiler.parser.capability.ExtractNamespaceBindings-->
<parcap:ExtractNamespaceBindings xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Extract xmlns*, xsi schema locations, and authored rootForm from the document root
  </is>
  <documentation>
    Extract xmlns*, xsi schema locations, and authored rootForm from the
    document root (legacy block vs type-as-root).
  </documentation>
  <references>
    <see type="pardocumentation:AttributeClassification" relation="SeeAlso" />
  </references>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <sourceInfo type="bomcommon:SourceInfo">
      <documentation>
        sourceInfo. TS type: bomcommon:SourceInfo. (required)
      </documentation>
    </sourceInfo>
  </properties>
</parcap:ExtractNamespaceBindings>
