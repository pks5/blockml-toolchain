<!--Parser Capability — VisibilityPrefix
  FQN: org.blockml.bml.compiler.parser.capability.VisibilityPrefix-->
<parcap:VisibilityPrefix xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map visibility enum to XML prefix (shared with serializer util)
  </is>
  <documentation>
    Map visibility enum to XML prefix (shared with serializer util)
  </documentation>
  <properties>
    <visibility type="type:Text">
      <documentation>
        visibility. TS type: type:Text. (optional)
      </documentation>
    </visibility>
    <prefix type="type:Text">
      <documentation>
        prefix. TS type: type:Text. (required)
      </documentation>
    </prefix>
  </properties>
</parcap:VisibilityPrefix>
