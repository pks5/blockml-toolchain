<!--Parser Capability — Parse
  FQN: org.blockml.bml.compiler.parser.capability.Parse-->
<parcap:Parse xmlns="http://blockml.org/bml"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Public entry: BML XML string → ParseResult (B26)
  </is>
  <documentation>
    Orchestrates pipeline [1]–[5]. Does not call validator or expand directives.
  </documentation>
  <references>
    <see type="pardocumentation:PublicApi" relation="SeeAlso" />
    <see type="bomapi:ParseOptions" relation="SeeAlso" />
    <see type="bomapi:ParseResult" relation="SeeAlso" />
  </references>
  <properties>
    <source type="type:Text">
      <documentation>
        source. TS type: type:Text. (required)
      </documentation>
    </source>
    <options type="bomapi:ParseOptions">
      <documentation>
        Default filePath=&lt;memory>, continueOnError=true. (optional)
      </documentation>
    </options>
    <result type="bomapi:ParseResult">
      <documentation>
        result. TS type: bomapi:ParseResult. (required)
      </documentation>
    </result>
  </properties>
</parcap:Parse>
