<!--Parser — MapContext
  FQN: org.blockml.bml.compiler.parser.map.MapContext-->
<parmap:MapContext xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    parser:ParserType
  </baseType>
  <is>
    Per-parse mapping configuration and namespace context
  </is>
  <documentation>
    Created by createMapContext(). Passed through map/* modules during step [5].
  </documentation>
  <properties>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <source type="type:Text">
      <documentation>
        Original source string. (required)
      </documentation>
    </source>
    <bindings type="type:Text">
      <documentation>
        Record&lt;string, string> namespace bindings. (required)
      </documentation>
    </bindings>
    <subBlockIndex type="type:Text">
      <documentation>
        Map&lt;string, string> sub-block lookup. (required)
      </documentation>
    </subBlockIndex>
    <parentBlockType type="type:Text">
      <documentation>
        Enclosing block type FQN when nested. (optional)
      </documentation>
    </parentBlockType>
    <isRoot type="type:Boolean">
      <documentation>
        isRoot. TS type: type:Boolean. (required)
      </documentation>
    </isRoot>
    <isEmbedded type="type:Boolean">
      <documentation>
        isEmbedded. TS type: type:Boolean. (required)
      </documentation>
    </isEmbedded>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        Shared map-time diagnostics; structural errors append here without aborting. (required)
      </documentation>
    </diagnostics>
    <parseValue type="type:Text">
      <documentation>
        Optional host parseValue hook from ParseOptions. (optional)
      </documentation>
    </parseValue>
    <resolveMemberType type="type:Text">
      <documentation>
        Optional host hook (ownerTypeFqn, memberName) → property type FQN. (optional)
      </documentation>
    </resolveMemberType>
    <isCommaSugarPayload type="type:Text">
      <documentation>
        Domain PrimitiveEntity payloads beyond the Core well-known comma-sugar set. (optional)
      </documentation>
    </isCommaSugarPayload>
  </properties>
</parmap:MapContext>
