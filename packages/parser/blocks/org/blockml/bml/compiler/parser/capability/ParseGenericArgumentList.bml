<!--Parser Capability — ParseGenericArgumentList
  FQN: org.blockml.bml.compiler.parser.capability.ParseGenericArgumentList-->
<parcap:ParseGenericArgumentList xmlns="http://blockml.org/bml"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Parse a parenthesized TypeExpression list for bml:generics
  </is>
  <documentation>
    Parse a parenthesized TypeExpression list for bml:generics.
    Outer parentheses are required. Reuses the TypeExpression parser used by
    baseType generic applications, without a leading type name.
  </documentation>
  <references>
    <see type="parcap:ParseTypeExpression" relation="SeeAlso" />
  </references>
  <properties>
    <raw type="type:Text">
      <documentation>
        raw. TS type: type:Text. (required)
      </documentation>
    </raw>
    <bindings type="type:Text">
      <documentation>
        xmlns prefix bindings. (required)
      </documentation>
    </bindings>
    <arguments type="bomtype:TypeExpression[]">
      <documentation>
        arguments. TS type: bomtype:TypeExpression[]. (required)
      </documentation>
    </arguments>
  </properties>
</parcap:ParseGenericArgumentList>
