<!--Parser Capability — GetAttribute
  FQN: org.blockml.bml.compiler.parser.capability.GetAttribute-->
<parcap:GetAttribute xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Get attribute value from element by name
  </is>
  <documentation>
    Get attribute value from element by name
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <name type="type:Text">
      <documentation>
        name. TS type: type:Text. (required)
      </documentation>
    </name>
    <value type="type:Text">
      <documentation>
        value. TS type: type:Text. (optional)
      </documentation>
    </value>
  </properties>
</parcap:GetAttribute>
