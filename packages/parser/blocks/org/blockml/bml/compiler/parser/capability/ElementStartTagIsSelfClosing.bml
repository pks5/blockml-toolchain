<!--Parser Capability — ElementStartTagIsSelfClosing
  FQN: org.blockml.bml.compiler.parser.capability.ElementStartTagIsSelfClosing-->
<parcap:ElementStartTagIsSelfClosing xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Detect whether an element's start tag is authored as self-closing
  </is>
  <documentation>
    True when the start tag ends with slash-greater-than. Used to record
    authoredEmptyElementForm on empty see references.
  </documentation>
  <properties>
    <source type="type:Text">
      <documentation>
        source. TS type: type:Text. (required)
      </documentation>
    </source>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <result type="type:Boolean">
      <documentation>
        result. TS type: type:Boolean. (required)
      </documentation>
    </result>
  </properties>
</parcap:ElementStartTagIsSelfClosing>
