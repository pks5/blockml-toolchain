<!--Parser Capability — TrimText
  FQN: org.blockml.bml.compiler.parser.capability.TrimText-->
<parcap:TrimText xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parconfig="org.blockml.bml.compiler.parser.config"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Strip common leading indent, then trim, from text node value
  </is>
  <documentation>
    Strip the longest leading whitespace prefix shared by non-empty lines (pretty-print indent), then trim surrounding whitespace. Relative extra indent on individual lines is kept.
    
    If the first line has non-whitespace and no leading space or tab (text glued to the opening tag), that line is excluded from the prefix calculation. One or more leading spaces or tabs on that same line mean the first line counts. A whitespace-only first line is ignored like any blank line.
    
    Used by GetCharacterData for documentation prose and other character-data hosts (B13).
  </documentation>
  <properties>
    <value type="type:Text">
      <documentation>
        value. TS type: type:Text. (required)
      </documentation>
    </value>
    <trimmed type="type:Text">
      <documentation>
        trimmed. TS type: type:Text. (required)
      </documentation>
    </trimmed>
  </properties>
</parcap:TrimText>
