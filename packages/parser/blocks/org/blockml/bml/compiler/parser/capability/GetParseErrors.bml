<!--Parser Capability — GetParseErrors
  FQN: org.blockml.bml.compiler.parser.capability.GetParseErrors-->
<parcap:GetParseErrors xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Collect xmldom parse error messages
  </is>
  <documentation>
    Collect xmldom parse error messages
  </documentation>
  <properties>
    <document type="parmap:XmlDomNode">
      <documentation>
        document. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </document>
    <errors type="type:Text[]">
      <documentation>
        errors. TS type: type:Text[]. (required)
      </documentation>
    </errors>
  </properties>
</parcap:GetParseErrors>
