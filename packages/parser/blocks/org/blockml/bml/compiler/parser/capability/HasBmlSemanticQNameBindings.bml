  <name>HasBmlSemanticQNameBindings</name>
  <type>parcap:HasBmlSemanticQNameBindings</type>
  <baseType>core:Capability</baseType>
  <is>Detect whether document uses BML-semantic prefixed xmlns</is>

  <documentation>Detect whether document uses BML-semantic prefixed xmlns</documentation>

  <properties>
    <bindings type="type:Text">
      <documentation>bindings. TS type: type:Text. (required)</documentation>
    </bindings>
    <result type="type:Boolean">
      <documentation>result. TS type: type:Boolean. (required)</documentation>
    </result>
  </properties>

