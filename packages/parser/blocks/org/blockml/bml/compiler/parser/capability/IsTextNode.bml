<!--Parser Capability — IsTextNode
  FQN: org.blockml.bml.compiler.parser.capability.IsTextNode-->
<parcap:IsTextNode xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Type guard: DOM node is text
  </is>
  <documentation>
    Type guard: DOM node is text
  </documentation>
  <properties>
    <node type="parmap:XmlDomNode">
      <documentation>
        node. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </node>
    <result type="type:Boolean">
      <documentation>
        result. TS type: type:Boolean. (required)
      </documentation>
    </result>
  </properties>
</parcap:IsTextNode>
