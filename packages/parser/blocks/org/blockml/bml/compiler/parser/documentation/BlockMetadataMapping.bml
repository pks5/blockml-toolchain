<!--Parser Documentation — BlockMetadataMapping
  FQN: org.blockml.bml.compiler.parser.documentation.BlockMetadataMapping-->
<pardocumentation:BlockMetadataMapping xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Block definition metadata field mapping
  </is>
  <documentation>
    <![CDATA[
    Map definition-wrapper child elements to BlockDefinition fields.
    The wrapper may be legacy <block> or a type-or-name tag (doc:DocumentFormat) on the
    document root, each Sub-Block, and each embed. A type tag supplies type; a Sub-Block
    tag supplies name (type stays derived). Child <type>/<name> are omitted unless they
    repeat the same identity.
    
    Identity: name, type, baseType, is, isNot, version, definition
    Structural: since, status, summary, documentation, abstract, final
    Aggregations: keywords, changelog, examples, references, constraints, aliases,
    language, genericTypes, contracts, properties, aggregations, associations,
    capabilities, subBlocks, embeddedBlocks
    
    • xmlRendering (bml:xml metadata) stored on BlockDefinition — NOT in directives[] (B23/D3)
    • authoredPlacement stored for dual element|attribute forms (D9)
    • authoredCharacterDataForm for text vs CDATA (D8)
    • authoredNameChild / authoredTypeChild when child name / type elements are present
    • genericTypes entries: name = element local name; baseType / defaultType attributes;
    documentation children → GenericType.documentations (same prose shape as members;
    not the enclosing Block's documentations[])
    • TrimText on character data: common leading indent stripped, then trim; a first line glued to the opening tag (no leading whitespace) is excluded from the prefix (B13)
    • Visibility prefixes stripped → logical name + visibility (B14 parse half)
    ]]>
  </documentation>
  <references>
    <see type="pardocumentation:MemberMapping" relation="ReadNext" />
    <see type="def:BlockDefinition" relation="SeeAlso" />
  </references>
</pardocumentation:BlockMetadataMapping>
