<!--Parser Capability — SplitQName
  FQN: org.blockml.bml.compiler.parser.capability.SplitQName-->
<parcap:SplitQName xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Split prefixed QName into prefix and local name
  </is>
  <documentation>
    Split prefixed QName into prefix and local name
  </documentation>
  <properties>
    <qname type="type:Text">
      <documentation>
        qname. TS type: type:Text. (required)
      </documentation>
    </qname>
    <parts type="parmap:QNameParts">
      <documentation>
        parts. TS type: parmap:QNameParts. (required)
      </documentation>
    </parts>
  </properties>
</parcap:SplitQName>
