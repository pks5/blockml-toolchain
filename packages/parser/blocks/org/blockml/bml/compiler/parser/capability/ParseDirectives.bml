<!--Parser Capability — ParseDirectives
  FQN: org.blockml.bml.compiler.parser.capability.ParseDirectives-->
<parcap:ParseDirectives xmlns="http://blockml.org/bml"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Parse bml:each/if/unless/with directive attributes
  </is>
  <documentation>
    Parse bml:each/if/unless/with directive attributes.
    bml:generics is composition meta (ParseGenericsBinding), not a flow-control directive.

    bml:with bindings split on commas at the top level of the binding list.
    Commas inside (), [], {}, quotes, and ${ } stay in the value. Each value
    then goes through expressionFromRaw. The expression is not evaluated here.
  </documentation>
  <references>
    <see type="pardocumentation:AttributeClassification" relation="SeeAlso" />
  </references>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <ctx type="parmap:MapContext">
      <documentation>
        ctx. TS type: parmap:MapContext. (required)
      </documentation>
    </ctx>
    <directives type="bomcomp:DirectiveAttribute[]">
      <documentation>
        directives. TS type: bomcomp:DirectiveAttribute[]. (required)
      </documentation>
    </directives>
  </properties>
</parcap:ParseDirectives>
