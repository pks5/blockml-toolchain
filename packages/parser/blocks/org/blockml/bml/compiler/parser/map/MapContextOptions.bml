<!--Parser — MapContextOptions
  FQN: org.blockml.bml.compiler.parser.map.MapContextOptions-->
<parmap:MapContextOptions xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parconfig="org.blockml.bml.compiler.parser.config"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:serdocumentation="org.blockml.bml.compiler.serializer.documentation"
  xmlns:valdocumentation="org.blockml.bml.compiler.validator.documentation">

  <baseType>
    parser:ParserType
  </baseType>
  <is>
    Optional extras when building MapContext
  </is>
  <documentation>
    BML type gap: stands for the options argument of createMapContext() (packages/parser/src/map/context.ts).
  </documentation>
  <properties>
    <subBlockIndex type="type:Text">
      <documentation>
        Map&lt;string, string> sub-block lookup. (optional)
      </documentation>
    </subBlockIndex>
    <parentBlockType type="type:Text">
      <documentation>
        Enclosing block type FQN when nested. (optional)
      </documentation>
    </parentBlockType>
    <isRoot type="type:Boolean">
      <documentation>
        isRoot. TS type: type:Boolean. (optional)
      </documentation>
    </isRoot>
    <isEmbedded type="type:Boolean">
      <documentation>
        isEmbedded. TS type: type:Boolean. (optional)
      </documentation>
    </isEmbedded>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics. TS type: bomcommon:Diagnostic[]. (optional)
      </documentation>
    </diagnostics>
    <parseValue type="type:Text">
      <documentation>
        Optional host parseValue hook from ParseOptions. (optional)
      </documentation>
    </parseValue>
  </properties>
</parmap:MapContextOptions>
