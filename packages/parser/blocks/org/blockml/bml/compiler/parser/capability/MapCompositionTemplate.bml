<!--Parser Capability — MapCompositionTemplate
  FQN: org.blockml.bml.compiler.parser.capability.MapCompositionTemplate-->
<parcap:MapCompositionTemplate xmlns="http://blockml.org/bml"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map &lt;composition> element to CompositionTemplate
  </is>
  <documentation>
    <![CDATA[Map <composition> element to CompositionTemplate]]>
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <ctx type="parmap:MapContext">
      <documentation>
        ctx. TS type: parmap:MapContext. (required)
      </documentation>
    </ctx>
    <template type="bomcomp:CompositionTemplate">
      <documentation>
        template. TS type: bomcomp:CompositionTemplate. (required)
      </documentation>
    </template>
  </properties>
</parcap:MapCompositionTemplate>
