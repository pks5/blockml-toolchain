<!--Parser Capability — ElementPrefix
  FQN: org.blockml.bml.compiler.parser.capability.ElementPrefix-->
<parcap:ElementPrefix xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Get element namespace prefix
  </is>
  <documentation>
    Get element namespace prefix
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <prefix type="type:Text">
      <documentation>
        prefix. TS type: type:Text. (required)
      </documentation>
    </prefix>
  </properties>
</parcap:ElementPrefix>
