<!--Parser Capability — ElementSourceLoc
  FQN: org.blockml.bml.compiler.parser.capability.ElementSourceLoc-->
<parcap:ElementSourceLoc xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Extract SourceLocation from DOM element line/column attrs
  </is>
  <documentation>
    Start from DOM locator line/column when present, else string search. End by scanning source for the matching close tag or self-closing start tag (endLine/endColumn).
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <source type="type:Text">
      <documentation>
        source. TS type: type:Text. (required)
      </documentation>
    </source>
    <location type="bomcommon:SourceLocation">
      <documentation>
        location. TS type: bomcommon:SourceLocation. (required)
      </documentation>
    </location>
  </properties>
</parcap:ElementSourceLoc>
