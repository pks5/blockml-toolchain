<!--Parser Capability — MapBlock
  FQN: org.blockml.bml.compiler.parser.capability.MapBlock-->
<parcap:MapBlock xmlns="http://blockml.org/bml"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map XML element to BlockDefinition
  </is>
  <documentation>
    Map XML element to BlockDefinition
  </documentation>
  <references>
    <see type="pardocumentation:MemberMapping" relation="SeeAlso" />
  </references>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <ctx type="parmap:MapContext">
      <documentation>
        ctx. TS type: parmap:MapContext. (required)
      </documentation>
    </ctx>
    <block type="bomblock:BlockDefinition">
      <documentation>
        block. TS type: bomblock:BlockDefinition. (required)
      </documentation>
    </block>
  </properties>
</parcap:MapBlock>
