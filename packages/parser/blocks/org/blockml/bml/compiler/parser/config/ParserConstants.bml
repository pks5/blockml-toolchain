<!--Parser — ParserConstants
  FQN: org.blockml.bml.compiler.parser.config.ParserConstants-->
<parconfig:ParserConstants xmlns="http://blockml.org/bml"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:parconfig="org.blockml.bml.compiler.parser.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    parser:ParserType
  </baseType>
  <is>
    Well-known URIs and V1 root element name
  </is>
  <documentation>
    Shared across pipeline, qname resolution, and namespace extraction.
  </documentation>
  <properties>
    <XSI_NS type="type:Text">
      <documentation>
        XSI_NS. TS type: type:Text. (required)
      </documentation>
    </XSI_NS>
    <BML_XMLNS type="type:Text">
      <documentation>
        BML_XMLNS. TS type: type:Text. (required)
      </documentation>
    </BML_XMLNS>
    <TYPE_REFERENCE_ENTITY type="type:Text">
      <documentation>
        TYPE_REFERENCE_ENTITY. TS type: type:Text. (required)
      </documentation>
    </TYPE_REFERENCE_ENTITY>
    <V1_ROOT_ELEMENT type="type:Text">
      <documentation>
        V1_ROOT_ELEMENT. TS type: type:Text. (required)
      </documentation>
    </V1_ROOT_ELEMENT>
  </properties>
</parconfig:ParserConstants>
