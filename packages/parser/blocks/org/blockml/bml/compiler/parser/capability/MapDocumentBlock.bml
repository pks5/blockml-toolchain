<!--Parser Capability — MapDocumentBlock
  FQN: org.blockml.bml.compiler.parser.capability.MapDocumentBlock-->
<parcap:MapDocumentBlock xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:pardocumentation="org.blockml.bml.compiler.parser.documentation"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map document root to BomDocument — step [5] entry
  </is>
  <documentation>
    <![CDATA[Map document root (<block> or type tag) to BomDocument — step [5] entry]]>
  </documentation>
  <references>
    <see type="parcap:MapBlock" relation="SeeAlso" />
    <see type="pardocumentation:BlockMetadataMapping" relation="SeeAlso" />
  </references>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <sourceInfo type="bomcommon:SourceInfo">
      <documentation>
        sourceInfo. TS type: bomcommon:SourceInfo. (required)
      </documentation>
    </sourceInfo>
    <ctx type="parmap:MapContext">
      <documentation>
        ctx. TS type: parmap:MapContext. (required)
      </documentation>
    </ctx>
    <document type="bomdoc:BomDocument">
      <documentation>
        document. TS type: bomdoc:BomDocument. (required)
      </documentation>
    </document>
  </properties>
</parcap:MapDocumentBlock>
