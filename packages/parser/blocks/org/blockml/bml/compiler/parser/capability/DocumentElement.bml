<!--Parser Capability — DocumentElement
  FQN: org.blockml.bml.compiler.parser.capability.DocumentElement-->
<parcap:DocumentElement xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Get root element from DOM document
  </is>
  <documentation>
    Get root element from DOM document
  </documentation>
  <properties>
    <document type="parmap:XmlDomNode">
      <documentation>
        document. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </document>
    <element type="parmap:XmlDomNode">
      <documentation>
        Element | null (optional)
      </documentation>
    </element>
  </properties>
</parcap:DocumentElement>
