<!--Parser Capability — FqnToQName
  FQN: org.blockml.bml.compiler.parser.capability.FqnToQName-->
<parcap:FqnToQName xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Convert FQN to prefixed QName using bindings
  </is>
  <documentation>
    Convert FQN to prefixed QName using bindings
  </documentation>
  <properties>
    <fqn type="type:Text">
      <documentation>
        fqn. TS type: type:Text. (required)
      </documentation>
    </fqn>
    <bindings type="type:Text">
      <documentation>
        bindings. TS type: type:Text. (required)
      </documentation>
    </bindings>
    <qname type="type:Text">
      <documentation>
        qname. TS type: type:Text. (required)
      </documentation>
    </qname>
  </properties>
</parcap:FqnToQName>
