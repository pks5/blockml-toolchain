<!--Parser Capability — MergeSourceInfo
  FQN: org.blockml.bml.compiler.parser.capability.MergeSourceInfo-->
<parcap:MergeSourceInfo xmlns="http://blockml.org/bml"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Merge SourceInfo with filePath and format
  </is>
  <documentation>
    Merge SourceInfo with filePath and format
  </documentation>
  <properties>
    <partial type="bomcommon:SourceInfo">
      <documentation>
        partial. TS type: bomcommon:SourceInfo. (required)
      </documentation>
    </partial>
    <filePath type="type:Text">
      <documentation>
        filePath. TS type: type:Text. (required)
      </documentation>
    </filePath>
    <format type="type:Text">
      <documentation>
        format. TS type: type:Text. (required)
      </documentation>
    </format>
    <sourceInfo type="bomcommon:SourceInfo">
      <documentation>
        sourceInfo. TS type: bomcommon:SourceInfo. (required)
      </documentation>
    </sourceInfo>
  </properties>
</parcap:MergeSourceInfo>
