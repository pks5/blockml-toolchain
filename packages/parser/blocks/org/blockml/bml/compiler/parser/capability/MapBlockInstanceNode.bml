<!--Parser Capability — MapBlockInstanceNode
  FQN: org.blockml.bml.compiler.parser.capability.MapBlockInstanceNode-->
<parcap:MapBlockInstanceNode xmlns="http://blockml.org/bml"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Map composition child node to BlockInstanceNode
  </is>
  <documentation>
    Map composition child node to BlockInstanceNode.
    
    Instance property and association values: attributes and child elements
    become memberValues. Repeated same-name elements merge into a list
    (verbose collection form). Compact JSON-like [ … ] in one attribute or
    element stays one list value. Mixing those forms, or attribute plus
    element for the same member, is BML_MIXED_MEMBER_VALUE.
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <ctx type="parmap:MapContext">
      <documentation>
        ctx. TS type: parmap:MapContext. (required)
      </documentation>
    </ctx>
    <node type="bomcomp:BlockInstanceNode">
      <documentation>
        node. TS type: bomcomp:BlockInstanceNode. (required)
      </documentation>
    </node>
  </properties>
</parcap:MapBlockInstanceNode>
