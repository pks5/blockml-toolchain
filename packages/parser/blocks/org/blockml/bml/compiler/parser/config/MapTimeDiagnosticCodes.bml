<!--Parser — MapTimeDiagnosticCodes
  FQN: org.blockml.bml.compiler.parser.config.MapTimeDiagnosticCodes-->
<parconfig:MapTimeDiagnosticCodes xmlns="http://blockml.org/bml"
  xmlns:parser="org.blockml.bml.compiler.parser"
  xmlns:parconfig="org.blockml.bml.compiler.parser.config"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    parser:ParserType
  </baseType>
  <is>
    Diagnostic codes emitted during parse pipeline and mapping
  </is>
  <documentation>
    Hard-fail codes return document: null. Map-time codes may attach to ParseResult with continueOnError.
  </documentation>
  <properties>
    <codes type="type:Text[]">
      <documentation>
        Ordered: BML_UNSUPPORTED_FORMAT, BML_MALFORMED_XML, BML_MISSING_ROOT, BML_INVALID_ROOT, BML_MISSING_BLOCK_TYPE, BML_MISSING_EMBEDDED_BLOCK_TYPE, BML_MISSING_SUBBLOCK_NAME, BML_MAP_ERROR, BML_UNKNOWN_NAMESPACE_PREFIX, BML_UNQUALIFIED_BLOCK_REFERENCE, BML_UNKNOWN_TYPE, BML_INVALID_TYPE_REFERENCE, BML_UNKNOWN_ELEMENT, BML_UNKNOWN_ATTRIBUTE, BML_UNKNOWN_DIRECTIVE, BML_STANDALONE_COMPOSITION, BML_NESTED_COMPOSITION, BML_DUPLICATE_COMPOSITION, BML_DUPLICATE_PROPERTY_VALUE, BML_MIXED_MEMBER_VALUE, BML_UNEXPECTED_TEXT, BML_INVALID_VALUE (required)
      </documentation>
    </codes>
  </properties>
</parconfig:MapTimeDiagnosticCodes>
