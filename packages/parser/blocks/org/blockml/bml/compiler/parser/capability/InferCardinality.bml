<!--Parser Capability — InferCardinality
  FQN: org.blockml.bml.compiler.parser.capability.InferCardinality-->
<parcap:InferCardinality xmlns="http://blockml.org/bml"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Infer cardinality from TypeExpression shape
  </is>
  <documentation>
    Infer cardinality from TypeExpression shape
  </documentation>
  <properties>
    <type type="bomtype:TypeExpression">
      <documentation>
        type. TS type: bomtype:TypeExpression. (optional)
      </documentation>
    </type>
    <cardinality type="type:Text">
      <documentation>
        cardinality. TS type: type:Text. (optional)
      </documentation>
    </cardinality>
  </properties>
</parcap:InferCardinality>
