<!--Parser Capability — ElementChildren
  FQN: org.blockml.bml.compiler.parser.capability.ElementChildren-->
<parcap:ElementChildren xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:parcap="org.blockml.bml.compiler.parser.capability"
  xmlns:parmap="org.blockml.bml.compiler.parser.map">

  <baseType>
    core:Capability
  </baseType>
  <is>
    Get element child nodes as Element array
  </is>
  <documentation>
    Get element child nodes as Element array
  </documentation>
  <properties>
    <element type="parmap:XmlDomNode">
      <documentation>
        element. TS type: parmap:XmlDomNode. (required)
      </documentation>
    </element>
    <children type="parmap:XmlDomNode[]">
      <documentation>
        children. TS type: parmap:XmlDomNode[]. (required)
      </documentation>
    </children>
  </properties>
</parcap:ElementChildren>
