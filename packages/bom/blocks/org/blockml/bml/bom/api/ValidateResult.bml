<!--BOM Urmodell — ValidateResult
  FQN: org.blockml.bml.bom.api.ValidateResult-->
<bomapi:ValidateResult xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Result of validate() (Stage 2)
  </is>
  <documentation>
    Result of @blockml/validator validate(). success is false when any diagnostic has severity error. pragmaticModel is the forked working copy when validation ran.
  </documentation>
  <properties>
    <pragmaticModel type="bomdoc:BomDocument">
      <documentation>
        Pragmatic model fork — optional. TS type: bomdoc:BomDocument | undefined. (optional)
      </documentation>
    </pragmaticModel>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics (required). TS type: bomcommon:Diagnostic[].
      </documentation>
    </diagnostics>
    <success type="type:Boolean">
      <documentation>
        success (required). TS type: type:Boolean.
      </documentation>
    </success>
  </properties>
</bomapi:ValidateResult>
