<!--BOM Urmodell — ValidateOptions
  FQN: org.blockml.bml.bom.api.ValidateOptions-->
<bomapi:ValidateOptions xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Options for validate() (Stage 2)
  </is>
  <documentation>
    Options for @blockml/validator validate(). When typeRegistry is omitted, bootstrapPaths and/or libraryPaths (or framework default paths) populate the registry. libraryPaths selects library-graph bootstrap mode (Library.bml dependency order).
  </documentation>
  <properties>
    <typeRegistry type="bomapi:TypeRegistryReader">
      <documentation>
        Pre-built registry surface — optional. Implemented by @blockml/framework TypeRegistry. (optional)
      </documentation>
    </typeRegistry>
    <bootstrapPaths type="type:Text[]">
      <documentation>
        Directories scanned for .bml when typeRegistry omitted (corpus mode). (optional)
      </documentation>
    </bootstrapPaths>
    <libraryPaths type="type:Text[]">
      <documentation>
        Library.bml file paths for library-graph bootstrap when typeRegistry omitted. (optional)
      </documentation>
    </libraryPaths>
    <continueOnError type="type:Boolean">
      <documentation>
        Default: true — continue after errors; still attach pragmaticModel when possible. (optional)
      </documentation>
    </continueOnError>
  </properties>
</bomapi:ValidateOptions>
