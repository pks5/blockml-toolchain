<!--BOM Urmodell — ParseResult
  FQN: org.blockml.bml.bom.api.ParseResult-->
<bomapi:ParseResult xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Result of parse() (B26)
  </is>
  <documentation>
    Result of parse() (B26)
  </documentation>
  <properties>
    <document type="bomdoc:BomDocument">
      <documentation>
        BomDocument | null — null on hard fail. (required)
      </documentation>
    </document>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics (required). TS type: bomcommon:Diagnostic[].
      </documentation>
    </diagnostics>
    <success type="type:Boolean">
      <documentation>
        success (required). TS type: type:Boolean.
      </documentation>
    </success>
  </properties>
</bomapi:ParseResult>
