<!--BOM Urmodell — SerializeResult
  FQN: org.blockml.bml.bom.api.SerializeResult-->
<bomapi:SerializeResult xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Result of serialize() (B26)
  </is>
  <documentation>
    Result of serialize() (B26)
  </documentation>
  <properties>
    <text type="type:Text">
      <documentation>
        string | null — null if serialize cannot produce text. (required)
      </documentation>
    </text>
    <diagnostics type="bomcommon:Diagnostic[]">
      <documentation>
        diagnostics (required). TS type: bomcommon:Diagnostic[].
      </documentation>
    </diagnostics>
    <success type="type:Boolean">
      <documentation>
        success (required). TS type: type:Boolean.
      </documentation>
    </success>
  </properties>
</bomapi:SerializeResult>
