  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>SerializeOptions</name>
  <type>bomapi:SerializeOptions</type>
  <baseType>bom:UrmodellType</baseType>
  <is>Options for serialize() (B26)</is>

  <documentation>Options for serialize() (B26)</documentation>

  <properties>
    <indent type="type:Integer">
      <documentation>Default: 2. 0 = compact (B13). (optional)</documentation>
    </indent>
    <xmlDeclaration type="type:Boolean">
      <documentation>Default: false (B17/B24). (optional)</documentation>
    </xmlDeclaration>
  </properties>

</block>
