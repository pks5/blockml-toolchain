<!--BOM Urmodell — ParseOptions
  FQN: org.blockml.bml.bom.api.ParseOptions-->
<bomapi:ParseOptions xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Options for parse() (B26)
  </is>
  <documentation>
    Options for parse() (B26)
  </documentation>
  <properties>
    <filePath type="type:Text">
      <documentation>
        Default: "&lt;memory>". (optional)
      </documentation>
    </filePath>
    <continueOnError type="type:Boolean">
      <documentation>
        Default: true. (optional)
      </documentation>
    </continueOnError>
    <parseValue type="type:Text">
      <documentation>
        Optional host hook (typeFqn, raw) → { ok, value } | { ok, skipped } | { ok: false, message }.
        Injected after TypeRegistry bootstrap (e.g. compileBmlToBom). Absent during library bootstrap.
        (optional)
      </documentation>
    </parseValue>
  </properties>
</bomapi:ParseOptions>
