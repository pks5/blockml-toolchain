<!--
  BOM Urmodell — UrmodellType
  FQN: org.blockml.bml.bom.UrmodellType
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomrules="org.blockml.bml.bom.rules"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>UrmodellType</name>
  <type>bom:UrmodellType</type>
  <baseType>core:Entity</baseType>
  <is>Abstract marker for BOM Urmodell data-structure blocks</is>

  <documentation>All org.blockml.bml.bom.* Urmodell types extend this abstract marker. These blocks describe parse-result data structures (Canonical BOM), not BML authoring grammar. Contrast with org.blockml.bml.definition.* (meta-model in @blockml/core).</documentation>

  <references>
    <see type="def:BlockDefinition" relation="SeeAlso" />
  </references>

  <abstract>true</abstract>

</block>
