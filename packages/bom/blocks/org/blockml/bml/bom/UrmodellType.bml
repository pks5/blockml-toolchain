<!--BOM Urmodell — UrmodellType
  FQN: org.blockml.bml.bom.UrmodellType-->
<bom:UrmodellType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition">

  <baseType>
    core:Block
  </baseType>
  <is>
    Abstract marker for BOM Urmodell data-structure blocks
  </is>
  <documentation>
    All org.blockml.bml.bom.* Urmodell types extend this abstract marker. These blocks describe parse-result data structures (Canonical BOM), not BML authoring grammar. Contrast with org.blockml.bml.definition.* (meta-model in @blockml/core).
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="def:BlockDefinition" relation="SeeAlso" />
  </references>
</bom:UrmodellType>
