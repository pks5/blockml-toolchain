<!--BOM Urmodell — XmlTrivia
  FQN: org.blockml.bml.bom.common.XmlTrivia-->
<bomcommon:XmlTrivia xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    XML comment trivia bound to an element (B11)
  </is>
  <documentation>
    <![CDATA[Comment bodies only — without <!-- / -->. Bound to the following XML element.]]>
  </documentation>
  <properties>
    <leadingComments type="type:Text[]">
      <documentation>
        leadingComments (optional). TS type: type:Text[].
      </documentation>
    </leadingComments>
    <trailingComments type="type:Text[]">
      <documentation>
        trailingComments (optional). TS type: type:Text[].
      </documentation>
    </trailingComments>
  </properties>
</bomcommon:XmlTrivia>
