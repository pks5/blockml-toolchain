<!--BOM Urmodell — Multiplicity
  FQN: org.blockml.bml.bom.type.Multiplicity-->
<bomtype:Multiplicity xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Collection multiplicity on a type reference
  </is>
  <documentation>
    Collection multiplicity on a type reference
  </documentation>
  <properties>
    <min type="type:Integer">
      <documentation>
        min (required). TS type: type:Integer.
      </documentation>
    </min>
    <max type="type:Text">
      <documentation>
        number or "*". (required)
      </documentation>
    </max>
  </properties>
</bomtype:Multiplicity>
