  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    bml:with binding entry
  </is>
  <documentation>
    bml:with binding entry
  </documentation>
  <properties>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <value type="bomvalue:ExpressionValue">
      <documentation>
        value (required). TS type: bomvalue:ExpressionValue.
      </documentation>
    </value>
  </properties>
</bomcomp:WithBinding>
