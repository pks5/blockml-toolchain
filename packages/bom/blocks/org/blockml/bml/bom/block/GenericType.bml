<!--BOM Urmodell — GenericType
  FQN: org.blockml.bml.bom.block.GenericType-->
<bomblock:GenericType xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Generic type parameter on a Block definition
  </is>
  <documentation>
    Generic type parameter on a Block definition
  </documentation>
  <properties>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <baseType type="type:Text">
      <documentation>
        baseType (required). TS type: type:Text.
      </documentation>
    </baseType>
    <defaultType type="type:Text">
      <documentation>
        defaultType (optional). TS type: type:Text.
      </documentation>
    </defaultType>
    <documentations type="bomblock:DocumentationProseEntry[]">
      <documentation>
        Technical documentation on this genericTypes entry — maps
        def:GenericTypeDefinition.documentation. Lives on this GenericType, not on the
        enclosing Block's documentations[]. (optional)
      </documentation>
    </documentations>
  </properties>
</bomblock:GenericType>
