<!--BOM Urmodell — GenericType
  FQN: org.blockml.bml.bom.block.GenericType-->
<bomblock:GenericType xmlns="http://blockml.org/bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bom:UrmodellType
  </baseType>
  <is>
    Generic type parameter on a Block definition
  </is>
  <documentation>
    Generic type parameter on a Block definition
  </documentation>
  <properties>
    <name type="type:Text">
      <documentation>
        name (required). TS type: type:Text.
      </documentation>
    </name>
    <baseType type="type:Text">
      <documentation>
        baseType (required). TS type: type:Text.
      </documentation>
    </baseType>
    <defaultType type="type:Text">
      <documentation>
        defaultType (optional). TS type: type:Text.
      </documentation>
    </defaultType>
    <documentations type="bomblock:DocumentationProseEntry[]">
      <documentation>
        Technical documentation on this genericTypes entry — maps
        def:GenericTypeDefinition.documentation. Lives on this GenericType, not on the
        enclosing Block's documentations[]. (optional)
      </documentation>
    </documentations>
  </properties>
</bomblock:GenericType>
