<!--BOM Documentation — TypeExpressionsOverview
  FQN: org.blockml.bml.bom.documentation.TypeExpressionsOverview-->
<bomdocumentation:TypeExpressionsOverview xmlns="http://blockml.org/bml"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Parse-time type expression model
  </is>
  <documentation>
    TypeExpression (alias TypeDescriptor in V1) — structured parse-time AST, not a ValueType.
    Used for Capability inputType/outputType and Property type attributes.
    
    Union variants: named, union, grouped, genericParam, self, anonymousStruct.
    grouped wraps a TypeExpression for nested multiplicity: (T[])[] or (A | B)[].
    
    Anonymous struct = shorthand for inline class with ordered fields (FunctionMapping positional order).
    Single primitive = NamedTypeReference directly — not wrapped in one-field struct.
    
    Union variant discrimination and AST are validateTypes()/parseExpression() utility results —
    not stored in Canonical BOM.
  </documentation>
  <references>
    <see type="bomtype:TypeExpression" relation="Defines" />
  </references>
</bomdocumentation:TypeExpressionsOverview>
