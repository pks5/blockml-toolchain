<!--BlockML BOM Library Descriptor
  FQN: org.blockml.bml.bom.Library-->
<bom:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:core="org.blockml.bml.core">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    The BlockML BOM Urmodell library catalog
  </is>
  <version>
    0.9.13
  </version>
  <documentation>
    # The BlockML BOM Urmodell library catalog
    
    Canonical BOM object model (Urmodell) for BlockML — TypeScript contracts in packages/bom/src/
    implement this library. Consumed by parser, serializer, validator, compiler, and LSP.
    
    Distinct from org.blockml.bml.definition.* (BML meta-model in @blockml/core).
    
    Membership is the nearest Library.bml at the same package level or above; search stops one level below the source folder.
  </documentation>
  <language>
    <blockml:language.English />
  </language>
  <properties>
    <description override="true">
      <value>BlockML BOM Urmodell library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <bom:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
  </aggregations>
</bom:Library>
