<!--
  BlockML BOM Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: org.blockml.bml.bom.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core">

  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML BOM Urmodell library catalog</is>

  <documentation>
    Canonical BOM object model (Urmodell) for BlockML — TypeScript contracts consumed by parser,
    serializer, validator, compiler, and LSP. Depends on org.blockml.bml.Library for framework types.
  </documentation>

  <version>0.1.0</version>

  <language>
    <English />
  </language>

  <properties>
    <description>
      <value>BlockML BOM Urmodell library</value>
    </description>
  </properties>

  <aggregations>
    <dependencies>
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
  </aggregations>

</block>
