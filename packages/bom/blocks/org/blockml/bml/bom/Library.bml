<!--
  BlockML BOM Library Descriptor
  FQN: org.blockml.bml.bom.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:cap="org.blockml.bml.capability">

  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML BOM Urmodell library catalog</is>

  <documentation>
    Canonical BOM object model (Urmodell) for BlockML — TypeScript contracts in packages/bom/src/
    implement this library. Consumed by parser, serializer, validator, compiler, and LSP.
    Distinct from org.blockml.bml.definition.* (BML meta-model in @blockml/core).
    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.6.0</version>

  <language>
    <English />
  </language>

  <properties>
    <description>
      <value>BlockML BOM Urmodell library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <bom:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition><bom:UrmodellType />
        <bomcommon:SourceLocation />
        <bomcommon:SourceInfo />
        <bomcommon:XmlTrivia />
        <bomcommon:UnknownXmlNode />
        <bomcommon:MemberSectionName />
        <bomcommon:MetadataElementTrivia />
        <bomcommon:XmlNodeKind />
        <bomcommon:CharacterDataForm />
        <bomcommon:XmlRenderingBlock />
        <bomcommon:XmlRenderingMember />
        <bomcommon:DiagnosticSeverity />
        <bomcommon:Diagnostic />
        <bomvalue:Address />
        <bomvalue:MemberValue />
        <bomvalue:LiteralValue />
        <bomvalue:ExpressionValue />
        <bomvalue:AddressValue />
        <bomtype:Multiplicity />
        <bomtype:InstanceConfiguration />
        <bomtype:TypeExpression />
        <bomtype:TypeDescriptor />
        <bomtype:NamedTypeReference />
        <bomtype:UnionTypeExpression />
        <bomtype:GroupedTypeExpression />
        <bomtype:GenericParameterReference />
        <bomtype:SelfTypeReference />
        <bomtype:StructField />
        <bomtype:AnonymousStructType />
        <bomblock:TypeReferenceEntityInstance />
        <bomblock:GenericType />
        <bomblock:KeywordEntry />
        <bomblock:DocumentationProseEntry />
        <bomblock:AliasEntry />
        <bomblock:ChangelogEntry />
        <bomblock:DocumentationExample />
        <bomblock:DocumentationReference />
        <bomblock:BlockDefinition />
        <bommember:ConstrainableDefinition />
        <bommember:MemberDefinitionBase />
        <bommember:MemberDefinition />
        <bommember:PropertyValueEntry />
        <bommember:PropertyDefinition />
        <bommember:AggregationDefinition />
        <bommember:AssociationDefinition />
        <bommember:EmbeddedExpression />
        <bommember:ImplementationBlock />
        <bommember:CapabilityDefinition />
        <bomcomp:WithBinding />
        <bomcomp:DirectiveAttribute />
        <bomcomp:EachDirective />
        <bomcomp:IfDirective />
        <bomcomp:UnlessDirective />
        <bomcomp:WithDirective />
        <bomcomp:BlockInstance />
        <bomcomp:CompositionTemplate />
        <bomcomp:InstanceAggregationComposition />
        <bomcomp:CompositionNode />
        <bomcomp:BlockInstanceNode />
        <bomcomp:VirtualContainerNode />
        <bomdoc:BomDocument />
        <bomapi:ParseOptions />
        <bomapi:SerializeOptions />
        <bomapi:ParseResult />
        <bomapi:SerializeResult />
        <bomapi:TypeRegistryReader />
        <bomapi:ValidateResult />
        <bomapi:ValidateOptions />
        <bomcap:StripProvenance />
        <bomcap:BomEquals />
        <bomdocumentation:Introduction />
        <bomdocumentation:LayerSeparation />
        <bomdocumentation:ArchitectureOverview />
        <bomdocumentation:AbstractionPrinciple />
        <bomdocumentation:AuthoredSurfaceTable />
        <bomdocumentation:DesignDecisions />
        <bomdocumentation:PackageOwnership />
        <bomdocumentation:PublicApi />
        <bomdocumentation:XmlComments />
        <bomdocumentation:SubBlockAndEmbeddedBlocks />
        <bomdocumentation:TypeExpressionsOverview />
        <bomdocumentation:MemberValueSemantics />
        <bomdocumentation:CompositionDirectives />
        <bomdocumentation:InstanceIdRules />
        <bomdocumentation:VersionRules />
        <bomdocumentation:ValidationResponsibilities />
        <bomdocumentation:RelatedDiagnostics />
        <bomdocumentation:CalibratorExample />
        <bomdocumentation:ScopeExclusions />
      </composition>
    </blocks>
  </aggregations>

</block>
