<!--
  BlockML BOM Library Descriptor
  FQN: org.blockml.bml.bom.Library
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type"
  xmlns:cap="org.blockml.bml.capability">

  <name>Library</name>
  <type>blockml:Library</type>
  <baseType>core:BlockLibrary</baseType>
  <is>The BlockML BOM Urmodell library catalog</is>

  <documentation>
    Canonical BOM object model (Urmodell) for BlockML — TypeScript contracts in packages/bom/src/
    implement this library. Consumed by parser, serializer, validator, compiler, and LSP.
    Distinct from org.blockml.bml.definition.* (BML meta-model in @blockml/core).
    Membership is defined exclusively by this blocks list.
  </documentation>

  <version>0.1.0</version>

  <language>
    <English />
  </language>

  <properties>
    <description>
      <value>BlockML BOM Urmodell library</value>
    </description>
  </properties>

  <aggregations>
    <readMe>
      <composition>
        <bom:README />
      </composition>
    </readMe>
    <dependencies>
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
    <blocks>
      <composition><bom:UrmodellType /></composition>
      <composition><bomcommon:SourceLocation /></composition>
      <composition><bomcommon:SourceInfo /></composition>
      <composition><bomcommon:XmlTrivia /></composition>
      <composition><bomcommon:MemberSectionName /></composition>
      <composition><bomcommon:MetadataElementTrivia /></composition>
      <composition><bomcommon:XmlNodeKind /></composition>
      <composition><bomcommon:CharacterDataForm /></composition>
      <composition><bomcommon:XmlRenderingBlock /></composition>
      <composition><bomcommon:XmlRenderingMember /></composition>
      <composition><bomcommon:DiagnosticSeverity /></composition>
      <composition><bomcommon:Diagnostic /></composition>
      <composition><bomvalue:Address /></composition>
      <composition><bomvalue:MemberValue /></composition>
      <composition><bomvalue:LiteralValue /></composition>
      <composition><bomvalue:ExpressionValue /></composition>
      <composition><bomvalue:AddressValue /></composition>
      <composition><bomtype:Multiplicity /></composition>
      <composition><bomtype:InstanceConfiguration /></composition>
      <composition><bomtype:TypeExpression /></composition>
      <composition><bomtype:TypeDescriptor /></composition>
      <composition><bomtype:NamedTypeReference /></composition>
      <composition><bomtype:UnionTypeExpression /></composition>
      <composition><bomtype:GenericParameterReference /></composition>
      <composition><bomtype:SelfTypeReference /></composition>
      <composition><bomtype:StructField /></composition>
      <composition><bomtype:AnonymousStructType /></composition>
      <composition><bomblock:TypeReferenceEntityInstance /></composition>
      <composition><bomblock:GenericType /></composition>
      <composition><bomblock:KeywordEntry /></composition>
      <composition><bomblock:DocumentationProseEntry /></composition>
      <composition><bomblock:AliasEntry /></composition>
      <composition><bomblock:ChangelogEntry /></composition>
      <composition><bomblock:DocumentationExample /></composition>
      <composition><bomblock:DocumentationReference /></composition>
      <composition><bomblock:BlockDefinition /></composition>
      <composition><bommember:ConstrainableDefinition /></composition>
      <composition><bommember:MemberDefinitionBase /></composition>
      <composition><bommember:MemberDefinition /></composition>
      <composition><bommember:PropertyValueEntry /></composition>
      <composition><bommember:PropertyDefinition /></composition>
      <composition><bommember:AggregationDefinition /></composition>
      <composition><bommember:AssociationDefinition /></composition>
      <composition><bommember:EmbeddedExpression /></composition>
      <composition><bommember:ImplementationBlock /></composition>
      <composition><bommember:CapabilityDefinition /></composition>
      <composition><bomcomp:WithBinding /></composition>
      <composition><bomcomp:DirectiveAttribute /></composition>
      <composition><bomcomp:EachDirective /></composition>
      <composition><bomcomp:IfDirective /></composition>
      <composition><bomcomp:UnlessDirective /></composition>
      <composition><bomcomp:WithDirective /></composition>
      <composition><bomcomp:BlockInstance /></composition>
      <composition><bomcomp:CompositionTemplate /></composition>
      <composition><bomcomp:InstanceAggregationComposition /></composition>
      <composition><bomcomp:CompositionNode /></composition>
      <composition><bomcomp:BlockInstanceNode /></composition>
      <composition><bomcomp:VirtualContainerNode /></composition>
      <composition><bomdoc:BomDocument /></composition>
      <composition><bomapi:ParseOptions /></composition>
      <composition><bomapi:SerializeOptions /></composition>
      <composition><bomapi:ParseResult /></composition>
      <composition><bomapi:SerializeResult /></composition>
      <composition><bomcap:StripProvenance /></composition>
      <composition><bomcap:BomEquals /></composition>
      <composition><bomdocumentation:Introduction /></composition>
      <composition><bomdocumentation:LayerSeparation /></composition>
      <composition><bomdocumentation:ArchitectureOverview /></composition>
      <composition><bomdocumentation:AbstractionPrinciple /></composition>
      <composition><bomdocumentation:AuthoredSurfaceTable /></composition>
      <composition><bomdocumentation:DesignDecisions /></composition>
      <composition><bomdocumentation:PackageOwnership /></composition>
      <composition><bomdocumentation:PublicApi /></composition>
      <composition><bomdocumentation:XmlComments /></composition>
      <composition><bomdocumentation:SubBlockAndEmbeddedBlocks /></composition>
      <composition><bomdocumentation:TypeExpressionsOverview /></composition>
      <composition><bomdocumentation:MemberValueSemantics /></composition>
      <composition><bomdocumentation:CompositionDirectives /></composition>
      <composition><bomdocumentation:InstanceIdRules /></composition>
      <composition><bomdocumentation:VersionRules /></composition>
      <composition><bomdocumentation:ValidationResponsibilities /></composition>
      <composition><bomdocumentation:RelatedDiagnostics /></composition>
      <composition><bomdocumentation:CalibratorExample /></composition>
      <composition><bomdocumentation:ScopeExclusions /></composition>
    </blocks>
  </aggregations>

</block>
