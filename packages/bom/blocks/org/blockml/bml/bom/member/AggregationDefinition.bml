<!--BOM Urmodell — AggregationDefinition
  FQN: org.blockml.bml.bom.member.AggregationDefinition-->
<bommember:AggregationDefinition xmlns="http://blockml.org/bml"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bommember:MemberDefinitionBase
  </baseType>
  <is>
    Aggregation member definition (kind: aggregation)
  </is>
  <documentation>
    Aggregation member definition (kind: aggregation)
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        kind (required). TS type: type:Text.
      </documentation>
      <value>aggregation</value>
    </kind>
    <type type="bomtype:TypeExpression">
      <documentation>
        type (optional). TS type: bomtype:TypeExpression.
      </documentation>
    </type>
    <cardinality type="type:Text">
      <documentation>
        "0..1" | "0..n" | "1..1" | "1..n". (optional)
      </documentation>
    </cardinality>
    <composition type="bomcomp:CompositionTemplate">
      <documentation>
        composition (optional). TS type: bomcomp:CompositionTemplate.
      </documentation>
    </composition>
    <groups type="bomblock:TypeReferenceEntityInstance[]">
      <documentation>
        groups (optional). TS type: bomblock:TypeReferenceEntityInstance[].
      </documentation>
    </groups>
    <authoredInAggregationsSection type="type:Boolean">
      <documentation>
        authoredInAggregationsSection (optional). TS type: type:Boolean.
      </documentation>
    </authoredInAggregationsSection>
  </properties>
</bommember:AggregationDefinition>
