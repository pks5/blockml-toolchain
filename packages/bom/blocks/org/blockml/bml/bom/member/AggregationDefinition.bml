<!--
  BOM Urmodell — AggregationDefinition
  FQN: org.blockml.bml.bom.member.AggregationDefinition
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <name>AggregationDefinition</name>
  <type>bommember:AggregationDefinition</type>
  <baseType>bommember:MemberDefinitionBase</baseType>
  <is>Aggregation member definition (kind: aggregation)</is>

  <documentation>Aggregation member definition (kind: aggregation)</documentation>

  <properties>
    <kind type="type:Text">
      <documentation>kind (required). TS type: type:Text.</documentation>
      <value>aggregation</value>
    </kind>
    <type type="bomtype:TypeExpression">
      <documentation>type (optional). TS type: bomtype:TypeExpression.</documentation>
    </type>
    <cardinality type="type:Text">
      <documentation>"0..1" | "0..n" | "1..1" | "1..n". (optional)</documentation>
    </cardinality>
    <default type="type:Boolean">
      <documentation>default (optional). TS type: type:Boolean.</documentation>
    </default>
    <composition type="bomcomp:CompositionTemplate">
      <documentation>composition (optional). TS type: bomcomp:CompositionTemplate.</documentation>
    </composition>
    <groups type="bomblock:TypeReferenceEntityInstance[]">
      <documentation>groups (optional). TS type: bomblock:TypeReferenceEntityInstance[].</documentation>
    </groups>
    <authoredInAggregationsSection type="type:Boolean">
      <documentation>authoredInAggregationsSection (optional). TS type: type:Boolean.</documentation>
    </authoredInAggregationsSection>
  </properties>

</block>
