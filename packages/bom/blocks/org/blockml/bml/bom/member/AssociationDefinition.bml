<!--BOM Urmodell — AssociationDefinition
  FQN: org.blockml.bml.bom.member.AssociationDefinition-->
<bommember:AssociationDefinition xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:bom="org.blockml.bml.bom"
  xmlns:bomapi="org.blockml.bml.bom.api"
  xmlns:bomblock="org.blockml.bml.bom.block"
  xmlns:bomcap="org.blockml.bml.bom.capability"
  xmlns:bomcommon="org.blockml.bml.bom.common"
  xmlns:bomcomp="org.blockml.bml.bom.composition"
  xmlns:bomdoc="org.blockml.bml.bom.document"
  xmlns:bomdocumentation="org.blockml.bml.bom.documentation"
  xmlns:bommember="org.blockml.bml.bom.member"
  xmlns:bomtype="org.blockml.bml.bom.type"
  xmlns:bomvalue="org.blockml.bml.bom.value"
  xmlns:core="org.blockml.bml.core"
  xmlns:def="org.blockml.bml.definition"
  xmlns:type="org.blockml.bml.type">

  <baseType>
    bommember:MemberDefinitionBase
  </baseType>
  <is>
    Association member definition (kind: association)
  </is>
  <documentation>
    Association member definition (kind: association)
  </documentation>
  <properties>
    <kind type="type:Text">
      <documentation>
        kind (required). TS type: type:Text.
      </documentation>
      <value>association</value>
    </kind>
    <type type="bomtype:TypeExpression">
      <documentation>
        type (required). TS type: bomtype:TypeExpression.
      </documentation>
    </type>
    <cardinality type="type:Text">
      <documentation>
        "0..1" | "0..n". (required)
      </documentation>
    </cardinality>
  </properties>
</bommember:AssociationDefinition>
